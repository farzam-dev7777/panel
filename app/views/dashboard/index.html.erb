
<div class="row">
	<div class="col-xs-12 col-md-12">
		<div class="page-header-sp m-top">
			<div class="page-title">Roster <span>Status</span> </div>
			<div></div>
		</div>
	</div>
	<div class="col-xs-12 col-md-12">
		<div class="sp-form sp-form-bg text-center">
			<p><b><%= certification_status(current_law_firm) %></b> 
			<b><%= link_to 'Submit Request Conflict Waiver', new_conflict_waiver_path, html_options = {class: 'btn-type-primary'}   %></b></p>
		</div>
	</div>
</div>
	
<div class="row">
	<div class="col-xs-12 col-md-12">
		<div class="page-header-sp">
			<div class="page-title ">Conflict Waivers</div>
			<div></div>
		</div>
	</div>
	<div class="col-xs-12 col-md-12">
		<div class="">
			<div>
				<% if current_law_firm.conflict_waivers.order(created_at: :desc).limit(5).size > 0 %>
				<div class="table-responsive">
					<table class="table table-decoration table-bordered">
						<thead>
						<tr>
							<th>Name of law firm</th>
							<th>Date of submission</th>
							<th>LXP Status</th>
							<th>Lawyer Status</th>
							<th width="8%">Action</th>
						</tr>
						</thead>
						<tbody>
							<%- current_law_firm.conflict_waivers.each do |conflict_waiver|  %>
							<tr>
								<td><%= conflict_waiver.name_of_law_firm %></td>
								<td><%= conflict_waiver.created_at.strftime("%d %b, %Y") %></td>
								<td><%= conflict_waiver.lxp_status_show %></td>
								<td><%= conflict_waiver.internal_lawyers_status_show %></td>
								<td>
									<div class="action-fields">
										<% if conflict_waiver.try(:lxp_status) != 'APPROVED' %>
										<a class="action-btn" href="/conflict_waivers/<%= conflict_waiver.id %>/edit">
											<%= image_tag "edit-icon.svg", alt:"Edit" %>
										</a>	
										<% end %>
										<a class="action-btn" href="/conflict_waivers/<%= conflict_waiver.id %>">
											<%= image_tag "view-icon.svg", alt:"View" %>
										</a>
									</div>	
								</td>
							</tr>
							<% end %>
						</tbody>
					</table>
				</div>
				<% else %>
					<h4 class="text-center">There are no Conflict waivers submissions to review yet</h4>
				<% end %>
			</div>
		</div>
	</div>
</div>


				
