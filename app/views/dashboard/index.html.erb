<div class="row">
  <div class="law_firm_dashboard">
    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
      <ul id="sparks" class="top-status-card">
        <li class="sparks-info color-border-01">
          <a href="/" class="card-content">
            <div class="card-icon bg-color-01">
              <%= image_tag "exceptions-icon.svg", alt:"Panel Firms" %>
            </div>
            <div class="card-details">
              <div class="total-record"><%= @client_count %></div>
              <div class="card-name">Number of clients</div>
              <div class="card-tag-line">Number of clients</div>
            </div>
          </a>
        </li>
        <li class="sparks-info color-border-03">
          <a href="/matter_intakes?filter=yes" class="card-content">
            <div class="card-icon bg-color-03">
              <%= image_tag "approved-icon.svg", alt:"Matters" %>
            </div>
            <div class="card-details">
              <div class="total-record"><%= @matter_intakes_count %></div>
              <div class="card-name">Matters</div>
              <div class="card-tag-line">Tag lines goes here</div>
            </div>
          </a>
        </li>
        <li class="sparks-info color-border-02">
          <a href="/invoices" class="card-content" >
            <div class="card-icon bg-color-02">
              <%= image_tag "submitted-icon.svg", alt:"Panel Consideration Requests" %>
            </div>
            <div class="card-details">
              <div class="total-record"><%= number_to_currency(@invoices_total || 0, unit: "$", strip_insignificant_zeros: true) %></div>
              <div class="card-name">FY Invoices</div>
              <div class="card-tag-line">Tag lines goes here</div>
            </div>
          </a>
        </li>
        <li class="sparks-info color-border-04">
          <a href="/conflict_waivers?filter=yes" class="card-content">
            <div class="card-icon bg-color-04">
              <%= image_tag "exceptions-icon.svg", alt:"Conflict Waiver Requests" %>
            </div>
            <div class="card-details">
              <div class="total-record"><%= @confilictc_requests_submitted %></div>
              <div class="card-name">Conflict Waiver Requests(Pending)</div>
              <div class="card-tag-line">Tag lines goes here</div>
            </div>
          </a>
        </li>
      </ul>
    </div>
  </div>
</div>
<div class="row">
  <div class="col-xs-12 col-md-12">
    <div class="page-header-sp m-top">
      <% if current_law_firm&.status_show == 'Off Panel'%>
        <div class="page-title" style="background: red;border-radius: 5px;padding: 5px; margin-top: 20px;">
          <%= current_law_firm&.status_show%>
        </div>
      <% else %>
        <div class="page-title" style="background: green;border-radius: 5px;padding: 5px; margin-top: 20px;">
          <%= current_law_firm&.status_show%>
        </div>
      <% end %>
    </div>
  </div>
  <div class="col-xs-12 col-md-12">
    <div class="sp-form sp-form-bg text-center">
      <p><b><%= certification_status(current_law_firm) %></b>
    </div>
  </div>
</div>
<%if @security_alerts.present? %>
  <div class="row">
    <%= render "news" %>
  </div>
<% end %>
<div class="row">
  <%= render "rfp_invite" %>
</div>
<div class="row">
  <%= render "matter_intake" %>
</div>
<div class="row">
  <%= render "invoice" %>
</div>
<div class="row">
  <div class="col-xs-12 col-md-12">
    <div class="page-header-sp">
      <div class="page-title ">Conflict Waiver Requests</div>
      <div class="back-edit-actions">
        <a class="btn-show-more" href="/conflict_waivers/new"> New</a>
      </div>
    </div>
  </div>
  <div class="col-xs-12 col-md-12">
    <div class="">
      <div>
        <% if current_law_firm && current_law_firm&.conflict_waivers.order(created_at: :desc).limit(5).size > 0 %>
          <div class="table-responsive">
            <table class="table table-decoration table-bordered">
              <thead>
                <tr>
                  <th>Date Submitted</th>
                  <th>Client</th>
                  <th>Internal Contact</th>
                  <th>Status Update Date</th>
                  <th>Status</th>
                  <th width="8%">Action</th>
                  <!--<th width="8%">Action</th>-->
                </tr>
              </thead>
              <tbody>
                <%- current_law_firm.conflict_waivers.each do |conflict_waiver|  %>
                  <tr onClick="window.location.href='/conflict_waivers/<%= conflict_waiver.id %>'">
                    <td data-order="<%= conflict_waiver.created_at.strftime('%Y%m%d%H%M') %>">
                      <%= conflict_waiver.created_at.strftime('%d %b %Y at %I:%M %p') %>
                    </td>
                    <td><%= conflict_waiver.repesenting %></td>
                    <td><%= conflict_waiver.bmo_business_contact %></td>
                    <td><%= conflict_waiver.updated_at.strftime('%d %b %Y at %I:%M %p') %></td>
                    <td>
                      <% if conflict_waiver.lxp_status_show.present? %>
                        <div class="status">
                          <span class="<%= conflict_waiver.lxp_status_show === "Approved" ? 'label label-success' : 'label label-default' %>">
                            <%= conflict_waiver.try(:lxp_status_show).try(:titleize) %>
                          </span>
                        </div>
                      <% else %>
                        -
                      <% end %>
                    </td>
                    <td>
                      <div class="action-fields">
                        <% if conflict_waiver.try(:lxp_status) != 'APPROVED' %>
                          <a class="action-btn" href="/conflict_waivers/<%= conflict_waiver.id %>/edit">
                            <%= image_tag "edit-icon.svg", alt:"Edit" %>
                          </a>
                        <% end %>
                        <a class="action-btn" href="/conflict_waivers/<%= conflict_waiver.id %>">
                          <%= image_tag "view-icon.svg", alt:"View" %>
                        </a>
                      </div>
                    </td>
                    <!--<td>
                  <div class="action-fields">
                    <a class="action-btn" href="/admin/conflict_waivers/<%= conflict_waiver.id %>">
                      <%= image_tag "view-icon.svg", alt:"View" %>
                    </a>
                  </div>
                </td>-->
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div class="sp-form sp-form-bg text-center">
            <h4 class="text-center">No submissions to date</h4>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>