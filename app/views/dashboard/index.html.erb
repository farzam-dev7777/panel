<div class="row">
	<%= certification_status(current_law_firm) %>
</div>

<div class="clearfix"></div>

<div class="col-md-6">
	<div class="jarviswidget security-threats jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">


		<header>
			<span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
			<h2 class="font-md"><strong>Security Threats </strong></h2>				
		</header>

		<div>

			<div>
				<!-- widget edit box -->
				<div class="jarviswidget-editbox">
					<div>
						<label>Title:</label>
						<input type="text" />
					</div>
				</div>
				<!-- end widget edit box -->

				<% if @action_items.any? %>
				<div class="widget-body no-padding smart-form">
					<!-- content goes here -->
					
					<% if (@action_items.select{|a| a.status != 'complete' && a.security_threat.severity_level.name == 'critical'}).count > 0 %>
						<h5 class="todo-group-title"><i class="fa fa-warning"></i> Critical</h5>
					<% end %>
					<% @action_items.select{|a| a.status != 'complete' && a.security_threat.severity_level.name == 'critical'}.each do |item| %>
						<%= render partial: 'action_item', locals: { item: item } %>
					<% end %>

					<% if (@action_items.select{|a| a.status != 'complete' && a.security_threat.severity_level.name == 'high'}).count > 0 %>
						<h5 class="todo-group-title"><i class="fa fa-warning"></i> High</h5>
					<% end %>
					<% @action_items.select{|a| a.status != 'high' && a.security_threat.severity_level.name == 'high'}.each do |item| %>
						<%= render partial: 'action_item', locals: { item: item } %>
					<% end %>

					<% if (@action_items.select{|a| a.status != 'complete' && a.security_threat.severity_level.name == 'low'}).count > 0 %>
						<h5 class="todo-group-title"><i class="fa fa-warning"></i> Low</h5>
					<% end %>
					<% @action_items.select{|a| a.status != 'low' && a.security_threat.severity_level.name == 'low'}.each do |item| %>
						<%= render partial: 'action_item', locals: { item: item } %>
					<% end %>



					<h5 class="todo-group-title"><i class="fa fa-check"></i> Completed Tasks</h5>
					<ul id="sortable3" class="todo">
						<% @action_items.select{|a| a.status == 'complete'}.each do |item| %>
						<li class="complete">
							<span class="handle" style="display:none"> <label class="checkbox state-disabled">
								<input type="checkbox" name="checkbox-inline" checked="checked" disabled="disabled">
								<i></i> </label> </span>
								<p>
									<strong><%= item.security_threat.title %></strong> [<%= link_to "More Details", action_item_path(item), :class => "", :remote => true, "data-toggle" => "modal", "data-target" => "securityAlert" %>] <span class="text-muted"><%= item.security_threat.description %> </span>
									<span class="date"><%= time_ago_in_words(item.created_at) %></span>
								</p>
							</li>
							<% end %>
						</ul>

						<!-- end content -->
					</div>


					<% else %>
						<em class="text-center"> There are no security threats </em>
					<% end %>

				</div>

			</div>


		</div>

	</div>

