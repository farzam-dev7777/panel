<!-- Matter Intakes Starts -->
<% rfp_invites = current_user&.law_firm && current_user&.law_firm&.rfp_invites.order("updated_at desc") %>
<div class="col-lg-12 col-md-12 col-sm-12">
  <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" 
  data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
    <div class="page-header-sp mobile-dashboard-header">
      <div class="page-title">RFPs</div>
    </div>
    <div class="no-padding">
      <% if rfp_invites.blank? %>
        <div class="sp-form sp-form-bg text-center">
          <h4 class="text-center">There are no RFP Invites created</h4>
        </div>
      <% else %>
        <div class="jarviswidget-editbox"></div>
          <!-- widget content -->
          <div class="widget-body">
          <div class="table-responsive">
            <table id="" class="table table-decoration table-bordered" width="100%">
              <thead>
                <tr>
                  <th>Matter Name</th>
                  <th>Number</th>
                  <th>Date Submitted</th>
                  <th>Date Expiry</th>
                  <th>Submitter By</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
                <tbody>
                  <% rfp_invites.each do |rfp_invite| %>
                      <tr onClick="window.location.href='rfps/<%= rfp_invite.rfp_id %>'">
                        <% rfp = rfp_invite.rfp%>
                        <% matter_intake =  rfp_invite.rfp.matter_intake%>
                        <td><%= matter_intake.name_of_matter_client %></td>
                        <td><%= matter_intake.matter_number.present? ? matter_intake.matter_number : "-" %></td>
                        <td><%= rfp_invite.created_at.strftime('%d %b %Y') %></td>
                        <td><%= rfp.expiry_date&.strftime('%d %b %Y') %></td>
                        <td>
                          <% if matter_intake.submitter_name.present? %>
                            <div class="firm-name">
                              <div class="name-avatar"><img src="<%= get_avatar_image(matter_intake&.submitter_name&.gsub(" ", "+")) %>"></div>
                              <div><%= matter_intake.submitter_name %></div>
                            </div>
                          <% else %>
                            -
                          <% end %>
                        </td>
                        <td><%= rfp.status %></td>
                        <td>
                          <% if rfp_invite.status == 'pending'%>
                            <%= link_to "Accept Invite", accept_invite_rfps_path(rfp_invite_id:rfp_invite.id), class: "btn btn-xs btn-secondary" %>  
                          <% else %>
                            <% proposal = rfp.proposals.where(law_firm_id: current_user&.law_firm.id ).first%>
                            <% if rfp.proposals.where(law_firm_id:current_user&.law_firm.id ).blank? %>
                              <%= link_to "Create Proposals", new_rfp_proposal_path(rfp), class: "btn btn-xs btn-secondary" %>
                            <% else %>
                              <%= link_to "Proposal", rfp_proposal_path(rfp, proposal), class: "btn btn-xs btn-secondary" %>
                            <% end %>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
<!-- Matter Intakes Ends-->