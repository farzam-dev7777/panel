<style>.user-form-wrapper { background-image: url(<%= asset_path 'bg-photo.jpg' %>) !important }</style>
<div class="jarviswidget form-wizard-wrapper" id="wid-id-0" data-widget-editbutton="false">
  <header>
    <span class="widget-icon"> <i class="fa fa-certificate"></i> </span>
    <h2>Certification Submission</h2>

  </header>

  <!-- widget div-->
  <div role="content">

    <!-- widget content -->
    <div class="widget-body fuelux no-padding user-form-wrapper">
      <%= render 'wizard' %>
      <div class="clearfix"></div>
      <div class="row">
        <div class="col-md-12 logics" data-logics=<%= logics.to_json(methods: :repeater_field) %>>
          <%= simple_form_for @form_submission, validate: true, :html => {:multipart => true, remote: true, authenticity_token: true} do |f| %>
            <%= yield :form %>
          <% end %>
        </div>
      </div>

      <div class="widget-footer" style="top: 54px;"">

        <div class="text-center">
          <div class="btn-group">
            <% if !first_step %>
              <%= link_to "<i class='fa fa-caret-left'></i> Prev <i class='loader fa fa-circle-o-notch fa-spin hidden'></i>".html_safe, previous_step_path, class: 'btn btn-default submit-form' %>
            <% end %>
            <%= link_to "<i class='fa fa-floppy-o'></i> Save".html_safe, current_step_path, class: 'btn btn-primary submit-form' %>

            <% if(last_step) %>
              <a href="#" class="btn btn-default submit-form finalize-submission" data-form_id=<%= params[:id] %>>
                <i class='fa fa-caret-right'></i> Submit
              </a>
            <% else %>
              <%= link_to "Next <i class='fa fa-caret-right'></i> <i class='loader fa fa-circle-o-notch fa-spin hidden'></i>".html_safe, next_step_path, class: 'btn btn-default submit-form' %>
            <% end %>
          </div>
        </div>
        
      </div>

    </div>
    
    <br />
    <br />
    <br />
    <!-- end widget content -->

  </div>
  <!-- end widget div -->

</div>