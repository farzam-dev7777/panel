<style>
  .user-form-wrapper { 
    /* background-image: url(<%= asset_path 'bg-photo.jpg' %>) !important  */
    }
</style>
<div class="row">
<div class="col-md-12">
  <div class="form-wizard-wrapper" id="wid-id-0" data-widget-editbutton="false">
    <!--header>
      <span class="widget-icon"> <i class="fa fa-certificate"></i> </span>
      <h2>Certification Submission</h2>
      <div style="float: right;padding-right: 10px;">
        <h2>Last Saved: <strong class="last-updated-timestamp"><%= @form_submission.updated_at.in_time_zone('Eastern Time (US & Canada)').strftime(LawFirm::TIME_FORMAT) %></strong> 
          <% if @form_submission.last_submitted_by %>
            by <strong><%= @form_submission.last_submitted_by.try(:username) %></strong>
          <% end %>
        </h2>
      </div>
    </header-->
      <div class="page-header-sp m-top">
        <div class="page-title">Certification Submission</div>
        <div class="back-edit-actions">
          <span>Last Saved: <strong class="last-updated-timestamp"><%= @form_submission.updated_at.in_time_zone('Eastern Time (US & Canada)').strftime(LawFirm::TIME_FORMAT) %></strong> 
            <% if @form_submission.last_submitted_by %>
              by <strong><%= @form_submission.last_submitted_by.try(:username) %></strong>
            <% end %>
          </span>
        </div>
      </div>
    <!-- widget div-->
    <div role="content">

      <!-- widget content -->
      <div class="fuelux no-padding">
        <%= render 'wizard' %>
        <div class="clearfix"></div>
        <div class="row">
          <div class="col-md-12 logics" 
              data-logics='<%= logics.to_json(methods: :repeater_field).to_s %>'
              data-follow-ups='<%= @form_submission.follow_ups.review.to_json(methods: :form_field_id) %>'
              data-form-submission-status=<%= @form_submission.status %>>

              <% if @form_submission.status == 'follow_up' %>
                <div class="col-md-12 toggle-view">
                  <a id="view-only-follow-ups" href="javascript:void(0)">View Only Follow Up Questions</a>
                  &nbsp; &nbsp; &nbsp; | &nbsp; &nbsp; &nbsp;
                  <a id="view-all-questions" href="javascript:void(0)">View All Questions</a>
                </div>
              <% end %>

            <%= simple_form_for @form_submission, validate: true, :html => {:multipart => true, authenticity_token: true} do |f| %>
              <input id="redirect_value" type="hidden" name="redirect_value">
              <div class="real-form clearfix">
                <%= yield :form %>
              </div>
              <div class="cloned-form clearfix">
                <div class="col-md-12  form-enclosure">
                  
                </div>
              </div>
            <% end %>
          </div>
        </div>
         <div>
          	<div class="tab-content">
              <div class="tab-pane fade in active" id="hr1">
                <div class="sp-form-bg show-data-fields">
                  <div class="row send-password-link">
                   <h2 style=" font-weight: bold; margin-left: 0; "> Law Firm Information :</h2>
                    <div class="row">
                     
                      <div class="col-md-12">
                        <div class="inner-label">Contact Information</div>
                        <div class="inner-form-field form-flex-wrap">
                          <div class="col-xs-12 col-md-6">
                            <div class="field-label">Law Firm Name </div>
                            <div class="field-data"><%= @form_submission.law_firm.name %></div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">BMO Relationship Partner Name</label>
                            <div class="field-data"><%= @form_submission.law_firm.bmo_relationship_partner_name  %> </div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">BMO Relationship Partner Email</label>
                            <div class="field-data"><%= @form_submission.law_firm.bmo_relationship_partner_email  %> </div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">BMO Relationship Partner Phone No.</label>
                            <div class="field-data"><%= @form_submission.law_firm.bmo_relationship_partner_phone_number  %> </div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">Additional BMO Relationship Contact Name (optional)</label>
                            <div class="field-data"><%= @form_submission.law_firm.secondary_rm_contact %> </div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">Additional BMO Relationship Contact Email (optional)</label>
                            <div class="field-data"><%= @form_submission.law_firm.secondary_rm_contact_email %> </div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">Billing Contact Name</label>
                            <div class="field-data"><%= @form_submission.law_firm.billing_contact_name %> </div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">Billing Contact Email</label>
                            <div class="field-data"><%= @form_submission.law_firm.billing_contact_email %> </div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <div class="field-label">Locations</div>	
                          
                            <div class="field-data"><%= @form_submission.law_firm.locations.map{|location| [location.city, location.province, @form_submission.law_firm.country_name(location.country)].reject(&:nil?).join(',') }.join("<br />").html_safe %></div>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-12">
                        <div class="inner-label">SEMS Information</div>
                        <div class="inner-form-field form-flex-wrap">
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">Engagement Number</label>
                            <div class="field-data"><%= @form_submission.law_firm.engagement_number  %> </div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">Relationship Number</label>
                            <div class="field-data"><%= @form_submission.law_firm.relationship_number %> </div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">Information Security Class</label>
                            <div class="field-data"><%= @form_submission.law_firm.information_security_class %> </div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">Information Security Assessment Outcome</label>
                            <div class="field-data"><%= @form_submission.law_firm.information_security_assessment_outcome %> </div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">Action Plan Findings</label>
                            <div class="field-data"><%= @form_submission.law_firm.action_plan_findings %> </div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">Action Plan Status</label>
                            <div class="field-data"><%= @form_submission.law_firm.action_plan_status  %> </div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">Information Security Contact Name</label>
                            <div class="field-data"><%= @form_submission.law_firm.information_security_contact %> </div>
                          </div>
                          <div class="col-xs-12 col-md-6">
                            <label class="field-label">Information Security Contact Email</label>
                            <div class="field-data"><%= @form_submission.law_firm.information_security_contact_email %> </div>
                          </div>
                        </div>
                      </div>
                      <div class="col-md-12">
                        <div class="inner-label">Law Firm Information</div>
                          <div class="inner-form-field form-flex-wrap">
                            <div class="col-xs-12 col-md-6">
                              <div class="field-label">No. of personnel</div>		
                              <div class="field-data"><%= @form_submission.law_firm.number_of_lawyers %></div>
                            </div>
                          
                            <div class="col-xs-12 col-md-6">
                              <label class="field-label">Diverse</label>
                              <div class="field-data"><%= @form_submission.law_firm.diverse %> </div>
                            </div>
                            <div class="col-xs-12 col-md-6">
                              <label class="field-label">Value-Add Activities</label>
                              <div class="field-data"><%= @form_submission.law_firm.values.map{|value| [value.value].reject(&:nil?).join(',') }.join("<br />").html_safe %></div>
                            </div>
                            <div class="col-xs-12 col-md-6">
                              <label class="field-label">Feedback</label>
                              <div class="field-data"><%= @form_submission.law_firm.feedbacks.map{|feedback| [feedback.feedback].reject(&:nil?).join(',') }.join("<br />").html_safe %></div>
                            </div>
                            <div class="col-xs-12 col-md-6">
                              <label class="field-label">Issues</label>
                              <div class="field-data"><%= @form_submission.law_firm.issues.map{|issue| [issue.issue].reject(&:nil?).join(',') }.join("<br />").html_safe %></div>
                            </div>
                            <div class="col-xs-12 col-md-6">
                              <label class="field-label">Merger/Combination</label>
                              <div class="field-data"><%= @form_submission.law_firm.merger_combination  %> </div>
                            </div>
                        </div>
                      </div>
                      <div class="col-md-12">
                        <div class="inner-label">Law Firm Information</div>
                          <div class="inner-form-field form-flex-wrap">
                            <div class="col-xs-12 col-md-6">
                              <div class="field-label">Username</div>
                              <div class="field-data"><%= !@form_submission.law_firm.user.try(:username).blank? ? @form_submission.law_firm.user.try(:username) : '-' %></div>
                            </div>
                            <div class="col-xs-12 col-md-6">
                              <div class="field-label">Law Firm Login Email </div>
                              <div class="field-data"><%= !@form_submission.law_firm.user.try(:email).blank? ? @form_submission.law_firm.user.try(:email) : '-' %></div>
                            </div>
                            <div class="col-xs-12 col-md-6">
                              <div class="field-label">Law Firm Login User Phone </div>
                              <div class="field-data"><%= @form_submission.law_firm.phone %></div>
                            </div>
                          </div>
                      </div>
                    
                      <% if Current.user.role === "internal_lawyers" %>
                        <div class="col-xs-12 col-md-6">
                          <div class="field-label">Relationship Manager Name	</div>
                          <div class="field-data"><%= @form_submission.law_firm.relationship_manager_name %></div>
                        </div>
                        <div class="col-xs-12 col-md-6">
                          <div class="field-label">Relationship Manager Email </div>
                          <div class="field-data"><%= @form_submission.law_firm.relationship_manager_email %></div>
                        </div>
                        <div class="col-xs-12 col-md-6">
                          <div class="field-label">Relationship Manager Phone </div>
                          <div class="field-data"><%= @form_submission.law_firm.relationship_manager_phone %></div>
                        </div>
                      <% end %>
                      <!--div class="col-xs-12 col-md-6">
                        <div class="field-label">Initial Date of Engagement with BMO</div>		
                        <div class="field-data"><%= @form_submission.law_firm.initial_date_of_engagement_with_the_bank && @form_submission.law_firm.initial_date_of_engagement_with_the_bank.in_time_zone('Eastern Time (US & Canada)').strftime(LawFirm::DATE_FORMAT) %></div>
                      </div-->
                      <div class="col-xs-12 col-md-6">
                        <div class="field-label">Types of matters your law firm has handled for us to date</div>		
                        <div class="field-data"><%= @form_submission.law_firm.type_of_matters_your_law_firm_handles_for_us.reject(&:blank?).join(", ") %></div>
                      </div>
                    </div>
                </div>
              </div>
            </div>
          </div>
        <div class="widget-footer">

          <div class="text-center">
            <div class="btn-group">
              <% if @form_submission.is_available_to_user %>

                <% if !first_step %>
                  <%= link_to "Prev".html_safe, previous_step_path, class: 'btn-type-primary submit-form' %>
                <% end %>
                <%= link_to "Save".html_safe, current_step_path, class: 'btn-type-primary submit-form save-btn' %>

                <% if(last_step) %>
                  <% if(current_user.role == 'master_user') %>
                    <a href="#" class="btn-type-primary finalize-submission" data-form_id=<%= params[:id] %>>
                      Submit
                    </a>
                  <% end %>
                <% elsif @form_submission.status == 'follow_up' %>
                  <% if(current_user.role == 'master_user') %>
                    <a href="#" class="btn-type-primary finalize-submission" data-form_id=<%= params[:id] %>>
                      Submit
                    </a>
                  <% end %>
                  <%= link_to "Next".html_safe, next_step_path, class: 'btn-type-primary submit-form next-btn' %>
                <% else %>
                  <%= link_to "Next".html_safe, next_step_path, class: 'btn-type-primary submit-form next-btn' %>
                <% end %>

              <% else %>

                <% if !first_step %>
                  <%= link_to " Prev".html_safe, previous_step_path, class: 'btn-type-primary' %>
                <% end %>

                <% if !last_step %>
                  <%= link_to "Next".html_safe, next_step_path, class: 'btn-type-primary' %>
                  <% end %>
              <% end %>
            </div>
          </div>
          
        </div>

      </div>
      <!-- end widget content -->

    </div>
    <!-- end widget div -->

  </div>
</div>
</div>