<%= simple_fields_for @form_submission do |f| %>
  <div class="container">
    
    <div class="col-md-10 col-md-offset-1 no-padding history-form-wrapper">
	  	<h4 class="m-b-20"><strong>List all significant, unauthorized attempts to gain access to bank data whether successful or thwarted. Also, Include Incidences where data was lost or was at risk of loss.</strong> <i class="fa fa-question-circle-o history-qtip"></i></h4>
	  	

    	<div class=" col-md-12 no-padding">
	      <%= f.simple_fields_for :history_submissions, f.object.render_history_submission_fields do |field| %>
	      	<%= render partial: "history_submission_fields", 
	      						 locals: {f: field}  %>
			  <% end %>
    	</div>
			<div class="clearfix"></div>
    	<hr class="seperator">
			<div class="link-to-add">
				<%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-primary"><i class="fa fa-plus-circle"></i> Add More</span>'.html_safe, f, :history_submissions %>
			</div>

			<p>&nbsp;</p>

    </div>

  </div>

<% end %>

