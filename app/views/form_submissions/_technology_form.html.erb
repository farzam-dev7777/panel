<%= simple_fields_for @form_submission do |f| %>
  <div class="col-md-10 col-md-offset-1 tech-form-wraper">
    
    <div class="col-md-12 no-padding">
	  	<h4 class="m-b-20 text-center">
        <strong>OPERATING SYSTEMS</strong>
      </h4>

	  	<p class="m-b-20 text-center">SERVER</p>

    	<div class=" col-md-12 no-padding" id="operating_system_servers">
        <% platform_category = 'operating_systems'; type = 'server' %>
	      <%= f.simple_fields_for :technology_values, build_fields(@form_submission, @form_submission.technology_values.operating_systems.server, platform_category, type) do |field| %>
	      	<%= render partial: "technology_value_fields", 
	      						 locals: {f: field, 
                              platform_category: platform_category, 
                              type: type}  %>
			  <% end %>
    	</div>
			<div class="clearfix"></div>
			<div class="link-to-add">
				<%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-default btn-sm"><i class="fa fa-plus-circle"></i> Server</span>'.html_safe, f, :technology_values, render_options: {locals: { platform_category: 'operating_systems', type: 'server' }} %>
			</div>

    	<div class="clearfix"></div>
    	<hr class="seperator">

	  	<p class="m-b-20 text-center">CLIENT</p>

