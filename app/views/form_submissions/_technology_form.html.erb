	  	<h4 class="m-b-20 text-center">OPERATING SYSTEMS</h4>

	  	<p class="m-b-20 text-center">SERVER</p>

    	<div class=" col-md-12 no-padding" id="operating_system_servers">
	      <%= f.simple_fields_for :technology_values, @form_submission.technology_values.operating_systems.server do |field| %>
	      	<%= render partial: "technology_value_fields", 
	      						 locals: {f: field, platform_category: 'operating_systems', type: 'server'}  %>
			  <% end %>
    	</div>
			<div class="clearfix"></div>
			<div class="link-to-add">
				<%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-primary btn-sm"><i class="fa fa-plus-circle"></i> Server</span>'.html_safe, f, :technology_values, render_options: {locals: { platform_category: 'operating_systems', type: 'server' }} %>
			</div>

