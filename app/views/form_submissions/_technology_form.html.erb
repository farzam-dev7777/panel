<style type="text/css">
  .bar {
    background: green;
    color: #fff;
    padding: 2px;
    display: none;
  }
  #progress{
    padding: 10px 0px;
  }
</style>
<div class="technology-uploader-container hidden">
  <div class="col-md-10 col-md-offset-1 tech-form-wraper ">
    <a href="#" class="pull-right show_technology_form">Enter Manually</a>
    <br/>
    <h4 class="m-b-20 text-center">
      <strong>Upload Inventory</strong>
    </h4>
    <br/>
    <div class="col-md-5">
      <div class="upload_inventory">
        <h1>Use SEAL's format</h1>
        <input type="file" class="fileupload-technology" data-upload-custom-csv="true" />
        <div id="progress">
          <div class="bar" style="width: 0%;"></div>
        </div>
        <p class="m-b-20"><a href="/upload-technology.csv">Download sample CSV</a></p>
      </div>
    </div>
    <div class="col-md-2 upload_inventory_or">OR</div>
    <div class="col-md-5">
      <div class="upload_inventory">
        <h1>Other software inventory list</h1>
        <input type="file" class="fileupload-technology" data-upload-custom-csv="false" />
        <div id="progress">
          <div class="bar" style="width: 0%;"></div>
        </div>
        <%- file = @form_submission.file_attachments.first %>
        <p><%= file.file.file.filename if file %></p>
      </div>
    </div>
  </div>
</div>

<div class="technology-form-container">

  <div class="col-md-10 col-md-offset-1 tech-form-wraper tech-form-wraper-help hidden">
    <ul>
      <li>- Please list all technologies that the bank data resides on or exposed to.</li>
      <li>- After Certification, Technology and History Sections will remain open for updating.</li>
      <li>- All files uploaded are encrypted in flight and after upload. The files cannot be downloaded or viewed after upload. You can, however, replace the file by deleting it and re-uploading a new file.</li>
    </ul>
    <br>
    <div class="col-md-12 text-center dont-show-wrapper">
      <label><input type="checkbox" name="dont-show"> Don't show this again</label> <br>
      <a class="btn btn-default btn-sm" href="javascript:void(0)">I Understand</a>
    </div>
  </div>

  <div class="clearfix"></div>

  <div class="col-md-10 col-md-offset-1 tech-form-wraper tech-form-wraper-csv-toggle text-center hidden">
    <label>Do you keep an updated inventory of end points (Applications)?</label>
    <p>&nbsp;</p>
    <a class="btn btn-sm btn-primary" href="javascript:void(0)">Yes</a>
    <a class="btn btn-sm btn-primary" href="javascript:void(0)">No</a>
  </div>

  <%= simple_fields_for @form_submission do |f| %>
    <div class="col-md-10 col-md-offset-1 tech-form-wraper form hidden">
      <a href="#" class="pull-right show_technology_uploader">Upload inventory of end points instead</a>
      <div class="col-md-12 no-padding">
  	  	<h4 class="m-b-20 text-center">
          <strong>OPERATING SYSTEMS</strong>
        </h4>

  	  	<p class="m-b-20 text-center">SERVER</p>

      	<div class=" col-md-12 no-padding" id="operating_system_servers">
          <% platform_category = 'operating_systems'; type = 'server' %>
  	      <%= f.simple_fields_for :technology_values, build_fields(@form_submission, @form_submission.technology_values.select{|tv| tv.platform_category == platform_category && tv.platform_type == type }, platform_category, type) do |field| %>
  	      	<%= render partial: "technology_value_fields", 
  	      						 locals: {f: field, 
                                platform_category: platform_category, 
                                type: type}  %>
  			  <% end %>
      	</div>
  			<div class="clearfix"></div>
  			<div class="link-to-add">
  				<%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-default btn-sm"><i class="fa fa-plus-circle"></i> Server</span>'.html_safe, f, :technology_values, render_options: {locals: { platform_category: 'operating_systems', type: 'server' }} %>
  			</div>

      	<div class="clearfix"></div>
      	<hr class="seperator">

  	  	<p class="m-b-20 text-center">CLIENT</p>

      	<div class=" col-md-12 no-padding">
          <% platform_category = 'operating_systems'; type = 'client' %>
          <%= f.simple_fields_for :technology_values, build_fields(@form_submission, @form_submission.technology_values.select{|tv| tv.platform_category == platform_category && tv.platform_type == type }, platform_category, type) do |field| %>
            <%= render partial: "technology_value_fields", 
                       locals: {f: field, platform_category: platform_category, type: type}  %>
          <% end %>
      	</div>
  			<div class="clearfix"></div>
  			<div class="link-to-add">
  				<%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-default btn-sm"><i class="fa fa-plus-circle"></i> Client</span>'.html_safe, f, :technology_values, render_options: {locals: { platform_category: 'operating_systems', type: 'client' }} %>
  			</div>

      </div>

      <p>&nbsp;</p><hr><p>&nbsp;</p>

      <div class="col-md-12 no-padding">
  	  	<h4 class="m-b-20 text-center">
          <strong>APPLICATIONS</strong>
        </h4>

        <p class="m-b-20 text-center">SERVER</p>

        <div class=" col-md-12 no-padding">
          <% platform_category = 'web_platforms'; type = 'intranet' %>
          <%= f.simple_fields_for :technology_values, build_fields(@form_submission, @form_submission.technology_values.select{|tv| tv.platform_category == platform_category && tv.platform_type == type }, platform_category, type) do |field| %>
            <%= render partial: "technology_value_fields", 
                       locals: {f: field, platform_category: platform_category, type: type}  %>
          <% end %>
        </div>
        <div class="clearfix"></div>
        <div class="link-to-add">
          <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-default btn-sm"><i class="fa fa-plus-circle"></i> Server</span>'.html_safe,f, :technology_values, render_options: {locals: { platform_category: 'web_platforms', type: 'intranet' }} %>
        </div>

      	<div class="clearfix"></div>
      	<hr class="seperator">
        <p class="m-b-20 text-center">CLIENT</p>

        <div class=" col-md-12 no-padding">
          <% platform_category = 'web_platforms'; type = 'internet' %>
          <%= f.simple_fields_for :technology_values, build_fields(@form_submission, @form_submission.technology_values.select{|tv| tv.platform_category == platform_category && tv.platform_type == type }, platform_category, type) do |field| %>
            <%= render partial: "technology_value_fields", 
                       locals: {f: field, platform_category: platform_category, type: type}  %>
          <% end %>
        </div>
        <div class="clearfix"></div>
        <div class="link-to-add">
          <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-default btn-sm"><i class="fa fa-plus-circle"></i> Client</span>'.html_safe, f, :technology_values, render_options: {locals: { platform_category: 'web_platforms', type: 'internet' }} %>
        </div>

      </div>

      <p>&nbsp;</p><hr><p>&nbsp;</p>

      <div class="col-md-12 no-padding">
  	  	<h4 class="m-b-20 text-center">
          <strong>INFOSEC TECHNOLOGIES</strong>
        </h4>
  	  	<p class="m-b-20 text-center">HARDWARE</p>

      	<div class=" col-md-12 no-padding">
  	      <% platform_category = 'infosec_technologies'; type = 'hardware' %>
          <%= f.simple_fields_for :technology_values, build_fields(@form_submission, @form_submission.technology_values.select{|tv| tv.platform_category == platform_category && tv.platform_type == type }, platform_category, type) do |field| %>
            <%= render partial: "technology_value_fields", 
                       locals: {f: field, platform_category: platform_category, type: type}  %>
          <% end %>
      	</div>
  			<div class="clearfix"></div>
  			<div class="link-to-add">
  				<%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-default btn-sm"><i class="fa fa-plus-circle"></i> Hardware</span>'.html_safe, f,  :technology_values, render_options: {locals: { platform_category: 'infosec_technologies', type: 'hardware' }} %>
  			</div>

      	<div class="clearfix"></div>
      	<hr class="seperator">

  	  	<p class="m-b-20 text-center">SOFTWARE & SERVICES</p>

      	<div class=" col-md-12 no-padding">
  	      <% platform_category = 'infosec_technologies'; type = 'software' %>
          <%= f.simple_fields_for :technology_values, build_fields(@form_submission, @form_submission.technology_values.select{|tv| tv.platform_category == platform_category && tv.platform_type == type }, platform_category, type) do |field| %>
            <%= render partial: "technology_value_fields", 
                       locals: {f: field, platform_category: platform_category, type: type}  %>
          <% end %>
      	</div>
  			<div class="clearfix"></div>
  			<div class="link-to-add">
  				<%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-default btn-sm"><i class="fa fa-plus-circle"></i> Software</span>'.html_safe, f,  :technology_values, render_options: {locals: { platform_category: 'infosec_technologies', type: 'software' }} %>
  			</div>

      </div>

      <p>&nbsp;</p><hr><p>&nbsp;</p>

      <div class="col-md-12 no-padding">
  	  	<h4 class="m-b-20 text-center">
          <strong>STORAGE & ARCHIVAL</strong>
        </h4>
  	  	<p class="m-b-20 text-center">HARDWARE</p>

      	<div class=" col-md-12 no-padding">
          <% platform_category = 'storage_archival'; type = 'hardware' %>
          <%= f.simple_fields_for :technology_values, build_fields(@form_submission, @form_submission.technology_values.select{|tv| tv.platform_category == platform_category && tv.platform_type == type }, platform_category, type) do |field| %>
            <%= render partial: "technology_value_fields", 
                       locals: {f: field, platform_category: platform_category, type: type}  %>
          <% end %>
      	</div>
  			<div class="clearfix"></div>
  			<div class="link-to-add">
  				<%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-default btn-sm"><i class="fa fa-plus-circle"></i> Hardware</span>'.html_safe, f,  :technology_values, render_options: {locals: { platform_category: 'storage_archival', type: 'hardware' }} %>
  			</div>

      	<div class="clearfix"></div>
      	<hr class="seperator">

  	  	<p class="m-b-20 text-center">SOFTWARE & SERVICES</p>

      	<div class=" col-md-12 no-padding">
  	      <% platform_category = 'storage_archival'; type = 'software' %>
          <%= f.simple_fields_for :technology_values, build_fields(@form_submission, @form_submission.technology_values.select{|tv| tv.platform_category == platform_category && tv.platform_type == type }, platform_category, type) do |field| %>
            <%= render partial: "technology_value_fields", 
                       locals: {f: field, platform_category: platform_category, type: type}  %>
          <% end %>
      	</div>
  			<div class="clearfix"></div>
  			<div class="link-to-add">
  				<%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-default btn-sm"><i class="fa fa-plus-circle"></i> Software</span>'.html_safe, f,  :technology_values, render_options: {locals: { platform_category: 'storage_archival', type: 'software' }} %>
  			</div>

      </div>

    </div>

  <% end %>

  <p>&nbsp;</p>
</div>