<div class="row history-field <%= follow_up_class_for_law_firm( f.object.id, 'HistorySubmission', params[:id]) %>">
	<div class="col-md-3 history-field"><%= f.input :incident_type, collection: ["Attempted Access", "Malicious Code", "Phishing", "Ransomware", "Social Engineering", "Unauthorized Access", "Virus", "Other – Provide Details"] %></div>
	<!-- <div class="col-md-4 history-field"><%= f.input :impact %></div> -->
<!-- 	<div class="col-md-2 history-field"><%= f.input :discovery_time %></div> -->
	<div class="col-md-4 history-field"><%= f.input :data_loss, collection: ["No", "Not that we know.", "Yes, but not client data", "Yes , some", "Significant"] %></div>
	<div class="col-md-4 history-field"><%= f.input :source, collection: ["Was done immediately", "Done", "Underway", "Planned", "Not done yet."], label: 'Remediation Status' %></div>
	<div class="col-md-1 text-center" style="line-height: 84px;">
		<%= link_to_remove_association "<i class='fa fa-minus-circle'></i>".html_safe, f, { wrapper_class: "history-field" }  %>
	</div>
	<div class="col-md-11"><%= f.input :incident_details, placeholder: 'Anonymous description only' %></div>

	<% if (follow_up_class_for_law_firm( f.object.id, 'HistorySubmission', params[:id]) == 'need-follow-up' ||follow_up_class_for_law_firm( f.object.id, 'HistorySubmission', params[:id]) == 'follow-up-success') %>
			<div class="col-md-1 text-right">
				<%= render partial: 'note', locals: { loggable: f.object, follow_ups: @follow_ups, 
																						 wrapper_class: note_class('history'),
																						 form_type: 'HistorySubmission', field: f.object} %>
      </div>
	<% end %>
</div>
<div class="clearfix"></div>