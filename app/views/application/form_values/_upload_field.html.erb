<style type="text/css">
  .bar {
    background: green;
    color: #fff;
    padding: 2px;
    display: none;
  }
  #progress{
    padding: 10px 0px;
  }
  .file-field{
    /*border: 3px dotted #ccc;*/
    /*padding: 10px;*/
  }
  .form-control[readonly] {
    border-bottom: 1px solid #ccc !important;
  }
  .file-upload-handler {
    position: relative;
    top: 3px;
  }
</style>

<div class="file-field">
  <label class="control-label"><%= v.object.try(:form_field).try(:label) %></label>
  <input class="fileupload hidden" type="file" name="files[]" data-url="/file_attachments/<%= v.object.id %>/<%= v.object.class.name %>" multiple data-form-field-id="<%= v.object.try(:form_field).try(:id) %>" data-file-count="<%= v.object.file_attachments.count %>">
  <input type="text" class="form-control file-upload-handler" placeholder="Click here to upload file(s)" readonly="readonly">

  <div id="progress">
    <div class="bar" style="width: 0%;"></div>
  </div>

  <%= render(partial: 'file_attachment', locals: { file_attachments: v.object.file_attachments }) %>
</div>
