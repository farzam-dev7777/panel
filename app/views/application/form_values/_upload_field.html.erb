<style type="text/css">
  .bar {
    background: green;
    color: #fff;
    padding: 2px;
    display: none;
  }
  #progress{
    padding: 10px 0px;
  }
  .file-field{
    border: 3px dotted #ccc;
    padding: 10px;
  }
</style>

<div class="file-field">
  <input class="fileupload" type="file" name="files[]" data-url="/file_attachments/<%= v.object.id %>/<%= v.object.class.name %>" multiple data-form-field-id="<%= v.object.try(:form_field).try(:id) %>" data-file-count="<%= v.object.file_attachments.count %>">

  <div id="progress">
    <div class="bar" style="width: 0%;"></div>
  </div>

  <%= render(partial: 'file_attachment', locals: { file_attachments: v.object.file_attachments }) %>
</div>
