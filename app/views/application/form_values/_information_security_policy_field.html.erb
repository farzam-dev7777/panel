<div>
  <label><%= field.try(:label) %></label>
  <div class="col-md-3">
    <label>Policy</label>
  </div>
  <div class="col-md-3">
    <label>Last Reviewed</label>
  </div>
  <div class="col-md-3">
    <label>Last Updated</label>
  </div>
  <div class="col-md-2">
    <label>Freq. of Review</label>
  </div>
  <%= v.simple_fields_for :information_security_policies do |information_security_policy_field| %>
    <%= render partial: "information_security_policy_fields", 
               locals: {f: information_security_policy_field} unless information_security_policy_field.object.nil? %>
  <% end %>
  <div class="add-information-security-policy text-right">
    <% if current_user %>
      <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-primary btn-sm"><i class="fa fa-plus-circle"></i> Information Security Policy</span>'.html_safe, v, :information_security_policies %>
     <% end %>
  </div>

  <hr>

</div>

