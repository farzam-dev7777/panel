<div>
	<label><%= field.try(:label) %></label>

  <%= v.input :value, as: :hidden, input_html: { class: 'repeater-field-value' } %>

  <div class="clearfix"></div>
  <div class="col-md-2 no-padding gfe-field">
    <label>Provider</label>
  </div>
  <div class="col-md-2 no-padding gfe-field">
    <label>Service Name</label>
  </div>
  <div class="col-md-2 no-padding gfe-field">
    <label>Type of Cloud</label>
  </div>
  <div class="col-md-1 no-padding gfe-field">
    <label>Data</label>
  </div>
  <div class="col-md-1 no-padding gfe-field">
    <label>Encrypted<br>(In Flight)</label>
  </div>
  <div class="col-md-1 no-padding gfe-field">
    <label>Encrypted<br>(At rest)</label>
  </div>
  <div class="col-md-2 no-padding gfe-field">
    <label>Location<br>(Country)</label>
  </div>
  <div class="clearfix"></div>

  <%= v.simple_fields_for :cloud_providers, v.object.render_cloud_provider_fields do |cloud_provider| %>
    <%= render partial: "cloud_provider_fields", 
               locals: {f: cloud_provider} unless cloud_provider.object.nil? %>
  <% end %>
  <div class="add-cloud-provider text-right">
  	<% if current_user %>
	    <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-default btn-sm"><i class="fa fa-plus-circle"></i> Cloud Provider</span>'.html_safe, v, :cloud_providers %>
	   <% end %>
  </div>

</div>