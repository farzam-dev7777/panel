<div>
  <% if(!v.object.try(:form_field).try(:help_description).blank?) %>
    <i class="fa fa-question-circle-o help-text" data-help="<%= v.object.try(:form_field).try(:help_description).try(:html_safe) %>"></i>
  <% end %> 
  <label><%= field.try(:label).try(:html_safe) %></label>
  <%= v.input :value, as: :hidden, input_html: { class: 'repeater-field-value' } %>

  <div class="clearfix"></div>
  <div class="col-md-4 no-padding gfe-field">
    <label>Vendor Name</label>
  </div>
  <div class="col-md-4 no-padding gfe-field">
    <label>Area</label>
  </div>
  <div class="col-md-3 no-padding gfe-field">
    <label>Confidentiality Agreement</label>
  </div>
  <div class="clearfix"></div>

  <%= v.simple_fields_for :third_party_vendors, v.object.render_third_party_vendor_fields do |third_party_vendor_field| %>
    <%= render partial: "third_party_vendor_fields", 
               locals: {f: third_party_vendor_field} %>
  <% end %>
  <div class="add-third-party-vendor text-right">
  	<% if current_user %>
	    <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-default btn-sm"><i class="fa fa-plus-circle"></i> Vendor</span>'.html_safe, v, :third_party_vendors %>
	   <% end %>
  </div>

</div>