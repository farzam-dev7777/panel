<div>
	<label><%= field.try(:label) %></label>
  <div class="col-md-4">
    <label>Vendor Name</label>
  </div>
  <div class="col-md-4">
    <label>Area</label>
  </div>
  <div class="col-md-3">
    <label>Confidentiality Agreement</label>
  </div>
  <%= v.simple_fields_for :third_party_vendors do |third_party_vendor_field| %>
    <%= render partial: "third_party_vendor_fields", 
               locals: {f: third_party_vendor_field} unless third_party_vendor_field.object.nil? %>
  <% end %>
  <div class="add-third-party-vendor text-right">
  	<% if current_user %>
	    <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-primary btn-sm"><i class="fa fa-plus-circle"></i> Vendor</span>'.html_safe, v, :third_party_vendors %>
	   <% end %>
  </div>

  <hr>

</div>