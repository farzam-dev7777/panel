<% 
  form_class = label_class = ''
  if(v.object.form_field.type == 'TextField' ||
     v.object.form_field.type == 'EmailField')
    form_class = 'md-form'
    label_class = 'form-control no-border'
  end
%>

<div class="form-group <%= form_class %>">
  <label class="<%= label_class %> control-label parent-f-sized-label"><%= field.label %></label>
  <%= v.input :value, {
    label: false,
    collection: field.collection.sort,
    input_html: { autocomplete: 'off' },
    required: field.required,
    wrapper: false,
    # wrapper_html: field.wrapper_html,
    blank: true,
    as: field.as
  }, &field.input_block(v) %>
</div>

