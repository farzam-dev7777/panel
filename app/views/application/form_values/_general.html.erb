<% 
  form_class = label_class = ''
  if(v.object.form_field.type == 'TextField' ||
     v.object.form_field.type == 'EmailField')
    form_class = 'float-form'
    label_class = 'form-control float-field no-border'
  end
%>

<% 
  form_class = label_class = ''
  if(v.object.form_field.type == 'Heading')
    form_class = 'float-form'
    label_class = 'no-border form-heading'
  end
%>

<div class="form-group <%= form_class %>">
  <% if(!v.object.try(:form_field).try(:help_description).blank?) %>
    <i class="fa fa-question-circle-o help-text" data-help="<%= v.object.try(:form_field).try(:help_description).try(:html_safe) %>"></i>
  <% end %>
  <label class="<%= label_class %> control-label parent-f-sized-label"><%= field.try(:label).try(:html_safe) %></label>
  <% if v.object && v.object.form_field && v.object.form_field.type == 'Heading' %>
  <% else %>
    <%= v.input :value, {
      label: false,
      collection: field.collection.sort,
      input_html: { autocomplete: 'off', value: v.object.try(:value), placeholder: v.object.form_field.type === "TextField" ? "Type here" : nil },
      required: field.required,
      wrapper: false,
      # wrapper_html: field.wrapper_html,
      blank: true,
      as: field.as,
      disabled: @readonly ? 'disabled' : ''
    }, &field.input_block(v) %>
  <% end %>
</div>

