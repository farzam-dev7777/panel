<div>
  <label><%= field.try(:label) %></label>
  <% if(!v.object.try(:form_field).try(:help_description).blank?) %>
    <i class="fa fa-question-circle-o help-text" data-help="<%= v.object.try(:form_field).try(:help_description) %>"></i>
  <% end %> 
  <%= v.input :value, as: :hidden, input_html: { class: 'repeater-field-value' } %>
  
  <div class="clearfix"></div>
  <div class="col-md-4 no-padding gfe-field">
    <label>Provider</label>
  </div>
  <div class="col-md-4 gfe-field">
    <label>Amount Covered</label>
  </div>
  <div class="col-md-3 gfe-field">
    <label>Date of Expiry</label>
  </div>
  <!-- <div class="col-md-3 gfe-field">
    <label>Standing</label>
  </div> -->
  <div class="clearfix"></div>

  <%= v.simple_fields_for :cyber_security_insurances, v.object.render_cyber_security_insurance_fields do |cyber_security_insurance_field| %>
    <%= render partial: "cyber_security_insurance_fields", 
               locals: {f: cyber_security_insurance_field} %>
  <% end %>
  <div class="add-information-security-policy text-right">
    <% if current_user && !current_user.is_an_admin? %>
      <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-default btn-sm"><i class="fa fa-plus-circle"></i> Policy</span>'.html_safe, v, :cyber_security_insurances %>
     <% end %>
  </div>

</div>

