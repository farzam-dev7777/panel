<div>
	<label><%= field.try(:label) %></label>
  <%= v.simple_fields_for :vendors do |vendor_field| %>
    <%= render partial: "vendor_fields", 
               locals: {f: vendor_field} unless vendor_field.object.nil? %>
  <% end %>
  <div class="add-vendor text-right">
  	<% if current_user %>
	    <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-primary btn-sm"><i class="fa fa-plus-circle"></i> Vendor</span>'.html_safe, v, :vendors %>
	   <% end %>
  </div>

  <hr>

</div>

