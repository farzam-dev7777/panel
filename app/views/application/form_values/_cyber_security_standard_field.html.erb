<div>
  <% if(!v.object.try(:form_field).try(:help_description).blank?) %>
    <i class="fa fa-question-circle-o help-text" data-help="<%= v.object.try(:form_field).try(:help_description).try(:html_safe) %>"></i>
  <% end %> 
  <label><%= field.try(:label).try(:html_safe) %></label>
  <%= v.input :value, as: :hidden, input_html: { class: 'repeater-field-value' } %>

  <div class="clearfix"></div>
  <div class="col-md-5 no-padding gfe-field">
    <label>Standard</label>
  </div>
  <div class="col-md-5 no-padding gfe-field">
    <label>Compliance Status</label>
  </div>
  <div class="clearfix"></div>
  
  <%= v.simple_fields_for :cyber_security_standards, v.object.render_cyber_security_standard_fields do |field| %>
    <%= render partial: "cyber_security_standard_fields", 
               locals: {f: field} unless field.object.nil? %>
  <% end %>
  <div class="add-css">
  	<% if current_user && !current_user.is_an_admin? %>
	    <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-default btn-sm"><i class="fa fa-plus-circle"></i> InfoSec Standard</span>'.html_safe, v, :cyber_security_standards %>
    <% end %>
  </div>
</div>

