<div>
	<label><%= field.try(:label) %></label>

  <%= v.input :value, as: :hidden, input_html: { class: 'repeater-field-value' } %>

  <div class="clearfix"></div>
  <div class="col-md-3 no-padding gfe-field">
    <label>Rank</label>
  </div>
  <div class="col-md-3 no-padding gfe-field">
    <label>Standard</label>
  </div>
  <div class="col-md-3 no-padding gfe-field">
    <label>Date of Cert.</label>
  </div>
  <div class="col-md-2 no-padding gfe-field">
    <label>Expiry</label>
  </div>
  <div class="clearfix"></div>
  
  <%= v.simple_fields_for :cyber_security_standards do |field| %>
    <%= render partial: "cyber_security_standard_fields", 
               locals: {f: field} unless field.object.nil? %>
  <% end %>
  <div class="add-css text-right">
  	<% if current_user %>
	    <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-default btn-sm"><i class="fa fa-plus-circle"></i> Cyber Security Standard</span>'.html_safe, v, :cyber_security_standards %>
    <% end %>
  </div>
</div>

