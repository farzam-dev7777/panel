
<p><strong><%= message.message %></strong></p>
<span class="pull-right">
	<em><%= "#{message.created_at} ago" %> 
	by <%= "#{message.sender}" unless message.sender.blank? %></em>
</span>	
<div class="clearfix"></div>
<%- if message.sender == current_user.email %>
	<div class="delete-note" data-id = "<%= message.id %>">
		<i class="fa fa-trash"></i>
	</div>
<% end %>
<div class="clearfix"></div>
<hr class="note-seperator" />