<div class="logic-wrapper-<%= f.object.id %>">
	<div class="col-md-2">
	  <%= f.input :form_id, as: :hidden, input_html: { value: @form.id } %>
	  <%= f.input :change_field_id, as: :hidden, input_html: { value: form_field.id } %>
	  <label>Action</label>
	  <div class="clearfix"></div>
	  <%= f.input :perform_action, collection: Logic::PERFORM_ACTION.map{|action| [action.try(:titleize), action]}, label: false, blank: false %>
	</div>
	<div class="col-md-2">
		<label>Logic</label>
		<div class="clearfix"></div>
	  <%= f.input :logic_to_be_applied, collection: Logic::LOGIC_TO_BE_APPLIED.map{|logic| [logic.try(:titleize), logic]}, label: false, blank: false %>
	</div>
	<div class="col-md-4">
		<label>Show When</label>
		<div class="clearfix"></div>
	  <%= f.input :listen_field_id, collection: @form.all_form_fields.map{|form_field| ["#{form_field.label}(#{form_field.type})", form_field.id]}, label: false %>
	</div>
	<div class="col-md-3">
		<label>Value</label>
		<div class="clearfix"></div>
	  <%= f.input :values, label: false %>
	</div>
	<div class="col-md-1 text-right" style="line-height: 84px; padding-right: 40px;">
		<%= link_to_remove_association "<i class='fa fa-minus-circle'></i>".html_safe, f, { wrapper_class: "logic-wrapper-#{f.object.id}" }  %>
	</div>
</div>