<div class="row vendor vendor-field-<%= f.object.try(:id) %>">
	<div class="col-md-4">
		<%= f.input :name, label: false %>
	</div>
	<div class="col-md-4">
		<%= f.input :vendor_type, label: false %>
	</div>
	<div class="col-md-3">
		<%= f.input :application, label: false %>
	</div>

	<div class="col-md-1" style="padding-top: 15px;">
		<% if f.object && current_user %>
			<%= link_to_remove_association "<i class='fa fa-minus-circle'></i>".html_safe, f, { wrapper_class: "vendor-field-#{f.object.try(:id)}" }  %>
		<% end %>
	</div>
</div>