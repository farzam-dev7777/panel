<div class="well dropdown-options">
  <div class="row">
    <div class="col-md-6">
      <%= f.input :key %>
    </div>
    <div class="col-md-6">
      <%= f.input :value %>
    </div>
    <div class="col-md-12">
      <div class="score-rating"></div>
      <%= f.input :score %>
    </div>
  </div>
  <%= link_to_remove_association "Remove Option", f, { wrapper_class: 'dropdown-options' } %>
</div>
