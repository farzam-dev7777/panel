<div class="well">
  <%= f.input :type, as: :select, collection: FormField.descendants %>
  <%= f.input :label %>
  <%= render "application/form_fields/#{f.object.type.try(:underscore)}", f: f if f.object.type %>
  <%= f.input :parent_id, collection: @form.form_fields.map{|form_field| ["#{form_field.label}(#{form_field.type})", form_field.id]} %>
  <%= link_to_remove_association "Remove Field", f, { wrapper_class: 'form-field' } %>
</div>