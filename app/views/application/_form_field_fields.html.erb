<div class="well">
  <%= f.input :type, as: :select, collection: FormField.descendants %>
  <%= f.input :label %>
  <%= render "application/form_fields/#{f.object.type.try(:underscore)}", f: f if f.object.type %>
  <%= f.input :required %>
  <div class="well">
    <%= f.input :custom_logic, input_html: { class: 'custom-logic-checkbox' } %>
    <div class="row">
      <div class="col-md-12 logics">
        <%= f.simple_fields_for :logics do |field| %>
          <%= render partial: "logic_fields", locals: {f: field}  %>
        <% end %>
      </div>
      <div class="col-md-12">
        <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-primary btn-sm"><i class="fa fa-plus-circle"></i> Custom logic</span>'.html_safe, f, :logics %>
      </div>
    </div>
  </div>
  <%= f.input :parent_id, collection: @form.form_fields.map{|form_field| ["#{form_field.label}(#{form_field.type})", form_field.id]} %>
  <%= link_to_remove_association "Remove Field", f, { wrapper_class: 'form-field', class: "btn btn-danger" } %>
</div>