<% step = 0 %>

<% if current_step == :policy %>
	<div class="col-md-10 col-md-offset-1 no-padding" style="margin-bottom: 40px">
		<div id="accordion">
			<div>
				<h4>Before you proceed</h4>
				<div class="row padding-10">
					<br/>Thanks for participating in the SEAL Assessment program.<br><strong>A few tips before you proceed.</strong><br/>
					<ul class="q-instructions">
						<li>- As you fill the SEAL Assessment form below. You’d need the following.</li>
						<ul>
							<li>- Policy Documents</li>
							<li>- Evidence of audit and recent changes to policies</li>
							<li>- Inventory of Software and Hardware.</li>
						</ul>
						<li>- Please make sure that any documents uploaded have no law firm identifiers in it (such as names, contact info. Etc)</li>
						<li>- All questions are mandatory.</li>
						<li>- Please review all your answers before submitted as you cannot change them after submitting.</li>
					</ul>
					<strong>Technical Tips</strong>
					<ul class="q-instructions">
						<li>- Your session times out after 30 minutes of inactivity. Please use the save button at the bottom of each page to save before you logout.</li>
						<li>- If a question is not clear or you need clarification, please use the feedback form at the bottom of the page.</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
<% end %>

<div class="col-md-10 col-md-offset-1 form-enclosure">
	<div class="col-md-12">
		<%= render "form_values_fields", f: f, form_values: f.object.build_values(nil, current_step), step: step, group_form: false, sub_fields: false %>
	</div>
</div>