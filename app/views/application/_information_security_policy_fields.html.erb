<div class="row information-security-policy information-security-policy-field-<%= f.object.try(:id) %>">
	<div class="col-md-2 gfe-field">
		<%= f.input :policy, label: false, collection: ["Access Control Policies / Procedures","Segregation of Duties Policies / Procedures","Remote Access Policies / Procedures","Asset Management Policies / Procedures","Acceptable Use Policy","Antivirus / Malware Policies / Procedures","Confidentiality Agreements / Non-Disclosure Agreements","Change Management / Change Control Policies / Procedures","Audit / Compliance Policies / Procedures","Data Backup Policies / Procedures","Data Destruction / Disposal Policies / Procedures","Business Continuity Management / Disaster Recovery Policies / Procedures","Application Development Policies / Procedures","Secure Coding Policies / Procedures","Email Use and Security Policies / Procedures","Encryption Policies / Procedures","Human Resource Screening Policies / Procedures","Human Resource Termination Policies / Procedures","Security Awareness Training Policies / Procedures","Incident Response Policies / Procedures","Information Security Policies / Procedures","Mobile Media / Devices Policies / Procedures","Network Security Management Policies / Procedures","IT Operations Policies / Procedures","Patch Management Policies/ Procedures","Privacy Notices","Physical Security Policies / Procedures","Internal Privacy Policies / Procedures","Risk Management / Risk Assessment Program Policies / Procedures","Data Retention Policies / Procedures","Third Party Management Policies / Procedures","Vulnerability Management Policies / Procedures"] %>
	</div>
	<div class="col-md-2 gfe-field">
		<%= f.input :last_reviewed, as: :string, input_html: { class: 'datepicker' }, label: false %>
	</div>
	<div class="col-md-2 gfe-field">
		<%= f.input :last_updated, as: :string, input_html: { class: 'datepicker' }, label: false %>
	</div>
	<div class="col-md-2 gfe-field">
		<%= f.input :freq_of_review, label: false %>
	</div>
	<div class="col-md-1 gfe-field">
		
	</div>


	<div class="col-md-1" style="padding-top: 15px;">
		<% if f.object && current_user %>
			<%= link_to_remove_association "<i class='fa fa-minus-circle fa-2x'></i>".html_safe, f, { wrapper_class: "information-security-policy-field-#{f.object.try(:id)}" }  %>
		<% end %>
	</div>
</div>