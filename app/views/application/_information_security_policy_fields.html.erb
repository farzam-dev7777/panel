<div class="row information-security-policy information-security-policy-field-<%= f.object.try(:id) %>">
	<div class="col-md-3">
		<%= f.input :policy %>
	</div>
	<div class="col-md-3">
		<%= f.input :last_reviewed, as: :string, input_html: { class: 'datepicker' } %>
	</div>
	<div class="col-md-3">
		<%= f.input :last_updated, as: :string, input_html: { class: 'datepicker' } %>
	</div>
	<div class="col-md-2">
		<%= f.input :freq_of_review %>
	</div>

	<div class="col-md-1" style="line-height: 84px; padding-right: 40px;">
		<% if f.object && current_user %>
			<%= link_to_remove_association "<i class='fa fa-minus-circle fa-2x'></i>".html_safe, f, { wrapper_class: "information-security-policy-field-#{f.object.try(:id)}" }  %>
		<% end %>
	</div>
</div>