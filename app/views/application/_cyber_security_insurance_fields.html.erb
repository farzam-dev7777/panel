<div class="cyber-security-insurance cyber-security-insurance-field-<%= f.object.try(:id) %>">
	<div class="col-md-4 gfe-field no-padding-left">
		<%= f.input :company, label: false, collection: ["ISO 27000/27001", "SSAE 16", "SAS 70 Report", "SOC 2", "COBIT"] %>
	</div>
	<div class="col-md-4 gfe-field">
		<%= f.input :coverage, as: :string, label: false %>
	</div>
	<div class="col-md-3 gfe-field">
		<%= f.input :date_of_expiry, as: :string, input_html: { class: 'datepicker', value: DateField.stringify_date(f.object.date_of_expiry) }, label: false %>
	</div>
	<!-- <div class="col-md-3 gfe-field">
		<%= f.input :standing, as: :string, label: false %>
	</div> -->


	<div class="col-md-1 text-right" style="font-size: 16px;">
		<% if f.object && current_user %>
			<%= link_to_remove_association "<i class='fa fa-minus-circle'></i>".html_safe, f, { wrapper_class: "cyber-security-insurance-field-#{f.object.try(:id)}" }  %>
		<% end %>
	</div>
	<div class="clearfix"></div>
</div>