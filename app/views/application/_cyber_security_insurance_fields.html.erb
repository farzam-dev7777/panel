<div class="cyber-security-insurance cyber-security-insurance-field-<%= f.object.try(:id) %>">
	<div class="col-md-2 gfe-field no-padding-left">
		<%= f.input :company, label: false, collection: ["Travelers", "Intact", "IIC", "Chubb", "Marsh", "IBC"] %>
	</div>
	<div class="col-md-3 gfe-field no-padding-left">
		<%= f.input :coverage, as: :string, label: false %>
	</div>
	<div class="col-md-3 gfe-field no-padding-left">
		<%= f.input :coverage_amount, as: :string, label: false %>
	</div>
	<div class="col-md-3 gfe-field no-padding-left">
		<%= render '/application/form_values/upload_field', v: f, f: f, field: f.object.form_value.form_field %>
	</div>


	<div class="col-md-1 text-right" style="font-size: 16px;">
		<% if f.object && current_user %>
			<%= link_to_remove_association "<i class='fa fa-minus-circle'></i>".html_safe, f, { wrapper_class: "cyber-security-insurance-field-#{f.object.try(:id)}" }  %>
		<% end %>
	</div>
</div>
<div class="clearfix"></div>