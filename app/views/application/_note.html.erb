<% follow_up = follow_ups.select{ |follow_up| follow_up.loggable_id == loggable.id }.first %>
<div class="tip-wrapper">
	<div class="col text-right <%= wrapper_class %>">
		<% # if(current_user && admin_panel?) %>
			<% # render partial: 'check_mark', locals: {loggable: loggable, form_type: form_type} %>
		<% # end %>
		<% if ((follow_up_needed?(params[:id], loggable.id, form_type) || (current_user && admin_panel?))) %>
			<a class=" btn-xs follow-up pull-right <%= follow_up ? 'has-follow-up' : '' %>"><i class="fa fa-envelope"></i></a>
		<% end %>
	</div>
	<div class="col-md-12 note-box">
		<div class="note-controls">
			<div class="note">
				<% if follow_up %>
					<% follow_up.messages.reverse.each do |message| %>
						<%= render partial: 'follow_up_note', locals: {message: message} %>
					<% end %>
				<% end %>
			</div>
			<div class="col-md-12 no-padding">
				<label>Add Note:</label>
				<textarea name="message" class="form-control note"></textarea>
			</div>
			<div class="col-md-12 text-right no-padding">
		    <input class="btn btn-default <% if current_user.role == 'master_user' %> add-note <% else %> add-note-admin <% end %>" type="submit" value="Add Note" data-form_submission_id=<%= params[:id] %> data-loggable_id="<%= loggable.id %>" data-loggable_type="<%= form_type %>" data-field_wrapper_id="<%= field.id %>">
		  </div>
	  </div>

		<% if current_user && (current_user.is_an_admin?) && follow_up && follow_up_needed?(params[:id], loggable.id, form_type) %>

	    <input class="btn btn-default resolve-btn" 
	    			 type="submit" 
	    			 value="Resolved" 
	    			 data-follow_up_id=<%= follow_up.id %> 
	    			 <%= follow_up.status == 'resolved' ? 'disabled' : '' %>>
		<% end %>
	</div>
</div>