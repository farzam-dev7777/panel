<div class="bank-information bank-information-field-<%= f.object.try(:id) %>">
	<div class="col-md-3 no-padding-left">
		<%= f.input :name, label: false %>
	</div>

	<div class="col-md-5 no-padding-left">
		<%= f.input :purpose, label: false %>
	</div>

	<div class="col-md-3 no-padding-left">
		<%= f.input :level_of_access, label: false %>
	</div>

	<div class="col-md-1 text-right" style="font-size: 16px;">
		<% if f.object && !current_user.is_an_admin? %>
			<%= link_to_remove_association "<i class='fa fa-minus-circle'></i>".html_safe, f, { wrapper_class: "bank-information-field-#{f.object.try(:id)}" }  %>
		<% end %>
	</div>
	
  <div class="clearfix"></div>
</div>