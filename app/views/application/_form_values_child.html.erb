<div class="col-md-<%= step %>"></div>
<div class="col-md-<%= 12 - step %>">
  <%= f.simple_fields_for :form_values, form_values do |v| %>
    <% field = v.object.form_field %>
    <% if field.group_form_id %>
      <%= v.input :form_field_id, as: :hidden, value: field.id %>
      <% form_values = field.group_form.build_values %>
      <%= render "form_values_child", f: f, form_values: field.group_form.build_values, step: step %>
    <% else %>
      <%= v.input :form_field_id, as: :hidden, value: field.id %>
      <% begin %>
        <%= render "/application/form_values/#{field.type.underscore}", v: v, f: f, field: field %>
      <% rescue Exception => e %>
        <%= render "/application/form_values/general", v: v, f: f, field: field %>
      <% end %>
      <%= render "form_values_child", f: f, form_values: v.object.build_nested_form_values, step: step + 1 %>
    <% end %>
  <% end %>
</div>
