<div class="row third-party-vendor third-party-vendor-field-<%= f.object.try(:id) %>">
	<div class="col-md-4">
		<%= f.input :vendor_name %>
	</div>
	<div class="col-md-4">
		<%= f.input :area %>
	</div>
	<div class="col-md-3">
		<%= f.input :confidentiality_agreement, collection: ['Yes', 'No'], blank: false  %>
	</div>

	<div class="col-md-1" style="line-height: 84px; padding-right: 40px;">
		<% if f.object && current_user %>
			<%= link_to_remove_association "<i class='fa fa-minus-circle fa-2x'></i>".html_safe, f, { wrapper_class: "third-party-vendor-field-#{f.object.try(:id)}" }  %>
		<% end %>
	</div>
</div>