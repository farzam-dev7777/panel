<div class="third-party-vendor third-party-vendor-field-<%= f.object.try(:id) %>">
	<div class="col-md-4 no-padding-left">
		<%= f.input :vendor_name, label: false %>
	</div>
	<div class="col-md-4 no-padding-left">
		<%= f.input :area, label: false %>
	</div>
	<div class="col-md-3 no-padding-left">
		<%= f.input :confidentiality_agreement, collection: ['Yes', 'No'], blank: false , label: false %>
	</div>

	<div class="col-md-1 text-right" style="font-size: 16px;">
		<% if f.object && current_user %>
			<%= link_to_remove_association "<i class='fa fa-minus-circle'></i>".html_safe, f, { wrapper_class: "third-party-vendor-field-#{f.object.try(:id)}" }  %>
		<% end %>
	</div>
</div>