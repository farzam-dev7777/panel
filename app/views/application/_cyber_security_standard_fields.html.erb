<div class="cyber-security cyber-security-field-<%= f.object.try(:id) %>">
	<div class="col-md-5 no-padding-left">
		<%= f.input :standard, label: false, collection: ["COBIT", "ISO IEC 27001:2005", "ISO IEC 27001:2013", "NIST CYBER SECURITY FRAMEWORK", "PCI DSS", "NA"] %>
	</div>
<!-- 	<div class="col-md-3 no-padding-left">
		<%= f.input :date_of_certification, as: :string, input_html: { class: 'restrict-till-day', value: DateField.stringify_date(f.object.date_of_certification) }, label: false %>
	</div>
	<div class="col-md-2 no-padding-left">
		<%= f.input :renewal, as: :string, input_html: { class: 'datepicker', value: DateField.stringify_date(f.object.renewal) }, label: false %>
	</div> -->
	<div class="col-md-5 no-padding-left">
		<%= f.input :status, label: false, collection: ["Certified", "Follow but not Certified", "Have an Active plan to obtain certification", "Follow Standard but not certified", "Partially follow.", "NA"] %>
	</div>

	<div class="col-md-1 text-right" style="padding-top: 15px;">
		<% if f.object && current_user && !current_user.is_an_admin? %>
			<%= link_to_remove_association "<i class='fa fa-minus-circle'></i>".html_safe, f, { wrapper_class: "cyber-security-field-#{f.object.try(:id)}" }  %>
		<% end %>
	</div>
	<div class="clearfix"></div>
</div>