<%- file_attachments.each do |file_attachment| %>
  <p id="delete_file-<%= file_attachment.id %>">
    <%- if current_admin_user %>
      <span><%= decrypt_file_attachment_path(file_attachment) %> </span>
    <% else %>
      <span><%= file_attachment.try(:file).try(:file).try(:filename) %> </span>
    <% end %>
    <%= link_to(file_attachment_path(file_attachment), class: "delete_file") do %>
      <i class="fa fa-trash"></i>
    <% end %>
  </p>
<% end %>