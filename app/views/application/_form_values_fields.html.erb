<div class="row">
  <div class="<%= get_form_value_class(sub_fields, group_form) %>">
    <%= f.simple_fields_for :form_values, form_values do |v| %>
      <% field = v.object.form_field %>
      <div class="<%= field.group_form_id ? follow_up_class(params[:id], v.object.id, 'FormValue') : '' %> field-wrapper-<%= field.id %>">        
        <div class="<%= get_form_value_field_wrapper_class(sub_fields, group_form, form_values, v.index) %>" data-show-when-field-id="<%= show_when_field_id(v.object) %>" data-show-when-value="<%= show_when_value(v.object) %>" data-custom-logic="<%= custom_logic(v.object) %>">
          <div class="<%= get_form_value_field_class(sub_fields, group_form, form_values) %>">
            <%- if !group_form %>
              <div class="note-wrapper">
                <% follow_up = @follow_ups.select{ |follow_up| follow_up.loggable_id == v.object.id }.first %>
                <% if follow_up || current_user %>
                  <%= render partial: 'note', locals: { loggable: v.object, follow_ups: @follow_ups, 
                                                        wrapper_class: note_class('policy'),
                                                        form_type: 'FormValue', field: field} %>
                <% end %>
              </div>
            <% end %>
            <%= v.input :form_field_id, as: :hidden, value: field.id %>
            <%= v.input :form_field_label, as: :hidden, value: field.id %>
            <%= v.input :submittable_id, as: :hidden %>
            <%= v.input :submittable_type, as: :hidden %>
            <% if field.group_form_id %>
              <label>
                <strong><%= field.group_form.try(:name) %></strong>
                <% if !v.object.try(:form_field).try(:help_description).blank? %>
                  <i class="fa fa-question-circle-o help-text" data-help="<%= v.object.try(:form_field).try(:help_description) %>"></i>
                <% end %>
              </label>
              <%= render "form_values_fields", f: f, form_values: @form_submission.build_values(field.group_form.form_fields, current_step), step: step, group_form: true, sub_fields: false %>
            <% else %>
              <div class="wrapper <%= !group_form ? follow_up_class(params[:id], v.object.id, 'FormValue') : '' %> field-wrapper-<%= field.id %>">
                <% begin %>
                  <%= render "/application/form_values/#{field.type.underscore}", v: v, f: f, field: field %>
                <% rescue ActionView::MissingTemplate => e %>
                  <%= render "/application/form_values/general", v: v, f: f, field: field %>
                <% end %>
              </div>
              <%= render "form_values_fields", f: f, form_values: v.object.build_nested_form_values(current_step), step: step + 1, group_form: false, sub_fields: true  %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

</div>
