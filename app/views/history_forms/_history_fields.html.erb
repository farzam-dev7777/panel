<div class="col-md-2"><%= field.input :incident_type %></div>
<div class="col-md-2"><%= field.input :impact %></div>
<div class="col-md-2"><%= field.input :discovery_time %></div>
<div class="col-md-2"><%= field.input :source %></div>
<div class="col-md-2"><%= field.input :data_loss, collection: ['yes', 'no'] %></div>
<div class="col-md-12"><%= field.input :incident_details %></div>
