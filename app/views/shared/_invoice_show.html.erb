<% if @matter_intake.invoices.count > 0 %>
  <div class="col-md-12 col-xs-12">
    <div class="formHeader">
      <div class="headerTitle">Invoices</div>
    </div>
    <% @matter_intake.invoices.each do |invoice| %>
      <div class="formSection row">
        <div class="col-xs-12 col-md-4">
          <div class="field-label">Amount</div>
          <div class="field-data"><%= invoice.amount.format %></div>
        </div>
        <div class="col-xs-12 col-md-3">
          <div class="field-label">Invoice date</div>
          <div class="field-data"><%= (invoice.date||invoice.created_at).strftime('%d %b %Y') %></div>
        </div>
        <div class="col-xs-12 col-md-1" style="padding-left:1px;padding-right:1px;">
          <div class="field-label">Status</div>
          <div class="field-data"><%= invoice.status&.capitalize||'Pending' %></div>
        </div>
        <% if invoice.invoice_attachments.count > 0 %>
          <div class="col-xs-12 col-md-1">
            <div class="field-label">Attachments</div>
             <div class="field" style="text-align: center;padding: 12px;">
                <% invoice.invoice_attachments.each do |attachment| %>
                  <a href="<%= attachment.file&.url %>" target="_blank" title="<%= attachment.file.identifier %>">
                    <i class="fa fa-money" aria-hidden="true"></i>
                  </a>
                <% end %>
            </div>
          </div>
        <% end %>
        <% if current_user.is_panel_admin_user? && @matter_intake.deleted_at.blank? %>
          <% if ['approved', 'rejected'].include?(invoice.status) == false %>
            <div class="col-xs-12 col-md-3">
              <div class="field-label"></div>
              <div style="padding-top: 14px;">
                <%= link_to "Approve", approve_invoice_path(invoice), class: "btn-type-primary" %> 
                <%= link_to "Reject", reject_invoice_path(invoice), class: "btn-type-primary", style: "background-color: #ad0000 !important;" %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="col-md-12 col-xs-12">
    <div class="totalRow">
      <div>
        <span>Total Amount:</span> <%= @matter_intake.invoices.sum(&:amount).try(:format) %>
      </div>
    </div>
  <div>
<% end %>