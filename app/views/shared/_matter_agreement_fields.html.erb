<div id="matter_intake_agreement">
	<div class="col-md-12 col-xs-12">
		<div class="formSection row nested-fields"> <!-- this main div will be functional -->
			<div class="col-xs-12 col-md-1">
				<div><label class="label">Upload</label></div>
				<div class="uploadFile">
					<label for="file" onclick="trigger_file_input(this)">
						<%= image_tag "uploadIcon.svg", alt:"Upload file" %>
						<span class="file_name" style="padding: 5px;"><%= f.object.file.identifier%></span>
					</label>
					<%= f.input :file, label: false, as: :file, input_html: {multiple: false, onchange:"show_file_name(this)"} %>
					<%= f.input :doc_type, as: :hidden, value: "agreement", label: false%>
				</div>
			</div>
			<div class="col-xs-12 col-md-1">
				<div class="remove-matter-agreement">
					<%= link_to_remove_association "<i class='fa fa-minus-circle'></i>".html_safe, f %>	
				</div>
			</div>
		</div>
	</div>
</div>