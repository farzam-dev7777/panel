<%- 
  begin
    law_firms = law_firms.limit(limit) if limit.present?
    table_id
  rescue
    table_id = ""
  end
%>

<table id="<%= table_id  %>" class="table table-decoration table-bordered" width="100%">
  <thead>
    <tr>
      <th>Firm Name</th>
      <th>Number of Matters</th>
      <th>Relationship Partner (Firm)</th>
      <th>Relationship Partner Email</th>
      <th>Billing Contact Email</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% law_firms.each do |law_firm| %>
      <tr onClick="window.location.href='<%= link_base_url ? "#{link_base_url}/#{law_firm&.id}" : "#" %>'">
        <td>
          <% if law_firm&.name.present? %>
            <div class="firm-name">
              <div class="name-avatar"><img src="<%= get_avatar_image(law_firm&.name&.gsub(" ", "+")) %>"></div>
              <div><%= law_firm&.name %></div>
            </div>
          <% else %>
            -
          <% end %>	
        </td>
        <td><%= law_firm&.matter_intakes&.count %></td>
        <td><%= law_firm.bmo_relationship_partner_name.present? ? law_firm.try(:bmo_relationship_partner_name) : "-" %></td>
        <td><%= law_firm.bmo_relationship_partner_email.present? ? law_firm.try(:bmo_relationship_partner_email) : "-" %></td>
        <td><%= law_firm.billing_contact_email.present? ? law_firm.try(:billing_contact_email) : "-" %></td>
        <td><%= law_firm.status_show %></td>
      </tr>
    <% end %>
  </tbody>
</table>