<style>
  div#gauge * {
    top: -25px;
  }

  input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
</style>

<div class="col-lg-12 col-md-12 col-sm-12">
  <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
    <div class="page-header-sp m-top">
      <div class="page-title">Mark this matter as "On Panel"</div>
      <div class="back-edit-actions">
        <a class="btn-type-default" href="/matter_intakes">
          <%= image_tag "chevron-back-icon.svg", alt:"Back" %>
        </a>
      </div>
    </div>
    <div class="sp-form sp-form-bg">
      <%= simple_form_for matter_form_url(@matter_intake), html: { multipart: true } do |f| %>
        <div class="row form-flex-wrap">
          <!-- New form start -->
          <div class="col-md-12 col-xs-12">
            <div class="formHeader">
              <div class="headerTitle">Agreements</div>
            </div>
          </div>
          <div class="col-md-12 col-xs-12">
            <% if @matter_intake.matter_intake_agreements.count > 0 %>
              <% @matter_intake.matter_intake_agreements.each do |attachment| %>
                <%= f.simple_fields_for :matter_intake_agreements, attachment do |form| %>
                  <%= render '/shared/matter_agreement_fields', f: form, attachment: attachment%>
                <% end %>
              <% end %>
            <% end %>
            <div class="addButton links mb-4">
              <%= link_to_add_association '<span href="javascript:void(0);"><i class="fa fa-plus-circle"></i> Add Agreement</span>'.html_safe, f, :matter_intake_agreements, partial: '/shared/matter_agreement_fields' %> 
            </div>
          </div>
          <div class="col-xs-12 col-md-12 text-right">
            <%=link_to 'Cancel', @matter_intake.new_record? ? matter_intakes_path : matter_intakes_path, class: 'btn-type-default' %>
            <%= f.button :submit, "Mark this matter as 'On Panel'", class: "btn-type-primary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>