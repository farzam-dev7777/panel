<% if @matter_intake.matter_approvals.size > 0 %>
  <!-- Invoices Starts-->
    <div class="col-lg-12 col-md-12 col-sm-12">
      <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
        <div class="page-header-sp mobile-dashboard-header">
          <div class="page-title">Approvals</div>
        </div>
        <div class="no-padding">
          <div class="jarviswidget-editbox"></div>
          <!-- widget content -->
          <div class="widget-body">
            <div class="table-responsive">
              <table id="" class="table table-decoration table-bordered" width="100%">
                <thead>
                  <tr>
                    <th>Group Name</th>
                    <th>Approval Name</th>
                    <th>Approval Status</th>
                    <th>Comments</th>
                  </tr>
                </thead>
                <tbody>
                  <% @matter_intake.approval_listing.order("approval_sequence desc, created_at desc").each_with_index do |approval, index| %>
                    <tr>
                      <td><%= approval.show_role %></td>
                      <td><%= approval.user&.full_name||'-' %></td>
                      <td><%= approval.show_status||'Pending'%></td>
                      <td><%= approval.message||'-' %></td>
                      <td></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  <!-- Invoices Ends-->
<% end %>