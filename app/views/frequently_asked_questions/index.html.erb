
<div class="container">
	<h2>Frequently Asked Questions</h2>
	<div class="well well-sm well-light">
		<div id="accordion">
			<% @faqs.each do |faq| %>
			<div>
				<h4><%= faq.question %></h4>
				<div class="row padding-10">
					<%= faq.answer %>
				</div>
			</div>
			<% end %>
		</div>
	</div>
</div>