<div id="invoices">
	<div class="col-md-12 col-xs-12">
		<div class="formSection row nested-fields"> <!-- this main div will be functional -->
			<div class="col-xs-12 col-md-2">
				<label class="label">Lawyer Name</label>
				<%= f.input :lawyer_name, label: false %>
			</div>
			<div class="col-xs-12 col-md-2">
				<label class="label">Hours</label>
				<%= f.input :hours, label: false %>
			</div>
			<div class="col-xs-12 col-md-2">
				<label class="label">Description</label>
				<%= f.input :description, label: false %>
			</div>
			<div class="col-xs-12 col-md-2">
				<label class="label">Rate Type</label> <!-- (Hourly/AFA) -->
				<%= f.input :rate_type, label: false, as: :select, collection: [['Hourly', 'Hourly'], ['AFA', 'AFA']] %>
			</div>
			<div class="col-xs-12 col-md-2">
				<label class="label">Amt</label>
				<%= f.input :amount, label: false %>
			</div>
			<%= f.simple_fields_for :invoice_attachments, InvoiceAttachment.new do |p| %>
				<div class="col-xs-12 col-md-1">
					<div><label class="label">Upload</label></div>
					<div class="uploadFile">
						<label for="file">
							<%= image_tag "uploadIcon.svg", alt:"Upload file" %>
						</label>
						<%= p.input :file, label: false, as: :file, input_html: {id: "file", multiple: false, class: "ajax_file_upload"} %>
						<span class="loader">&nbsp;&nbsp;<i class="fa fa-refresh fa-spin fa-1x fa-fw"></i></span>
					</div>
				</div>
			<% end %>
			<div class="col-xs-12 col-md-1">
				<div class="remove-matter-invoice">
					<%= link_to_remove_association "<i class='fa fa-minus-circle'></i>".html_safe, f %>	
				</div>
			</div>
		</div>
	</div>
</div>