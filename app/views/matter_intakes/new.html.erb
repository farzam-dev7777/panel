<style>
  div#gauge * {
    top: -25px;
  }

  input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
</style>

<div class="col-lg-12 col-md-12 col-sm-12">
  <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
    <div class="page-header-sp m-top">
      <div class="page-title">Matter Intake Form - <%= @form_type === 'general' || @matter_intake&.form_type === 'general' ? "General" : "Litigation" %></div>
      <div class="back-edit-actions">
        <% if @show_information_security_form.present? %>
          <a class="btn-type-default" href="#" id="matter-security-form">
            <%= image_tag "chevron-back-icon.svg", alt:"Back" %>
          </a>
        <% else %>
          <a class="btn-type-default" href="/matter_intakes">
            <%= image_tag "chevron-back-icon.svg", alt:"Back" %>
          </a>
        <% end %>
      </div>
    </div>
    <%= render "form_v1" %> 
  </div>
</div>