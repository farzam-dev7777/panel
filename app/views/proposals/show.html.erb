<div class="col-lg-12 col-md-12 col-sm-12">
  <div class="jarviswidget-color-darken" id="wid-id-2">
    <div class="page-header-sp m-top">
      <div class="page-title">Proposal: <%= @proposal.status%></div>
      <div class="back-edit-actions">
        <% if @proposal.rfp.status == 'pending'%>
          <div class="action-buttons-alignment" style="padding-left: 600px;">
            <a class="action-btn export-icon" href=<%= edit_rfp_proposal_path(@proposal.rfp, @proposal)%> data-toggle="tooltip" data-placement="top" title="" data-original-title="Edit">
              <span class="blue-text">Edit</span>
            </a>
          </div>
        <% end %>
      </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12">
      <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
            <!-- widget content -->
              <div class="sp-form-bg show-data-fields">
                <div class="row form-flex-wrap">
                  <div class="col-xs-12 col-md-6">
                    <div class="field-label">Description</div>
                     <div class="field-data"><%= @proposal.description %></div>
                  </div>
                  <div class="col-xs-12 col-md-6">
                    <div class="field-label">Amount</div>
                     <div class="field-data"><%= @proposal.amount %></div>
                  </div>
                </div>
              </div>
        </div>
      </div>
  </div>
</div>
<% if @proposal.rfp.status == 'pending'%>
  <%= render "comment_form" %>
<% end %>
<%= render "comment" %>