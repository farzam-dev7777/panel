<div style=" margin-bottom: 10px; " class="col-md-12 no-padding issue-object issue-<%= f.object.try(:id) %>">
  
  <div class="col-md-11 no-padding">
    <div class="form-group optional law_firm_issues_country">
      <%= f.input :issue, input_html: { class: 'no-margin no-padding' }, label: false %>
    </div>
  </div>
  <div class="col-md-1" style="line-height: 35px;">
    <%= link_to_remove_association "<i class='fa fa-minus-circle'></i>".html_safe, f, { wrapper_class: "issue-#{f.object.try(:id)}" }  %>
  </div>
</div>
