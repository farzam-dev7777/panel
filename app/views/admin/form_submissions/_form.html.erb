<div class="jarviswidget form-wizard-wrapper" id="wid-id-0" data-widget-editbutton="false">
  <header>
    <span class="widget-icon"> <i class="fa fa-certificate"></i> </span>
    <h2>Certification Submission</h2>

  </header>
  <!-- widget div-->
  <div class="no-border">

    <!-- widget edit box -->
    <div class="jarviswidget-editbox">
      <!-- This area used as dropdown edit box -->

    </div>
    <!-- end widget edit box -->

    <!-- widget content -->
    <div class="widget-body fuelux">
      <%= render 'wizard' %>
      <div class="clearfix"></div>
      <div class="row">
        <div class="col-md-12">
          <%= simple_form_for @form_submission, validate: true, :html => {:multipart => true, remote: true, authenticity_token: true} do |f| %>
            <%= yield :form %>
          <% end %>
        </div>
      </div>
    </div>


    <% if(last_step && !save_and_follow_up?(@form_submission.id)) %>
      <div class="col-md-10 col-md-offset-1">
        <%= simple_form_for @form_submission, url: update_score_admin_form_submission_path, validate: true, :html => {remote: true, authenticity_token: true, class: 'score-form'} do |f| %>
          <%= f.input :score, as: :integer, required: true %>
          <%= f.submit 'Update Score', class: 'btn btn-primary force-center' %>
        <% end %>
      </div>
    <% end %>



    <div class="col-md-12 text-center" style="margin: 20px 0px">
      <div class="btn-group">
        <%= link_to "<i class='fa fa-caret-left'></i> Prev <i class='loader fa fa-circle-o-notch fa-spin hidden'></i>".html_safe, previous_step_path, class: 'btn btn-default' %>

        <% if(!last_step) %>
          <%= link_to "Next <i class='fa fa-caret-right'></i> <i class='loader fa fa-circle-o-notch fa-spin hidden'></i>".html_safe, next_step_path, class: 'btn btn-default' %>
        <% end %>

        <% if(last_step) %>
          <%= link_to "<i class='fa fa-ban'></i> Decline <i class='loader fa fa-circle-o-notch fa-spin hidden'></i>".html_safe, decline_admin_form_submission_path(@form_submission), class: 'btn btn-danger' %>

          <%= link_to "Save & Follow Up <i class='loader fa fa-circle-o-notch fa-spin hidden'></i>".html_safe, save_and_follow_up_admin_form_submission_path(@form_submission), method: :post, class: 'btn btn-warning', disabled: !save_and_follow_up?(@form_submission.id) %>

          <%= link_to "<i class='fa fa-check'></i> Approve <i class='loader fa fa-circle-o-notch fa-spin hidden'></i>".html_safe, approve_admin_form_submission_path(@form_submission), method: :post, disabled: save_and_follow_up?(@form_submission.id), class: 'btn btn-success' %>
        <% end %>
      </div>
    </div>

    
    <br />
    <br />
    <br />
    <!-- end widget content -->

  </div>
  <!-- end widget div -->

</div>