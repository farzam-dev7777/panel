<div class="jarviswidget" id="wid-id-0" data-widget-editbutton="false">
  <header>
    <span class="widget-icon"> <i class="fa fa-certificate"></i> </span>
    <h2>Certification Submission</h2>

  </header>

  <!-- widget div-->
  <div>

    <!-- widget edit box -->
    <div class="jarviswidget-editbox">
      <!-- This area used as dropdown edit box -->

    </div>
    <!-- end widget edit box -->

    <!-- widget content -->
    <div class="widget-body fuelux">
      <%= render 'wizard' %>
      <div class="clearfix"></div>
      <div class="row">
        <div class="col-md-12">
          <%= simple_form_for [:admin, @form_submission], :html => {:multipart => true, remote: true, authenticity_token: true} do |f| %>
            <%= render 'new_form_submission', resource: @form_submission %>
          <% end %>
        </div>
      </div>
      <%= render 'wizard' %>
    </div>
    <div class="col-md-2 col-md-offset-5">
      <div class="btn-group">
        <%= link_to "<i class='fa fa-caret-left'></i> Previous <i class='loader fa fa-circle-o-notch fa-spin hidden'></i>".html_safe, previous_step_path, class: 'btn btn-default submit-form' %>
        <%= link_to "<i class='fa fa-disk'></i> Save".html_safe, current_step_path, class: 'btn btn-primary submit-form' %>
        <%= link_to "Next <i class='fa fa-caret-right'></i> <i class='loader fa fa-circle-o-notch fa-spin hidden'></i>".html_safe, next_step_path, class: 'btn btn-primary submit-form' %>
      </div>
    </div>
    <br />
    <br />
    <br />
    <!-- end widget content -->

  </div>
  <!-- end widget div -->

</div>