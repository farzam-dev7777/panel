<div class="row technology-field-<%= platform_category %>-<%= type %> select-fields <%= follow_up_class(params[:id], f.object.id, 'TechnologyValue') %>">
	<%= f.input :platform_category, as: :hidden, input_html: { value: platform_category }  %>
	<%= f.input :platform_type, as: :hidden, input_html: { value: type } %>

	<div class="col-md-3 vendor-wrapper">
		<%= f.input :vendor, collection: Technology.all.pluck(:vendor).uniq, 
												 input_html: {class: 'dynamic-select', data: { field: 'vendor' } } %>
	</div>
	<div class="col-md-2 platform-wrapper">
		<%= f.input :platform, collection: Technology.all.pluck(:platform).uniq, input_html: {class: 'dynamic-select', data: {field: 'platform'}} %>
	</div>
	<div class="col-md-2 version-wrapper">
		<%= f.input :version, collection: Technology.all.pluck(:version).uniq, input_html: {class: 'dynamic-select', data: {field: 'version'} } %>
	</div>
	<div class="col-md-2 service_pack-wrapper">
		<%= f.input :service_pack, collection: Technology.all.pluck(:service_pack).uniq, input_html: { data: {field: 'service_pack'} } %>
	</div>
	<div class="col-md-2">
		<%= f.input :supported, collection: ['Yes', 'No'] %>
	</div>

	<%= render partial: 'note', locals: { loggable: f.object, follow_ups: @follow_ups, 
																							wrapper_class: note_class('technology'),
																							form_type: 'TechnologyValue', field: f.object } %>
</div>

<div class="clearfix"></div>