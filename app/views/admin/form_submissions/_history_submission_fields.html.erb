<div class="row history-field <%= follow_up_class(params[:id], f.object.id, 'HistorySubmission') %>">
	<div class="col-md-3"><%= f.input :incident_type, collection: ['Incident Type 1', 'Incident Type 2'] %></div>
	<div class="col-md-2"><%= f.input :impact %></div>
	<div class="col-md-2"><%= f.input :discovery_time %></div>
	<div class="col-md-2"><%= f.input :source, collection: ['Source 1',  'Source 2'] %></div>
	<div class="col-md-2"><%= f.input :data_loss, collection: ['Yes', 'No'] %></div>



	<div class="clearfix"></div>
	<div class="col-md-11"><%= f.input :incident_details %></div>

	<%= render partial: 'note', locals: { loggable: f.object, follow_ups: @follow_ups, 
																							wrapper_class: note_class('history'),
																							form_type: 'HistorySubmission'} %>

</div>
<div class="clearfix"></div>