<% content_for :page_title do %>
	<span>Security Alerts</span>
<% end %>


<% content_for :page_buttons do %>
	<%= link_to "Create New Security Alert", new_admin_security_alert_path, class: "btn btn-primary btn-md pull-right m-b-20" %>
<% end %>

<div class="clearfix"></div>




<div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
	<header>
		<span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
		<h2 class="font-md"><strong>Current Alerts </strong></h2>				
	</header>
	<div class="no-padding">
		<div class="jarviswidget-editbox"></div>
		<!-- widget content -->
		<div class="widget-body">

			<div class="col-lg-12 col-md-12 col-sm-12">

				<div class="table-responsive">
					<table class="table table-bordered" id="sec-alert">
						<thead>
							<tr style="background: #2b3344;color: #fff;">
								<th>Title</th>
								<th>Severity</th>
								<th>Submitted</th>
								<th colspan="2">Action</th>
							</tr>
						</thead>

						<tbody>
							<% @security_alerts.each do |alert| %>
								<tr>
									<td><%= alert.title %></td>
									<td><%= alert.severity %></td>
									<td><%= "#{time_ago_in_words(alert.alert_date || alert.created_at)} ago" %></td>
									<td class="text-center">
										<%= link_to "Edit", edit_admin_security_alert_path(alert), class: "btn btn-xs btn-primary" %>	
									</td>
									<td class="text-center">
										<a href="javascript:void(0)" class="btn btn-xs btn-danger delete-security-alert" data-id="<%= alert.id %>">Delete</a>
									</td>
								</tr>
							<% end %>
						</tbody>

					</table>
					<div class="clearfix"></div>

					<%= will_paginate @security_alerts, renderer: BootstrapPagination::Rails %>
				</div>
			</div>	

		</div>
	</div>
</div>