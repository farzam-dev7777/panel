<div class="no-padding">
  <div class="jarviswidget-editbox"></div>
    <!-- widget content -->
    </br>
    <div class="field-label">Questions </div>
    <div class="widget-body">
    <div class="table-responsive">
      <table id="" class="table table-decoration table-bordered" width="100%">
        <thead>
          <tr>
            <th>Title</th>
            <th>Type</th>
          </tr>
          <tbody>
            <% @rfp.questions.order(:id).each do |question| %>
              <tr>
                  <td><%= question.message%></td>
                  <td><%= question.kind %></td>
              </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
