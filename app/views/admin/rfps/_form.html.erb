<div class="sp-form sp-form-bg">
  <% invoice_enable = false%>
  <% matter_intake = @rfp.matter_intake%>
  <% matter_role = matter_intake.matter_form_role(current_user)%>
  <%= simple_form_for [:admin, @rfp], html: { multipart: true } do |rfp| %>
    <%= rfp.simple_fields_for :matter_intake do |f| %>
      <%= rfp.input :status, as: :hidden, :input_html => { :value => rfp.object.status||'pending'} %>
      <div class="row form-flex-wrap">
        <%matter_intake.rfp_generate_fields(current_user, Tenant.current).each do |obj| %>
          <%= f.input :form_type, as: :hidden, :input_html => { :value => 'rfp'} %>
          <% if obj[:access][matter_role] == 'write' && obj[:database_field] != :law_firm_id && obj[:database_field] != :lawyer_ids %>
            <% f_width = obj[:database_field] == :matter_description ? 12 : 6%>
            <% if obj[:database_field] == :invoices && obj[:access][matter_role] == 'write' %>
              <% invoice_enable = true %>
            <% else %>
              <div class="col-xs-12 col-md-<%= f_width%>" title="<%= matter_lang_title(obj[:database_field], obj[:name]) %>">
                <label  class="label" style="white-space: unset;">
                  <% if obj[:optional] == true %>
                    <%= obj[:name] %>
                  <% else %>
                    <%= obj[:name] %><span class="mandatory">*</span>
                  <% end %>
                </label>
                <% if obj[:access][matter_role] == 'read' %>
                  <% if obj[:database_field] == :law_firm_id%>
                    <%= f.input obj[:database_field], label: false, :input_html => { :value => matter_intake.law_firm&.name, disabled:true} %>
                  <% else %>
                    <%= f.input obj[:database_field], label: false, :input_html => { :value => obj[:value], disabled:true} %>
                  <% end %>
                  <%= f.input obj[:database_field], as: :hidden, :input_html => { :value => obj[:value]} %>
                <% else %>
                  <% if obj[:type] == 'currency' %>
                    <%= f.input obj[:database_field], label: false, :input_html => { :value => obj[:value], pattern:"^\$\d{1,3}(,\d{3})*(\.\d+)?$", data_type: "currency", placeholder: "Add amount"} %>
                  <% elsif obj[:type] == 'dropdown' %>
                    <%= f.input obj[:database_field], label: false, collection: obj[:collection], input_html: { multiple: obj[:multiple].present? } %>
                  <% elsif obj[:type] == 'file' %>
                    <%= f.input obj[:database_field], as: :file, label: false  %>
                  <% elsif obj[:type] == 'text' %>
                    <%= f.input obj[:database_field], label: false, :input_html => { :value => obj[:value], multiple: obj[:multiple].present? } %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        <% end %>
        <div class="col-xs-12 col-md-3">
          <label class="label">Law Firm Invites</label>
          <%= rfp.input :invites, label: false, collection: [['Select All', 'select_all']]+Tenant.current.law_firms.select{|s| s.status_show=='On Panel'}.map{ |lf| [lf.name, lf.id] }, selected: @rfp.rfp_invites.map(&:law_firm_id), input_html: { multiple: true } %>
        </div>
        <div class="col-xs-12 col-md-3">
          <label class="label">Assigned Lawyer</label>
          <% c_law_firm = (@matter_intake&.law_firm||current_user&.law_firm) %>
          <%= f.input :lawyer_ids, label: false, collection: (c_law_firm&.users&.where(role:'user')&.map{|s| [(s.name), s.id]}||[]), selected: @matter_intake.lawyers&.ids, input_html: { multiple: true } %>
        </div>
        <div class="col-xs-12 col-md-3">
          <label class="label">Expiry Date</label>
          <%= rfp.input :expiry_date, as: :string, input_html: { class: 'rfp_datepicker', value: rfp.object&.expiry_date&.strftime("%d %b %Y %H:%m") }, label: false %>
        </div>
        <div class="col-xs-12 col-md-3">
          <label class="label">Notify Lawyers</label>
          <%= rfp.input :notify_lawyers, as: :check_boxes, label: false, collection: [['Yes', 'Yes']] %>  
        </div>

        <!-- New Lobs start -->
        <div class="col-md-12 col-xs-12">
          <div class="formHeader">
            <div class="headerTitle">Invite internal stakeholders</div>
          </div>
        </div>
        <div class="col-md-12 col-xs-12">
          <% if @rfp.rfp_lobs.size > 0 %>
            <% @rfp.rfp_lobs.each do |rfp_lob| %>
              <%= rfp.simple_fields_for :rfp_lobs, rfp_lob do |form| %>
                <%= render 'rfp_lob_fields', f: form, rfp_lob: rfp_lob %>
              <% end %>
            <% end %>
          <% end %>
          <div class="addButton links mb-4">
            <%= link_to_add_association '<span href="javascript:void(0);"><i class="fa fa-plus-circle"></i> Invite stakeholder</span>'.html_safe, rfp, :rfp_lobs, partial: 'rfp_lob_fields' %> 
          </div>
        </div>
        <!-- New Question start -->
        <div class="col-md-12 col-xs-12">
          <div class="formHeader">
            <div class="headerTitle">Questions (Select/Deselect or Create New)</div>
          </div>
        </div>
        <div class="col-md-12 col-xs-12">
          <% if @rfp.questions.size > 0 %>
            <% @rfp.questions.each do |question| %>
              <%= rfp.simple_fields_for :questions, question do |form| %>
                <%= render 'rfp_question_fields', f: form, question: question %>
              <% end %>
            <% end %>
          <% end %>
          <div class="addButton links mb-4">
            <%= link_to_add_association '<span href="javascript:void(0);"><i class="fa fa-plus-circle"></i> Add Question</span>'.html_safe, rfp, :questions, partial: 'rfp_question_fields' %> 
          </div>
        </div>

        <!-- New form start -->
        <div class="col-md-12 col-xs-12">
          <div class="formHeader">
            <div class="headerTitle">Reference Materials</div>
          </div>
        </div>
        <div class="col-md-12 col-xs-12">
          <% if matter_intake.matter_intake_attachments.count > 0 %>
            <% matter_intake.matter_intake_attachments.each do |attachment| %>
              <%= f.simple_fields_for :matter_intake_attachments, attachment do |form| %>
                <%= render '/shared/matter_attachment_fields', f: form, attachment: attachment %>
              <% end %>
            <% end %>
          <% end %>
          <div class="addButton links mb-4">
            <%= link_to_add_association '<span href="javascript:void(0);"><i class="fa fa-plus-circle"></i> Add Attachment</span>'.html_safe, f, :matter_intake_attachments, partial: '/shared/matter_attachment_fields' %> 
          </div>
        </div>
      </div>
      <div class="col-xs-12 col-md-12 text-right">
        <%=link_to 'Cancel', admin_matter_intakes_path, class: 'btn-type-default' %>
        <%= f.button :submit, "Submit", class: "btn-type-primary simple_form_edit_matter_intakes" %>
      </div>
    <% end %>
  <% end %>
</div>
