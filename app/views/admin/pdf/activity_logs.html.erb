<link href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-BVYiiSIFeK1dGmJRAkycuHAHRg32OmUcww7on3RYdg4Va+PmSTsz/K68vbdEjh4u" crossorigin="anonymous">
<style>
	table tr td,
	table tr th, {
		font-size: 12px !important;
	}
	em { font-size: 10px; }
	table tr th {
		text-align: left !important;
	}
</style>

<table class="table table-striped table-bordered" style="width: 100%">
	<tr>
		<th>Law Firm</th>
		<th>Event</th>
		<th>Logged At</th>
	</tr>
	<% @activity_logs.each do |activity| %>
		<tr>
			<td width="35%"><%= activity.law_firm.try(:name) %></td>
			<td width="40%">
				<%= activity.custom_message || activity.event_type.humanize %> <br>
				<em>(<%= activity.source == 'AdminUser' ? 'Bank' : 'Law Firm' %>)</em>	
			</td>
			<td width="25%"><%= activity.created_at.strftime('%d %b at %I:%M %p') %></td>
		</tr>
	<% end %>
</table>