<style>
	table tr td,
	table tr th, {
		font-size: 12px !important;
	}
	table tr th {
		text-align: left !important;
	}
</style>

<table style="width: 100%">
	<tr>
		<th>Law Firm</th>
		<th>Event</th>
		<th>Source</th>
		<th>Logged At</th>
	</tr>
	<% @activity_logs.each do |activity| %>
		<tr>
			<td><%= activity.law_firm.try(:name) %></td>
			<td><%= activity.custom_message || activity.event_type.humanize %></td>
			<td><%= activity.source %></td>
			<td><%= activity.created_at.strftime('%d %b at %I:%M %p') %></td>
		</tr>
	<% end %>
</table>