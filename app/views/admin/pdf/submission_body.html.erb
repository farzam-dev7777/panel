<% @form_submission.form_values.includes(:form_field).where(form_fields: {parent_id: nil}).each_with_index do |form_value, index| %>  
  <% children_form_values = FormValue.includes(:form_field).where(submittable: @form_submission, form_fields: { parent_id: form_value.form_field_id }) %>
  <%= render "admin/pdf/form_values", form_value: form_value, serial: index, sub_questions: false %>
  <% children_form_values.each_with_index do |fv, idx| %>
    <%= render "admin/pdf/form_values", form_value: fv, serial: idx, sub_questions: true %>
  <% end %>
<% end %>

<div class="col-md-12">
  <div class="quer-oe">
    <div class="question-sec"> 
      <i>Section : Technology</i> 
    </div>
  </div>
</div>

<div class="col-md-12">
  <div class="quer-oe">
    <div class="question-sec"> <b class="que"><i>X.</i>OPERATING SYSTEMS</b> <em>Yes</em> </div>
    <div class="to-po-z"> <i>X.1</i> <b>SERVER</b>
      <div class="top-info">
        <div class="top-info">
          <% if @form_submission.technology_values.operating_systems.server.count > 0 %>
            <%= render "admin/pdf/technology_header"  %>
            <% @form_submission.technology_values.operating_systems.server.each do |form_value| %>
              <%= render "admin/pdf/technology_value_fields", form_value: form_value  %>
            <% end %> 
          <% else %>
              N/A
          <% end %>
        </div>      
      </div>
    </div>
