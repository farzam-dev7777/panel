<% content_for :page_title do %>
  <span>Forms</span>
<% end %>

<% content_for :page_buttons do %>
  <%= link_to "Create New Form", new_admin_form_path, class: "btn btn-primary btn-md pull-right" %>
<% end %>

<div class="clearfix"></div>

<div class="clearfix"></div>

<div class="row">
  
  <div class="col-lg-8 col-md-8 col-sm-12">

    <div class="table-responsive">
      <table class="table table-bordered all-forms">

        <tr>
          <th>Name</th>
          <th>Action</th>
        </tr>

        <% @forms.each do |form| %>
          <tr>
            <td><%= form.name %></td>
            <td class="text-center">
              <%= link_to "Edit", edit_admin_form_path(form), class: "btn btn-sm btn-info" %> 
            </td>
          </tr>
          
        <% end %>

      </table>
      <div class="clearfix"></div>

      <%= will_paginate @forms, renderer: BootstrapPagination::Rails %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="well">
      <%= simple_form_for @q, url: :admin_forms, method: :get do |f| %>
        <%= f.input :name_cont, label: 'Name', class: 'form-control' %>
        <%= f.input :group_form_eq, label: 'Group Form', collection: [true, false], class: 'form-control' %>
        <%= f.button :submit, "Search", class: "btn btn-sm btn-primary" %>
      <% end %>
    </div>
  </div>

</div>
