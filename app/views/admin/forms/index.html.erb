<% content_for :page_title do %>
  <span>Forms</span>
<% end %>

<% content_for :page_buttons do %>
  <%= link_to "Create New Form", new_admin_form_path, class: "btn btn-primary btn-md pull-right" %>
<% end %>

<div class="clearfix"></div>

<div class="clearfix"></div>

<div class="row">
  
  <div class="col-lg-8 col-md-8 col-sm-12">

    <div class="table-responsive">
      <table class="table table-bordered">

        <tr>
          <th>Name</th>
          <th>Action</th>
        </tr>

        <% @forms.each do |form| %>
          <tr>
            <td><%= form.name %></td>
            <td class="text-center">
              <%= link_to "Edit", edit_admin_form_path(form), class: "btn btn-primary" %> 
              <%= link_to "Duplicate", duplicate_admin_form_path(form), class: "btn btn-primary", method: :post %>
              <%= link_to "Preview", edit_admin_form_form_submission_path(form_id: form.id, id: FormSubmission.find_by(form_id: form.id)), class: "btn btn-primary" if FormSubmission.find_by(form_id: form.id) %> 
              <%= link_to "Generate a new form", generate_admin_form_form_submissions_path(form_id: form.id), class: "btn btn-primary", method: :post unless FormSubmission.find_by(form_id: form.id) %> 
            </td>
          </tr>
          
        <% end %>

      </table>
      <div class="clearfix"></div>

      <%= will_paginate @forms, renderer: BootstrapPagination::Rails %>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="well">
      <%= simple_form_for @q, url: :admin_forms, method: :get do |f| %>
        <%= f.input :name_cont, class: 'form-control' %>
        <%= f.input :group_form_eq, collection: [true, false], class: 'form-control' %>
        <%= f.button :submit, "Search", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

</div>
