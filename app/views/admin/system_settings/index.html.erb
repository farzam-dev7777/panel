<div class="row">
	<div class="col-md-2">
		System Score Threshold
	</div>
	<div class="col-md-4">
		<div class="system-score-threshold"></div>
	</div>
</div>


<div class="row">
	<div class="col-md-2">
		Docusign Access Token
	</div>
	<div class="col-md-4">
		<%= simple_form_for [:admin, SystemSetting.fetch] do |f| %>
			<%= f.input :docusign_access_token, label: false, input_html: {rows: 15, cols: 10} %>
			<%= f.submit "Save", class: "btn btn-primary" %>
		<% end %>

	</div>
	<div class="col-md-4">
		<a href="/auth/docusign" class="request_docusign_access_token btn-type-primary">Request Docusign Access Token</a>
	</div>

</div>