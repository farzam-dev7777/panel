<div class="row">
	<div class="col-md-12">
		<div class="col-md-2">
			System Score Threshold
		</div>
		<div class="col-md-4">
			<div class="system-score-threshold"></div>
		</div>
	</div>
</div>

<%= simple_form_for [:admin, @settings] do |f| %>
<div class="row">
	<div class="col-md-12">
			<div class="col-md-2">
			Docusign Access Token
		</div>
		<div class="col-md-4">  
				<%#= f.input :docusign_access_token, label: false, input_html: {rows: 15, cols: 10} %>
				<br>
				<% if @settings.docusign_token_expires_at.present? %>
					<b>Docusign Token Expires At : <%= @settings.docusign_token_expires_at.strftime('%d %b %Y at %I:%M %p') %></b>
				<% end %>	
		</div>
		<div class="col-md-4">
			<a href="/users/auth/docusign" class="request_docusign_access_token btn-type-primary">Request Docusign Access Token</a>
		</div>
	</div>
	<div class="col-md-12">
			<div class="col-md-2">
			Docusign LXP Email
		</div>
		<div class="col-md-4"> 
				<%= f.input :lxp_email, label: false, input_html: {rows: 15, cols: 10} %>
		</div>
	 
	</div> 
	<div class="col-md-12">
		<div class="col-md-2">
			Docusign LXP Name
		</div>
		<div class="col-md-4">  
				<%= f.input :lxp_name, label: false, input_html: {rows: 15, cols: 10} %> 
		</div> 
	</div>
	<div class="col-md-12">
		<div class="col-md-2">
			Panel Consideration Request Open For Lob/Lawyers
		</div>
		<div class="col-md-4">  
		<%= f.input :panel_status, as: :radio_buttons, label: false, collection: [["Yes", "Yes"], ["No", "No"]] %>
		</div> 
	</div>
 	<div class="col-md-12"> 
	 	<div class="col-md-2">
		 
		</div>
		<div class="col-md-4">  
			<%= f.submit "Save", class: "btn btn-primary" %> 
		</div> 
	</div>
	<% end %>
</div>