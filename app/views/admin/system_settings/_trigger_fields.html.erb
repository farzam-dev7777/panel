<div class="severity-level-">
	<div class="col-md-1">
		<%= f.input :hours %>
	</div>
	<div class="col-md-6">
		<%= f.input :message %>
	</div>
	<div class="col-md-4">
		<%= f.input :action_type, collection: Trigger::ACTION_TYPES.map{|action| [action.humanize, action] }, input_html: { style: 'width: 100%' } %>
	</div>
	<div class="col-md-1 text-right" style="padding-top: 20px;">
		<%= link_to_remove_association "<i class='fa fa-minus-circle fa-2x'></i>".html_safe, f, { wrapper_class: "severity-level-" }  %>
	</div>
</div>
<div class="clearfix"></div>