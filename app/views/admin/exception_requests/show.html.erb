<style>
    div#gauge * {
      top: -25px;
    }
  </style>
  
  <div class="col-lg-3">
    <%= link_to "<i class='fa fa-long-arrow-left'></i>".html_safe, admin_exception_requests_path, class: "btn btn-sm btn-default" %>
    <% if current_user.role == "lob" %>
      <%= link_to "<i class='fa fa-pencil-square-o'></i> Edit".html_safe, edit_admin_exception_request_path, class: "btn btn-sm btn-primary m-l-15 no-border" %>
    <% end %>
  </div>
  <div class="clearfix"></div>


  <div class="col-lg-12 col-md-12 col-sm-12">
    <div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
      <header>
        <span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
        <h2 class="font-md"><strong> Exception Request </strong></h2>				
      </header>
      <div class="  ">
        <div class="jarviswidget-editbox"></div>
        <!-- widget content -->
        <div class="widget-body">
          <%= render "exception_request"  %>
        </div>
      </div>
    </div>
  </div>
  
   
 <%= render "#{current_user.role}_show" %>

