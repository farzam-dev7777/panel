<style>
	input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
</style>


<!-- Modal -->
<div id="addNewFirmModal" class="modal fade" role="dialog">
  <div class="modal-dialog">

    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h4 class="modal-title">Modal Header</h4>
      </div>
      <div class="modal-body">
        <p>Some text in the modal.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
      </div>
    </div>

  </div>
</div>

<div class="col-md-12">
  <div class="page-header-sp m-top">
    <div class="page-title">Engage Exception Request</div>
    <div class="back-edit-actions">
      <a class="btn-type-default" href="/admin/exception_requests">
        <%= image_tag "chevron-back-icon.svg", alt:"Back" %>
      </a>
    </div>
  </div>
</div>

<div class="clearfix"></div>
<div class="col-md-12">
	<div class="sp-form sp-form-bg">
    <%= simple_form_for [:admin, @exception_request] do |f| %>
    
			<div class="row form-flex-wrap">
        <div class="col-xs-12 col-md-6">
          <label class="label">Requested By</label>
          <%= f.input :requested_by, label: false %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Submitted By</label>
          <%= f.input :submitted_by_email, label: false, :input_html => { :value => @current_admin_user_email, :readonly => true } %>
          <%= f.input :user_id, :as => :hidden, :input_html => { :value => @current_admin_user_id } %>
          <%= f.input :request_type, :as => :hidden, :input_html => { :value => "EXCEPTION" } %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Line of Business</label>
          <%= f.input :line_of_business, label: false, collection: ExceptionRequest::LOB_LIST %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">LOB Contact Name</label>
          <%= f.input :lob_contact_name, label: false %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label  class="label">Law Firm</label>
          <%= f.input :law_firm_name, label: false, collection: @law_firms.map{ |law_firm| ["#{law_firm.name} - #{law_firm.id}", law_firm.id] }, prompt: "Select Firm" %>
          <%= f.input :law_firm_id, as: :hidden %>
          <div style="display: none;" class="firmDetails">
            <div class="col-md-8 tab-pane ">
              <div class="col-md-12">
                <div class="col-md-4 column">Name</div>
                <div class="col-md-8 data firmName"></div>
              </div>
              <div class="col-md-12">
                <div class="col-md-4 column">Email</div>		
                <div class="col-md-8 data firmEmail"></div>
              </div>
              <div class="col-md-12">
                <div class="col-md-4 column">Phone</div>		
                <div class="col-md-8 data firmPhone"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Business Manager Name</label>
          <%= f.input :business_manager_name, label: false %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Business Manager Email</label>
          <%= f.input :business_manager_email, label: false %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Business Manager Phone</label>
          <%= f.input :business_manager_phone, label: false %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Law firm Category</label>
          <%= f.input :law_firm_category, label: false, collection:ExceptionRequest::LAW_FIRM_CATEGORIES.map{ |k,v| [v,k]} %>
            <p style="color: #949494;display:none" id="panel_notification" class="text-left">
              <em>Exception not required, firm already on Panel.</em>
            </p>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Minority Owned</label>
          <%= f.input :minority_owned, label: false, collection: ExceptionRequest::MINORITY_OWNED_TYPE  %>
        </div>
        <div class="col-xs-12 col-md-6 minority_owned_details"  style="display:none;">
          <label class="label">Minority Owned Details</label>
          <%= f.input :minority_owned_details, label: false%>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Women Owned</label>
          <%= f.input :women_owned, label: false, collection: ExceptionRequest::WOMEN_OWNED_TYPE %>
        </div>
        <div class="col-xs-12 col-md-6 women_owned_details" style="display:none;">
          <label class="label">Women Owned Details</label>
          <%= f.input :women_owned_details, label: false %>
        </div>
        <div class="col-xs-12 col-md-6 matter_name">
          <label class="label">Matter Name</label>
          <%= f.input :matter_name, label: false, input_html: { autocomplete: 'off' } %>
        </div>
        <div class="col-xs-12 col-md-6 multiple-selector">
          <label class="label">Matter Types</label>
          <%= f.input :matter_types, label: false, collection: ExceptionRequest::MATTER_TYPES,  input_html: { multiple: true }%>
        </div>
        <div class="col-xs-12 col-md-6">
            <%=link_to 'Cancel', @exception_request.new_record? ? admin_exception_requests_path : admin_law_firm_path, class: 'btn-type-default' %>
            <%= f.button :submit, @exception_request.new_record? ? "Submit Request" : "Update Request", class: "btn-type-primary" %>
        </div>
			</div>
		<% end %>
	</div>
</div>