
<% if !@exception_request.fully_approved?  %>  
  <div class="col-lg-12 col-md-12 col-sm-12">
    <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
      <div class="page-header-sp">
        <div class="page-title">LXP Review</div>
        <div class="back-edit-actions">
        </div>
      </div>
      <div class="  ">
        <div class="jarviswidget-editbox"></div>
        <!-- widget content -->
        
        <div class="exceptationRequestProcesss">
          
            <div class="sp-form sp-form-bg">
              <%= simple_form_for [:admin, Review.new()] do |f| %>
                <div class="row">
                  <div class="col-xs-12 col-md-6">
                    <label class="label">Comment</label>
                      <%= f.input :description, label: false %>
                      <%= f.input :reviewable_type, label: false, as: :hidden, input_html: { value: @exception_request.class.to_s } %>
                      <%= f.input :reviewable_id, label: false, as: :hidden, input_html: { value: @exception_request.id } %>
                  </div>		
                  <div class="col-xs-12 col-md-6">
                    <label class="label">Status</label>
                    <%= f.input :status, label: false, collection: ExceptionRequest::EXCEPTION_REQUEST_STATUS.map{|value,key| [key, value]}%>
                  </div>
                </div>
                <div class="row">
                  <div class="col-xs-12 col-md-6 internal_lawyers_box" style="display:none">
                    <label class="label">Assign to</label>
                    <%= f.input :assigned_to_id, label: false, collection: User.where(role: "internal_lawyers").map{|user| [user.email, user.id] } %>
                  </div> 
                  <div class="col-xs-12 col-md-12 text-right">
                    <%= link_to 'Cancel', @exception_request.new_record? ? admin_exception_requests_path : admin_conflict_waiver_path, class: 'btn-type-default' %>
                    <%= f.button :submit, @exception_request.new_record? ? "Submit Request" : "Update Status", class:  @current_user.role === "lxp" ? "lxp_sttaus btn-type-primary" : "laywr_status btn-type-primary" %>
                    <%# if @exception_request.lxp_status === "APPROVED" %>
                      <a href="javascript:void(0)" class="non-panel_send_retainer btn-type-primary" data-message="<%= @exception_request.docusign_retainer_envelope.try(:status) ? "Are you sure you want send this retainer agreement again?" : "Are you sure you want send this retainer agreement?" %>""  data-id="<%= @exception_request.id %>"> <%= @exception_request.docusign_retainer_envelope.try(:status) ? "Re-Send Retainer Agreement" : "Send Retainer Agreement" %> <span class="loader">&nbsp;&nbsp;<i class="fa fa-refresh fa-spin fa-1x fa-fw"></i></span></a>
                      <span class="hide non_panel_send_retainer_status"></span>
                    <%# end %>
                  </div>
                </div>
            <% end %>
            </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
<div class="col-md-12">
    <%- if @exception_request.reviews.size > 0 %>
      <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
        <div class="page-header-sp">
          <div class="page-title">Review Logs</div>
          <div class="back-edit-actions">
        </div>
      </div>
        <div>
          <!-- MAIN PANEL -->
          <div role="main">
            <!-- MAIN CONTENT -->
            <div>
              <!-- row -->
              <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                  <div class="sp-form-bg">
                    <!-- Timeline Content -->
                    <div class="smart-timeline">
                      <ul class="smart-timeline-list">
                        <% @exception_request.reviews.reverse.each do |review| %>
                        <% if review.status_from.blank? && review.status.blank? && review.assigned_to_id.present? %>
                          <li data-id="<%= review.id %>">
                              <div class="smart-timeline-icon">
                                R
                              </div>
                              <div class="smart-timeline-time">
                                <small><%= review.created_at.strftime('%d %b %Y at %I:%M %p') %></small>
                              </div>
                              <div class="smart-timeline-content">
                                <p>
                                  <strong>
                                  <%= review.actor.email %> assigned exception request to internal lawyer for approval.
                                  <strong>
                                </p>
                                <p>
                                  <%= review.description %>
                                </p>
                              </div>
                            </li>
                        <% else %>
                          <li data-id="<%= review.id %>">
                          <div class="smart-timeline-icon">
                            R
                          </div>
                          <div class="smart-timeline-time">
                            <small><%= review.created_at.strftime('%d %b %Y at %I:%M %p') %></small>
                            <small><i><%= time_ago_in_words(review.created_at) %> ago</i> </small>
                          </div>
                          <div class="smart-timeline-content">
                            <p>
                              <strong>
                                <%- if review.status_show %>
                                  <%= review.actor.email %> change status to <%= review.status_show %>
                                <% else %>
                                  <%= review.actor.email %> left a comment
                                <% end %>
                              <strong>
                            </p>
                            <p>
                              <%= review.description.blank? ? "NA" : review.description %>
                            </p>
                          </div>
                        </li>
                          <% end %>
                        <% end %>
                      </ul>
                    </div>
                    <!-- END Timeline Content -->
                  </div>
                </div>
              </div>
              <!-- end row -->
            </div>
            <!-- END MAIN CONTENT -->
          </div>
          <!-- END MAIN PANEL -->
        </div>
      </div>
    <% end %>
  </div>