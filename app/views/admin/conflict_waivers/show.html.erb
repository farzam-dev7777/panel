<style>
  div#gauge * {
  	top: -25px;
  }
</style>
<div class="col-lg-3">
</div>
<div class="col-lg-12">
  <div class="jarviswidget">
    <header>
    </header>
    <!-- widget div-->
    <div>
      <!-- widget edit box -->
      <!-- end widget edit box -->
      <!-- widget content -->
      <div class="widget-body no-padding">
        <!-- widget body text-->
        <div class="tab-content padding-10">
          <div class="tab-pane fade in active">
            <div class="col-md-8">
              <div class="col-md-12">
                <div class="col-md-4 column">Name of law firm	</div>
                <div class="col-md-8 data"><%= @conflict_waiver.name_of_law_firm %></div>
              </div>
              <div class="col-md-12">
                <div class="col-md-4 column">Contact details</div>
                <div class="col-md-8 data"><%= @conflict_waiver.contact_details %></div>
              </div>
              <div class="col-md-12">
                <div class="col-md-4 column">BMO Business contact	</div>
                <div class="col-md-8 data"><%= @conflict_waiver.bmo_business_contact %></div>
              </div>
              <div class="col-md-12">
                <div class="col-md-4 column">Reason for Request	</div>
                <div class="col-md-8 data"><%= @conflict_waiver.reason %></div>
              </div>

							<div class="col-md-12">
                <div class="col-md-4 column">LXP Status</div>
                <div class="col-md-8 data"><%= @conflict_waiver.lxp_status %></div>
              </div>

							<div class="col-md-12">
                <div class="col-md-4 column">Internal Lawyers Status</div>
                <div class="col-md-8 data"><%= @conflict_waiver.internal_lawyers_status %></div>
              </div>

							<div class="col-md-12">
                <div class="col-md-4 column">Waiver Fully Approved</div>
                <div class="col-md-8 data"><%= @conflict_waiver.fully_approved? ? "Yes" : "No" %></div>
              </div>
            </div>
            <div class="clearfix"></div>
          </div>
        </div>
        <div class="clearfix"></div>
        <div class="container">
          <%- if @conflict_waiver.can_user_change_status?(current_user) %>
						<div class="table-responsive">
							<%= simple_form_for [:admin, Review.new()] do |f| %>
								<table class="table table-striped">
									<tbody>
										<tr>
											<td class="text-right" width="20%"><strong>Description</strong></td>
											<td>
												<%= f.input :description, label: false %>
												<%= f.input :reviewable_type, label: false, as: :hidden, input_html: { value: @conflict_waiver.class.to_s } %>
												<%= f.input :reviewable_id, label: false, as: :hidden, input_html: { value: @conflict_waiver.id } %>
											</td>
										
										<tr>
											<td class="text-right" width="20%"><strong>Status</strong></td>
											<td><%= f.input :status, label: false, collection: ConflictWaiver::CONFLICT_WAIVER_STATUS.map{|value,key| [key, value]}%></td>
                    </tr>
                    <tr style="display:none;" class="internal_lawyers_box">
                        <td class="text-right" width="20%"><strong>Assign to</strong></td>
                        <td>
                          <%= f.input :assigned_to_id, label: false, collection: User.where(role: "internal_lawyers").map{|user| [user.email, user.id] } %>
                        </td>
                      </tr>
										<tr>
												<td colspan="2">
													<%= link_to 'Cancel', @conflict_waiver.new_record? ? admin_exception_requests_path : admin_conflict_waiver_path, class: 'btn btn-danger btn-sm' %>
													<%= f.button :submit, @conflict_waiver.new_record? ? "Submit Request" : "Update Status", class: "" %>
												</td>
											</tr>
										</tbody>
									</table>
								<% end %>
							</div>
						<% end %>
          </div>
          <!-- end widget body text-->
        </div>
        <!-- end widget content -->
      </div>
      <!-- end widget div -->
    </div>
    <!-- end widget -->
  </div>

<h1>Reviews</h1>
<% @conflict_waiver.reviews.each do |review| %>
	<p><%= review.actor.email %> added a review <%= review.status %>: <%= review.description %></p>
<% end %>