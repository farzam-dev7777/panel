wb = xlsx_package.workbook

wb.styles do |style|
  project_heading = style.add_style(b: true, sz: 14)
  heading = style.add_style(b: true)

  wb.add_worksheet(name: "conflict waiver") do |sheet|
    # Add a title row
    #sheet.add_row ["conflict waiver List"], style: project_heading
    # Add the date this was downloaded
    #sheet.add_row ["Downloaded at", Time.now.strftime("%b %-d, %Y")]
    # Add a blank row
    #sheet.add_row []
    # Create the header row
    sheet.add_row [
      "Date Submitted", 
      "Name of law firm",
      "Contact details",
      "Internal Contact",
      "Reason for Request",
      "Internal Status",
      "Internal Lawyer Status",
      ], style: heading
    # Create entries for each item
     @conflict_waivers.each do |conflict_waiver|
      sheet.add_row [
        conflict_waiver.created_at.strftime('%d %b %Y at %I:%M %p'),
        conflict_waiver.name_of_law_firm,
        conflict_waiver.contact_details,
        conflict_waiver.bmo_business_contact,
        conflict_waiver.reason,
        conflict_waiver.lxp_status_show,
        conflict_waiver.internal_lawyers_status_show,
        ]
    end
  end
end