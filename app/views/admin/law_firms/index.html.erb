<% content_for :page_title do %>
	<span>Law Firms</span>
<% end %>


<% content_for :page_buttons do %>
	<%= link_to "Add".html_safe, new_admin_law_firm_path, class: "btn btn-primary pull-right" %>
<% end %>

<div class="clearfix"></div>
<div class="col-lg-12">
	<div class="well">
		<div class="row">
			<%= simple_form_for @q, url: :admin_law_firms, method: :get do |f| %>
				<div class="col-md-11">
				  <%= f.input :name_or_email_or_phone_or_description_cont, label: "Search", class: 'form-control' %>
				</div>
				<div class="col-md-1" style="line-height: 75px">
				  <%= f.button :submit, "Search", class: "btn btn-primary" %>
				</div>
			<% end %>
		</div>
	</div>
</div>



<div class="col-lg-12">
	
	<div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
								<!-- widget options:
								usage: <div class="jarviswidget" id="wid-id-0" data-widget-editbutton="false">
				
								data-widget-colorbutton="false"
								data-widget-editbutton="false"
								data-widget-togglebutton="false"
								data-widget-deletebutton="false"
								data-widget-fullscreenbutton="false"
								data-widget-custombutton="false"
								data-widget-collapsed="true"
								data-widget-sortable="false"
				
								-->
								<header>
									<span class="widget-icon"> <i class="fa fa-table"></i> </span>
									<h2>Standard Data Tables </h2>
				
								</header>
				
								<!-- widget div-->
								<div>
				
									<!-- widget edit box -->
									<div class="jarviswidget-editbox">
										<!-- This area used as dropdown edit box -->
				
									</div>
									<!-- end widget edit box -->
				
									<!-- widget content -->
									<div class="widget-body no-padding">
				
										<table id="dt_basic" class="table table-striped table-bordered table-hover" width="100%">
											<thead>			                
												<tr style="background: #007ac3;color: #fff;">
													<th>ID</th>
													<th>Name</th>
													<th>Email</th>
													<th>Phone</th>
													<th>Score</th>
													<th>Certification Status</th>
												</tr>
											</thead>
											<tbody>
												<% @law_firms.each do |firm| %>
													<tr class="law-firm-row" data-id="<%= firm.id %>">
														<td><%= firm.id %></td>
														<td><%= firm.name %></td>
														<td><%= firm.email %></td>
														<td><%= firm.phone %></td>
														<td class="text-center">
															<div> 
																<span class="percent txt-color-blue bold">
																	<b><%= firm.form_submissions.latest.try(:score) || '-' %></b>
																</span> 
															</div>
														</td>
														<td class="text-center">
															<% if !firm.form_submissions.any? %>	
																<%= link_to "Start", begin_certification_process_admin_law_firm_path(firm), class: "btn btn-primary btn-xs" %>	
															<% elsif firm.form_submissions.approved.latest.try(:status) == 'approved' %>	
																<%= link_to "Begin Recertification Process", begin_certification_process_admin_law_firm_path(firm), class: "btn btn-primary btn-xs" %>	
															<% elsif firm.form_submissions.latest.try(:status) == 'sent' %>
																<%= link_to "Waiting for Law Firm", '#', class: "btn btn-primary btn-xs", disabled: true %>		
															<% elsif firm.form_submissions.latest.try(:status) == 'started' %>
																<%= link_to "Started", "#", class: "btn btn-default btn-xs", disabled: true %>
															<% elsif firm.form_submissions.latest.try(:status) == 'submitted' %>
																<%= link_to "Review Submission", policy_step_admin_form_submission_path(firm.form_submissions.latest), class: "btn btn-primary btn-xs" %>	
															<% else %>
																<%= link_to firm.form_submissions.latest.try(:status).try(:humanize) || '-', "#", class: "btn btn-default btn-xs", disabled: true %>
															<% end %>
														</td>
													</tr>
												<% end %>
												
											</tbody>
										</table>

									</div>
									<!-- end widget content -->
				
								</div>
								<!-- end widget div -->
				
							</div>
							<!-- end widget -->

</div>
