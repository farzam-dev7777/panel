<% content_for :page_title do %>
	<span>Law Firms</span>
<% end %>


<div class="col-lg-12">
	<div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
			<div class="page-header-sp m-top">
				<div class="page-title">Law Firms</div>
				<div></div>
  		</div>
			<!-- widget div-->

			<!-- Search Filter -->
				<div class="search-filter-sp">
					<div class="sp-filter">
						<div class="accordion" id="sp-filter">
							<div class="card z-depth-0">
								<div class="card-header" id="headingThree">
									<div class="collapsed filter-title" type="button" data-toggle="collapse" data-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
										<%= image_tag "filter-icon.svg", alt:"score" %>
										<span>Filter</span>
									</div>
								</div>
								<div id="collapseThree" class="col-md-12 collapse sp-filter-fields" aria-labelledby="headingThree" data-parent="#sp-filter">
									<div class="card-body sp-form">
										<%= search_form_for [:admin, @q] do |f| %>
											<div class="row">
												<div class="col-xs-12 col-md-4">
													<%= f.label :name_cont, label: false, :class => 'label' %>
													<%= f.search_field :name_cont, :class => 'sp-form-control' %>
												</div>
												<div class="col-xs-12 text-right">
													<%= f.submit "Search", class: "btn-type-primary input-btn m-right" %>
													<%= f.submit "Reset", type: "reset", value: "Reset",  class: "btn-type-default input-btn" %>
												</div>
											</div>        
										<% end %>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			<!-- Search Filter END -->

			<div>
				<!-- widget content -->
				<div class="table-dyanmic-search table-responsive">
					<table id="dt_basic" class="table table-decoration table-bordered" data-ordering="7" width="100%">
						<thead>			                
							<tr>
								<th>Law Firm Name</th>
								<!--th>Username</th-->
								<th>Relationship Partner Name</th>
								<th>Relationship Partner Email</th>
								<th>Location</th>
								<th>Score</th>
								<th>Onboarded</th>
								<th>Status</th>
								<th width="10%">RFI Status</th>
							</tr>
						</thead>
						<tbody>
							<% @law_firms.each do |firm| %>
								<tr class="law-firm-row" data-order="<%= firm.created_at.strftime('%Y%m%d%I%M') %>" data-id="<%= firm.id %>">
									<td>
										<% if firm.name.present? %>
											<div class="firm-name">
												<div class="name-avatar"><img src="<%= get_avatar_image(firm&.name&.gsub(" ", "+")) %>"></div>
												<div><%= firm.name %></div>
											</div>
										<% end %>	
									</td>
									<td><%= firm.try(:bmo_relationship_partner_name) %></td>
									<td><%= firm.try(:bmo_relationship_partner_email) %></td>
									<td><%= firm.locations.map{|location| [location.city, location.province, firm.country_name(location.country)].reject(&:nil?).join(',') }.join(", ").html_safe %></td>
									<td>
										<div> 
											<span class="percent txt-color-blue bold">
												<% if firm.form_submissions.try(:latest).try(:status) == 'approved' %>
													<% score = firm.total_calculated_score(firm.form_submissions.try(:latest)) %>
													<div class="total-score" data-color="<%= firm.form_submissions.try(:latest).try(:color, score, 'total_calculated_score') %>" data-score=<%= score %>></div>
												<% end %>
											</span> 
										</div>
									</td>
									<td>
										<div class="date-time">
											<%= firm.created_at.strftime(LawFirm::TIME_FORMAT) %>
										</div>
									</td>
									<td>
										<div class="date-time">
											<%= firm.panel_request.try(:lxp_status_show) %>
										</div>
									</td>
									<td>
										<% if firm.form_submissions.any? %>
											<span class="label label-<%= submission_status_class(firm.form_submissions.latest) %>"><%= firm.form_submissions.latest.formatted_status %></span>
											<%=  %>
										<% else %>
											<span class="label label-warning">Onboarded</span>
										<% end %>
									</td>
								</tr>
							<% end %>
						</tbody>
					</table>

				</div>
				<!-- end widget content -->

			</div>
			<!-- end widget div -->

		</div>
		<!-- end widget -->

</div>
