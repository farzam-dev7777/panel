<!-- widget content -->
<% if @law_firm.matter_intakes.blank? %>
  <div class="sp-form sp-form-bg text-center">
    <h4 class="text-center no-submissions">There are no Matters created</h4>
  </div>
<% else %>
  <div class="table-dyanmic-search table-responsive">
    <table id="dt_basic" class="table table-decoration table-bordered" width="100%">
      <thead>
        <tr>
          <th>Matter Number</th>
          <th>Date Submitted</th>
          <th>Submitter By</th>
          <!--<th>LOB Contact Name</th>-->
          <th>Name of Matter/Client</th>
          <!--th>Law Firm Suggested</th-->
          <th>Status</th>
          <!--<th>Action</th>-->
        </tr>
      </thead>
      <tbody>
        <% @law_firm.matter_intakes.each do |matter_intake| %>
          <% if Current.user.role === "lxp"  && matter_intake.status === "matter_not_open" %>
            <tr onClick="window.location.href='/admin/matter_intakes/<%= matter_intake.id %>/review'">
          <% elsif Current.user.role === "internal_lawyers"  && matter_intake.status != "matter_open" && matter_intake.user_id.present? %>
            <tr onClick="window.location.href='/admin/matter_intakes/<%= matter_intake.id %>/review'">
          <% elsif Current.user.role === "lxp" && matter_intake.status === "awaiting_lxp_review" %>
            <tr onClick="window.location.href='/admin/matter_intakes/<%= matter_intake.id %>/lxp_review'">
          <% else %>
            <tr onClick="window.location.href='/admin/matter_intakes/<%= matter_intake.id %>'">
          <% end %>
            <td><%= matter_intake.matter_number.present? ? matter_intake.matter_number : "-" %></td>
            <td data-order="<%= matter_intake.created_at.strftime('%Y%m%d%H%M') %>">
              <%= matter_intake.created_at.strftime('%d %b %Y') %>
            </td>
            <td>
              <% if matter_intake.submitter_name.present? %>
              <div class="firm-name">
                <div class="name-avatar"><img src="<%= get_avatar_image(matter_intake&.submitter_name&.gsub(" ", "+")) %>"></div>
                <div><%= matter_intake.submitter_name %></div>
              </div>
              <% else %>
								-
							<% end %>
            </td>
            <!--<td><%= matter_intake.lob_contact_name %></td>-->
            <td><%= matter_intake.name_of_matter_client %></td>
            <!--td><%= matter_intake.law_firm.try(:name) %></td-->
            <td>
              <div class="status">
                <span class="<%= matter_intake.status === "matter_open" ? 'label label-success' : 'label label-default' %>"> 
                  <%= matter_intake.show_status %>
                </span>
              </div>
            </td>
            <!--<td>
              <% if @current_user.role === "internal_lawyers" && (matter_intake.status === "awaiting_lawyer_review" || matter_intake.status === "awaiting_lawyer_update") %>
                <%= link_to "review", review_admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>	
              <% elsif @current_user.role === "lxp" %>
                <% if matter_intake.status === "awaiting_lxp_review" %>
                  <%= link_to "review", lxp_review_admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>
                <% end %>
              <% end %>
              <%= link_to "view", admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>
            </td>-->
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
<!-- end widget content -->