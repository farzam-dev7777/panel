<div class="col-md-12 no-padding jurisdiction-<%= f.object.try(:id) %>">
	<div class="col-md-6">
		<label>Country</label>
		<%= f.input :country, label: false, collection: LawFirm::JURISDICTION_COUNTRIES, input_html: { class: 'j-country' } %>
	</div>
	<div class="col-md-5 j-states">
		<label>States/Provinces</label>
		<%= f.input :city, label: false, collection: [], input_html: { multiple: true } %>
	</div>
	<div class="col-md-1" style="line-height: 90px;">
		<%= link_to_remove_association "<i class='fa fa-minus-circle fa-2x'></i>".html_safe, f, { wrapper_class: "jurisdiction-#{f.object.try(:id)}" }  %>
	</div>
	<hr>
</div>
