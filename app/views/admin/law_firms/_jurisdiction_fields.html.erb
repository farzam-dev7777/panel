<div class="col-md-12 no-padding jurisdiction-<%= f.object.try(:id) %>">
	<div class="col-md-6">
		<label>Country</label>
		<%= f.input :country, label: false, as: :string %>
	</div>
	<div class="col-md-5">
		<label>City</label>
		<%= f.input :city, label: false %>
	</div>
	<div class="col-md-1" style="line-height: 90px;">
		<%= link_to_remove_association "<i class='fa fa-minus-circle fa-2x'></i>".html_safe, f, { wrapper_class: "jurisdiction-#{f.object.try(:id)}" }  %>
	</div>
	<hr>
</div>
