<% content_for :page_title do %>
	<span>Law Firms</span>
<% end %>


<div class="col-lg-12">
	<div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
			<div class="page-header-sp m-top">
				<div class="page-title">Panel Law Firms</div>
				<div></div>
  		</div>
			<!-- widget div-->

			<!-- Search Filter -->
				<div class="search-filter-sp">
					<div class="sp-filter">
						<div class="accordion" id="sp-filter">
							<div class="card z-depth-0">
								<div class="card-header" id="headingThree">
									<div class="collapsed filter-title" type="button" data-toggle="collapse" data-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
										<%= image_tag "filter-icon.svg", alt:"score" %>
										<span>Filter</span>
									</div>
								</div>
	
								<div id="collapseThree" class="col-md-12 collapse <%= @params_string ? "in" : "" %> sp-filter-fields" aria-labelledby="headingThree" data-parent="#sp-filter">
									<div class="card-body sp-form">

										<%= search_form_for([:admin, @q], url: url_for(controller: 'law_firms', action: 'panel_law_firms') ) do |f| %>

											<div class="row">
												<div class="col-xs-12 col-md-4">
													<%= f.label :matter_intakes_matter_type_id_in, label: false, :class => 'label' %>
													<%= f.input :matter_intakes_matter_type_id_in, label: false, collection: MatterType.all.reject{|mt| mt.matter_type === "Litigation / Litiges"}.map{|mt| [mt.matter_type, mt.id] }, input_html: { multiple: true } %>
												</div>
												<div class="col-xs-12 col-md-4">
													<%= f.label :law_firms_tenants_type_of_matters_your_law_firm_handles_for_us_in, 'Firms with Experience in matters', :class => 'label' %>
													<%= f.input :law_firms_tenants_type_of_matters_your_law_firm_handles_for_us_in, label: false, collection: LawFirm::TYPES_OF_MATTERS_FOR_US, input_html: { multiple: true } %>
												</div>
												<div class="col-xs-12 col-md-4">
													<%= f.label :countries_name_cont, 'Country Name', :class => 'label' %>
  													<%= f.country_select :countries_name_cont, :class => 'sp-form-control', :include_blank => true %>
												</div>
												<div class="col-xs-12 col-md-4">
													<%= f.label :states_name_cont, 'State Name', :class => 'label' %>
  													<%= f.select :states_name_cont, State.all.pluck(:name).uniq, :class => 'sp-form-control', :include_blank => true %>
												</div>
												<div class="col-xs-12 text-right">
													<%= f.submit "Search", class: "btn-type-primary input-btn m-right" %>
													<a href="/admin/law_firms" title="Law Firms" class="btn-type-default input-btn">Reset</a>
												</div>
											</div>        
										<% end %>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			<!-- Search Filter END -->

			<div>
				<!-- widget content -->
				<div class="table-dyanmic-search table-responsive">
					<%= render "/shared/law_firms_list", law_firms: @law_firms, link_base_url: "/admin/law_firms", table_id: "dt_basic", limit: nil %>
					
				</div>
				<!-- end widget content -->

			</div>
			<!-- end widget div -->

		</div>
		<!-- end widget -->

</div>
