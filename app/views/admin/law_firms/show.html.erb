<style>
	div#gauge * {
		top: -25px;
	}
</style>

<div class="col-lg-2 ">
	<%= link_to "<i class='fa fa-long-arrow-left'></i> Back".html_safe, admin_law_firms_path, class: "btn btn-default" %>
	<%= link_to "<i class='fa fa-pencil-square-o'></i> Edit".html_safe, edit_admin_law_firm_path, class: "btn btn-primary m-l-15 no-border" %>
</div>
<div class="col-md-10 text-right law-firm-controls">
	<!-- <div class="col-lg-1 pull-right"> -->
	<!-- </div> -->
<% if (@law_firm.form_submissions.any? && @law_firm.form_submissions.latest.status == 'decertified') %>
	
	<!-- <div class="col-lg-1 pull-right"> -->
		<a class="btn btn-success certify-btn" data-id='<%= @law_firm.id %>' data-name='<%= @law_firm.name %>'>Certify</a>
	<!-- </div> -->

	<div class="clearfix"></div>

	<div class="col-md-12">
		<hr>
		<div class="alert alert-danger">
		  <strong><%= @law_firm.name %></strong> has been decertified. <em>(<%= @law_firm.form_submissions.latest.reason %>)</em>
		</div>
	</div>

<% else %>

<% if(@law_firm.form_submissions.any? && @law_firm.form_submissions.latest.status == 'approved') %>
	<!-- <div class="col-lg-1 pull-right"> -->
		<a class="btn btn-danger decertify-btn pull-right" data-id='<%= @law_firm.id %>' data-name='<%= @law_firm.name %>'>Decertify</a>
	<!-- </div> -->

	<!-- <div class="col-lg-2 pull-right"> -->
		<a class="btn btn-primary pull-right begin-recertification-btn" data-id="<%= @law_firm.id %>">Begin Recertification Process</a>
	<!-- </div> -->
<% end %>

<% if(!@law_firm.form_submissions.any?) %>
	<!-- <div class="col-lg-2 pull-right"> -->
		<a class="btn btn-primary pull-right begin-certification-btn" data-id="<%= @law_firm.id %>">Begin Certification Process</a>
	<!-- </div> -->
<% end %>

<% end %>

</div>

<div class="clearfix"></div>
<p>&nbsp;</p>

<div class="col-lg-12">
	<div class="jarviswidget" id="wid-id-11" data-widget-colorbutton="false" data-widget-colorbutton="false" data-widget-editbutton="false" data-widget-togglebutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false" data-widget-custombutton="false">

		<header>
			<h2><strong><%= @law_firm.name %></strong></h2>	
			
			<ul id="widget-tab-1" class="nav nav-tabs pull-right">

				<li class="active">

					<a data-toggle="tab" href="#hr1"> <i class="fa fa-lg fa-arrow-circle-o-down"></i> <span class="hidden-mobile hidden-tablet"> Law Firm Info </span> </a>

				</li>

				<li>
					<a data-toggle="tab" href="#hr2"> <i class="fa fa-lg fa-arrow-circle-o-up"></i> <span class="hidden-mobile hidden-tablet"> History </span></a>
				</li>

				<li>
					<a data-toggle="tab" href="#hr3"> <i class="fa fa-lg fa-book"></i> <span class="hidden-mobile hidden-tablet"> Submissions </span></a>
				</li>

				<li>
					<a data-toggle="tab" href="#hr4"> <i class="fa fa-lg fa-book"></i> <span class="hidden-mobile hidden-tablet"> Internal Notes </span></a>
				</li>

			</ul>	
			
		</header>

		<!-- widget div-->
		<div>
			
			<!-- widget edit box -->
			<div class="jarviswidget-editbox">
				<!-- This area used as dropdown edit box -->
				
			</div>
			<!-- end widget edit box -->
			
			<!-- widget content -->
			<div class="widget-body no-padding">

				<!-- widget body text-->
				
				<div class="tab-content padding-10">
					<div class="tab-pane fade in active" id="hr1">
						<div class="col-md-8">
							<div class="col-md-4 column">Name</div>		
							<div class="col-md-8 data"><%= !@law_firm.name.blank? ? @law_firm.name : '-' %></div>		

							<div class="col-md-4 column">Description</div>		
							<div class="col-md-8 data"><%= !@law_firm.description.blank? ? @law_firm.description : '-' %></div>		

							<div class="col-md-4 column">Email</div>		
							<div class="col-md-8 data"><%= !@law_firm.email.blank? ? @law_firm.email : '-' %></div>

							<div class="col-md-4 column">Phone</div>		
							<div class="col-md-8 data"><%= !@law_firm.phone.blank? ? @law_firm.phone : '-' %></div>	

							<div class="col-md-4 column">Username</div>		
							<div class="col-md-8 data"><%= !@law_firm.user.try(:username).blank? ? @law_firm.user.try(:username) : '-' %></div>		

							<div class="col-md-4 column">Relationship Manager</div>		
							<div class="col-md-8 data"><%= !@law_firm.try(:relationship_manager_email).blank? ? @law_firm.try(:relationship_manager_email) : '-' %></div>		
						</div>

						<div class="col-lg-4 column text-center">
							<% if @law_firm.user %>
								<%= image_tag @law_firm.user.google_qr_uri %><br/>
								<p>Account: <%= @law_firm.user.username %> </p>
							  <p>Key: <%= @law_firm.user.google_secret %></p>
						  <% end %>
						</div>

						<div class="clearfix"></div>

						<% if(@law_firm.form_submissions.try(:latest).try(:status) == 'approved') %>
							<% latest_form_submission = @law_firm.form_submissions.latest %>

							<div class="score-form">
			          <div class="col-md-12 text-center">
			            <p class="rating-label">TOTAL SCORE (<%= @law_firm.total_calculated_score %>)</p>
			            <div class="readonly-total-score-rating force-center" 
			            		 data-score="<%= @law_firm.total_calculated_score %>"
			            		 data-color="<%= latest_form_submission.try(:color, @law_firm.total_calculated_score, 'total_calculated_score') %>"></div>
			          </div>
							</div>

							<div class="score-form">
			          <div class="col-md-4 text-center">
			            <p class="rating-label">SYSTEM SCORE (<%= latest_form_submission.system_score %>)</p>
			            <p class="rating-label no-margin-bottom">40%</p>
			            <div class="readonly-system-score force-center" 
			            		 data-score=<%= latest_form_submission.system_score %>
			            		 data-color="<%= latest_form_submission.try(:color, latest_form_submission.system_score, 'system_score') %>"></div>
			          </div>
			          <div class="col-md-4 text-center">
			            <p class="rating-label">ASSESSOR SCORE (<%= latest_form_submission.assessor_score %>)</p>
			            <p class="rating-label no-margin-bottom">20%</p>
			            <div class="readonly-assessor-score-rating force-center" 
			            		 data-score="<%= latest_form_submission.assessor_score %>"
			            		 data-color="<%= latest_form_submission.try(:color, latest_form_submission.assessor_score, 'assessor_score') %>"></div>
			          </div>
			          <div class="col-md-4 text-center">
			            <p class="rating-label">RESPONSIVE SCORE (<%= @law_firm.responsiveness_rate %>)</p>
			            <p class="rating-label no-margin-bottom">40%</p>
			            <div class="readonly-responsiveness-score-rating force-center" 
			            		 data-score="<%= @law_firm.responsiveness_rate %>"
			            		 data-color="<%= latest_form_submission.try(:color, @law_firm.responsiveness_rate, 'responsiveness_rate') %>"></div>
			          </div>
				      </div>
			      <% end %>

					</div>
					<div class="tab-pane fade" id="hr2">
						

						<%= link_to "<i class='fa fa-download'></i>".html_safe, activity_logs_admin_pdf_index_path(id: @law_firm.id), method: :get, params: { id: @law_firm.id }, class: 'btn btn-success btn-xs pull-right' %>

						<div class="clearfix"></div>
						<section id="cd-timeline" class="cd-container">

							<%- @law_firm.activity_logs.reverse.each do |activity| %>
								<div class="cd-timeline-block">
									<div class="cd-timeline-img cd-picture">
										<i class="fa fa-edit fa-2x timeline-icon"></i>
									</div>

									<div class="cd-timeline-content">
										<h2>
											<strong><%= activity.event_type.titleize %></strong>
										</h2>
										<p><%= activity.custom_message %></p>
										<span class="cd-date"><%= activity.created_at.strftime('%d %b') %></span>
									</div>
								</div>
							<%- end %>

						</section> <!-- cd-timeline -->
						
					</div>

					<div class="tab-pane fade" id="hr3">

						<div class="col-lg-12">

								<% if @law_firm.form_submissions.any? %>
							<div class="table-responsive">
								<table class="table table-bordered text-center content-in-jarvis">

									<tr>
										<th class="text-center">Law Firm</th>
										<th class="text-center">Score</th>
										<th class="text-center">Status</th>
										<th class="text-center">Action</th>
									</tr>

									<% @law_firm.form_submissions.each do |submission| %>
										<tr>
											<td><%= submission.law_firm.name %></td>
											<td><%= submission.total_score || '-' %></td>
											<td class="text-center">
											<span class="label label-<%= submission_status_class(submission) %>">
												<%= submission.try(:status).titleize %>
												<% if submission.try(:status) == 'decertified' %>	
													<br><em><%= submission.try(:reason) %></em>
												<% end %>
											</span>
											</td>
											<td>
												<% if submission.try(:status) == 'approved' %>	
													<%= link_to "Begin Recertification Process", begin_recertification_process_admin_law_firm_path(submission.law_firm), class: "btn btn-primary btn-xs" %>	

													<a class="btn btn-default btn-xs extend-expiry">Extend Expiry Date</a>
													<form id="extend-expiry-form" class="text-center" style="margin-top: 20px; height: 75px;" method="POST" action="">
														<div class="col-md-offset-3 no-padding col-md-6 text-center">
															<div class="col-md-9">
																<label>Expiry Date</label>
																<input type="hidden" value="<%= submission.id %>" name="id"></input>
																<input type="text" class="datepicker" name="expiry_date" value="<%= submission.expiry_date %>">
															</div>
															<div class="col-md-3" style="line-height: 75px;">
																<input type="Submit" class="btn btn-primary">
															</div>
														</div>
													</form>

												<% elsif submission.try(:status) == 'sent' %>
													<%= link_to "Waiting for Law Firm", '#', class: "btn btn-primary btn-xs", disabled: true %>		
												<% elsif submission.try(:status) == 'started' %>
													<%= link_to "Started", "#", class: "btn btn-default btn-xs", disabled: true %>
												<% elsif submission.try(:status) == 'submitted' %>
													<%= link_to "Review Submission", policy_step_admin_form_submission_path(submission), class: "btn btn-primary btn-xs" %>	
												<% else %>
													<%= link_to submission.try(:status).try(:humanize) || '-', "#", class: "btn btn-default btn-xs", disabled: true %>
												<% end %>


											</td>
										</tr>
										
									<% end %>

								</table>
								<div class="clearfix"></div>


							</div>
							<% else %>
								<h4 class="text-center">There are no submissions to review yet</h4>
							<% end %>
						</div>


						
					</div>


					<div class="tab-pane fade" id="hr4">

						<div>

							<div class="container bootstrap snippet">
						    <div class="row">
						    	<ul class="internal-notes">
			            	<% @law_firm.internal_notes.reverse.each do |note| %>
					            <%= render partial: 'internal_note', locals: {note: note} %>
				            <% end %> 
								</ul>  
							</div>
						</div>
								
						</div>
						<form id="internal-note-form" action="#" method="POST">
							<div class="col-md-11 no-padding">
								<input type="hidden" name="id" value="<%= @law_firm.id %>">
								<textarea id="new-note" placeholder="Add your message here." name="message"></textarea>
							</div>
							<div class="col-md-1 no-padding">
								<input type="submit" class="btn btn-primary" value="Add">
							</div>
						</form>
					</div>



				</div>
				
				<!-- end widget body text-->
				
			</div>
			<!-- end widget content -->
			
		</div>
		<!-- end widget div -->
		
	</div>
	<!-- end widget -->			
</div>

<div class="col-lg-8">
	
</div>