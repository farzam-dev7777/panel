<style>
	div#gauge * {
		top: -25px;
	}
</style>

<div class="col-lg-1">
	<%= link_to "<i class='fa fa-long-arrow-left'></i> Back".html_safe, admin_law_firms_path, class: "btn btn-default" %>
</div>
<div class="col-md-11 text-right">
	<div class="col-lg-1 pull-right">
		<%= link_to "<i class='fa fa-pencil-square-o'></i> Edit".html_safe, edit_admin_law_firm_path, class: "btn btn-primary" %>
	</div>
<% if (@law_firm.form_submissions.any? && @law_firm.form_submissions.latest.status == 'decertified') %>
	
	<div class="col-lg-1 pull-right">
		<a class="btn btn-success certify-btn" data-id='<%= @law_firm.id %>' data-name='<%= @law_firm.name %>'>Certify</a>
	</div>

	<div class="clearfix"></div>

	<div class="col-md-12">
		<hr>
		<div class="alert alert-danger">
		  <strong><%= @law_firm.name %></strong> has been decertified. <em>(<%= @law_firm.form_submissions.latest.reason %>)</em>
		</div>
	</div>

<% else %>

<% if(@law_firm.form_submissions.any? && @law_firm.form_submissions.latest.status == 'approved') %>
	<div class="col-lg-1 pull-right">
		<a class="btn btn-danger decertify-btn pull-right" data-id='<%= @law_firm.id %>' data-name='<%= @law_firm.name %>'>Decertify</a>
	</div>

	<div class="col-lg-2 pull-right">
		<%= link_to "Begin Recertification Process", begin_recertification_process_admin_law_firm_path(@law_firm), class: "btn btn-primary pull-right" %>
	</div>
<% end %>

<% if(!@law_firm.form_submissions.any?) %>
	<div class="col-lg-2 pull-right">
		<%= link_to "Begin Certification Process", begin_certification_process_admin_law_firm_path(@law_firm), class: "btn btn-primary pull-right" %>
	</div>
<% end %>

<% end %>

</div>

<div class="clearfix"></div>
<p>&nbsp;</p>

<div class="col-lg-12">
	<div class="jarviswidget" id="wid-id-11" data-widget-colorbutton="false" data-widget-colorbutton="false" data-widget-editbutton="false" data-widget-togglebutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false" data-widget-custombutton="false">

		<header>
			<h2><strong><%= @law_firm.name %></strong></h2>	
			
			<ul id="widget-tab-1" class="nav nav-tabs pull-right">

				<li class="active">

					<a data-toggle="tab" href="#hr1"> <i class="fa fa-lg fa-arrow-circle-o-down"></i> <span class="hidden-mobile hidden-tablet"> Law Firm Info </span> </a>

				</li>

				<li>
					<a data-toggle="tab" href="#hr2"> <i class="fa fa-lg fa-arrow-circle-o-up"></i> <span class="hidden-mobile hidden-tablet"> History </span></a>
				</li>

				<li>
					<a data-toggle="tab" href="#hr3"> <i class="fa fa-lg fa-book"></i> <span class="hidden-mobile hidden-tablet"> Submissions </span></a>
				</li>

				<li>
					<a data-toggle="tab" href="#hr4"> <i class="fa fa-lg fa-book"></i> <span class="hidden-mobile hidden-tablet"> Internal Notes </span></a>
				</li>

			</ul>	
			
		</header>

		<!-- widget div-->
		<div>
			
			<!-- widget edit box -->
			<div class="jarviswidget-editbox">
				<!-- This area used as dropdown edit box -->
				
			</div>
			<!-- end widget edit box -->
			
			<!-- widget content -->
			<div class="widget-body no-padding">

				<!-- widget body text-->
				
				<div class="tab-content padding-10">
					<div class="tab-pane fade in active" id="hr1">
						<div class="col-md-8">
							<div class="col-md-4 column">Name</div>		
							<div class="col-md-8 data"><%= @law_firm.name %></div>		

							<div class="col-md-4 column">Description</div>		
							<div class="col-md-8 data"><%= @law_firm.description %></div>		

							<div class="col-md-4 column">Email</div>		
							<div class="col-md-8 data"><%= @law_firm.email %></div>

							<div class="col-md-4 column">Phone</div>		
							<div class="col-md-8 data"><%= @law_firm.phone %></div>	

							<div class="col-md-4 column">Username</div>		
							<div class="col-md-8 data"><%= @law_firm.user.try(:username) %></div>	
						</div>
						<div class="col-md-4">
							<div id="gauge" style="position: relative; height: 128px;" class="200x160px"></div>
						</div>
						<div class="clearfix"></div>
					</div>
					<div class="tab-pane fade" id="hr2">
						
						<section id="cd-timeline" class="cd-container">

							<%- @law_firm.activity_logs.reverse.each do |activity| %>
								<div class="cd-timeline-block">
									<div class="cd-timeline-img cd-picture">
										<i class="fa fa-edit fa-2x timeline-icon"></i>
									</div>

									<div class="cd-timeline-content">
										<h2>
											<strong><%= activity.event_type.titleize %></strong>
										</h2>
										<p><%= activity.custom_message %></p>
										<span class="cd-date"><%= activity.created_at.strftime('%d %b') %></span>
									</div>
								</div>
							<%- end %>

						</section> <!-- cd-timeline -->
						
					</div>

					<div class="tab-pane fade" id="hr3">

						<div class="col-lg-12">

								<% if @law_firm.form_submissions.any? %>
							<div class="table-responsive">
								<table class="table table-bordered text-center content-in-jarvis">

									<tr>
										<th class="text-center">Law Firm</th>
										<th class="text-center">Score</th>
										<th class="text-center">Status</th>
										<th class="text-center">Action</th>
									</tr>

									<% @law_firm.form_submissions.each do |submission| %>
										<tr>
											<td><%= submission.law_firm.name %></td>
											<td><%= submission.total_score || '-' %></td>
											<td class="text-center">
											<span class="label label-<%= submission_status_class(submission) %>"><%= submission.try(:status).titleize %></span>
											</td>
											<td>
												<% if submission.try(:status) == 'approved' %>	
													<%= link_to "Begin Recertification Process", begin_recertification_process_admin_law_firm_path(submission.law_firm), class: "btn btn-primary btn-xs" %>	
												<% elsif submission.try(:status) == 'sent' %>
													<%= link_to "Waiting for Law Firm", '#', class: "btn btn-primary btn-xs", disabled: true %>		
												<% elsif submission.try(:status) == 'started' %>
													<%= link_to "Started", "#", class: "btn btn-default btn-xs", disabled: true %>
												<% elsif submission.try(:status) == 'submitted' %>
													<%= link_to "Review Submission", policy_step_admin_form_submission_path(submission), class: "btn btn-primary btn-xs" %>	
												<% else %>
													<%= link_to submission.try(:status).try(:humanize) || '-', "#", class: "btn btn-default btn-xs", disabled: true %>
												<% end %>
											</td>
										</tr>
										
									<% end %>

								</table>
								<div class="clearfix"></div>


							</div>
							<% else %>
								<h4 class="text-center">There are no submissions to review yet</h4>
							<% end %>
						</div>


						
					</div>


					<div class="tab-pane fade" id="hr4">

						<div>

							<div class="container bootstrap snippet">
						    <div class="row">
						    	<ul class="internal-notes">
			            	<% @law_firm.internal_notes.reverse.each do |note| %>
					            <%= render partial: 'internal_note', locals: {note: note} %>
				            <% end %> 
								</ul>  
							</div>
						</div>
								
						</div>
						<form id="internal-note-form" action="#" method="POST">
							<div class="col-md-11 no-padding">
								<input type="hidden" name="id" value="<%= @law_firm.id %>">
								<textarea id="new-note" placeholder="Add your message here." name="message"></textarea>
							</div>
							<div class="col-md-1 no-padding">
								<input type="submit" class="btn btn-primary" value="Add">
							</div>
						</form>
					</div>



				</div>
				
				<!-- end widget body text-->
				
			</div>
			<!-- end widget content -->
			
		</div>
		<!-- end widget div -->
		
	</div>
	<!-- end widget -->			
</div>

<div class="col-lg-8">
	
</div>