<style>
	div#gauge * {
		top: -25px;
	}
</style>


<div class="col-lg-12">
	<div class="page-header-sp m-top">
		<div class="page-title"><%= @law_firm.name %></div>
		<div class="back-edit-actions">
			<a class="btn-type-default" href="/admin/law_firms">
				<%= image_tag "chevron-back-icon.svg", alt:"Back" %>
			</a>
			<%= link_to "Edit".html_safe, edit_admin_law_firm_path, class: "btn-type-primary" %>
		</div>
	</div>
	<!-- Page Header -->
	<div class="page-header-sp m-top">
		<div class="page-title"></div>
		<div class="back-edit-actions mobile-action-btn">
			<% if (@law_firm.form_submissions.any? && @law_firm.form_submissions.latest.status == 'decertified') %>
				<a class="btn-type-primary" data-id='<%= @law_firm.id %>' data-name='<%= @law_firm.name %>'>Recertify</a>
				<div class="">
					<hr>
					<div class="alert alert-danger">
						<strong><%= @law_firm.name %></strong> has been decertified. <em>(<%= @law_firm.form_submissions.latest.reason %>)</em>
					</div>
				</div>
			<% else %>
			<% if(@law_firm.form_submissions.any? && @law_firm.form_submissions.latest.status == 'approved') %>
				<a class="btn-type-primary" data-id='<%= @law_firm.id %>' data-name='<%= @law_firm.name %>'>Decertify</a>
				<a class="btn-type-primary begin-recertification-btn" data-id="<%= @law_firm.id %>">Send RFI Questionnaire again</a>
			<% end %>
			<% if(!@law_firm.form_submissions.any?) %>
				<% if(@law_firm.user.try(:is_deactivated?)) %>
					<a class="btn-type-primary send-user-info-btn" data-id="<%= @law_firm.user.id %>">Send user information and create new password link </a>
					<a class="btn-type-primary send-user-info-begin-certification-btn" data-id="<%= @law_firm.user.id %>">Send RFI Questionnaire with user active password link </a>
					<% else %>	
					<a class="btn-type-primary begin-certification-btn" data-id="<%= @law_firm.id %>">Send RFI Questionnaire</a>
					<% end %>	
			<% end %>

			<% end %>
		</div>
	</div>
	<!-- Page Header END -->
	<div class="" id="wid-id-11" data-widget-colorbutton="false" data-widget-colorbutton="false" data-widget-editbutton="false" data-widget-togglebutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false" data-widget-custombutton="false">
		<div class="sp-tab-block">
			<div class="ui-widget-content">
			<ul id="widget-tab-1" class="sp-tabs-nav dashboard-tab nav nav-tabs ui-tabs-nav">
				<li class="active">
					<a data-toggle="tab" href="#hr1">Law Firm Info</a>
				</li>
				<!-- <li>
					<a data-toggle="tab" href="#hr2"> <i class="fa fa-lg fa-arrow-circle-o-up"></i> <span class="hidden-mobile hidden-tablet"> History </span></a>
				</li> -->
				<li>
					<a data-toggle="tab" href="#hr3">RFI</a>
				</li>
				<!-- 
				<li>
					<a data-toggle="tab" href="#hrst"> <i class="fa fa-lg fa-lock"></i> <span class="hidden-mobile hidden-tablet"> Security Threats </span></a>
				</li>
				<li>
					<a data-toggle="tab" href="#hr4"> <i class="fa fa-lg fa-sticky-note-o"></i> <span class="hidden-mobile hidden-tablet"> Internal Notes </span></a>
				</li> -->
				<li>
					<a data-toggle="tab" href="#hr5">Exception Requests</a>
				</li>
				<li>
					<a data-toggle="tab" href="#hr6">Conflict Waiver</a>
				</li>
				<li>
					<a data-toggle="tab" href="#hr7">Panel Request</a>
				</li>
			</ul>	
			</div>
		</div>

		<!-- widget div-->
		<div>
			<!-- widget content -->
			<div class="">
				<!-- widget body text-->
				<div class="tab-content">
					<div class="tab-pane fade in active" id="hr1">
						<div class="sp-form-bg show-data-fields">
							<div class="row send-password-link">
								<div class="col-md-12">
									<% if @law_firm.user.try(:id)%>
										<a class="btn-type-primary send-user-info-btn" data-id="<%= @law_firm.user.id %>">Send new password link </a>
									<% end %>
									<% if(@law_firm.form_submissions.try(:latest).try(:status) == 'approved') %>
										<% latest_form_submission = @law_firm.form_submissions.latest %>
										<div class="score-form">
											<div class="col-md-12 text-center">
												<p class="rating-label">TOTAL SCORE (<%= @law_firm.total_calculated_score %>)</p>
												<div class="readonly-total-score-rating force-center" 
														data-score="<%= @law_firm.total_calculated_score %>"
														data-color="<%= latest_form_submission.try(:color, @law_firm.total_calculated_score, 'total_calculated_score') %>"></div>
											</div>
										</div>
										<div class="score-form">
											<div class="col-md-4 text-center">
												<p class="rating-label">SYSTEM SCORE (<%= latest_form_submission.system_score %>)</p>
												<p class="rating-label no-margin-bottom">40%</p>
												<div class="readonly-system-score force-center" 
														data-score=<%= latest_form_submission.system_score %>
														data-color="<%= latest_form_submission.try(:color, latest_form_submission.system_score, 'system_score') %>"></div>
											</div>
											<div class="col-md-4 text-center">
												<p class="rating-label">ASSESSOR SCORE (<%= latest_form_submission.assessor_score %>)</p>
												<p class="rating-label no-margin-bottom">20%</p>
												<div class="readonly-assessor-score-rating force-center" 
														data-score="<%= latest_form_submission.assessor_score %>"
														data-color="<%= latest_form_submission.try(:color, latest_form_submission.assessor_score, 'assessor_score') %>"></div>
											</div>
											<div class="col-md-4 text-center">
												<p class="rating-label">RESPONSIVE SCORE (<%= @law_firm.responsiveness_rate %>)</p>
												<p class="rating-label no-margin-bottom">40%</p>
												<div class="readonly-responsiveness-score-rating force-center" 
														data-score="<%= @law_firm.responsiveness_rate %>"
														data-color="<%= latest_form_submission.try(:color, @law_firm.responsiveness_rate, 'responsiveness_rate') %>"></div>
											</div>
										</div>
									<% end %>
								</div>
							</div>
							<div class="row">
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Law Firm Name </div>
									<div class="field-data"><%= @law_firm.name %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Username</div>
									<div class="field-data"><%= !@law_firm.user.try(:username).blank? ? @law_firm.users.first.try(:username) : '-' %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Email </div>
									<div class="field-data"><%= !@law_firm.user.try(:email).blank? ? @law_firm.users.first.try(:email) : '-' %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Phone </div>
									<div class="field-data"><%= @law_firm.phone %></div>
								</div>
								<div class="col-xs-12 col-md-12">
									<div class="field-label">Description </div>
									<div class="field-data"><%= @law_firm.description %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Relationship Manager Name	</div>
									<div class="field-data"><%= @law_firm.relationship_manager_name %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Relationship Manager Email </div>
									<div class="field-data"><%= @law_firm.relationship_manager_email %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Relationship Manager Phone </div>
									<div class="field-data"><%= @law_firm.relationship_manager_phone %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Initial Date of Engagement with BMO</div>		
									<div class="field-data"><%= @law_firm.initial_date_of_engagement_with_the_bank && @law_firm.initial_date_of_engagement_with_the_bank.in_time_zone('Eastern Time (US & Canada)').strftime(LawFirm::DATE_FORMAT) %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Types of matters your law firm has handled for us to date</div>		
									<div class="field-data"><%= @law_firm.type_of_matters_your_law_firm_handles_for_us.reject(&:blank?).join(", ") %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">No. of personnel</div>		
									<div class="field-data"><%= @law_firm.number_of_lawyers %></div>
								</div>
								<div class="col-xs-12 col-md-6">
								<label class="field-label">Secondary RM Contact</label>
									<div class="field-data"><%= @law_firm.secondary_rm_contact %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Secondary RM Contact Email</label>
									<div class="field-data"><%= @law_firm.secondary_rm_contact_email %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Billing Contact Name</label>
									<div class="field-data"><%= @law_firm.billing_contact_name %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Billing Contact Email</label>
									<div class="field-data"><%= @law_firm.billing_contact_email %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Information Security Contact</label>
									<div class="field-data"><%= @law_firm.information_security_contact %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Information Security Contact Email</label>
									<div class="field-data"><%= @law_firm.information_security_contact_email %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Diverse</label>
									<div class="field-data"><%= @law_firm.diverse %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Value-Add Activities</label>
									<div class="field-data"><%= @law_firm.value_add_activities %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Feedback</label>
									<div class="field-data"><%= @law_firm.feedback %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Issues</label>
									<div class="field-data"><%= @law_firm.issues %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Merger/Combination</label>
									<div class="field-data"><%= @law_firm.merger_combination  %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Engagement Number</label>
									<div class="field-data"><%= @law_firm.engagement_number  %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Relationship Number</label>
									<div class="field-data"><%= @law_firm.relationship_number %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Information Security Class</label>
									<div class="field-data"><%= @law_firm.information_security_class %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Information Security Assessment Outcome</label>
									<div class="field-data"><%= @law_firm.information_security_assessment_outcome %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Action Plan Findings</label>
									<div class="field-data"><%= @law_firm.action_plan_findings %> </div>
								</div>
								<div class="col-xs-12 col-md-6">
									<label class="field-label">Action Plan Status</label>
									<div class="field-data"><%= @law_firm.action_plan_status  %> </div>
								</div>

								<div class="col-xs-12 col-md-6">
									<div class="field-label">Locations</div>		
									<div class="field-data"><%= @law_firm.locations.map{|location| [location.city, location.province, location.country].reject(&:nil?).join(',') }.join("<br />").html_safe %></div>
								</div>
							</div>
						</div>
						
					</div>
					<div class="tab-pane fade" id="hr2">
						<div class="sp-form-bg show-data-fields">
							<%= link_to "<i class='fa fa-download'></i>".html_safe, activity_logs_admin_pdf_index_path(id: @law_firm.id), method: :get, params: { id: @law_firm.id }, class: 'btn btn-success btn-xs pull-right' %>
							<div class="row send-password-link">
								<div class="col-md-12">
									<section id="cd-timeline" class="cd-container">

										<%- @law_firm.activity_logs.reverse.each do |activity| %>
											<div class="cd-timeline-block">
												<div class="cd-timeline-img cd-picture">
													<i class="fa fa-edit fa-2x timeline-icon"></i>
												</div>

												<div class="cd-timeline-content">
													<h2>
														<strong class="<%= activity_source_class(activity) %>"><%= activity.custom_message || activity.event_type.try(:titleize) %></strong>
													</h2>
													<em>(<%= activity.source == 'AdminUser' ? 'Bank' : 'Law Firm' %>)</em>
													<span class="cd-date"><%= activity.created_at.strftime('%d %b at %I:%M %p') %></span>
												</div>
											</div>
										<%- end %>

									</section> <!-- cd-timeline -->
								</div>
							</div>
						</div>
					</div>
					<div class="tab-pane fade" id="hr3">
						<div class="">
							<% if @law_firm.form_submissions.any? %>
								<div class="table-responsive">
									<table class="table table-decoration table-bordered">
										<thead>
											<tr>
												<th>Score</th>
												<th>Status</th>
												<th>Approved At</th>
												<th>Expiry Date</th>
												<th>Submission</th>
												<th width="8%">Action</th>
											</tr>
										</thead>
										<% @law_firm.form_submissions.each do |submission| %>
										<tr>
											<td><%= @law_firm.total_calculated_score(submission) || '-' %></td>
											<td>
												<span class="label label-<%= submission_status_class(submission) %>">
													<%= submission.formatted_status %>
												</span>
												<% if submission.try(:status) == 'decertified' %>	
													<br><em><%= submission.try(:reason) %></em>
												<% end %>
											</td>
											<td>
												<%= submission.approved_at %>
											</td>
											<td class="text-center">
												<%= submission.expiry_date %>
											</td>
											<td>
												<% if submission.try(:status) == 'approved' %>	
													<% #link_to "Begin Recertification Process", begin_recertification_process_admin_law_firm_path(submission.law_firm), class: "btn btn-primary btn-xs" %>	

													<%= submission.expiry_date %>
													<a class="btn btn-default btn-xs extend-expiry">Extend Expiry Date</a>
													<form id="extend-expiry-form" class="text-center" style="margin-top: 20px; height: 75px;" method="POST" action="">
														<div class="col-md-offset-3 no-padding col-md-6 text-center">
															<div class="col-md-9">
																<label>Expiry Date</label>
																<input type="hidden" value="<%= submission.id %>" name="id"></input>
																<input type="text" class="datepicker" name="expiry_date" value="<%= submission.expiry_date %>">
															</div>
															<div class="col-md-3" style="line-height: 75px;">
																<input type="Submit" class="btn btn-sm btn-primary">
															</div>
														</div>
													</form>

												<% elsif submission.try(:status) == 'sent' %>
													<%= link_to "Waiting for Law Firm", '#', class: "btn btn-primary btn-xs", disabled: true %>		
												<% elsif submission.try(:status) == 'started' %>
													<%= link_to "Started", "#", class: "btn btn-default btn-xs", disabled: true %>
												<% elsif submission.try(:status) == 'submitted' %>
													<%= link_to "Review Submission", pricing_step_admin_form_submission_path(submission), class: "btn btn-primary btn-xs" %>	
												<% else %>
													<%= link_to submission.try(:status).try(:humanize) || '-', "#", class: "btn btn-default btn-xs", disabled: true %>
												<% end %>


											</td>
											<td>
												<% link_to "View Submission", pricing_step_admin_form_submission_path(submission), class: "btn btn-outline-primary btn-xs" %>
												<div class="action-fields">
													<a class="action-btn" href="/admin/form_submissions/<%= submission.id %>/pricing_step">
														<%= image_tag "view-icon.svg", alt:"View" %>
													</a>
												</div>	
											</td>
										</tr>
										<% end %>
									</table>
									<div class="clearfix"></div>
								</div>
								<% else %>
								<h4 class="text-center no-submissions">There are no submissions to review yet</h4>
							<% end %>
						</div>
					</div>
					<div class="tab-pane fade" id="hrst">
						<div class="clearfix"></div>
						<div class="col-lg-12">
							<div>
								<!-- widget edit box -->
								<div class="jarviswidget-editbox">
									<div>
										<label>Title:</label>
										<input type="text" />
									</div>
								</div>
								<!-- end widget edit box -->

								<% if @law_firm.action_items.any? %>
								<div class="widget-body no-padding smart-form" style="margin-top: 5px !important">
									<!-- content goes here -->
									
									<% if (@law_firm.action_items.select{|a| a.status != 'complete' && a.security_threat.severity_level.name == 'critical'}).count > 0 %>
										<h5 class="todo-group-title"><i class="fa fa-warning"></i> Critical</h5>
									<% end %>
									<% @law_firm.action_items.select{|a| a.status != 'complete' && a.security_threat.severity_level.name == 'critical'}.each do |item| %>
										<%= render partial: 'dashboard/action_item', locals: { item: item, active: false } %>
									<% end %>

									<% if (@law_firm.action_items.select{|a| a.status != 'complete' && a.security_threat.severity_level.name == 'high'}).count > 0 %>
										<h5 class="todo-group-title"><i class="fa fa-warning"></i> High</h5>
									<% end %>
									<% @law_firm.action_items.select{|a| a.status != 'complete' && a.security_threat.severity_level.name == 'high'}.each do |item| %>
										<%= render partial: 'dashboard/action_item', locals: { item: item, active: false } %>
									<% end %>

									<% if (@law_firm.action_items.select{|a| a.status != 'complete' && a.security_threat.severity_level.name == 'low'}).count > 0 %>
										<h5 class="todo-group-title"><i class="fa fa-warning"></i> Low</h5>
									<% end %>
									<% @law_firm.action_items.select{|a| a.status != 'complete' && a.security_threat.severity_level.name == 'low'}.each do |item| %>
										<%= render partial: 'dashboard/action_item', locals: { item: item, active: false } %>
									<% end %>



									<h5 class="todo-group-title"><i class="fa fa-check"></i> Completed Tasks</h5>
									<ul id="sortable3" class="todo">
										<% @law_firm.action_items.select{|a| a.status == 'complete'}.each do |item| %>
										<li class="complete">
											<span class="handle" style="display:none"> <label class="checkbox state-disabled">
												<input type="checkbox" name="checkbox-inline" checked="checked" disabled="disabled">
												<i></i> </label> </span>
												<p>
													<strong><%= item.security_threat.title %></strong> [<%= link_to "More Details", action_item_path(item), :class => "", :remote => true, "data-toggle" => "modal", "data-target" => "securityAlert" %>] <span class="text-muted"><%= item.security_threat.description %> </span>
													<span class="date"><%= time_ago_in_words(item.created_at) %></span>
												</p>
											</li>
											<% end %>
										</ul>

										<!-- end content -->
									</div>


									<% else %>
										<em class="text-center"> There are no security threats </em>
									<% end %>

								</div>
						</div>
					</div>
					<div class="tab-pane fade" id="hr4">

						<div>

							<div class="container bootstrap snippet">
						    <div class="row">
						    	<ul class="internal-notes">
			            	<% @law_firm.internal_notes.reverse.each do |note| %>
					            <%= render partial: 'internal_note', locals: {note: note} %>
				            <% end %> 
								</ul>  
							</div>
						</div>
								
						</div>
						<form id="internal-note-form" action="#" method="POST">
							<div class="col-md-10 no-padding">
								<input type="hidden" name="id" value="<%= @law_firm.id %>">
								<textarea id="new-note" placeholder="Add your message here." name="message"></textarea>
							</div>
							<div class="col-md-2 no-padding">
								<input type="submit" class="btn btn-sm btn-primary" value="Add">
							</div>
						</form>
					</div>
					<div class="tab-pane fade" id="hr5">
						<div class="">
							<% if @law_firm.exception_requests.count > 0 %>
							<div class="table-responsive">
								<table class="table table-decoration table-bordered content-in-jarvis">
									<thead>
									<tr>
										<th>Request By</th>
										<th>Submitted By	</th>
										<th>LXP Status</th>
										<th>Internal Lawyer Status</th>
										<th>Pay Type</th>
										<th>Document Status</th>
										<th width="8%">Action</th>
									</tr>
									</thead>
									<% @law_firm.exception_requests.each do |exception_request| %>
									<tr>
										<td><%= exception_request.requested_by %></td>
										<td><%= exception_request.submitted_by_email %></td>
										<td><%= exception_request.lxp_status_show %></td>
										<td><%= exception_request.internal_lawyers_status_show %></td>
										<td>
											<% if exception_request.docusign_envelope_id.present? %>
