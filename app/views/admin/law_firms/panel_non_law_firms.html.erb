<% content_for :page_title do %>
	<span>Law Firms</span>
<% end %>


<div class="col-lg-12">
	<div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
			<div class="page-header-sp m-top">
				<div class="page-title">Non Panel Law Firms</div>
				<div></div>
  		</div>
			<!-- widget div-->

			<!-- Search Filter -->
				<div class="search-filter-sp">
					<div class="sp-filter">
						<div class="accordion" id="sp-filter">
							<div class="card z-depth-0">
								<div class="card-header" id="headingThree">
									<div class="collapsed filter-title" type="button" data-toggle="collapse" data-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
										<%= image_tag "filter-icon.svg", alt:"score" %>
										<span>Filter</span>
									</div>
								</div>
	
								<div id="collapseThree" class="col-md-12 collapse <%= @params_string ? "in" : "" %> sp-filter-fields" aria-labelledby="headingThree" data-parent="#sp-filter">
									<div class="card-body sp-form">
										<%= search_form_for([:admin, @q], url: url_for(controller: 'law_firms', action: 'panel_law_firms') ) do |f| %>
											<div class="row">
												<div class="col-xs-12 col-md-4">
													<%= f.label :name_cont, label: false, :class => 'label' %>
													<%= f.search_field :name_cont, :class => 'sp-form-control' %>
												</div>
												<div class="col-xs-12 col-md-4">
												<%= f.label :locations_country_cont %>
  											<%= f.country_select :locations_country_cont, :class => 'sp-form-control', :include_blank => true %>
													</div>
												<div class="col-xs-12 col-md-4">
													<%= f.label :panel_status_cont, label: false, :class => 'label' %>
													<%#= f.search_field :panel_status_eq, :class => 'sp-form-control' %>
													<%= f.select :panel_status_eq, options_from_collection_for_select(LawFirm::PANEL_REQUEST_STATUS, "to_s", "to_s", @q.panel_status_eq), {:include_blank => true}, :class => 'sp-form-control' %>
												</div>
												<div class="col-xs-12 text-right">
													<%= f.submit "Search", class: "btn-type-primary input-btn m-right" %>
													<a href="/admin/law_firms" title="Law Firms" class="btn-type-default input-btn">Reset</a>
												</div>
											</div>        
										<% end %>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			<!-- Search Filter END -->

			<div>
				<!-- widget content -->
				<div class="table-dyanmic-search table-responsive">
					<table id="dt_basic" class="table table-decoration table-bordered"  width="100%">
						<thead>			                
							<tr>
							<th>Date Submitted</th>
								<th>Law Firm Name</th>
								<!--th>Username</th-->
								<th>Province</th>
								<th>Country</th>
								<th>Minority/Women</th>
								<th>Owned Email/Phone</th>
							</tr>
						</thead>
						<tbody>
							<% @law_firms.each do |firm| %>
								
								<tr class="law-firm-row" data-id="<%= firm.id %>">
								<td data-order="<%= firm.created_at.strftime('%Y%m%d%H%M') %>"><%= firm.created_at.strftime('%d %b %Y at %I:%M %p') %></td>
									<td>
										<% if firm.name.present? %>
											<div class="firm-name">
												<div class="name-avatar"><img src="<%= get_avatar_image(firm&.name&.gsub(" ", "+")) %>"></div>
												<div><%= firm.name %></div>
											</div>
										<% end %>	
									</td>
									<td><%= firm.try(:exception_requests)[0].try(:states_formated) %></td>
									<td><%= firm.try(:exception_requests)[0].try(:countries_formated) %></td>
									<td><%= firm.try(:exception_requests)[0].try(:women_owned) %></td>
									<td><%= firm.try(:exception_requests)[0].try(:women_owned) %></td>
								
								</tr>
							<% end %>
						</tbody>
					</table>

				</div>
				<!-- end widget content -->

			</div>
			<!-- end widget div -->

		</div>
		<!-- end widget -->

</div>
