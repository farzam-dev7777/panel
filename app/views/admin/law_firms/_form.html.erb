<style>
  input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
</style>
<div class="page-header-sp m-top">
  <div class="page-title">
    <% content_for :page_title do %>
      <% if @law_firm.new_record? %>
        Onboard a law firm
      <% else %>
        Editing <%= @law_firm.name %>
      <% end %>
    <% end %>
    <% if @law_firm.new_record? %>
      Onboard a law firm
    <% else %>
      Editing <%= @law_firm.name %>
    <% end %>
  </div>
  <div class="back-edit-actions">
    <a class="btn-type-default" href="/admin/law_firms">
      <%= image_tag "chevron-back-icon.svg", alt:"Back" %>
    </a>
  </div>
</div>
<div class="sp-form sp-form-bg adminLawFirm">
  <%= simple_form_for([:admin, @law_firm]) do |f| %>
    <div class="row form-flex-wrap">
      <div class="col-md-12">
        <div class="inner-label">Contact Information</div>
        <div class="inner-form-field form-flex-wrap">
          <div class="col-xs-12 col-md-6">
            <label class="label">Category</label>
            <%= f.input :law_firm_category, label: false, collection: ExceptionRequest::LAW_FIRM_CATEGORIES.map{ |k,v| [v,k]}, input_html: { autocomplete: 'off', class: 'text-left' }, prompt: 'Please Select a Category' , required: true %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Name</label>
            <%= f.input :name, label: false , required: true %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">BMO Relationship Partner Name</label>
            <%= f.input :bmo_relationship_partner_name, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">BMO Relationship Partner Email</label>
            <%= f.input :bmo_relationship_partner_email, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">BMO Relationship Partner Phone No.</label>
            <%= f.input :bmo_relationship_partner_phone_number, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Secondary RM Contact</label>
            <%= f.input :secondary_rm_contact, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Secondary RM Contact Email</label>
            <%= f.input :secondary_rm_contact_email, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Billing Contact Name</label>
            <%= f.input :billing_contact_name, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Billing Contact Email</label>
            <%= f.input :billing_contact_email,  label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Locations</label>
            <div class="col-md-12 no-padding">
              <div class="col-md-3">
                <div class="form-group optional law_firm_locations_country"><b>Country</b></div>
              </div>
              <div class="col-md-4"><b>Province</b></div>
              <div class="col-md-4"><b>City</b></div>
            </div>
            <%= f.simple_fields_for :locations do |field| %>
              <%= render partial: "location_fields", locals: {f: field} %>
            <% end %>
            <div class="add-css">
              <%= link_to_add_association '<span href="javascript:void(0);" class="btn-type-default"><i class="fa fa-plus-circle"></i> Add Law Firm\'s Location(s)</span>'.html_safe, f, :locations %>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-12">
        <div class="inner-label">SEMS Information</div>
        <div class="inner-form-field form-flex-wrap">
          <div class="col-xs-12 col-md-6">
            <label class="label">Engagement Number</label>
            <%= f.input :engagement_number, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Relationship Number</label>
            <%= f.input :relationship_number, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Information Security Class</label>
            <%= f.input :information_security_class, label: false, collection: LawFirm::INFORMATION_SECURITY_CLASS,  input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Information Security Assessment Outcome</label>
            <%= f.input :information_security_assessment_outcome, collection: LawFirm::INFORMATION_SECURITY_ASSESSMENT_OUTCOME, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Action Plan Findings</label>
            <%= f.input :action_plan_findings, as: :numeric, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Action Plan Status</label>
            <%= f.input :action_plan_status, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Information Security Contact Name</label>
            <%= f.input :information_security_contact, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Information Security Contact Email</label>
            <%= f.input :information_security_contact_email, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
        </div>
        <div class="inner-label">Law Firm Login</div>
        <div class="inner-form-field form-flex-wrap">
          <% if @law_firm.new_record? %>
            <div class="col-xs-12 col-md-6">
              <label class="label">Law Firm Login Email</label>
              <%= f.input :email, label: false , required: true %>
            </div>
          <% end %>
          <div class="col-xs-12 col-md-6">
            <label class="label">Law Firm Login User Phone</label>
            <%= f.input :phone, label: false %>
          </div>
          <% if @law_firm.new_record? %>
            <div class="col-xs-12 col-md-6">
              <label class="label">Temp. Password</label>
              <%= f.input :temp_password, autocomplete: "off", label: false, input_html: { class: 'set-password' } , required: true %>
              <p style="color: #949494;" class="text-left"><em>Minimum 10 characters required</em></p>
            </div>
            <div class="col-xs-12 col-md-6">
              <label class="label">Confirm Password</label>
              <%= f.input :temp_password_confirmation, autocomplete: "off", label: false, input_html: { class: 'set-password' }, required: true %>
            </div>
          <% else %>
            <%= f.simple_fields_for :users do |field| %>
              <div class="col-xs-12 col-md-6">
                <label class="label">Username</label>
                <%= field.input :username, autocomplete: "off", label: false, input_html: { class: 'set-password', disabled: true } %>
                <% if Current.user.role === "lxp" %>
                  <label class="label"> Password</label>
                  <%= field.input :password, autocomplete: "off", label: false, input_html: { class: 'set-password', placeholder: "Password" } %>
                  <%= field.input :password_confirmation, autocomplete: "off", label: false, input_html: { class: 'set-password', placeholder: "Password Confirmation" } %>
                  <%= field.input :_destroy, label: "Remove", as: :boolean if field.object.role != "master_user" %>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="inner-label">Law Firm Information</div>
      <div class="inner-form-field form-flex-wrap">
        <div class="col-xs-12 col-md-6">
          <label class="label"><i class="fa fa-question-circle-o help-text" data-help="All users that have access to law firm files, electronic or physical"></i> No. of personnel </label>
          <%= f.input :number_of_lawyers, label: false, collection: LawFirm::NUMBER_OF_LAWYERS, input_html: { autocomplete: 'off', class: 'text-left' } %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Diverse</label>
          <%= f.input :diverse, label: false, collection: LawFirm::DIVESER, input_html: { autocomplete: 'off', class: 'text-left' } %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Value-Add Activities</label>
          <%= f.simple_fields_for :values do |field| %>
            <%= render partial: "value_fields", locals: {f: field} %>
          <% end %>
          <div class="add-css">
            <%= link_to_add_association '<span href="javascript:void(0);" class="btn-type-default"><i class="fa fa-plus-circle"></i> Add Law Firm\'s Value(s)</span>'.html_safe, f, :values %>
          </div>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Feedback</label>
          <%= f.simple_fields_for :feedbacks do |field| %>
            <%= render partial: "feedback_fields", locals: {f: field} %>
          <% end %>
          <div class="add-css">
            <%= link_to_add_association '<span href="javascript:void(0);" class="btn-type-default"><i class="fa fa-plus-circle"></i> Add Law Firm\'s Feedback(s)</span>'.html_safe, f, :feedbacks %>
          </div>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Issues</label>
          <%= f.simple_fields_for :issues do |field| %>
            <%= render partial: "issue_fields", locals: {f: field} %>
          <% end %>
          <div class="add-css">
            <%= link_to_add_association '<span href="javascript:void(0);" class="btn-type-default"><i class="fa fa-plus-circle"></i> Add Law Firm\'s Issue(s)</span>'.html_safe, f, :issues %>
          </div>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Merger/Combination</label>
          <%= f.input :merger_combination, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
        </div>
      </div>
      <% if Current.user.role === "internal_lawyers" %>
        <div class="col-xs-12 col-md-6">
          <label class="label">Relationship Manager Name</label>
          <%= f.input :relationship_manager_name, label: false %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Relationship Manager Email</label>
          <%= f.input :relationship_manager_email, label: false %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Relationship Manager Phone</label>
          <%= f.input :relationship_manager_phone, label: false %>
        </div>
      <% end %>
      <!--div class="col-xs-12 col-md-6">
				<label class="label">Initial date of engagement with organization</label>
				<%= f.input :initial_date_of_engagement_with_the_bank, as: :datepicker, label: false, input_html: { autocomplete: 'off', class: 'text-left datepicker' } %>
			</div-->
      <div class="col-xs-12 col-md-6 multiple-selector">
        <label class="label">Select Matter Type</label>
        <%= f.input :matter_type_ids, label: false, collection: MatterType.all.map{|mt| [mt.matter_type, mt.id] } , input_html: { multiple: true }   %>
      </div>
      <div class="col-xs-12 col-md-6 sub_matter_type_box multiple-selector" style="display:none" >
        <label class="label">Select Sub Matter Type</label>
        <span class="sub_matter_type"><%= f.input :sub_matter_type_ids, label: false, collection: SubMatterType.all.map{|mt| [mt.sub_matter_type, mt.id] } , input_html: { multiple: true }   %></span>
      </div>
      <div class="col-xs-12 col-md-6 multiple-selector">
        <label class="label">Select Jurisdiction Type</label>
        <span class="jurisdiction_type"><%= f.input :jurisdiction_type_ids, label: false, collection: JurisdictionType.all.map{|mt| [mt.jurisdiction_type, mt.id] } , input_html: { multiple: true }   %></span>
      </div>
      <div class="col-xs-12 col-md-6 multiple-selector">
        <label class="label">Select Country</label>
        <span class="country_type"><%= f.input :country_ids, label: false, collection: Country.order(:position).map{|mt| [mt.name, mt.id] } , input_html: { multiple: true }   %></span>
      </div>
      <div class="col-xs-12 col-md-6 state_type_box multiple-selector" style="display:none">
        <label class="label">Select State/Province</label>
        <span class="state_type"><%= f.input :state_ids, label: false, collection: State.all.map{|mt| [mt.name, mt.id] } , input_html: { multiple: true }   %></span>
      </div>
      <div class="col-xs-12 col-md-12">
        <%=link_to 'Cancel', f.object.new_record? ? admin_law_firms_path : admin_law_firm_path, class: 'btn-type-default' %>
        <%= f.button :submit, f.object.new_record? ? 'Create' : 'Update', class: "btn-type-primary" %>
      </div>
    </div>
  <% end %>
</div>
