<style>
	input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
</style>
<% content_for :page_title do %>
	<% if @law_firm.new_record? %>
		<span>Onboard a law firm</span>
	<% else %>
		<span>Editing <%= @law_firm.users.first.try(:username) %></span>
	<% end %>
<% end %>
<h2>
	<% if @law_firm.new_record? %>
		<strong>Onboard a law firm</strong>
	<% else %>
		<strong>Editing <%= @law_firm.users.first.try(:username) %></strong>
	<% end %>
</h2>
<div class="table-responsive">
	<%= simple_form_for([:admin, @law_firm]) do |f| %>
		<table class="table table-striped">
			<tbody>
					
					<!-- <tr>
						<td class="text-right" width="20%"><strong>Type</strong></td>
						<td><%= f.input :law_firm_type, label: false, collection: LawFirm::COMPANY_TYPES, input_html: { autocomplete: 'off', class: 'text-left' }, prompt: 'Please Select a Type' %></td>
					</tr> -->

					<tr>
						<td class="text-right" width="20%"><strong>Name</strong></td>
						<td><%= f.input :name, label: false %></td>
					</tr>
					<tr>
						<td class="text-right" width="20%"><strong>Email</strong></td>
						<td><%= f.input :email, label: false %></td>
					</tr>
					<tr>
						<td class="text-right" width="20%"><strong>Phone</strong></td>
						<td><%= f.input :phone, label: false %></td>
					</tr>
					<tr>
						<td class="text-right" width="20%"><strong>Description</strong></td>
						<td><%= f.input :description, label: false %></td>
					</tr>
					<tr>
						<td class="text-right" width="20%"><strong>Initial Date of Engagement with BMO</strong></td>
						<td><%= f.input :initial_date_of_engagement_with_the_bank, as: :datepicker, label: false, input_html: { autocomplete: 'off', class: 'text-left datepicker' } %></td>
					</tr>

					<tr>
						<td class="text-right" width="20%"><strong>Types of matters your law firm has handled for us to date</strong></td>
						<td><%= f.input :type_of_matters_your_law_firm_handles_for_us, label: false, collection: LawFirm::TYPES_OF_MATTERS_FOR_US, input_html: { autocomplete: 'off', class: 'text-left', multiple: true } %></td>
					</tr>

					<!-- <tr>
						<td class="text-right" width="20%"><strong>Type of services your law firm provides generally</strong></td>
						<td><%= f.input :type_of_services_your_law_firm_provides_generally, label: false, collection: LawFirm::TYPES_OF_MATTERS, input_html: { autocomplete: 'off', class: 'text-left', multiple: true } %></td>
					</tr> -->

					<!-- <tr>
						<td class="text-right" width="20%"><strong>Confidentiality level of matters that are handled</strong></td>
						<td><%= f.input :confidentiality_level_of_matters_that_are_handled, label: false, collection: LawFirm::TYPES_OF_MATTERS, input_html: { autocomplete: 'off', class: 'text-left', multiple: false } %></td>
					</tr> -->

					<tr>
						<td class="text-right" width="20%"><i class="fa fa-question-circle-o help-text" data-help="All users that have access to law firm files, electronic or physical"></i><strong>No. of personnel</strong></td>
						<td><%= f.input :number_of_lawyers, label: false, collection: LawFirm::NUMBER_OF_LAWYERS, input_html: { autocomplete: 'off', class: 'text-left' } %></td>
					</tr>
					
					<!-- <tr>
						<td class="text-right" width="20%"><strong>Practice Area</strong></td>
						<td><%= f.input :practice_area, label: false, collection: LawFirm::PRACTICE_AREAS, input_html: { multiple: true } %></td>
					</tr> -->

					<tr>
						<% if @law_firm.new_record? %>
							<td class="text-right" width="20%"><strong>Temp. Password</strong></td>
							<td>
								<%= f.input :temp_password, autocomplete: "off", label: false, input_html: { class: 'set-password' } %>
								<p style="color: #949494;" class="text-left"><em>Minimum 10 characters required</em></p>	
							</td>
						</tr>
							<tr>
							<td class="text-right" width="20%"><strong>Confirm Password</strong></td>
							<td>
								<%= f.input :temp_password_confirmation, autocomplete: "off", label: false, input_html: { class: 'set-password' } %>
							</td>
						</tr>
						<% else %>
							<td class="text-right" width="20%"><strong>Password</strong></td>
							<td class="text-left">
								<%= f.simple_fields_for :users do |field| %>
							  	<div class="well">
								  	<%= field.input :username, autocomplete: "off", label: false, input_html: { class: 'set-password', disabled: true } %>
								  	<%= field.input :password, autocomplete: "off", label: false, input_html: { class: 'set-password', placeholder: "Password" } %>
								  	<%= field.input :password_confirmation, autocomplete: "off", label: false, input_html: { class: 'set-password', placeholder: "Password Confirmation" } %>
								  	<%= field.input :_destroy, label: "Remove", as: :boolean if field.object.role != "master_user" %>
								  </div>
							  <% end %>
							</td>
							<!-- <td>
								<%= f.input :password, autocomplete: "off", label: false, input_html: { class: 'set-password' } %>
								<p style="color: #949494;" class="text-left"><em>Minimum 10 characters required</em></p>	
							</td> -->
						<% end %>
					</tr>

					<!-- <tr class="within-block">
						<td class="text-right" width="20%"><strong>Contact Info</strong></td>
						<td><%= f.input :principle_contact_info, label: false, input_html: { autocomplete: 'off' } %></td>
					</tr> -->

					
						<tr>
							<td colspan="2">
								<div class="col-md-12 no-padding" style="margin-bottom: 15px">
									<!-- <div class="col-md-4"><label><strong>City</strong></label></div> -->
									<div class="col-md-3"><label><strong>Country</strong></label></div>
									<!-- <div class="col-md-4"><label><strong>State/Province</strong></label></div> -->
								</div>
								<%= f.simple_fields_for :locations do |field| %>
							    <%= render partial: "location_fields", locals: {f: field} %>
							  <% end %>
							  <div class="add-css">
							    <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-primary btn-sm"><i class="fa fa-plus-circle"></i> Add Law Firm\'s Location(s)</span>'.html_safe, f, :locations %>
							  </div>
						  </td>
					  </tr>

						<!-- <tr>
							<td colspan="2">
								<div class="col-md-12">
									<div class="col-md-6">
										<label><strong>Country</strong></label>
									</div>
									<div class="col-md-5 j-states">
										<label><strong>States/Provinces</strong></label>
									</div>
								</div>
								<% f.simple_fields_for :jurisdictions do |field| %>
							    <%= render partial: "jurisdiction_fields", 
							               locals: {f: field} unless field.object.nil? %>
							  <% end %>
							  <div class="add-css">
						    <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-primary btn-sm"><i class="fa fa-plus-circle"></i> Add Law Firm\'s Jurisdication(s)</span>'.html_safe, f, :jurisdictions %>
							  </div>
						  </td>
					  </tr> -->
					


					<tr>
						<td colspan="2">
							<%=link_to 'Cancel', f.object.new_record? ? admin_law_firms_path : admin_law_firm_path, class: 'btn btn-danger btn-sm' %>
							<%= f.button :submit, f.object.new_record? ? 'Create' : 'Update', class: "" %>
						</td>
					</tr>
			</tbody>
		</table>
	<% end %>
</div>