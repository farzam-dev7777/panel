<style>
	input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
</style>
<div class="page-header-sp">
		<div class="page-title m-top-zero">
			<% content_for :page_title do %>
				<% if @law_firm.new_record? %>
					Onboard a law firm
				<% else %>
					Editing <%= @law_firm.name %>
				<% end %>
			<% end %>
			<% if @law_firm.new_record? %>
				Onboard a law firm
			<% else %>
				Editing <%= @law_firm.name %>
			<% end %>
		</div>
		<div class="back-edit-actions"> </div>
	</div>

<div class="sp-form sp-form-bg">
	<%= simple_form_for([:admin, @law_firm]) do |f| %>
		<div class="row">
			<div class="col-xs-12 col-md-6">
				<label class="label">Category</label>
				<%= f.input :law_firm_category, label: false, collection: ExceptionRequest::LAW_FIRM_CATEGORIES.map{ |k,v| [v,k]}, input_html: { autocomplete: 'off', class: 'text-left' }, prompt: 'Please Select a Category' , required: true %>
			</div>
			<div class="col-xs-12 col-md-6">
				<label class="label">Name</label>
				<%= f.input :name, label: false , required: true %>
			</div>
		</div>
		<div class="row">
			<% if @law_firm.new_record? %>
				<div class="col-xs-12 col-md-6">
					<label class="label">Email</label>
					<%= f.input :email, label: false , required: true %>
				</div>
			<% end %>
			<div class="col-xs-12 col-md-6">
				<label class="label">Phone</label>
				<%= f.input :phone, label: false %>
			</div>
		</div>
		<div class="row">
			<div class="col-xs-12 col-md-6">
				<label class="label">Relationship Manager Name</label>
				<%= f.input :relationship_manager_name, label: false %>
			</div>
			<div class="col-xs-12 col-md-6">
				<label class="label">Relationship Manager Email</label>
				<%= f.input :relationship_manager_email, label: false %>
			</div>
		</div>
		<div class="row">
			<div class="col-xs-12 col-md-6">
				<label class="label">Relationship Manager Phone</label>
				<%= f.input :relationship_manager_phone, label: false %>
			</div>
			<div class="col-xs-12 col-md-6">
				<label class="label">Description</label>
				<%= f.input :description, label: false %>
			</div>
		</div>
		<div class="row">
			<div class="col-xs-12 col-md-6">
				<label class="label">Initial Date of Engagement with BMO</label>
				<%= f.input :initial_date_of_engagement_with_the_bank, as: :datepicker, label: false, input_html: { autocomplete: 'off', class: 'text-left datepicker' } %>
			</div>
			<div class="col-xs-12 col-md-6">
				<label class="label">Select Matter Type</label>
				<%= f.input :matter_type_ids, label: false, collection: MatterType.all.map{|mt| [mt.matter_type, mt.id] } , input_html: { multiple: true }   %>
			</div>
		</div>
		<div class="row">
			<div class="col-xs-12 col-md-6 sub_matter_type_box" style="display:none" >
				<label class="label">Select Sub Matter Type</label>
				<span class="sub_matter_type"><%= f.input :sub_matter_type_ids, label: false, collection: SubMatterType.all.map{|mt| [mt.sub_matter_type, mt.id] } , input_html: { multiple: true }   %></span>
			</div>
			<div class="col-xs-12 col-md-6">
				<label class="label">Select Jurisdiction Type</label>
				<span class="jurisdiction_type"><%= f.input :jurisdiction_type_ids, label: false, collection: JurisdictionType.all.map{|mt| [mt.jurisdiction_type, mt.id] } , input_html: { multiple: true }   %></span>
			</div>
		</div>
		<div class="row">
			<div class="col-xs-12 col-md-6">
				<label class="label">Select Country</label>
				<span class="country_type"><%= f.input :country_ids, label: false, collection: Country.all.map{|mt| [mt.name, mt.id] } , input_html: { multiple: false }   %></span>
			</div>
			<div class="col-xs-12 col-md-6 state_type_box" style="display:none">
				<label class="label">Select State/Province</label>
				<span class="state_type"><%= f.input :state_ids, label: false, collection: State.all.map{|mt| [mt.name, mt.id] } , input_html: { multiple: false }   %></span>
			</div>
		</div>
		<div class="row">
			<div class="col-xs-12 col-md-6">
				<label class="label"><i class="fa fa-question-circle-o help-text" data-help="All users that have access to law firm files, electronic or physical"></i> No. of personnel</div>
				<%= f.input :number_of_lawyers, label: false, collection: LawFirm::NUMBER_OF_LAWYERS, input_html: { autocomplete: 'off', class: 'text-left' } %>
			</div>
		</div>
		<div class="row">
			<div class="col-xs-12 col-md-6">
				<% if @law_firm.new_record? %>
				<label class="label">Temp. Password<label>
				<%= f.input :temp_password, autocomplete: "off", label: false, input_html: { class: 'set-password' } , required: true %>
				<p style="color: #949494;" class="text-left"><em>Minimum 10 characters required</em></p>
			</div>
			<div class="col-xs-12 col-md-6">
				<label class="label">Confirm Password</label>
				<%= f.input :temp_password_confirmation, autocomplete: "off", label: false, input_html: { class: 'set-password' }, required: true %>
			</div>
			<% else %>
			<div class="col-xs-12 col-md-6">
				<label class="label">Password<label>
					<%= f.simple_fields_for :users do |field| %>
						<div class="well">
							<%= field.input :username, autocomplete: "off", label: false, input_html: { class: 'set-password', disabled: true } %>
							<%= field.input :password, autocomplete: "off", label: false, input_html: { class: 'set-password', placeholder: "Password" } %>
							<%= field.input :password_confirmation, autocomplete: "off", label: false, input_html: { class: 'set-password', placeholder: "Password Confirmation" } %>
							<%= field.input :_destroy, label: "Remove", as: :boolean if field.object.role != "master_user" %>
						</div>
						<% end %>
				<% end %>
			</div>
		</div>
		<div class="row">
			<div class="col-xs-12 col-md-12">
				<%=link_to 'Cancel', f.object.new_record? ? admin_law_firms_path : admin_law_firm_path, class: 'btn-type-default' %>
				<%= f.button :submit, f.object.new_record? ? 'Create' : 'Update', class: "btn-type-primary" %>
			</div>
		</div>
	<% end %>
</div>