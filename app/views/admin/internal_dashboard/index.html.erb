<!-- Engage Non Panel Firms Starts-->
<div class="col-lg-12 col-md-12 col-sm-12">
	<div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<div class="page-header-sp mobile-dashboard-header">
			<div class="page-title">Non-Panel (one-off) Requests</div>
			<div class="back-edit-actions">
				<a class="btn-show-more" href="/admin/exception_requests">
        Show more
      	</a>
			</div>
  	</div>		
		<div class="no-padding">
			<div class="jarviswidget-editbox"></div>
			<!-- widget content -->
			<div class="widget-body">
				<div class="table-responsive">
					<table id="" class="table table-decoration table-bordered" width="100%">
						<thead>
							<tr>
								<th>Date Submitted</th>
								<th>Requested By</th>
								<th>LOB Contact Name</th>
								<th>Line of Business</th>
								<th>Law Firm Name</th>
								<th>Matter Name</th>
								<% if current_user.role === "lxp" %>
									<th>LXP Status</th>
								<% end %>
								<th>Lawyer Status</th>
								<!--<th width="8%">Action</th>-->
							</tr>
						</thead>
						<tbody>
							<% @exception_requests.each do |exception_request| %>
								<% if exception_request.law_firm_id.present?  %>
									<tr onClick="window.location.href='/admin/exception_requests/<%= exception_request.id %>'">
										<td>
											<%= exception_request.created_at.strftime('%d %b %Y at %I:%M %p') %>
										</td>
										<td>
											<% if exception_request.requested_by.present? %>
												<div class="firm-name">
													<div class="name-avatar"><img src="<%= get_avatar_image(exception_request&.requested_by&.gsub(" ", "+")) %>"></div>
													<div><%= exception_request.requested_by %></div>
												</div>
											<% end %>
										</td>
										<td><%= exception_request&.lob_contact_name %></td>
										<td><%= exception_request&.line_of_business %></td>
										<td><%= exception_request&.law_firm.try(:name) %></td>
										<td><%= exception_request&.try(:matter_name) %></td>
										<% if current_user.role === "lxp" %>
											<td>
												<div class="status">
													<% if exception_request.lxp_status.present? %>
														<span class="<%= exception_request.lxp_status === "APPROVED" ? 'label label-success' : 'label label-default' %>"> 
															<%= exception_request.lxp_status_show %>
														</span>
													<% end %>
												</div>
											</td>
										<% end %>
										<td>
											<% if exception_request.internal_lawyers_status.present? %>
											<div class="status">
												<span class="<%= exception_request.internal_lawyers_status === "APPROVED" ? 'label label-success' : 'label label-default' %>"> 
													<%= exception_request.try(:internal_lawyers_status).try(:titleize) %>
												</span>
											</div>
											<% end %>
										</td>
										<!--<td>
											<% if current_user.role == 'lob' &&  exception_request.try(:lxp_status) != 'APPROVED' %>
												<%= link_to "Edit", edit_admin_exception_request_path(exception_request), class: "btn btn-xs btn-primary" %>
											<% end %> 
											<%= link_to "Review", admin_exception_request_path(exception_request), class: "btn btn-xs btn-secondary" %>	
										</td>-->
									</tr>
								<% end %>
							<% end %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Engage Non Panel Firms Ends-->

<!-- Conflict Waiver Starts -->
<div class="col-lg-12 col-md-12 col-sm-12">
	<div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<div class="page-header-sp mobile-dashboard-header">
			<div class="page-title">Conflict Waiver Requests</div>
			<div class="back-edit-actions">
				<a class="btn-show-more" href="admin/conflict_waivers">
        Show more
      	</a>
			</div>
  	</div>		
		<div class="no-padding">
			<div class="jarviswidget-editbox"></div>
			<!-- widget content -->
			<div class="widget-body">
				<div class="table-responsive">
					<table id="" class="table table-decoration table-bordered" width="100%">
						<thead>
							<tr>
								<th>Date Submitted</th>
								<th>Name of law firm</th>
								<th>Contact details</th>
								<th>BMO business contact</th>
								<th>LXP Status</th>
              	<th>Internal Lawyer Status</th>
								<!--<th width="8%">Action</th>-->
							</tr>
						</thead>
						<tbody>
							<% @conflict_waivers.each do |conflict_waiver| %>
								<tr onClick="window.location.href='/admin/conflict_waivers/<%= conflict_waiver.id %>'">
									<td>
										<%= conflict_waiver.created_at.strftime('%d %b %Y at %I:%M %p') %>
									</td>
									<td>
										<% if conflict_waiver.name_of_law_firm.present? %>
											<div class="firm-name">
												<div class="name-avatar"><img src="<%= get_avatar_image(conflict_waiver&.name_of_law_firm&.gsub(" ", "+")) %>"></div>
												<div><%= conflict_waiver&.name_of_law_firm %></div>
											</div>
										<% end %>	
									</td>
									<td><%= conflict_waiver&.contact_details %></td>
									<td><%= conflict_waiver&.bmo_business_contact %></td>
									<!--<td>
										<div class="action-fields">
											<a class="action-btn" href="/admin/conflict_waivers/<%= conflict_waiver.id %>">
												<%= image_tag "view-icon.svg", alt:"View" %>
											</a>
										</div>
									</td>-->
									<td>
										<% if conflict_waiver.lxp_status_show.present? %>
											<div class="status">
												<span class="<%= conflict_waiver.lxp_status_show === "Approved" ? 'label label-success' : 'label label-default' %>"> 
													<%= conflict_waiver.try(:lxp_status_show).try(:titleize) %>
												</span>
											</div>
										<% end %>
									</td>
									<td>
										<% if conflict_waiver.internal_lawyers_status_show.present? %>
											<div class="status">
												<span class="<%= conflict_waiver.internal_lawyers_status_show === "Approve" ? 'label label-success' : 'label label-default' %>"> 
													<%= conflict_waiver.try(:internal_lawyers_status_show).try(:titleize) %>
												</span>
											</div>
										<% end %>
										<% conflict_waiver.internal_lawyers_status_show %>
									</td>
								</tr>
							<% end %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Conflict Waiver Ends-->

<!-- Matter Intakes Starts -->
<div class="col-lg-12 col-md-12 col-sm-12">
	<div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<div class="page-header-sp mobile-dashboard-header">
			<div class="page-title">Matter Intake Forms</div>
			<div class="back-edit-actions">
				<a class="btn-show-more" href="admin/matter_intakes">
        Show more
      	</a>
			</div>
  	</div>		
		<div class="no-padding">
			<div class="jarviswidget-editbox"></div>
			<!-- widget content -->
			<div class="widget-body">
				<div class="table-responsive">
					<table id="" class="table table-decoration table-bordered" width="100%">
						<thead>
							<tr>
								<th>Date Submitted</th>
								<th>Submitter Name</th>
								<!--<th>LOB Contact Name</th>-->
								<th>Name of Matter/Client</th>
								<!--th>Law Firm Suggested</th-->
								<th>Matter Number</th>
								<th>Status</th>
								<!--<th>Action</th>-->
							</tr>
						<tbody>
							<% @matter_intakes.each do |matter_intake| %>
								<% if Current.user.role === "internal_lawyers" && matter_intake.status != "matter_open" && matter_intake.user_id.present? %>
									<tr onClick="window.location.href='/admin/matter_intakes/<%= matter_intake.id %>/review'">
								<% else %>
									<tr onClick="window.location.href='/admin/matter_intakes/<%= matter_intake.id %>'">
								<% end %>
									<td><%= matter_intake.created_at.strftime('%d %b %Y at %I:%M %p') %></td>
									<td>
										<% if matter_intake.submitter_name.present? %>
											<div class="firm-name">
												<div class="name-avatar"><img src="<%= get_avatar_image(matter_intake&.submitter_name&.gsub(" ", "+")) %>"></div>
												<div><%= matter_intake.submitter_name %></div>
											</div>
										<% end %>	
									</td>
									<!--<td><%= matter_intake.lob_contact_name %></td>-->
									<td><%= matter_intake.name_of_matter_client %></td>
									<!--td><%= matter_intake.law_firm.try(:name) %></td-->
									<td><%= matter_intake.matter_number %></td>
									<td>
										<div class="status">
											<span class="<%= matter_intake.status === "matter_open" ? 'label label-success' : 'label label-default' %>"> 
												<%= matter_intake.show_status %>
											</span>
										</div>
									</td>
									<!--<td>
										<% if @current_user.role === "internal_lawyers" && (matter_intake.status === "awaiting_lawyer_review" || matter_intake.status === "awaiting_lawyer_update") %>
											<%= link_to "review", review_admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>	
										<% elsif @current_user.role === "lxp" %>
											<% if matter_intake.status === "awaiting_lxp_review" %>
												<%= link_to "review", lxp_review_admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>
											<% end %>
										<% end %>
										<%= link_to "view", admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>
									</td>-->
								</tr>
							<% end %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Matter Intakes Ends-->

 
