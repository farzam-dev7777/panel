<% content_for :page_title do %>
<span>Law Firms</span>
<% end %>


<% content_for :page_buttons do %>
<%= link_to "Create New Law Firm", new_admin_law_firm_path, class: "btn btn-primary btn-md pull-right" %>
<% end %>

<div class="clearfix"></div>

<div class="col-lg-12 col-md-12 col-sm-12">



<div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
<header>
<span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
<h2 class="font-md"><strong>Recently SEAL'ed Firms </strong></h2>				
</header>
<div class="no-padding">
<div class="jarviswidget-editbox"></div>
<!-- widget content -->
<div class="widget-body">
	
		<div class="table-responsive">
			<table class="table table-bordered">

				<tr>
					<th>Name</th>
					<th>Email</th>
					<th>Phone</th>
					<th>Score</th>
					<th>Action</th>
				</tr>

				<% @law_firms.each do |firm| %>
					<tr>
						<td><%= firm.name %></td>
						<td><%= firm.email %></td>
						<td><%= firm.phone %></td>
						<td class="text-center">
							<div> 
								<span class="percent txt-color-blue font-xl semi-bold">
									<%= rand(120...300) %>
								</span> 
							</div>
						</td>
						<td class="text-center" width="150px">
							<%= link_to "Edit", edit_admin_law_firm_path(firm), class: "btn btn-primary" %>	
							<%= link_to "Mail", edit_admin_law_firm_path(firm), class: "btn btn-primary" %>	
						</td>
					</tr>
					
				<% end %>

			</table>
			<div class="clearfix"></div>

		</div>		
	
</div>
</div>
</div>


</div>



<div class="col-md-4">
<div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">


	<header>
		<span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
		<h2 class="font-md"><strong>Send Message </strong></h2>				
	</header>

	<div>

		<div class="jarviswidget" id="wid-id-8" data-widget-editbutton="false" data-widget-custombutton="false" style="border-top: 1px solid #ccc;">

		<!-- widget div-->
		<div>
			
			<!-- widget edit box -->
			<div class="jarviswidget-editbox">
				<!-- This area used as dropdown edit box -->
				
			</div>
			<!-- end widget edit box -->
			
			<!-- widget content -->
			<div class="widget-body no-padding">
				
				<!-- <form action="/admin" method="post" id="message-form" class="smart-form"> -->
				<%= form_tag '/admin/messages', class: 'smart-form', id: 'message-form' do %>
					
					<div class="alert adjusted alert-success fade in hidden">
						<button class="close" data-dismiss="alert">
							×
						</button>
						<i class="fa-fw fa-lg fa fa-exclamation"></i>
						<strong>Message sent successfully!</strong>
					</div>

					<fieldset>
						
						<section>
							<label class="label">Law Firm</label>
							<label class="input">
								<i class="icon-append fa fa-tag"></i>
								<%= collection_select :message, :law_firm_id, @law_firms, :id, :name, {}, style: "width: 100%" %>							
							</label>
						</section>
						
						<section>
							<label class="label">Subject</label>
							<label class="input">
								<i class="icon-append fa fa-tag"></i>
								<%= text_field_tag 'message[subject]' %>
							</label>
						</section>
						
						<section>
							<label class="label">Message</label>
							<label class="textarea">
								<i class="icon-append fa fa-comment"></i>
								<%= text_area_tag 'message[body]' %>
							</label>
						</section>

					</fieldset>
					
					<footer>
						<button type="submit" class="btn btn-primary">Send</button>
					</footer>

				<% end %>
				
			</div>
			<!-- end widget content -->
			
		</div>
		<!-- end widget div -->
		
	</div>

	</div>


</div>

</div>

<div class="col-md-8">
	
	<div class="jarviswidget jarviswidget-color-blue" id="wid-id-4" data-widget-editbutton="false" data-widget-colorbutton="false">

						<!-- widget options:
						usage: <div class="jarviswidget" id="wid-id-0" data-widget-editbutton="false">

