<div class="lxp_dashboard">
  <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
    <ul id="sparks" class="top-status-card">
      <li class="sparks-info color-border-01">
        <a href="/admin/law_firms/panel_law_firms" class="card-content">
          <div class="card-icon bg-color-01">
            <%= image_tag "exceptions-icon.svg", alt:"Panel Firms" %>
          </div>
          <div class="card-details">
            <div class="total-record"><%= @panel_law_firm_count || 0 %></div>
            <div class="card-name">Panel Firms</div>
            <div class="card-tag-line">Tag lines goes here</div>
          </div>
        </a>
      </li>
      <li class="sparks-info color-border-03">
        <a href="/admin/matter_intakes?filter=yes" class="card-content">
          <div class="card-icon bg-color-03">
            <%= image_tag "approved-icon.svg", alt:"Matters" %>
          </div>
          <div class="card-details">
            <div class="total-record"><%= @matter_intakes_count %></div>
            <div class="card-name">Matters</div>
            <div class="card-tag-line">Tag lines goes here</div>
          </div>
        </a>
      </li>
      <li class="sparks-info color-border-02">
        <a href="admin/invoices" class="card-content" >
          <div class="card-icon bg-color-02">
            <%= image_tag "submitted-icon.svg", alt:"Panel Consideration Requests" %>
          </div>
          <div class="card-details">
            <div class="total-record"><%= number_to_currency(@invoices_total || 0, unit: "$", strip_insignificant_zeros: true) %></div>
            <div class="card-name">FY Invoices</div>
            <div class="card-tag-line">Tag lines goes here</div>
          </div>
        </a>
      </li>
      <li class="sparks-info color-border-04">
        <a href="/admin/conflict_waivers?filter=yes" class="card-content">
          <div class="card-icon bg-color-04">
            <%= image_tag "exceptions-icon.svg", alt:"Conflict Waiver Requests" %>
          </div>
          <div class="card-details">
            <div class="total-record"><%= @confilictc_requests_submitted %></div>
            <div class="card-name">Conflict Waiver Requests(Pending)</div>
            <div class="card-tag-line">Tag lines goes here</div>
          </div>
        </a>
      </li>
    </ul>
  </div>
</div>
<br>
