<div class="lxp_dashboard">

	<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
		<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 current-stats">
			<ul id="sparks" class="text-left">
				<li class="sparks-info">
					<a href="javascript:void(0);">
						<h5 class="current-month-info"> Exceptions
							<span class="txt-color">
								- <%= @exception_requests_submitted %> -
							</span>
						</h5>
					</a>
				</li>
				<li class="sparks-info">
					<a href="javascript:void(0);">
						<h5 class="current-month-info"> Conflicts
							<span>
								- <%= @confilictc_requests_submitted %> -
							</span>
						</h5>
					</a>
				</li>
				<li class="sparks-info">
					<a href="javascript:void(0);">
						<h5 class="current-month-info"> Panel Firms
							<span>- <%= @panel_requests_submitted %> -</span>
						</h5>
					</a>
				</li>
			</ul>
		</div>
	</div>


</div>

<p>&nbsp;</p>


  
 

<div class="clearfix"></div>

<div class="col-lg-12 col-md-12 col-sm-12">
	<div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<header>
			<span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
			<h2 class="font-md"><strong>Latest Panel Request </strong></h2>				
		</header>
		<div class="no-padding">
			<div class="jarviswidget-editbox"></div>
			<!-- widget content -->
			<div class="widget-body">

				<div class="table-responsive">
					<table id="dt_basic" class="table table-striped table-bordered table-hover" width="100%">
						<thead>
							<tr style="background: #007ac3;color: #fff;">
								<th>Requested By</th>
								<th>Submitted By</th>
								<th>LOB Contact Name</th>
								<th>Action</th>
							</tr>
						</thead>
						<tbody>
							<% @panel_requests.each do |panel_request| %>
							<tr class="" data-id="<%= panel_request.id %>">
								<td><%= panel_request.requested_by %></td>
								<td><%= panel_request.submitted_by_email %></td>
								<td><%= panel_request.lob_contact_name %></td>
								<td>
									<% if current_user.role == 'lxp' &&  panel_request.try(:lxp_status) != 'APPROVED' %>
										<%= link_to "Edit", edit_admin_panel_request_path(panel_request), class: "btn btn-xs btn-primary" %>
									<% end %> 
									<%= link_to "Review", admin_panel_request_path(panel_request), class: "btn btn-xs btn-secondary" %>	
								</td>
							</tr>
							<% end %>
						</tbody>
					</table>
					<div class="clearfix"></div>

				</div>		

			</div>
		</div>
	</div>


</div>
<div class="clearfix"></div>

<div class="col-lg-12 col-md-12 col-sm-12">



	<div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<header>
			<span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
			<h2 class="font-md"><strong>Active Law Firms </strong></h2>				
		</header>
		<div class="no-padding">
			<div class="jarviswidget-editbox"></div>
			<!-- widget content -->
			<div class="widget-body">

				<div class="table-responsive">
					<table id="db_lfs" class="table table-striped table-bordered table-hover">

						<thead>
							<tr style="background: #007ac3; color: #fff;">
								<th>Name</th>
								<th>Status</th>
								<th>Last Updated At</th>
								<th>Score</th>
							</tr>
						</thead>

						<tbody>
							<% @law_firms.each do |firm| %>
								<tr>
									<td><%= link_to firm.name, admin_law_firm_path(firm) %>	</td>
									<td><%= firm.form_submissions.latest.try(:status).try(:humanize) %></td>
									<td><%= firm.updated_at.in_time_zone('Eastern Time (US & Canada)').strftime(LawFirm::TIME_FORMAT) %></td>
									<td class="text-center">
										<div> 
											<span class="percent txt-color-blue semi-bold">
												<% if firm.form_submissions.try(:latest).try(:status) == 'approved' %>
													<% score = firm.form_submissions.try(:latest).try(:total_score) %>
													<div class="total-score" data-color="<%= firm.form_submissions.try(:latest).try(:color, score, 'total_score') %>" data-score=<%= score %>></div>
												<% end %>
											</span> 
										</div>
									</td>
								</tr>
							<% end %>
						</tbody>

					</table>
					<div class="clearfix"></div>

				</div>		

			</div>
		</div>
	</div>


</div>
