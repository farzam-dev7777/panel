											<%= link_to "review", review_admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>	
										<% elsif @current_user.role === "lxp" %>
											<% if matter_intake.status === "waiting_for_lxp_review" %>
												<%= link_to "review", lxp_review_admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>
											<% end %>
										<% end %>
										<%= link_to "view", admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>
									</td>-->
								</tr>
							<% end %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Matter Intakes Ends-->

<% if current_user.role == 'lxp' %>
	<div class="col-lg-12 col-md-12 col-sm-12">
		<div class=" jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
			<div class="page-header-sp mobile-dashboard-header">
				<div class="page-title">Panel Consideration Requests</div>
				<div class="back-edit-actions">
					<a class="btn-show-more" href="admin/panel_requests/">
					Show more
					</a>
				</div>
			</div>
			<div class="no-padding">
				<!-- widget content -->
				<div class="widget-body">
					<div class="table-responsive">
						<!-- db_lfs id for dynamic table -->
						<table id="" class="table table-decoration table-bordered" width="100%">
							<thead>
								<tr>
									<th>Date Submitted</th>
									<th>Requested By</th>
									<th>Submitted By</th>
									<th>LOB Contact Name</th>
									<th>Panel Status</th>
              		<th>LXP Status</th>
									<!--<th>Action</th>-->
								</tr>
							</thead>
							<tbody>
								<% @panel_requests.each do |panel_request| %>
								<tr onClick="window.location.href='/admin/panel_requests/<%= panel_request.id %>'">
									<td><%= panel_request.created_at.strftime("%d/%m/%Y") %></td>
									<td>
										<% if panel_request.requested_by.present? %>
											<div class="firm-name">
												<div class="name-avatar"><img src="<%= get_avatar_image(panel_request&.requested_by&.gsub(" ", "+")) %>"></div>
												<div><%= panel_request.requested_by %></div>
											</div>
										<% end %>	
									</td>
									<td><%= panel_request.submitted_by_email %></td>
									<td><%= panel_request.lob_contact_name %></td>
									<td>
										<div class="status">
											<% if panel_request.status.present? %>
												<span class="<%= panel_request.status === "Activate" ? 'label label-success' : 'label label-default' %>"> 
													<%= panel_request.try(:status).try(:titleize) %>
												</span>
											<% end %>
										</div>
										<% panel_request.status %>
									</td>
									<td>
										<div class="status">
											<% if panel_request.lxp_status_show.present? %>
												<span class="<%= panel_request.lxp_status_show === "Approved" ? 'label label-success' : 'label label-default' %>"> 
													<%= panel_request.try(:lxp_status_show).try(:titleize) %>
												</span>
											<% else %>
												<div class="text-center">-</div>
											<% end %>
										</div>
										<% panel_request.lxp_status_show ? panel_request.lxp_status_show : "-" %>
									</td>
									<!--<td>
										<% if current_user.role == 'lxp' &&  panel_request.try(:lxp_status) != 'APPROVED' %>
											<%= link_to "Edit", edit_admin_panel_request_path(panel_request), class: "btn btn-xs btn-primary" %>
										<% end %> 
										<% link_to "Review", admin_panel_request_path(panel_request), class: "btn btn-xs btn-secondary" %>	
									</td>-->
								</tr>
								<% end %>
							</tbody>
						</table>
					</div>		
				</div>
			</div>
		</div>
	</div>
<% end %>

