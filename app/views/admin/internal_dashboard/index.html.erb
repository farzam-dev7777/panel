          <div class="table-responsive">
            <%= render "/shared/law_firms_list", law_firms: @panel_law_firms, link_base_url: "/admin/law_firms", table_id: nil, limit: nil %>
          </div>
        </div>
      </div>
    </div>
  </div>
<!-- Panel Firms Ends-->
<!-- Matter Intakes Starts -->
<div class="col-lg-12 col-md-12 col-sm-12">
  <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
    <div class="page-header-sp mobile-dashboard-header">
      <div class="page-title">Matters</div>
      <div class="back-edit-actions">
        <a class="btn-show-more" href="admin/matter_intakes">
          Show more
        </a>
      </div>
    </div>
    <div class="no-padding">
      <div class="jarviswidget-editbox"></div>
      <!-- widget content -->
      <div class="widget-body">
        <div class="table-responsive">
          <table id="" class="table table-decoration table-bordered" width="100%">
            <thead>
              <tr>
                <th>Matter #</th>
                <th>Matter Name</th>
                <th>Date Submitted</th>
                <th>External Law Firm</th>
                <th>Requested By</th>
                <th>Status</th>
              </tr>
              <tbody>
                <% @matter_intakes.each do |matter_intake| %>
                    <% if Current.user.role === "internal_lawyers" && matter_intake.status != "matter_open" && matter_intake.user_id.present? %>
                    <tr onClick="window.location.href='/admin/matter_intakes/<%= matter_intake.id %>/review'">
                    <% else %>
                      <tr onClick="window.location.href='/admin/matter_intakes/<%= matter_intake.id %>'">
                    <% end %>
                      <td><%= matter_intake.matter_number.present? ? matter_intake&.matter_number : "-" %></td>
                      <td>
                        <%= matter_intake&.name_of_matter_client %>
                      </td>
                      <td>
                        <%= matter_intake.created_at.strftime('%d %b %Y at %I:%M %p') %>
                      </td>
                      <td>
                        <%= matter_intake&.law_firm&.name %>
                      </td>
                      <td>
                        <% if matter_intake.submitter_name.present? %>
                          <div class="firm-name">
                            <div class="name-avatar"><img src="<%= get_avatar_image(matter_intake&.submitter_name&.gsub(" ", "+")) %>"></div>
                            <div><%= matter_intake&.submitter_name %></div>
                          </div>
                        <% end %>
                      </td>
                      
                      <td>
                        <div class="status">
                          <span class="<%= matter_intake&.status === "matter_open" ? 'label label-success' : 'label label-default' %>">
                            <%= matter_intake.show_status %>
                          </span>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
<!-- Matter Intakes Ends-->
<!-- Invoices Starts-->
  <div class="col-lg-12 col-md-12 col-sm-12">
    <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
      <div class="page-header-sp mobile-dashboard-header">
        <div class="page-title">Invoices</div>
        <div class="back-edit-actions">
          <a class="btn-show-more" href="admin/invoices">
            Show more
          </a>
        </div>
      </div>
      <div class="no-padding">
        <div class="jarviswidget-editbox"></div>
        <!-- widget content -->
        <div class="widget-body">
          <div class="table-responsive">
            <table id="" class="table table-decoration table-bordered" width="100%">
              <thead>
                <tr>
                  <th>Last Updated</th>
                  <th>Matter Number</th>
                  <th>Matter Name</th>
                  <th>Law Firm</th>
                  <th>Total of Invoice</th>
                </tr>
              </thead>
              <tbody>
                <% @invoices.each do |invoice| %>
                  <tr>
                    <td><%= invoice&.updated_at&.strftime('%d %b %Y') %></td>
                    <td><%= invoice&.matter_intake&.matter_number %></td>
                    <td><%= invoice&.matter_intake&.name_of_matter_client %></td>
                    <td><%= invoice&.matter_intake&.law_firm&.name %></td>
                    <td><%= invoice.amount.try(:format) %></td>
                    <td>-</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
<!-- Invoices Ends-->
<!-- Conflict Waiver Starts -->
<div class="col-lg-12 col-md-12 col-sm-12">
  <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
    <div class="page-header-sp mobile-dashboard-header">
      <div class="page-title">Conflict Waiver Requests</div>
      <div class="back-edit-actions">
        <a class="btn-show-more" href="admin/conflict_waivers">
          Show more
        </a>
      </div>
    </div>
    <div class="no-padding">
      <div class="jarviswidget-editbox"></div>
      <!-- widget content -->
      <div class="widget-body">
        <div class="table-responsive">
          <table id="" class="table table-decoration table-bordered" width="100%">
            <thead>
              <tr>
                <th>Date Submitted</th>
                <th>Name of law firm</th>
                <th>Contact details</th>
                <th>Internal Contact</th>
                <th>Internal Status</th>
                <th>Internal Lawyer Status</th>
                <!--<th width="8%">Action</th>-->
              </tr>
            </thead>
            <tbody>
              <% @conflict_waivers.each do |conflict_waiver| %>
                <tr onClick="window.location.href='/admin/conflict_waivers/<%= conflict_waiver.id %>'">
                  <td>
                    <%= conflict_waiver.created_at.strftime('%d %b %Y') %>
                  </td>
                  <td>
                    <% if conflict_waiver.name_of_law_firm.present? %>
                      <div class="firm-name">
                        <div class="name-avatar"><img src="<%= get_avatar_image(conflict_waiver&.name_of_law_firm&.gsub(" ", "+")) %>"></div>
                        <div><%= conflict_waiver&.name_of_law_firm %></div>
                      </div>
                    <% end %>
                  </td>
                  <td><%= conflict_waiver&.contact_details %></td>
                  <td><%= conflict_waiver&.bmo_business_contact %></td>
                  <!--<td>
                <div class="action-fields">
                  <a class="action-btn" href="/admin/conflict_waivers/<%= conflict_waiver.id %>">
                    <%= image_tag "view-icon.svg", alt:"View" %>
                  </a>
                </div>
              </td>-->
                  <td>
                    <% if conflict_waiver.lxp_status_show.present? %>
                      <div class="status">
                        <span class="<%= conflict_waiver.lxp_status_show === "Approved" ? 'label label-success' : 'label label-default' %>">
                          <%= conflict_waiver.try(:lxp_status_show).try(:titleize) %>
                        </span>
                      </div>
                    <% end %>
                  </td>
                  <td>
                    <% if conflict_waiver.internal_lawyers_status_show.present? %>
                      <div class="status">
                        <span class="<%= conflict_waiver.internal_lawyers_status_show === "Approve" ? 'label label-success' : 'label label-default' %>">
                          <%= conflict_waiver.try(:internal_lawyers_status_show).try(:titleize) %>
                        </span>
                      </div>
                    <% else %>
                      -
                    <% end %>
                    <% conflict_waiver.internal_lawyers_status_show %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- Conflict Waiver Ends-->
