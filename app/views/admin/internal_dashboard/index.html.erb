<div class="lxp_dashboard">
		<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
			<ul id="sparks" class="top-status-card">
				<li class="sparks-info color-border-01">
					<a href="javascript:void(0);" class="card-content">
						<div class="card-icon bg-color-01">
							<%= image_tag "exceptions-icon.svg", alt:"Exceptions" %> 
						</div>
						<div class="card-deatails">
							<div class="total-record"><%= @exception_requests_submitted %></div>
							<div class="card-name">Exceptions</div>
							<div class="card-tag-line">Tag lines goes here</div>
						</div>
					</a>
				</li>
				<li class="sparks-info color-border-02">
					<a href="javascript:void(0);" class="card-content">
						<div class="card-icon bg-color-02">
							<%= image_tag "exceptions-icon.svg", alt:"Exceptions" %> 
						</div>
						<div class="card-deatails">
							<div class="total-record"><%= @confilictc_requests_submitted %></div>
							<div class="card-name">Conflicts</div>
							<div class="card-tag-line">Tag lines goes here</div>
						</div>
					</a>
				</li>
				<li class="sparks-info color-border-03">
					<a href="javascript:void(0);" class="card-content">
						<div class="card-icon bg-color-03">
							<%= image_tag "exceptions-icon.svg", alt:"Exceptions" %> 
						</div>
						<div class="card-deatails">
							<div class="total-record"><%= @panel_requests_submitted %></div>
							<div class="card-name">Panel Firms</div>
							<div class="card-tag-line">Tag lines goes here</div>
						</div>
					</a>
				</li>
			</ul>
		</div>
</div>

<div class="col-lg-12 col-md-12 col-sm-12">
	<div class=" jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<div class="page-header-sp">
			<div class="page-title">Panel Request</div>
			<div></div>
  	</div>
		<div class="no-padding">
			<!-- widget content -->
			<div class="widget-body">
				<div class="table-responsive">
					<!-- db_lfs id for dynamic table -->
					<table id="" class="table table-decoration table-bordered" width="100%">
						<thead>
							<tr>
								<th>Requested By</th>
								<th>Submitted By</th>
								<th>LOB Contact Name</th>
								<th>Action</th>
							</tr>
						</thead>
						<tbody>
							<% @panel_requests.each do |panel_request| %>
							<tr class="" data-id="<%= panel_request.id %>">
								<td><%= panel_request.requested_by %></td>
								<td><%= panel_request.submitted_by_email %></td>
								<td><%= panel_request.lob_contact_name %></td>
								<td>
									<% if current_user.role == 'lxp' &&  panel_request.try(:lxp_status) != 'APPROVED' %>
										<%= link_to "Edit", edit_admin_panel_request_path(panel_request), class: "btn btn-xs btn-primary" %>
									<% end %> 
									<%= link_to "Review", admin_panel_request_path(panel_request), class: "btn btn-xs btn-secondary" %>	
								</td>
							</tr>
							<% end %>
						</tbody>
					</table>
				</div>		
			</div>
		</div>
	</div>
</div>

<div class="col-lg-12 col-md-12 col-sm-12">
	<div class=" jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<div class="page-header-sp">
			<div class="page-title">Active Law Firms</div>
			<div></div>
  	</div>
		<div class="no-padding">
			<!-- widget content -->
			<div class="widget-body">
				<div class="table-responsive">
					<!-- db_lfs id for dynamic table -->
					<table id="" class="table table-decoration table-bordered">
						<thead>
							<tr>
								<th>Name</th>
								<th>Status</th>
								<th>Last Updated At</th>
								<th>Score</th>
							</tr>
						</thead>
						<tbody>
							<% @law_firms.each do |firm| %>
								<tr>
									<td><%= link_to firm.name, admin_law_firm_path(firm) %>	</td>
									<td><%= firm.form_submissions.latest.try(:status).try(:humanize) %></td>
									<td><%= firm.updated_at.in_time_zone('Eastern Time (US & Canada)').strftime(LawFirm::TIME_FORMAT) %></td>
									<td class="text-center">
										<div> 
											<span class="percent txt-color-blue semi-bold">
												<% if firm.form_submissions.try(:latest).try(:status) == 'approved' %>
													<% score = firm.form_submissions.try(:latest).try(:total_score) %>
													<div class="total-score" data-color="<%= firm.form_submissions.try(:latest).try(:color, score, 'total_score') %>" data-score=<%= score %>></div>
												<% end %>
											</span> 
										</div>
									</td>
								</tr>
							<% end %>
						</tbody>
					</table>
				</div>		
			</div>
		</div>
	</div>
</div>
