<div>

	<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
		<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 current-stats">
			<ul id="sparks" class="text-left">
				<li class="sparks-info">
					<a href="/admin/law_firms?filter=onboarded">
						<h5 class="current-month-info"> Onboarded 
							<span class="txt-color">
								- <%= LawFirm.onboarded.count %> -
							</span>
						</h5>
					</a>
				</li>
				<li class="sparks-info">
					<a href="/admin/law_firms?filter=under_process">
						<h5 class="current-month-info"> In Process 
							<span>- <%= LawFirm.in_process.count %> -</span>
						</h5>
					</a>
				</li>
				<li class="sparks-info">
					<a href="/admin/law_firms?filter=certified">
						<h5 class="current-month-info"> Certified 
							<span>
								- <%= LawFirm.certified.count %> -
							</span>
						</h5>
					</a>
				</li>
				<li class="sparks-info">
					<a href="/admin/law_firms?filter=decertified">
						<h5 class="current-month-info"> Decertified 
							<span>- <%= LawFirm.decertified.count %> -</span>
						</h5>
					</a>
				</li>
			</ul>
		</div>
	</div>

</div>

<p>&nbsp;</p>


<div class="row">
<div class="col-md-6">
		<article class="col-sm-12">
			<!-- new widget -->
			<div class="jarviswidget" id="wid-id-0" data-widget-editbutton="false">
