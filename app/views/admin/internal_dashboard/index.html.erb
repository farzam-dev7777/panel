<% content_for :page_title do %>
	<span>Law Firms</span>
<% end %>




<div class="clearfix"></div>

<div class="col-lg-12 col-md-12 col-sm-12">



	<div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<header>
			<span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
			<h2 class="font-md"><strong>Current Threats </strong></h2>				
		</header>
		<div class="no-padding">
			<div class="jarviswidget-editbox"></div>
			<!-- widget content -->
			<div class="widget-body">

				<div class="table-responsive">
					<table class="table table-bordered">
						<thead>
						<tr>
							<th>Title</th>
							<th>Description</th>
							<th>Severity</th>
							<th>Status</th>
						</tr>
						</thead>
						<tbody>
							<% @security_threats.each do |threat| %>
								<tr class="security-threat-row" data-id="<%= threat.id %>">
									<td><%= threat.title %></td>
									<td><%= truncate(threat.description, length: 150) %></td>
									<td><%= threat.severity_level.name.humanize %></td>
									<td><%= link_to "More Details", admin_security_threat_path(threat), :class => "", :remote => true, "data-toggle" => "modal", "data-target" => "securityAlert" %></td>
								</tr>
							<% end %>
						</tbody>

					</table>
					<div class="clearfix"></div>

				</div>		

			</div>
		</div>
	</div>


</div>

<div class="clearfix"></div>

<div class="col-lg-12 col-md-12 col-sm-12">



	<div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<header>
			<span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
			<h2 class="font-md"><strong>Active Law Firms </strong></h2>				
		</header>
		<div class="no-padding">
			<div class="jarviswidget-editbox"></div>
			<!-- widget content -->
			<div class="widget-body">

				<div class="table-responsive">
					<table id="db_lfs" class="table table-striped table-bordered table-hover">

						<thead>
							<th>Name</th>
							<th>Status</th>
							<th>Last Updated At</th>
							<th>Score</th>
						</thead>

						<tbody>
							<% @law_firms.each do |firm| %>
								<tr>
									<td><%= link_to firm.name, admin_law_firm_path(firm) %>	</td>
									<td><%= firm.form_submissions.latest.try(:status).try(:humanize) %></td>
									<td><%= firm.updated_at.strftime(LawFirm::TIME_FORMAT) %></td>
									<td class="text-center">
										<div> 
											<span class="percent txt-color-blue semi-bold">
												<% if firm.form_submissions.try(:latest).try(:total_score) %>
												<div class="total-score" data-score=<%= firm.form_submissions.try(:latest).try(:total_score) %>></div>
												<% end %>
												
											</span> 
										</div>
									</td>
								</tr>
							<% end %>
						</tbody>

					</table>
					<div class="clearfix"></div>

				</div>		

			</div>
		</div>
	</div>


</div>



