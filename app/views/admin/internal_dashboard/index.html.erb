<div class="lxp_dashboard">
		<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
			<ul id="sparks" class="top-status-card">
				<li class="sparks-info color-border-01">
					<a href="javascript:void(0);" class="card-content">
						<div class="card-icon bg-color-01">
							<%= image_tag "exceptions-icon.svg", alt:"Exceptions" %> 
						</div>
						<div class="card-details">
							<div class="total-record"><%= @exception_requests_submitted %></div>
							<div class="card-name">Engage Non Panel Firms</div>
							<div class="card-tag-line">Tag lines goes here</div>
						</div>
					</a>
				</li>
				<li class="sparks-info color-border-02">
					<a href="javascript:void(0);" class="card-content">
						<div class="card-icon bg-color-02">
							<%= image_tag "submitted-icon.svg", alt:"Exceptions" %> 
						</div>
						<div class="card-details">
							<div class="total-record"><%= @confilictc_requests_submitted %></div>
							<div class="card-name">Conflict Waiver</div>
							<div class="card-tag-line">Tag lines goes here</div>
						</div>
					</a>
				</li>
				<li class="sparks-info color-border-03">
					<a href="javascript:void(0);" class="card-content">
						<div class="card-icon bg-color-03">
							<%= image_tag "approved-icon.svg", alt:"Exceptions" %> 
						</div>
						<div class="card-details">
							<div class="total-record"><%= @matter_intakes_count %></div>
							<div class="card-name">Matter Takes</div>
							<div class="card-tag-line">Tag lines goes here</div>
						</div>
					</a>
				</li>
				<li class="sparks-info color-border-04">
					<a href="javascript:void(0);" class="card-content">
						<div class="card-icon bg-color-04">
							<%= image_tag "exceptions-icon.svg", alt:"Exceptions" %> 
						</div>
						<div class="card-details">
							<div class="total-record"><%= @panel_requests_submitted %></div>
							<div class="card-name">Panel Firm Requests</div>
							<div class="card-tag-line">Tag lines goes here</div>
						</div>
					</a>
				</li>
			</ul>
		</div>
</div>

<!-- Engage Non Panel Firms Starts-->
<div class="col-lg-12 col-md-12 col-sm-12">
	<div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<div class="page-header-sp">
			<div class="page-title">Engage Non Panel Firms</div>
			<div class="back-edit-actions">
				<a class="btn-show-more" href="/admin/exception_requests">
        Show more
      	</a>
			</div>
  	</div>		
		<div class="no-padding">
			<div class="jarviswidget-editbox"></div>
			<!-- widget content -->
			<div class="widget-body">
				<div class="table-responsive">
					<table id="" class="table table-decoration table-bordered" width="100%">
						<thead>
							<tr>
								<th>Requested By</th>
								<th>Line of Business</th>
								<th>Law Firm Name</th>
								<th>LXP Status</th>
								<th>Lawyer Status</th>
								<!--<th width="8%">Action</th>-->
							</tr>
						</thead>
						<tbody>
							<% @exception_requests.each do |exception_request| %>
								<% if exception_request.law_firm_id.present? && exception_request.requested_by != nil  %>
									<tr onClick="window.location.href='/admin/exception_requests/<%= exception_request.id %>'">
										<% if exception_request.law_firm_id.present? %>
											<td>
												<div class="firm-name">
													<div class="name-avatar"><img src="<%= get_avatar_image(exception_request&.requested_by&.gsub(" ", "+")) %>"></div>
													<div><%= exception_request.requested_by %></div>
												</div>
											</td>
											<td><%= exception_request.line_of_business %></td>
											<td><%= exception_request.law_firm.try(:name) %></td>
											<td>
												<div class="status">
													<span class="<%= exception_request.lxp_status === "APPROVED" ? 'label label-success' : 'label label-default' %>"> 
														<%= exception_request.try(:lxp_status).try(:titleize) %>
													</span>
												</div>
												<% exception_request.lxp_status %>
											</td>
											<td>
												<% if exception_request.internal_lawyers_status.present? %>
												<div class="status">
													<span class="<%= exception_request.internal_lawyers_status === "APPROVED" ? 'label label-success' : 'label label-default' %>"> 
														<%= exception_request.try(:internal_lawyers_status).try(:titleize) %>
													</span>
												</div>
												<% end %>
											</td>
											<!--<td>
												<% if current_user.role == 'lob' &&  exception_request.try(:lxp_status) != 'APPROVED' %>
													<%= link_to "Edit", edit_admin_exception_request_path(exception_request), class: "btn btn-xs btn-primary" %>
												<% end %> 
												<%= link_to "Review", admin_exception_request_path(exception_request), class: "btn btn-xs btn-secondary" %>	
											</td>-->
										<% end %>
									</tr>
              	<% end %>
							<% end %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Engage Non Panel Firms Ends-->

<!-- Conflict Waiver Starts -->
<div class="col-lg-12 col-md-12 col-sm-12">
	<div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<div class="page-header-sp">
			<div class="page-title">Conflict Waiver</div>
