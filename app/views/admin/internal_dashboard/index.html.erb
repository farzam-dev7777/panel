<!-- Matter Intakes Starts -->
<div class="col-lg-12 col-md-12 col-sm-12">
	<div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<div class="page-header-sp">
			<div class="page-title">Matter Intake</div>
			<div class="back-edit-actions">
				<a class="btn-show-more" href="admin/matter_intakes">
        Show more
      	</a>
			</div>
  	</div>		
		<div class="no-padding">
			<div class="jarviswidget-editbox"></div>
			<!-- widget content -->
			<div class="widget-body">
				<div class="table-responsive">
					<table id="" class="table table-decoration table-bordered" width="100%">
						<thead>
							<tr>
								<th>Submitter Name</th>
								<th>LOB Contact Name</th>
								<th>Name of Matter/Client</th>
								<th>Type of Matter</th> 
								<th>Law Firm Suggested</th>
								<th>BMO lawyer name</th>
								<th>Budget amount</th>
								<th>Status</th>
								<!--<th>Action</th>-->
							</tr>
						<tbody>
							<% @matter_intakes.each do |matter_intake| %>
								<tr onClick="window.location.href='/admin/matter_intakes/<%= matter_intake.id %>'">
									<td>
										<div class="firm-name">
                      <div class="name-avatar"><img src="<%= get_avatar_image(matter_intake&.submitter_name&.gsub(" ", "+")) %>"></div>
                      <div><%= matter_intake.submitter_name %></div>
                    </div>
									</td>
									<td><%= matter_intake.lob_contact_name %></td>
									<td><%= matter_intake.name_of_matter_client %></td>
									<td><%= matter_intake.matter_type.try(:matter_type) %></td>
									<td><%= matter_intake.law_firm.try(:name) %></td>
									<td><%= matter_intake.bmo_lawyer_name %></td>
									<td><%= matter_intake.budget_amount %></td>
									<td>
										<div class="status">
											<span class="<%= matter_intake.status === "matter_open" ? 'label label-success' : 'label label-default' %>"> 
												<%= matter_intake.status.try(:titleize) %>
											</span>
										</div>
									</td>
									<!--<td>
										<% if @current_user.role === "internal_lawyers" && (matter_intake.status === "waiting_for_lawyer_review" || matter_intake.status === "waiting_for_lawyer_update") %>
											<%= link_to "review", review_admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>	
										<% elsif @current_user.role === "lxp" %>
											<% if matter_intake.status === "waiting_for_lxp_review" %>
												<%= link_to "review", lxp_review_admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>
											<% end %>
										<% end %>
										<%= link_to "view", admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>
									</td>-->
								</tr>
							<% end %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Matter Intakes Ends-->

<div class="col-lg-12 col-md-12 col-sm-12">
	<div class=" jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<div class="page-header-sp">
			<div class="page-title">Panel Request</div>
			<div></div>
  	</div>
		<div class="no-padding">
			<!-- widget content -->
			<div class="widget-body">
				<div class="table-responsive">
					<!-- db_lfs id for dynamic table -->
					<table id="" class="table table-decoration table-bordered" width="100%">
						<thead>
							<tr>
								<th>Requested By</th>
								<th>Submitted By</th>
								<th>LOB Contact Name</th>
								<th>Action</th>
							</tr>
						</thead>
						<tbody>
							<% @panel_requests.each do |panel_request| %>
							<tr class="" data-id="<%= panel_request.id %>">
								<td>
									<div class="firm-name">
										<div class="name-avatar"><img src="<%= get_avatar_image(panel_request&.requested_by&.gsub(" ", "+")) %>"></div>
										<div><%= panel_request.requested_by %></div>
									</div>
								</td>
								<td><%= panel_request.submitted_by_email %></td>
								<td><%= panel_request.lob_contact_name %></td>
								<td>
									<% if current_user.role == 'lxp' &&  panel_request.try(:lxp_status) != 'APPROVED' %>
										<%= link_to "Edit", edit_admin_panel_request_path(panel_request), class: "btn btn-xs btn-primary" %>
									<% end %> 
									<%= link_to "Review", admin_panel_request_path(panel_request), class: "btn btn-xs btn-secondary" %>	
								</td>
							</tr>
							<% end %>
						</tbody>
					</table>
				</div>		
			</div>
		</div>
	</div>
</div>

