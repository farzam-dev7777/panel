<div>

	<div class="col-xs-12 col-sm-12 col-md-8 col-lg-8">
		<ul id="sparks" class="text-left">
			<li class="sparks-info">
				<a href="/admin/law_firms?filter=onboarded">
					<h5 class="current-month-info"> Onboarded 
						<span class="txt-color">
							- <%= LawFirm.where('id NOT IN (SELECT DISTINCT(law_firm_id) FROM form_submissions)').count %> -
						</span>
					</h5>
				</a>
			</li>
			<li class="sparks-info">
				<a href="/admin/law_firms?filter=under_process">
					<h5 class="current-month-info"> In Process 
						<span class="txt-color-yellow">- <%= LawFirm.joins(:form_submissions).where("form_submissions.created_at = (SELECT MAX(form_submissions.created_at) FROM form_submissions WHERE form_submissions.law_firm_id = law_firms.id) AND form_submissions.status='sent' OR  form_submissions.status='submitted' OR  form_submissions.status='started'").count %> -</span>
					</h5>
				</a>
			</li>
			<li class="sparks-info">
				<a href="/admin/law_firms?filter=certified">
					<h5 class="current-month-info"> Certified 
						<span class="txt-color-green">
							- <%= LawFirm.joins(:form_submissions).where("form_submissions.created_at = (SELECT MAX(form_submissions.created_at) FROM form_submissions WHERE form_submissions.law_firm_id = law_firms.id) AND form_submissions.status='approved'").count %> -
						</span>
					</h5>
				</a>
			</li>
			<li class="sparks-info">
				<a href="/admin/law_firms?filter=decertified">
					<h5 class="current-month-info"> Decertified 
						<span class="txt-color-red">- <%= LawFirm.joins(:form_submissions).where("form_submissions.created_at = (SELECT MAX(form_submissions.created_at) FROM form_submissions WHERE form_submissions.law_firm_id = law_firms.id) AND form_submissions.status='decertified'").count %> -</span>
					</h5>
				</a>
			</li>
		</ul>
	</div>

	<div class="col-md-4 pull-right">
		<%= link_to new_admin_law_firm_path, class: "btn-onboard btn-green pull-right" do %>
			<i class="fa fa-arrow-circle-up" aria-hidden="true"></i>
			<p>Onboard</p>
		<% end %>
	</div>

</div>


