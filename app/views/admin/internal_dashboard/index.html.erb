<div>

	<div class="col-xs-12 col-sm-5 col-md-7 col-lg-7">
		<ul id="sparks" class="text-left">
			<li class="sparks-info">
				<h5 class="current-month-info"> Sealed Firms 
					<span class="txt-color-green">
						<% @fs = FormSubmission.where(law_firm_id: LawFirm.all.pluck(:id)) %>
						- <%= @fs.map(&:status).count('approved') %> -
					</span>
				</h5>
			</li>
			<li class="sparks-info">
				<h5 class="current-month-info"> Under Process 
					<span class="txt-color-yellow">- <%= @fs.map(&:status).count('sent') + @fs.map(&:status).count('review') + @fs.map(&:status).count('follow_up') %> -</span>
				</h5>
			</li>
			<li class="sparks-info">
				<h5 class="current-month-info"> Decertified 
					<span class="txt-color-red">- <%= @fs.map(&:status).count('declined') %> -</span>
				</h5>
			</li>
		</ul>
	</div>

	<div class="col-md-4 pull-right">
		<%= link_to "Create New Law Firm", new_admin_law_firm_path, class: "btn btn-primary btn-md pull-right" %>
	</div>

</div>


<div class="row">
	<div class="col-md-12">
		<article class="col-sm-12">
			<!-- new widget -->
			<div class="jarviswidget" id="wid-id-0" data-widget-editbutton="false">
					<!-- widget options:
					usage: <div class="jarviswidget" id="wid-id-0" data-widget-editbutton="false">

					data-widget-colorbutton="false"
					data-widget-editbutton="false"
					data-widget-togglebutton="false"
					data-widget-deletebutton="false"
					data-widget-fullscreenbutton="false"
					data-widget-custombutton="false"
					data-widget-collapsed="true"
					data-widget-sortable="false"

				-->
				<header>
					<span class="widget-icon"> <i class="fa fa-bar-chart-o"></i> </span>
					<h2>SEAL Stats</h2>

				</header>

				<!-- widget div-->
				<div>

					<!-- widget edit box -->
					<div class="jarviswidget-editbox">
						<!-- This area used as dropdown edit box -->

					</div>
					<!-- end widget edit box -->

					<!-- widget content -->
					<div class="widget-body no-padding">

						<div id="bar-chart" class="chart"></div>

					</div>
					<!-- end widget content -->

				</div>
				<!-- end widget div -->

			</div>

		</article>
	</div>
</div>





<% content_for :page_title do %>
<span>Law Firms</span>
<% end %>




<div class="clearfix"></div>

<div class="col-lg-12 col-md-12 col-sm-12">



	<div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<header>
			<span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
			<h2 class="font-md"><strong>Recently SEAL'ed Firms </strong></h2>				
		</header>
		<div class="no-padding">
			<div class="jarviswidget-editbox"></div>
			<!-- widget content -->
			<div class="widget-body">

				<div class="table-responsive">
					<table class="table table-bordered">

						<tr>
							<th>Name</th>
							<th>Email</th>
							<th>Phone</th>
							<th>Score</th>
						</tr>

						<% @law_firms.each do |firm| %>
						<tr>
							<td><%= link_to firm.name, admin_law_firm_path(firm) %>	</td>
							<td><%= firm.email %></td>
							<td><%= firm.phone %></td>
							<td class="text-center">
								<div> 
									<span class="percent txt-color-blue semi-bold">
										<%= firm.form_submissions.try(:latest).try(:score) || '-' %>
									</span> 
								</div>
							</td>
						</tr>

						<% end %>

					</table>
					<div class="clearfix"></div>

				</div>		

			</div>
		</div>
	</div>


</div>



