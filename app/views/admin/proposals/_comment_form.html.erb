<div class="col-lg-12 col-md-12 col-sm-12">
  <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
          <div class="page-header-sp m-top">
          </div>
          <div class="  ">
            <!-- widget content -->
            <div class="">
              <div class="sp-form-bg show-data-fields">
              <div class="page-header-sp m-top">
                <div class="page-title">Add Comment</div>
              </div>
              <%= simple_form_for([@proposal.rfp, @proposal], :url => url_for(:action => 'add_comment', :controller => 'proposals'),
              :method => 'post') do |f| %>
                 <div class="row">
                   <div class="col-xs-12 col-md-6">
                     <label class="label"><%= t('comment') %></label>
                      <textarea class="form-control" type="text" name="comment" id="comment" style="width: 572px; height: 97px;"></textarea>
                   </div>
                   <div class="col-xs-12 col-md-3" style="left:10%; padding-top: 50px;">
                     <%= f.button :submit, "Submit", class:  "btn-type-primary" %>
                   </div>
                 </div>
             <% end %>
              </div>
            </div>
          </div>
        </div>
    </div>
  </div>
</div>