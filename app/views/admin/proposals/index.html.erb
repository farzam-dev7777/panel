<% content_for :page_title do %>
	<span>Proposals</span>
<% end %>


<div class="col-lg-12">
	<div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
			<div class="page-header-sp m-top">
				<div class="page-title">Proposals</div>
  		</div>
			<!-- widget div-->
			<div>

				<!-- widget content -->
				<div class="table-dyanmic-search table-responsive">
					<table id="dt_basic" class="table table-decoration table-bordered"  width="100%">
						<thead>			                
							<tr>
							<th>Law Firm</th>
							<th>Date Submitted</th>
							<th>Submitted By</th>
							<th>Status</th>
							<th>Action</th>
							</tr>
						</thead>
						<tbody>
							<% @rfp.proposals.each do |proposal| %>
								<tr class="proposal-row" data-url="<%= admin_rfp_proposal_path(proposal.rfp, proposal) %>">
									<td><%= proposal.law_firm&.name %></td>
									<td data-order="<%= proposal.created_at.strftime('%Y%m%d%H%M') %>">
										<%= proposal.created_at.strftime('%d %b %Y') %></td>
									<td><%= proposal.created_by&.name %></td>
									<td><%= proposal.show_status %></td>
									<td>
										<% if proposal.status == 'approved'%>
											<button type="button" class="btn btn-xs btn-secondary" data-dismiss="modal" disabled='disabled'>Approve</button>
										<% else %>
											<%= link_to "Approve", accept_admin_rfp_proposal_path(proposal.rfp, proposal), class: "btn btn-xs btn-secondary" %>
										<% end %>
									</td>
								</tr>
							<% end %>
						</tbody>
					</table>

				</div>
				<!-- end widget content -->

			</div>
			<!-- end widget div -->

		</div>
		<!-- end widget -->

</div>
