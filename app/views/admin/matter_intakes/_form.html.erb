<div class="table-responsive">
  <%= simple_form_for [:admin, @matter_intake] do |f| %>
    <table class="table table-striped">
      <tbody>
        <tr>
          <td class="text-right" width="20%"><strong>BMO lawyer name </strong></td>
          <td>
            <%= f.input :bmo_lawyer_name, label: false, :input_html => { :value => current_user.try(:full_name) } %>
            <%= f.input :lawyer_id, as: :hidden, label: false, :input_html => { :value => current_user.try(:id) } %>
            <%= f.input :form_type, as: :hidden, label: false, :input_html => { :value => @form_type } %>
          </td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>Legal Group of BMO Lawyer </strong></td>
          <td>
            <%= f.input :legal_group_of_bmo_lawyer, label: false, collection: MatterIntake::LegalGroupBMOLawyer %>
          </td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>Work Area </strong></td>
          <td>
            <%= f.input :work_area, label: false, collection: @form_type == "litigation" ? MatterIntake::WorkAreaLitigation : MatterIntake::WorkArea  %>
          </td>
        </tr>
        <tr class="work_area_reportable" style="display: none;">
          <td class="text-right" width="20%"><strong>Is this matter ORE reportable? </strong></td>
          <td>
            <%= f.input :is_ore_reportable, label: false, collection: [['Yes', true], ["No", false]] %>
          </td>
        </tr>
        <tr class="work_area_reportable" style="display: none;">
          <td class="text-right" width="20%"><strong>Is this matter otherwise reportable? </strong></td>
          <td>
            <%= f.input :is_otherwise_reportable, label: false, collection: [['Yes', true], ["No", false]] %>
          </td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>Is this a syndicate matter? </strong></td>
          <td>
            <%= f.input :is_syndicate_matter, label: false, collection: [['Yes', true], ["No", false]] %>
          </td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>Conceal iManage Workspace? </strong></td>
          <td>
            <%= f.input :is_conceal_imanage_workspace, label: false, collection: [['Yes', true], ["No", false]] %>
          </td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>Paper file? </strong></td>
          <td>
            <%= f.input :is_paper_file, label: false, collection: [['Yes', true], ["No", false]] %>
          </td>
        </tr>
        <tr>
        <td class="text-right" width="20%"><strong>Matter name </strong></td>
          <td><%= f.input :name_of_matter_client, label: false %></td>
        </tr>
        <tr>
        <td class="text-right" width="20%"><strong>Matter Description </strong></td>
          <td><%= f.input :matter_description, label: false %></td>
        </tr>
        <tr>
        <td class="text-right" width="20%"><strong>Legal Entity </strong></td>
          <td><%= f.input :paying_entity, label: false, collection: MatterIntake::LegalEntity %></td>
        </tr>
        <tr>
        <td class="text-right" width="20%"><strong>Business Paying for this Matter </strong></td>
          <td><%= f.input :business_paying_for_matter, label: false, collection: MatterIntake::Business %></td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>Group Paying for this Matter </strong></td>
          <td><%= f.input :group_paying_for_matter, label: false, collection: [] %></td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>Jurisdiction </strong></td>
          <td><%= f.input :jurisdiction, label: false, collection: MatterIntake::Jurisdiction %></td>
        </tr>
        <% if @form_type == "litigation" %>
          <tr>
            <td class="text-right" width="20%"><strong>Branch </strong></td>
            <td><%= f.input :branch, label: false %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Will outside counsel be engaged?  </strong></td>
            <td><%= f.input :outside_counsel_engaged, label: false, collection: MatterIntake::OutsideCounselEngaged %></td>
          </tr>
        <% end %>
        <tr>
        <td class="text-right" width="20%"><strong>How will this matter be paid? </strong></td>
          <td><%= f.input :mode_of_payment, label: false, collection: MatterIntake::MatterBePaidOptions %></td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>Cost Centre for legal fees </strong></td>
          <td><%= f.input :cost_centre_for_legal_fees, label: false %></td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>LOB contact to create PO </strong></td>
          <td><%= f.input :lob_contact_for_po, label: false %></td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>Panel or Non-Panel Firm </strong></td>
          <td><%= f.input :firm_type, label: false, collection: MatterIntake::FirmType %></td>
        </tr>
        <tr class="panel_firm" style="display: none;">
          <td class="text-right" width="20%"><strong>Name of Panel Firm </strong></td>
          <td><%= f.input :name_of_panel_firm, label: false %></td>
        </tr>
        <tr class="non_panel_firm" style="display: none;">
          <td class="text-right" width="20%"><strong>Name of Non-Panel Firm </strong></td>
          <td><%= f.input :name_of_non_panel_firm, label: false %></td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>Type of Pricing </strong></td>
          <td><%= f.input :type_of_price, label: false, collection: MatterIntake::TypeOfPrice %></td>
        </tr>
        <tr class="alternative_fee" style="display: none;">
          <td class="text-right" width="20%"><strong>Is there an Alternative Fee Arrangement? </strong></td>
          <td>
            <%= f.input :is_alternative_fee_arrangement, label: false, collection: [['Yes', true], ["No", false]] %>
          </td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>AFA Details </strong></td>
          <td><%= f.input :afa_details, label: false %></td>
        </tr>
        <% if @form_type == "litigation" %>
          <tr>
            <td class="text-right" width="20%"><strong>Could this matter be reimbursed? </strong></td>
            <td>
              <%= f.input :can_reimbursed_matter, label: false, collection: [['Yes', true], ["No", false]] %>
            </td>
          </tr>
        <% end %>
        <tr>
          <td class="text-right" width="20%"><strong>Other Party (Other than BMO) </strong></td>
          <td><%= f.input :other_party, label: false, collection: MatterIntake::OtherParty %></td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>Additional Matter Contact (not specified elsewhere) </strong></td>
          <td><%= f.input :additional_matter_contact, label: false %></td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>Budget amount, if already negotiated with the law firm </strong></td>
          <td><%= f.input :budget_amount, label: false %></td>
        </tr>
        <tr>
          <td class="text-right" width="20%"><strong>Other Matter Issues (not specified elsewhere) </strong></td>
          <td><%= f.input :other_matter_issues, label: false %></td>
        </tr>
        <tr>
        <% if @form_type == "litigation" %>
          <tr>
            <td class="text-right" width="20%"><strong>Background/Key Facts (other than matter description </strong></td>
            <td><%= f.input :key_facts, label: false %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Legal Analysis </strong></td>
            <td><%= f.input :legal_analysis, label: false %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Stage of Litigation </strong></td>
            <td><%= f.input :stage_of_litigation, label: false, collection: MatterIntake::StageOfLitigation %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Allegation of Employee Misconduct? </strong></td>
            <td>
              <%= f.input :allegation_of_employee_misconduct, label: false, collection: [['Yes', true], ["No", false]] %>
            </td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Primary Issue </strong></td>
            <td><%= f.input :primary_issue, label: false, collection: MatterIntake::PrimaryIssue %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Secondary Issue </strong></td>
            <td><%= f.input :secondary_issue, label: false, collection: MatterIntake::SecondaryIssue %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>What Party is BMO in this action? </strong></td>
            <td><%= f.input :bmo_party, label: false, collection: MatterIntake::BMOParty %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Opposing Counsel Firm </strong></td>
            <td><%= f.input :opposing_counsel_firm, label: false %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Written Legal Notice Required </strong></td>
            <td><%= f.input :written_legal_notice_required, label: false, as: :boolean %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Arbitration Offered </strong></td>
            <td>
              <%= f.input :arbitration_offered, label: false, collection: [['Yes', true], ["No", false]] %>
            </td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Arbitration Accepted </strong></td>
            <td>
              <%= f.input :arbitration_accepted, label: false, collection: [['Yes', true], ["No", false]] %>
            </td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Branch Manager/Investment Advisor Name </strong></td>
            <td><%= f.input :branch_manager_investment_advisor, label: false %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Region (Canadian P&C) </strong></td>
            <td><%= f.input :region_name, label: false, collection: MatterIntake::Region %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Date Suit Filed </strong></td>
            <td><%= f.input :date_suit_filed, label: false, as: :date, html5: true %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Unquantified Claim </strong></td>
            <td>
              <%= f.input :unquantified_claim, label: false, collection: [['Yes', true], ["No", false]] %>
            </td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Valued at $50,000 or more </strong></td>
            <td>
              <%= f.input :valued_at, label: false %>
            </td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Amount Claimed from BMO 1 </strong></td>
            <td>
              <%= f.input :amount_claimed_from_bmo_1, label: false %>
            </td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Amount Claimed 1 currency </strong></td>
            <td><%= f.input :amount_claimed_1_currency, label: false, collection: MatterIntake::AmountCurrency %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Amount Claimed from BMO 2 </strong></td>
            <td>
              <%= f.input :amount_claimed_from_bmo_2, label: false %>
            </td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Amount Claimed 2 currency </strong></td>
            <td><%= f.input :amount_claimed_2_currency, label: false, collection: MatterIntake::AmountCurrency %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Amount Claimed by BMO </strong></td>
            <td>
              <%= f.input :amount_claimed_by_bmo, label: false %>
            </td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Amount Claimed by BMO currency </strong></td>
            <td><%= f.input :amount_claimed_by_bmo_currency, label: false, collection: MatterIntake::AmountCurrency %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Breakdown of Claim Amount </strong></td>
            <td><%= f.input :breakdown_of_claim_amount, label: false %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Court Name </strong></td>
            <td><%= f.input :court_name, label: false %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Case Caption </strong></td>
            <td><%= f.input :case_caption, label: false %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Court Type </strong></td>
            <td><%= f.input :court_type, label: false, collection: MatterIntake::CourtType %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Docket Number </strong></td>
            <td><%= f.input :docket_number, label: false %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Comset Issues </strong></td>
            <td><%= f.input :comset_issues, label: false, collection: MatterIntake::ComsetIssues %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Comset Ref: </strong></td>
            <td><%= f.input :comset_ref, label: false %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>M&I Matter </strong></td>
            <td>
              <%= f.input :mi_matter, label: false, collection: [['Yes', true], ["No", false]] %>
            </td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Nature of Events </strong></td>
            <td><%= f.input :nature_of_events, label: false %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Process Type Level 1 </strong></td>
            <td><%= f.input :process_type_level_1, label: false, collection: MatterIntake::ProcessTypeLevel1 %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Process Type Level 2 </strong></td>
            <td><%= f.input :process_type_level_2, label: false, collection: [] %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Product Type Level 1 </strong></td>
            <td><%= f.input :product_type_level_1, label: false, collection: MatterIntake::ProductTypeLevel1 %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Product Type Level 2 </strong></td>
            <td><%= f.input :product_type_level_2, label: false, collection: [] %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Event Type Level 1 </strong></td>
            <td><%= f.input :event_type_level_1, label: false, collection: MatterIntake::EventTypeLevel1 %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Event Type Level 2 </strong></td>
            <td><%= f.input :event_type_level_2, label: false, collection: [] %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Business Activity Level 1 </strong></td>
            <td><%= f.input :business_activity_level_1, label: false, collection: MatterIntake::BusinessActivityLevel1 %></td>
          </tr>
          <tr>
            <td class="text-right" width="20%"><strong>Business Activity Level 2 </strong></td>
            <td><%= f.input :business_activity_level_2, label: false, collection: [] %></td>
          </tr>
        <% end %>
        <td colspan="2">
          <%=link_to 'Cancel', @matter_intake.new_record? ? new_admin_matter_intake_path : new_admin_matter_intake_path, class: 'btn btn-danger btn-sm' %>
          <%= f.button :submit, @matter_intake.new_record? ? "Submit Matter Intake" : "Update Matter Intake", class: "" %>
        </td>
      </tr>
      </tbody>
    </table>
  <% end %>
</div>