<% content_for :page_title do %>
  <span>Matters</span>
  <% end %>
  <div class="clearfix"></div>

<div class="col-lg-12">
<div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false"> 
  <div class="page-header-sp m-top">
    <div class="page-title">Matters</div>
  </div>
  
  <div class="">
    
    <!-- Search Filter -->
      <div class="search-filter-sp">
        <div class="sp-filter">
          <div class="accordion" id="sp-filter">
            <div class="card z-depth-0">
              <div class="card-header" id="headingThree">
                <div class="action-buttons-alignment">
                  <a class="export-icon right-action-btns add-button" href="<%= new_admin_matter_intake_path(form_type: 'general') %>">
                    <%= image_tag "add.svg", alt:"General Intake" %> <span>New Matter Request</span>
                  </a>
                  <!--<a class="export-icon right-action-btns add-button" href="<%= new_admin_matter_intake_path(form_type: 'litigation') %>">
                    <%= image_tag "add.svg", alt:"Litigation Intake" %> <span>Litigation Intake</span>
                  </a>-->
                </div>
                <div class="collapsed filter-title" type="button" data-toggle="collapse" data-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                  <%= image_tag "filter-icon.svg", alt:"score" %>
                  <span>Filter</span>
                </div>
              </div>
              <div id="collapseThree" class="col-md-12 collapse sp-filter-fields" aria-labelledby="headingThree" data-parent="#sp-filter">
                <div class="card-body sp-form">
                  <%= search_form_for [:admin, @q] do |f| %>
                    <div class="row">
                      <div class="col-xs-12 col-md-3">
                        <%= f.label :matter_description_cont, label: false, :class => 'label' %>
                        <%= f.search_field :matter_description_cont, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 col-md-3">
                        <%= f.label :invoice_status_cont, label: false, :class => 'label' %>
                        <%= f.search_field :invoices_status_cont, value: @invoice_status, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 col-md-3">
                        <%= f.label :budget_amount_lt_any, 'Fee estimate(max amount)', :class => 'label' %>
                        <%= f.search_field :budget_amount_lt_any, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 col-md-3">
                        <label label="false" class="label" for="q_name_of_matter_client_cont">Include Archive</label>
                        <br>
                        <%= check_box_tag('q[include_archive][]', ((params[:q]||{})[:include_archive]), ((params[:q]||{})[:include_archive]).present?, style: "margin-top: 18px;") %>
                      </div>
                      <div class="col-xs-12 text-right">
                        <%= f.submit "Search", class: "btn-type-primary input-btn m-right" %>
                        <%= f.submit "Reset", type: "reset", value: "Reset",  class: "btn-type-default input-btn" %>
                      </div>
                    </div>        
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    <!-- Search Filter END -->

    <%= render "/shared/matter_list", matters: @matter_intakes%>
    <!-- end widget div -->
  </div>
  <!-- end widget -->
</div>

