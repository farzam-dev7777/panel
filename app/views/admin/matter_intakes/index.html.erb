<% content_for :page_title do %>
  <span>Matter Intakes</span>
  <% end %>
  <div class="clearfix"></div>

<div class="col-lg-12">
<div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false"> 
  <div class="page-header-sp m-top">
    <div class="page-title">Matter Intake Forms</div>
    <div>
      <% if @current_user.role === "internal_lawyers" %>
        <div class="project-context sp-inner-dropdown">
          <span class="dropdown-toggle sp-derpdwon" data-toggle="dropdown">
            <div class="dropdown-text">Submit New Matter Intake Form</div>
            <span class="drop-down-icon">
              <%= image_tag "drop-down-icon.png", alt:"Drop menu" %>
            </span>
          </span>
          <ul class="dropdown-menu">
            <li id="" class="">
              <%= link_to 'General Intake', new_admin_matter_intake_path(form_type: "general"), html_options = {class: ''}   %>
            </li>
            <li role="separator" class="divider"></li>
            <li id="" class="">
              <%= link_to 'Litigation Intake', new_admin_matter_intake_path(form_type: "litigation"), html_options = {class: ''}   %>
            </li> 
          </ul>
          <!-- end dropdown-menu-->
        </div>
      <% end %>
    </div>
  </div>
  
  <div class="">
    
    <!-- Search Filter -->
      <div class="search-filter-sp">
        <div class="sp-filter">
          <div class="accordion" id="sp-filter">
            <div class="card z-depth-0">
              <div class="card-header" id="headingThree">
                <div class="collapsed filter-title" type="button" data-toggle="collapse" data-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                  <%= image_tag "filter-icon.svg", alt:"score" %>
                  <span>Filter</span>
                </div>
              </div>
              <div id="collapseThree" class="col-md-12 collapse sp-filter-fields" aria-labelledby="headingThree" data-parent="#sp-filter">
                <div class="card-body sp-form">
                  <%= search_form_for [:admin, @q] do |f| %>
                    <div class="row">
                      <div class="col-xs-12 col-md-4">
                        <%= f.label :submitter_name_cont, label: false, :class => 'label' %>
                        <%= f.search_field :submitter_name_cont, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 col-md-4">
                        <%= f.label :name_of_matter_client_cont, label: false, :class => 'label' %>
                        <%= f.search_field :name_of_matter_client_cont, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 col-md-4">
                        <%= f.label :bmo_lawyer_name_cont, label: false, :class => 'label' %>
                        <%= f.search_field :bmo_lawyer_name_cont, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 text-right">
                        <%= f.submit "Search", class: "btn-type-primary input-btn m-right" %>
                        <%= f.submit "Reset", type: "reset", value: "Reset",  class: "btn-type-default input-btn" %>
                      </div>
                    </div>        
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    <!-- Search Filter END -->

    <div>
      <!-- widget content -->
      <div class="table-dyanmic-search table-responsive">
        <table id="dt_basic" class="table table-decoration table-bordered" width="100%">
          <thead>
            <tr>
              <th>Date Submitted</th>
              <th>Submitter Name</th>
              <!--<th>LOB Contact Name</th>-->
              <th>Name of Matter/Client</th>
              <th>Type of Matter</th> 
              <th>Law Firm Suggested</th>
              <th>Matter Number</th>
              <!--<th>Budget amount</th>-->
              <th>Status</th>
              <!--<th>Action</th>-->
            </tr>
          </thead>
          <tbody>
            <% @matter_intakes.each do |matter_intake| %>
              <tr onClick="window.location.href='/admin/matter_intakes/<%= matter_intake.id %>'">
                <td>
                  <%= matter_intake.created_at.strftime('%d %b %Y at %I:%M %p') %>
                </td>
                <td>
                  <% if matter_intake.submitter_name.present? %>
                  <div class="firm-name">
                    <div class="name-avatar"><img src="<%= get_avatar_image(matter_intake&.submitter_name&.gsub(" ", "+")) %>"></div>
                    <div><%= matter_intake.submitter_name %></div>
                  </div>
                  <% end %>
                </td>
                <!--<td><%= matter_intake.lob_contact_name %></td>-->
                <td><%= matter_intake.name_of_matter_client %></td>
                <td><%= matter_intake.matter_type.try(:matter_type) %></td>
                <td><%= matter_intake.law_firm.try(:name) %></td>
                <td><%= matter_intake.matter_number %></td>
                <!--<td><%= matter_intake.budget_amount %></td>-->
                <td>
                  <div class="status">
                    <span class="<%= matter_intake.status === "matter_open" ? 'label label-success' : 'label label-default' %>"> 
                      <%= matter_intake.status.try(:titleize) %>
                    </span>
                  </div>
                </td>
                <!--<td>
                  <% if @current_user.role === "internal_lawyers" && (matter_intake.status === "waiting_for_lawyer_review" || matter_intake.status === "waiting_for_lawyer_update") %>
                    <%= link_to "review", review_admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>	
                  <% elsif @current_user.role === "lxp" %>
                    <% if matter_intake.status === "waiting_for_lxp_review" %>
                      <%= link_to "review", lxp_review_admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>
                    <% end %>
                  <% end %>
                  <%= link_to "view", admin_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>
                </td>-->
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <!-- end widget content -->
    </div>
    <!-- end widget div -->
  </div>
  <!-- end widget -->
</div>

