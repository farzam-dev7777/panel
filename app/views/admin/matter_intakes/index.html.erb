                    <div class="row">
                      <div class="col-xs-12 col-md-4">
                        <%= f.label :submitter_name_cont, label: false, :class => 'label' %>
                        <%= f.search_field :submitter_name_cont, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 col-md-4">
