<% if @matter_intake.invoices.count > 0 %>
  <div class="col-md-12 col-xs-12">
    <div class="formHeader">
      <div class="headerTitle">Invoices</div>
    </div>
    <% @matter_intake.invoices.each do |invoice| %>
      <div class="formSection row">
        <div class="col-xs-12 col-md-2">
          <div class="field-label">Lawyer Name</div>
          <div class="field-data"><%= invoice.lawyer_name %></div>
        </div>

        <div class="col-xs-12 col-md-2">
          <div class="field-label">Hours</div>
          <div class="field-data"><%= invoice.hours %></div>
        </div>

        <div class="col-xs-12 col-md-2">
          <div class="field-label">Description</div>
          <div class="field-data"><%= invoice.description %></div>
        </div>

        <div class="col-xs-12 col-md-2">
          <div class="field-label">Rate Type</div>
          <div class="field-data"><%= invoice.rate_type %></div>
        </div>

        <div class="col-xs-12 col-md-2">
          <div class="field-label">Amt.</div>
          <div class="field-data"><%= invoice.amount.format %></div>
        </div>

        <div class="col-xs-12 col-md-2">
          <div class="field-label">Attachments</div>
          <div class="field-data">
            <% if invoice.invoice_attachments.count > 0 %>
              <% invoice.invoice_attachments.each do |attachment| %>
                <a href="<%= attachment.file&.url %>" target="_blank"><%= attachment.file.identifier %></a>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <div class="col-md-12 col-xs-12">
    <div class="totalRow">
      <div>
        <span>Total Hours:</span> <%= @matter_intake.invoices.sum(&:hours) %>
      </div>
      <div>
        <span>Total Amt:</span> <%= @matter_intake.invoices.sum(&:amount).try(:format) %>
      </div>
    </div>
  <div>
<% end %>
</div>
<div class="clearfix"></div>
</div>
</div>
</div>
</div>
</div>
</div>
<div class="col-md-12">
  <%- if @matter_intake.reviews.size > 0 %>
    <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
      <div class="page-header-sp">
        <div class="page-title">Review Logs</div>
        <div class="back-edit-actions">
        </div>
      </div>
      <div>
        <div class="clearfix"></div>
        <!-- MAIN PANEL -->
        <div role="main">
          <!-- MAIN CONTENT -->
          <div>
            <!-- row -->
            <div class="row">
              <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <div class="sp-form-bg">
                  <!-- Timeline Content -->
                  <div class="smart-timeline">
                    <ul class="smart-timeline-list">
                      <% @matter_intake.reviews.reverse.each do |review| %>
                        <% if review.status_from.blank? && review.status.blank? && review.assigned_to_id.present? %>
                          <li data-id="<%= review.id %>">
                            <div class="smart-timeline-icon">
                              R
                            </div>
                            <div class="smart-timeline-time">
                              <small><%= review.created_at.strftime('%d %b %Y at %I:%M %p') %></small>
                            </div>
                            <div class="smart-timeline-content">
                              <p>
                                <strong>
                                  <%= review.actor.email %> assigned exception request to internal lawyer for approval.
                                  <strong>
                                  </p>
                                  <p>
                                    <%= review.description %>
                                  </p>
                                </div>
                              </li>
                            <% else %>
                              <li data-id="<%= review.id %>">
                                <div class="smart-timeline-icon">
                                  R
                                </div>
                                <div class="smart-timeline-time">
                                  <small><%= review.created_at.strftime('%d %b %Y at %I:%M %p') %></small>
                                  <small><i><%= time_ago_in_words(review.created_at) %> ago</i> </small>
                                </div>
                                <div class="smart-timeline-content">
                                  <p>
                                    <strong>
                                      <%- if review.status === "requires_an_update"  %>
                                        <%= review.actor.full_name %>  returned to lawyer for update
                                      <% elsif review.status_show %>
                                        <%= review.actor.email %> change status to <%= review.status_show %>
                                      <% else %>
                                        <%= review.actor.email %> left a comment
                                      <% end %>
                                      <strong>
                                      </p>
                                      <p>
                                        <%= review.description.blank? ? "NA" : review.description %>
                                      </p>
                                    </div>
                                  </li>
                                <% end %>
                              <% end %>
                            </ul>
                          </div>
                          <!-- END Timeline Content -->
                        </div>
                      </div>
                    </div>
                    <!-- end row -->
                  </div>
                  <!-- END MAIN CONTENT -->
                </div>
                <!-- END MAIN PANEL -->
              </div>
            </div>
          <% end %>
        </div>
