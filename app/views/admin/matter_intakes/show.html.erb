<%if @matter_intake&.form_type === 'general' || @matter_intake&.form_type.blank? %>
  <%= render "show_v2" %>
<% else %>
  <%= render "show_v1" %> 
<% end %>
<div class="col-md-12">
  <%= link_to "Delete", admin_matter_intake_path(@matter_intake), method: :delete, class: "btn btn-xs btn-secondary btn-danger", data: { confirm: 'Are you sure you want to delete this?' } %>
</div>