<% content_for :page_title, "Messages" %>

<div id="inbox-content" class="inbox-body no-content-padding">
  <%= render partial: 'sidebar' %>
  <div class="table-wrap custom-scroll animated fast fadeInRight">
    <table id="inbox-table" class="table table-striped table-hover">
      <tbody>
        <% @conversations.each do |conversation| %>
          <% receipt = ReceiptDecorator.decorate(conversation.receipts.object.where(mailbox_type: 'sentbox').last) %>
          <tr class="unread" >
            <td class="inbox-table-icon">
              <div class="checkbox">
                <label>
                  <input type="checkbox" class="checkbox style-2">
                  <span></span> </label>
              </div>
            </td>
            <td class="inbox-data-from hidden-xs hidden-sm">
              <div>
                <%= receipt.receiver.name %>
              </div>
            </td>
            <td class="inbox-data-message">
              <div>
                <span>
                  <a href="/admin/messages/<%= conversation.id %>">
                    <%= receipt.message.subject %>
                  </a>
                </span>
                <%= receipt.message.body_excerpt %>
              </div>
            </td>
            <!-- <td class="inbox-data-attachment hidden-xs">
              <div>
                <a href="javascript:void(0);" rel="tooltip" data-placement="left" data-original-title="FILES: rocketlaunch.jpg, timelogs.xsl" class="txt-color-darken"><i class="fa fa-paperclip fa-lg"></i></a>
              </div>
            </td> -->
            <td class="inbox-data-date hidden-xs">
              <div>
                <%= receipt.message.humanized_created_at %>
              </div>
            </td>
          </tr>
        <% end %>

      </tbody>
    </table>
  </div>
</div>