<% content_for :page_title do %>
	<span>Frequently Asked Questions</span>
<% end %>


<% content_for :page_buttons do %>
	<%= link_to "Create New FAQ", new_admin_frequently_asked_question_path, class: "btn btn-primary btn-md pull-right m-b-20" %>
<% end %>

<div class="clearfix"></div>




<div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
	<header>
		<span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
		<h2 class="font-md"><strong>Current FAQs </strong></h2>				
	</header>
	<div class="no-padding">
		<div class="jarviswidget-editbox"></div>
		<!-- widget content -->
		<div class="widget-body">

			<div class="col-lg-12 col-md-12 col-sm-12">

				<div class="table-responsive">
					<table class="table table-bordered">
						<thead>
							<tr style="background: #00a0af;color: #fff;">
								<th>Question</th>
								<th>Answer</th>
								<th>Created</th>
								<th>Action</th>
							</tr>
						</thead>

						<tbody>
							<% @faqs.each do |faq| %>
								<tr>
									<td><%= faq.question %></td>
									<td><%= faq.answer %></td>
									<td><%= "#{time_ago_in_words(faq.created_at)} ago" %></td>
									<td class="text-center">
										<%= link_to "Edit", edit_admin_frequently_asked_question_path(faq), class: "btn btn-xs btn-primary" %>	
										<%= link_to "Delete", admin_frequently_asked_question_path(faq), method: :delete, class: "btn btn-xs btn-primary", data: { confirm: "Are you you want to delete?" } %>	
									</td>
								</tr>
							<% end %>
						</tbody>

					</table>
					<div class="clearfix"></div>

					<%= will_paginate @faqs, renderer: BootstrapPagination::Rails %>
				</div>
			</div>	

		</div>
	</div>
</div>