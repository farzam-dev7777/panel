<% content_for :page_title do %>
<% if @faq.new_record? %>
<span>Create new FAQ</span>
<% else %>
<span>Edit <%= @faq.question %></span>
<% end %>
<% end %>
<div class="table-responsive">
	<%= simple_form_for([:admin, @faq]) do |f| %>
		<table class="table table-bordered">

			<tbody>
				<tr>
					<td>Question</td>
					<td><%= f.input :question, autofocus: true, label: false %></td>
				</tr>

				<tr>
					<td>Description</td>
					<td><%= f.input :answer, label: false %></td>
				</tr>

				<tr>
					<td>Category</td>
					<td><%= f.input :faq_category_id, label: false, collection: FaqCategory.all %></td>
				</tr>

				<tr>
					<td colspan="2">
						<%= f.button :submit, f.object.new_record? ? 'Create' : 'Update', class: "btn btn-primary" %>
					</td>
				</tr>

			</tbody>

		</table>
	<% end %>
</div>