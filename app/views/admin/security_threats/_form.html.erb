<%= f.simple_fields_for :technology do |t| %>
<div class="row">
	<div class="col-md-3 vendor-wrapper">
		<%= t.input :vendor, collection: TechnologyValue.pluck(:vendor).uniq, include_blank: 'None',
												 input_html: {class: 'threat-lf-dynamic-select', data: { field: 'vendor' },
												 name: 'security_threat[vendor]' } %>
	</div>
	<div class="col-md-3 platform-wrapper">
		<%= t.input :platform, collection: TechnologyValue.pluck(:platform).uniq, include_blank: 'None', input_html: {class: 'threat-lf-dynamic-select', data: {field: 'platform'}, name: 'security_threat[platform]'} %>
	</div>
	<div class="col-md-3 version-wrapper">
		<%= t.input :version, collection: TechnologyValue.pluck(:version).uniq, include_blank: 'None', input_html: {class: 'threat-lf-dynamic-select', data: {field: 'version'}, name: 'security_threat[version]' } %>
	</div>
	<div class="col-md-3 service_pack-wrapper">
		<%= t.input :service_pack, collection: TechnologyValue.pluck(:service_pack).uniq, include_blank: 'None', input_html: { class: 'threat-lf-dynamic-select', data: {field: 'service_pack'}, name: 'security_threat[service_pack]' } %>
	</div>
</div>
<% end %>
<p id="law-firms-count"></p>

<div class="col-md-9 no-padding">
	<select name="[law_firm_ids][]" id="law-firms" multiple="multiple">
		<% LawFirm.all.uniq.each do |firm| %>
			<option value="<%= firm.id %>"><%= firm.name %></option>
		<% end %>
	</select>
</div>

<div class="col-md-3 text-right">
	<button class="btn btn-primary add-all-lawfirms btn-sm">Add all Law Firms</button>
	<button class="btn btn-danger clear-all-lawfirms btn-sm">Clear</button>
</div>

<div class="clearfix"></div>

<br><hr><br>

<div class="row">
	<div class="col-md-8">
		<%= f.input :title %>
	</div>
	<div class="col-md-4">
		<%= f.input :severity_level, 
								input_html: { name: '[security_threat][severity_level_id]', class: 'severity-level' },
								collection: SeverityLevel.all.map{ |severity| [severity.name.humanize, severity.id] },
								prompt: "Select severity level" %>
	</div>

	<%= render partial: 'severity_negative_factor', locals: { triggers: @triggers } %>

	<div class="col-md-12">
		<%= f.input :description, input_html: { class: 'h-300' } %>
	</div>
</div>

<%= f.submit nil, class: "btn btn-primary" %>