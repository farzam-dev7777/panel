<div class="col-md-12 pull-right">
	<%= link_to "Create New Security Threat", new_admin_security_threat_path, class: "btn btn-primary btn-md pull-right" %>
</div>

<p>&nbsp;</p>


<div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
	<header>
		<span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
		<h2 class="font-md"><strong>Current Threats </strong></h2>				
	</header>
	<div class="no-padding">
		<div class="jarviswidget-editbox"></div>
		<!-- widget content -->
		<div class="widget-body">

			<div class="col-md-12 table-responsive">
				<table class="table table-bordered" id="sec-threat">
					<thead>
					<tr style="background: #007ac3;color: #fff;">
						<th>Title</th>
						<th>Description</th>
						<th></th>
						<th>Severity</th>
						<th>Status</th>
					</tr>
					</thead>
					<tbody>
						<% @security_threats.each do |threat| %>
							<tr class="security-threat-row" data-id="<%= threat.id %>">
								<td><%= threat.title %></td>
								<td><%= truncate(threat.description, length: 150) %></td>
								<td>
									<% if threat.vendor %>
										<p><b>Vendor: </b> <%= threat.vendor %></p>
									<% end %>
									<% if threat.platform %>
										<p><b>Platform: </b> <%= threat.platform %></p>
									<% end %>
									<% if threat.version %>
										<p><b>Version: </b> <%= threat.version %></p>
									<% end %>
									<% if threat.service_pack %>
										<p><b>Service Pack: </b> <%= threat.service_pack %></p>
									<% end %>
								</td>
								<td><%= threat.severity_level.try(:name) %></td>
								<td><%= link_to "More Details", admin_security_threat_path(threat), :class => "", :remote => true, "data-toggle" => "modal", "data-target" => "securityAlert" %></td>
							</tr>
						<% end %>
					</tbody>

				</table>
				<div class="clearfix"></div>

			</div>		

		</div>
	</div>
</div>
