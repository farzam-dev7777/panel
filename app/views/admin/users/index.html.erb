<% content_for :page_title do %>
  <span>Users List</span>
<% end %>
<div class="clearfix"></div>
<div class="col-lg-12">
  <div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
    <header>
      <span class="widget-icon"> <i class="fa fa-briefcase"></i> </span>
      <h2>Users List</h2>
    </header>
    <div class="col-lg-12">
    <div class="no-padding">
      <div class="widget-body">
        <div id="myTabContent" class="tab-content">
          <div class="tab-pane fade active in padding-10 no-padding-bottom" id="s1">
            <div class="row no-space text-center">
              <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <p>
                  <b><%= link_to 'Create New User', new_admin_user_path, html_options = {class: 'btn btn-primary btn-lg dashboard-certificate-button'}   %></b>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- widget div-->
    <div>
      <!-- <%= search_form_for [:admin, @q] do |f| %>
        <div class="row" style="padding-top: 20px;">
          <div class="col-xs-12 col-sm-12">
            <h2 style="margin: 0px 0px 10px;">Search Filter</h2>
          </div>
          <div class="col-xs-12 col-sm-4">
              <strong><%= f.label :email_cont, label: false  %></strong>
              <%= f.search_field :email_cont %>
          </div>
          <div class="col-xs-12 col-sm-4">
            <strong><%= f.label :role_cont %></strong>
            <%= f.search_field :role_cont, label: false, collection: User::PANEL_ADMIN_USER_ROLES.map{ |role| ["#{role.humanize}", role] } %>
           
          </div>
          <div class="col-xs-12 text-right" style="margin-top: 20px;">
              <%= f.submit "Search", class: "btn btn-primary" %>
              <%= f.submit "Reset", type: "reset", value: "Reset",  class: "btn btn-primary" %>
          </div>
        </div>        
      <% end %> -->
      <!-- widget edit box -->
      <div class="jarviswidget-editbox">
        <!-- This area used as dropdown edit box -->
      </div>
      <!-- end widget edit box -->
      <!-- widget content -->
      <div class="widget-body no-padding">
        <table id="" class="table table-striped table-bordered table-hover" width="100%">
          <thead>
            <tr style="background: #007ac3;color: #fff;">
              <th>Name</th>
              <th>Email</th>
              <th>Username</th>
              <th>Role</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |user| %>
              <tr>
                <td><%= "#{user.first_name} #{user.last_name}" %></td>
                <td><%= user.email%></td>
                <td><%= user.username%></td>
                <td><%= user.role.humanize %></td>
                <td>
                  <%= link_to "edit", edit_admin_user_url(user), class: "btn btn-xs btn-secondary" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <!-- end widget content -->
    </div>
    <!-- end widget div -->
  </div>
  <!-- end widget -->
</div>
