<style>
  input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
</style>
<div class="sp-form sp-form-bg">
  <%= simple_form_for [:admin, @panel_request] do |f| %>
    <div class="row form-flex-wrap">
      <!--<div class="col-xs-12 col-md-6">
          <label class="label">Requested By</label>
          <%= f.input :requested_by, label: false %>
        </div>-->
      <div class="col-xs-12 col-md-6">
        <label class="label">Submitted By</label>
        <%= f.input :submitted_by_email, label: false, :input_html => { :value => @current_admin_user_email, :readonly => true } %>
        <%= f.input :user_id, :as => :hidden, :input_html => { :value => @current_admin_user_id } %>
        <%= f.input :request_type, :as => :hidden, :input_html => { :value => "ADD_TO_LAW_FIRM_PANEL" } %>
        <%= f.input :status, :as => :hidden, :input_html => { :value => "Received" } %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label class="label">Line of Business<span class="mandatory">*</span></label>
        <%= f.input :line_of_business, label: false, collection: PanelRequest::LOB_LIST %>
      </div>
      <div class="col-md-12">
        <label class="inner-label">Law Firm</label>
        <div class="">
          <div class="inner-form-field">
            <div class="row">
              <div class="col-xs-12 col-md-6 col-sm-6">
                <label class="label">Name<span class="mandatory">*</span></label>
                <%= f.input :law_frim_name, label: false, required: true %>
                <%= f.input :law_firm_category, :as => :hidden, :input_html => { :value => "PANEL" } %>
              </div>
              <div class="col-xs-12 col-md-6 col-sm-6">
                <label class="label">Contact Name<span class="mandatory">*</span></label>
                <%= f.input :law_firm_contact_name, label: false, required: true %>
              </div>
            </div>
            <div class="row">
              <div class="col-xs-12 col-md-12">
                <label class="label">Email<span class="mandatory">*</span></label>
                <%= f.input :law_firm_mail, label: false %>
                <%= f.input :law_firm_role, :as => :hidden, label: false, :input_html => { :value => "master_user" }%>
              </div>
            </div>
            <div class="row">
              <div class="col-xs-12 col-sm-6 col-md-6">
                <label class="label">Phone<span class="mandatory">*</span></label>
                <%= f.input :law_firm_phone, label: false %>
              </div>
              <div class="col-xs-12 col-sm-6 col-md-6">
                <label class="label">Would you use this firm on a regular basis?<span class="mandatory">*</span></label>
                <%= f.input :firm_use_on_regular_basis, as: :select, required: true,  label: false, collection: [["Yes", "Yes"], ["No", "No"]] %>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!--<div class="col-xs-12 col-md-6">
          <label class="label">Minority Owned</label>
          <%= f.input :minority_owned, label: false, collection: PanelRequest::MINORITY_OWNED_TYPE  %>
        </div>
        <div class="col-xs-12 col-md-6 minority_owned_details"  style="display:none;">
          <label class="label">Minority Owned Details</label>
          <%= f.input :minority_owned_details, label: false%>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Women Owned</label>
          <%= f.input :women_owned, label: false, collection: PanelRequest::WOMEN_OWNED_TYPE %>
        </div>
        <div class="col-xs-12 col-md-6 women_owned_details" style="display:none;">
          <label class="label">Women Owned Details</label>
          <%= f.input :women_owned_details, label: false %>
        </div>-->
      <div class="col-xs-12 col-md-12 multiple-selector">
        <label class="label">What type of matters would this firm work on?</label>
        <%= f.input :matter_types, label: false, collection: PanelRequest::MATTER_TYPES,  input_html: { multiple: true }%>
      </div>
      <div class="col-xs-12 col-md-12">
        <label class="label">Does this firm have a specific niche expertise not available from an existing panel law firm?</label>
        <%= f.input :niche_preferred_external_counsel_panel_law_firms, label: false, required: true, collection: [["Yes", "Yes"], ["No", "No"]]  %>
      </div>
      <div class="col-xs-12 col-md-12 panel_request_niche_expertise" style="display:none;">
        <label class="label">If yes, please describe niche expertise</label>
        <%= f.input :niche_expertise, label: false%>
      </div>
      <div class="col-xs-12 col-md-12">
        <label class="label">Does this firm practice in a location not already covered by an existing panel law firm?</label>
        <%= f.input :required_unique_geography, label: false, required: true, collection: [["Yes", "Yes"], ["No", "No"]]  %>
      </div>
      <div class="col-xs-12 col-md-12 panel_request_geographic_location" style="display:none;">
        <label class="label">If yes, confirm location</label>
        <%= f.input :geographic_location, label: false%>
      </div>
      <div class="col-xs-12 col-md-12">
        <label class="label">Would engagements of this firm involve the following</label>
        <%= f.input :involved_engagement, label: false, collection: PanelRequest::INVOLVED_ENGAGEMENT %>
      </div>
      <div class="col-xs-12 col-md-12">
        <label class="label">Is this a certified minority/woman owned firm?</label>
        <%= f.input :women_owned, label: false, collection: PanelRequest::MINORITY_OWNED_TYPE  %>
      </div>
      <div class="col-xs-12 col-md-12 women_owned_details"  style="display:none;">
        <label class="label">If yes, which organization certified the firm?</label>
        <%= f.input :women_owned_details, label: false%>
      </div>
      <div class="col-xs-12 col-md-12">
        <label class="label">Are there additional reasons to consider this firm for our organization's panel? Provide details</label>
        <%= f.input :reason_other, label: false, required: true %>
      </div>
      <div class="col-xs-12 col-md-12">
        <%=link_to 'Cancel', @panel_request.new_record? ? admin_panel_requests_path : admin_panel_requests_path, class: 'btn-type-default' %>
        <%= f.button :submit, @panel_request.new_record? ? "Submit Request" : "Update Request", class: "btn-type-primary" %>
      </div>
    </div>
  <% end %>
</div>
