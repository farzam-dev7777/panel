<style>
  div#gauge * {
  	top: -25px;
  }
</style>
<div class="col-lg-12 col-md-12 col-sm-12">
  <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
    <div class="page-header-sp m-top">
      <div class="page-title">Panel Consideration Requests
        <% if @panel_request.status.present? %>
          <span style=" color: #fff; "  class="<%= @panel_request.status === "Active" ? 'label label-success' : 'label label-default' %>">
            Panel Status: <%= @panel_request.try(:status).try(:titleize) %>
          </span>
        <% end %>
        <% if @panel_request.lxp_status_show.present? %>
          <span style=" color: #fff; "  class="<%= @panel_request.lxp_status_show === "Approved" ? 'label label-success' : 'label label-default' %>">
            Internal Status: <%= @panel_request.try(:lxp_status_show).try(:titleize) %>
          </span>
        <% end %>
      </div>
      <div class="back-edit-actions">
        <a class="btn-type-default" href="/admin/panel_requests">
          <%= image_tag "chevron-back-icon.svg", alt:"Back" %>
        </a>
        <% if( current_user.role == 'lxp' || current_user.role == 'internal_lawyers' )&&  @panel_request.try(:lxp_status) != 'APPROVED' %>
          <% if current_user.role === "lxp"  || SystemSetting.fetch.panel_status === "Yes" %>
            <a class="btn-type-primary" href="/admin/panel_requests/<%= @panel_request.id %>/edit">
              Edit
            </a>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="  ">
      <!-- widget content -->
      <div class="view-request">
        <div class="tab-content view-request">
          <div class="sp-form-bg show-data-fields">
            <div class="row">
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Submitted By</div>
                <div class="field-data"><%= @panel_request.submitted_by_email %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Line of Business	</div>
                <div class="field-data"><%= @panel_request.requested_by %><%= @panel_request.line_of_business %></div>
              </div>
              <div class="col-md-12">
                <div class="inner-label">Law Firm</div>
                <div class="row inner-form-field">
                  <div class="col-xs-12 col-md-6">
                    <div class="field-label">Type</div>
                    <div class="field-data"><%= @panel_request.law_firm_category %></div>
                  </div>
                  <div class="col-xs-12 col-md-6">
                    <div class="field-label">Name</div>
                    <div class="field-data"><%= @panel_request.law_frim_name %></div>
                  </div>
                  <div class="col-xs-12 col-md-6">
                    <div class="field-label">Contact Name</div>
                    <div class="field-data"><%= @panel_request.law_firm_contact_name %></div>
                  </div>
                  <div class="col-xs-12 col-md-6">
                    <div class="field-label">Email</div>
                    <div class="field-data"><%= @panel_request.law_firm_mail %></div>
                  </div>
                  <div class="col-xs-12 col-md-6">
                    <div class="field-label">Phone</div>
                    <div class="field-data"><%= @panel_request.law_firm_phone %></div>
                  </div>
                  <div class="col-xs-12 col-md-6">
                    <div class="field-label">Would you use?</div>
                    <div class="field-data"><%= @panel_request.firm_use_on_regular_basis ? "Yes" : "No" %></div>
                  </div>
                </div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">What type of matters would this firm work on?</div>
                <div class="field-data"><%= @panel_request.matter_types.join(', ') %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Does this firm have a specific niche expertise not available from an existing panel law firm?</div>
                <div class="field-data"><%= @panel_request.niche_preferred_external_counsel_panel_law_firms %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">If yes, please describe niche expertise</div>
                <div class="field-data"><%= @panel_request.niche_expertise %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Does this firm practice in a location not already covered by an existing panel law firm?</div>
                <div class="field-data"><%= @panel_request.required_unique_geography %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">If yes, confirm location</div>
                <div class="field-data"><%= @panel_request.geographic_location %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Would engagements of this firm involve the following</div>
                <div class="field-data"><%= @panel_request.involved_engagement %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Is this a certified minority/woman owned firm?</div>
                <div class="field-data"><%= @panel_request.women_owned %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">If yes, which organization certified the firm?</div>
                <div class="field-data"><%= @panel_request.women_owned_details %></div>
              </div>
              <div class="col-xs-12 col-md-12">
                <div class="field-label">Are there additional reasons to consider this firm for our organization's panel? Provide details</div>
                <div class="field-data"><%= @panel_request.reason_other %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Internal Status</div>
                <div class="field-data"><%=  @panel_request.lxp_status_show ? @panel_request.lxp_status_show : "-" %></div>
              </div>
              <% if current_user.role === "lxp" %>
                <div class="col-xs-12 col-md-6">
                  <div class="field-label">Panel Approved</div>
                  <div class="field-data"><%= @panel_request.fully_approved? ? "Yes" : "No" %></div>
                </div>
              <% end %>
              <% if @panel_request.docusign_envelope_id.present? %>
                <div class="col-md-12">
                  <div class="field-label">Document Status</div>
                  <div class="field-data"><%= @panel_request.docusign_retainer_envelope.try(:status) %></div>
                </div>
                <% if @panel_request.docusign_retainer_envelope.try(:status) == "completed" %>
                  <div class="col-md-12">
                    <div class="field-label">Download Document</div>
                    <div class="field-data">
                      <%= link_to "Download Document", admin_panel_request_download_pdf_path(@panel_request), class: "" %>
                    </div>
                  </div>
                <% end %>
              <% end %>
              <% if @panel_request.law_firm.present? &&(!@panel_request.law_firm.form_submissions.any?) && current_user.role === "lxp"  %>
                <div class="col-xs-12 col-md-12">
                  <%= link_to "View Law Firm", admin_law_firm_url(@panel_request.law_firm), class: "btn-type-default" %>
                </div>
                <div class="col-xs-12 col-md-12">
                  <% if @panel_request.fully_approved? %>
                    <a href="javascript:void(0)" class="email_wnn_documents btn-type-primary" data-id="<%= @panel_request.id %>">Email WNN Documents <span class="loader">&nbsp;&nbsp;<i class="fa fa-refresh fa-spin fa-1x fa-fw"></i></span></a>
                  <% end %>
                </div>
                <div class="col-xs-12 col-md-12 mobile-action-btn">
                  <% if(@panel_request.law_firm.form_submissions.any? && @panel_request.law_firm.form_submissions.latest.status == 'approved') %>
                    <!-- <div class="col-lg-1 pull-right"> -->
                    <a class="btn-type-primary" data-id='<%= @panel_request.law_firm.id %>' data-name='<%= @panel_request.law_firm.name %>'>Decertify</a>
                    <!-- </div> -->
                    <!-- <div class="col-lg-2 pull-right"> -->
                    <a class="btn-type-primary begin-recertification-btn" data-id="<%= @panel_request.law_firm.id %>">Send RFI Questionnaire again</a>
                    <!-- </div> -->
                  <% end %>
                  <!-- <div class="col-lg-2 pull-right"> -->
                  <% if(@panel_request.law_firm.user.try(:is_deactivated?)) %>
                    <a class="btn-type-primary send-user-info-btn" data-id="<%= @panel_request.law_firm.user.id %>">Send Reset Password Link </a>
                    <a style="margin-top: 10px;" class="btn-type-primary send-user-info-begin-certification-btn" data-id="<%= @panel_request.law_firm.user.id %>">Send RFI and Password Link</a>
                  <% else %>
                    <a class="btn-type-primary begin-certification-btn" data-id="<%= @panel_request.law_firm.id %>">Send RFI Questionnaire
                    </a>
                  <% end %>
                  <!-- </div> -->
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<% if current_user.role === "lxp" %>
  <%= render "#{current_user.role}_show" %>
<% end %>
