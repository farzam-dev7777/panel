<style>
		div#gauge * {
			top: -25px;
		}
	</style>
	
  <div class="col-lg-12 col-md-12 col-sm-12">
    <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
			<div class="page-header-sp m-top">
				<div class="page-title">Panel Consideration Requests</div>
				<div class="back-edit-actions">
					<a class="btn-type-default" href="/admin/panel_requests">
						<%= image_tag "chevron-back-icon.svg", alt:"Back" %>
					</a>
					<% if current_user.role == 'lxp' &&  @panel_request.try(:lxp_status) != 'APPROVED' %>
						<a class="btn-type-primary" href="/admin/panel_requests/<%= @panel_request.id %>/edit">
							Edit
						</a>
					<% end %> 
				</div>
			</div>
      <div class="  ">
        
        <!-- widget content -->
				<div class="view-request">
					<div class="tab-content view-request">
						<div class="sp-form-bg show-data-fields">
