<style>
		div#gauge * {
			top: -25px;
		}
	</style>
	
	<div class="col-lg-3 back-btn">
		<%= link_to "<i class='fa fa-long-arrow-left'></i>".html_safe, admin_panel_requests_path, class: "btn btn-sm btn-default" %>
	</div>
	 
	<div class="clearfix"></div>


  <div class="col-lg-12 col-md-12 col-sm-12">
    <div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
      <header>
        <span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
        <h2 class="font-md"><strong> Panel Request </strong></h2>				
      </header>
      <div class="  ">
        <div class="jarviswidget-editbox"></div>
        <!-- widget content -->
				<div class="widget-body no-padding view-request">
						<div class="tab-content padding-10 view-request">
							<div class="tab-pane fade in active">

								<div class="col-md-10">
										<div class="col-md-12">
											<div class="col-md-3 column">Requested By	</div>
											<div class="col-md-9 data"><%= @panel_request.requested_by %></div>
										</div>
										<div class="col-md-12">
											<div class="col-md-3 column">Submitted By</div>		
											<div class="col-md-9 data"><%= @panel_request.submitted_by_email %></div>
										</div>
										<div class="col-md-12">
											<div class="col-md-3 column">Line of Business	</div>		
											<div class="col-md-9 data"><%= @panel_request.requested_by %><%= @panel_request.line_of_business %></div>
										</div>
										<div class="col-md-12">
											<div class="col-md-3 column">LOB Contact Name	</div>		
											<div class="col-md-9 data"><%= @panel_request.lob_contact_name %></div>
										</div>
										<div class="col-md-12">
											<div class="col-md-3 column">Business Manager Name</div>
											<div class="col-md-9 data"><%= @panel_request.business_manager_name %></div>
										</div>
										<div class="col-md-12">
											<div class="col-md-3 column">Business Manager Email</div>		
											<div class="col-md-9 data"><%= @panel_request.business_manager_email %></div>
										</div>
										<div class="col-md-12">
											<div class="col-md-3 column">Business Manager Phone	</div>		
											<div class="col-md-9 data"><%= @panel_request.business_manager_phone %></div>
										</div>	
										<div class="col-md-12">
												<div class="col-md-3 column">Law firm Category</div>		
												<div class="col-md-9 data"><%= @panel_request.law_firm_category %></div>
											</div>		
										<div class="col-md-12">
											<div class="col-md-3 column">Law Firm</div>		
											<div class="col-md-8 data">
											<div class="col-md-12 ">
													<div class="col-md-12">
														<div class="col-md-6 column">Law Firm Category : </div>
														<div class="col-md-6 data firmName"><%= @panel_request.law_firm.law_firm_category %></div>
													</div>
													<div class="col-md-12">
														<div class="col-md-6 column">Name : </div>
														<div class="col-md-6 data firmName"><%= @panel_request.law_firm.name %></div>
													</div>
													<div class="col-md-12">
														<div class="col-md-6 column">Email : </div>		
														<div class="col-md-6 data firmEmail"> <%= !@panel_request.law_firm.user.try(:email).blank? ? @panel_request.law_firm.user.try(:email) : '-' %></div>
													</div>
													<div class="col-md-12">
														<div class="col-md-6 column">Phone : </div>		
														<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.phone %></div>
													</div>
													<div class="col-md-12">
														<div class="col-md-6 column">Description : </div>		
														<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.description %></div>
													</div>
													<div class="col-md-12">
														<div class="col-md-6 column">Relationship Manager Name :	</div>		
														<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.relationship_manager_name %></div>
													</div>
													<div class="col-md-12">
														<div class="col-md-6 column">Relationship Manager Email : </div>		
														<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.relationship_manager_email %></div>
													</div>
													<div class="col-md-12">
														<div class="col-md-6 column">Relationship Manager Phone : </div>		
														<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.relationship_manager_phone %></div>
													</div>
													<div class="col-md-12">
															<div class="col-md-6 column">Select Matter Type : </div>		
															<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.matter_types.map(&:matter_type).join(", ") %></div>
														</div>
														<div class="col-md-12">
															<div class="col-md-6 column">Select Sub Matter Type : </div>		
															<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.sub_matter_types.map(&:sub_matter_type).join(", ") %></div>
														</div>
														<div class="col-md-12">
															<div class="col-md-6 column">Select Jurisdiction Type : </div>		
															<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.jurisdiction_types.map(&:jurisdiction_type).join(", ") %></div>
														</div>
														<div class="col-md-12">
															<div class="col-md-6 column">Select Country : </div>		
															<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.countries.map(&:name).join(", ") %></div>
														</div>
														<div class="col-md-12">
															<div class="col-md-6 column">Select State/Province : </div>		
															<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.states.map(&:name).join(", ") %></div>
														</div>
													<div class="col-md-12">
														<%= link_to "View Law Firm", admin_law_firm_url(@panel_request.law_firm), class: "btn btn-sm btn-secondary pull-right waves-effect waves-light" %>	
														<% if(@panel_request.law_firm.form_submissions.any? && @panel_request.law_firm.form_submissions.latest.status == 'approved') %>
															<!-- <div class="col-lg-1 pull-right"> -->
																<a class="btn btn-sm btn-danger pull-right begin-certification-btn waves-effect waves-light " data-id='<%= @panel_request.law_firm.id %>' data-name='<%= @panel_request.law_firm.name %>'>Decertify</a>
															<!-- </div> -->
		
															<!-- <div class="col-lg-2 pull-right"> -->
																<a class="btn btn-sm btn-primary pull-right begin-recertification-btn" data-id="<%= @panel_request.law_firm.id %>">Send RFI Questionnaire again			</a>
															<!-- </div> -->
														<% end %>
		
														<% if(!@panel_request.law_firm.form_submissions.any?) %>
															<!-- <div class="col-lg-2 pull-right"> -->
																	<% if(@panel_request.law_firm.user.try(:is_deactivated?)) %>
																	<a class="btn btn-sm btn-primary pull-right send-user-info-btn" data-id="<%= @panel_request.law_firm.user.id %>">Send user information and create new password link </a>
																	<a class="btn btn-sm btn-secondary pull-right send-user-info-begin-certification-btn" data-id="<%= @panel_request.law_firm.user.id %>">Send RFI Questionnaire with user active password link </a>
																	
																	<% else %>	
																	<a class="btn btn-sm btn-primary pull-right begin-certification-btn" data-id="<%= @panel_request.law_firm.id %>">Send RFI Questionnaire
																		</a>
																	<% end %>	
															<!-- </div> -->
														<% end %>
													</div>	
												</div>
											</div>
										</div>
										<div class="col-md-12">
											<div class="col-md-3 column">Minority Owned</div>		
											<div class="col-md-9 data"><%= @panel_request.minority_owned %></div>
										</div>
										<div class="col-md-12">
											<div class="col-md-3 column">Minority Owned Details</div>		
											<div class="col-md-9 data"><%= @panel_request.minority_owned_details %></div>
										</div>
										<div class="col-md-12">
											<div class="col-md-3 column">Women Owned</div>		
											<div class="col-md-9 data"><%= @panel_request.women_owned %></div>
										</div>
										<div class="col-md-12">
											<div class="col-md-3 column">Women Owned Details</div>		
											<div class="col-md-9 data"><%= @panel_request.women_owned_details %></div>
										</div>	
										<div class="col-md-12">
												<div class="col-md-3 column">LXP Status :</div>
												<div class="col-md-9 data"><%=  @panel_request.lxp_status_show ? @panel_request.lxp_status_show : "-" %></div>
											</div>
											<div class="col-md-12">
												<div class="col-md-3 column">Panel Approved :</div>
												<div class="col-md-9 data"><%= @panel_request.fully_approved? ? "Yes" : "No" %></div>
											</div>
											<% if @panel_request.docusign_envelope_id.present? %>
												<div class="col-md-12">
													<div class="col-md-3 column">Document Status</div>
													<div class="col-md-9 data"><%= @panel_request.docusign_retainer_envelope.try(:status) %></div>
												</div>
												<% if @panel_request.docusign_retainer_envelope.try(:status) == "completed"%>
													<div class="col-md-12">
														<div class="col-md-3 column">Download Document</div>
														<div class="col-md-9 data">
															<%= link_to "Download Document", admin_panel_request_download_pdf_path(@panel_request), class: "" %>
														</div>
													</div>
												<% end %>	
											<% end %>
									</div>
							</div>
						</div>
        </div>
      </div>
    </div>
	</div>
 

 <%= render "#{current_user.role}_show" %>