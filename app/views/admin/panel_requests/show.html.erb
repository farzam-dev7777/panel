											<div class="field-label">Description : </div>		
											<div class="field-data"><%= @panel_request.law_firm.description %></div>
										</div>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Relationship Manager Name :	</div>		
											<div class="field-data"><%= @panel_request.law_firm.relationship_manager_name %></div>
										</div>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Relationship Manager Email : </div>		
											<div class="field-data"><%= @panel_request.law_firm.relationship_manager_email %></div>
										</div>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Relationship Manager Phone : </div>		
											<div class="field-data"><%= @panel_request.law_firm.relationship_manager_phone %></div>
										</div>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Select Matter Type : </div>		
											<div class="field-data"><%= @panel_request.law_firm.matter_types.map(&:matter_type).join(", ") %></div>
										</div>
										<div class="col-xs-12 col-md-12">
											<div class="field-label">Select Sub Matter Type : </div>		
											<div class="field-data"><%= @panel_request.law_firm.sub_matter_types.map(&:sub_matter_type).join(", ") %></div>
										</div>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Select Jurisdiction Type : </div>		
											<div class="field-data"><%= @panel_request.law_firm.jurisdiction_types.map(&:jurisdiction_type).join(", ") %></div>
										</div>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Select Country : </div>		
											<div class="field-data"><%= @panel_request.law_firm.countries.map(&:name).join(", ") %></div>
										</div>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Select State/Province : </div>		
											<div class="field-data"><%= @panel_request.law_firm.states.map(&:name).join(", ") %></div>
										</div>-->
										
									</div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">What type of matters would this firm work on? :</div>		
									<div class="field-data"><%= @panel_request.matter_types.join(', ') %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Does this firm have a specific niche expertise not available from a BMO LXP Panel law firm?</div>		
									<div class="field-data"><%= @panel_request.niche_preferred_external_counsel_panel_law_firms %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">If yes, please describe niche expertise :</div>		
									<div class="field-data"><%= @panel_request.niche_expertise %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Does this firm practice in a location not already covered by a BMO LXP Panel law firm? :</div>		
									<div class="field-data"><%= @panel_request.required_unique_geography %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">If yes, confirm location :</div>		
									<div class="field-data"><%= @panel_request.geographic_location %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Would engagements of this firm involve the following :</div>		
									<div class="field-data"><%= @panel_request.involved_engagement %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Is this a certified minority/woman owned firm? :</div>		
									<div class="field-data"><%= @panel_request.women_owned %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">If yes, which organization certified the firm? :</div>		
									<div class="field-data"><%= @panel_request.women_owned_details %></div>
								</div>
								<div class="col-xs-12 col-md-12">
									<div class="field-label">Are there additional reasons to consider this firm for BMO's LXP Panel? Provide details :</div>		
									<div class="field-data"><%= @panel_request.reason_other %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">LXP Status :</div>
									<div class="field-data"><%=  @panel_request.lxp_status_show ? @panel_request.lxp_status_show : "-" %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Panel Approved :</div>
									<div class="field-data"><%= @panel_request.fully_approved? ? "Yes" : "No" %></div>
								</div>
								<% if @panel_request.docusign_envelope_id.present? %>
									<div class="col-md-12">
										<div class="field-label">Document Status</div>
										<div class="field-data"><%= @panel_request.docusign_retainer_envelope.try(:status) %></div>
									</div>
									<% if @panel_request.docusign_retainer_envelope.try(:status) == "completed"%>
										<div class="col-md-12">
											<div class="field-label">Download Document</div>
											<div class="field-data">
												<%= link_to "Download Document", admin_panel_request_download_pdf_path(@panel_request), class: "" %>
											</div>
										</div>
									<% end %>	
								<% end %>

								<div class="col-xs-12 col-md-12">
									<%= link_to "View Law Firm", admin_law_firm_url(@panel_request.law_firm), class: "btn-type-default" %>
								</div>
								<div class="col-xs-12 col-md-12 mobile-action-btn">	
									<% if(@panel_request.law_firm.form_submissions.any? && @panel_request.law_firm.form_submissions.latest.status == 'approved') %>
										<!-- <div class="col-lg-1 pull-right"> -->
											<a class="btn-type-primary" data-id='<%= @panel_request.law_firm.id %>' data-name='<%= @panel_request.law_firm.name %>'>Decertify</a>
										<!-- </div> -->

										<!-- <div class="col-lg-2 pull-right"> -->
											<a class="btn-type-primary begin-recertification-btn" data-id="<%= @panel_request.law_firm.id %>">Send RFI Questionnaire again</a>
										<!-- </div> -->
									<% end %>

									<% if(!@panel_request.law_firm.form_submissions.any?) %>
										<!-- <div class="col-lg-2 pull-right"> -->
											<% if(@panel_request.law_firm.user.try(:is_deactivated?)) %>
												<a class="btn-type-primary send-user-info-btn" data-id="<%= @panel_request.law_firm.user.id %>">Send Reset Password Link </a>
												<a style="margin-top: 10px;" class="btn-type-primary send-user-info-begin-certification-btn" data-id="<%= @panel_request.law_firm.user.id %>">Send RFI and Password Link</a>
											
											<% else %>	
											<a class="btn-type-primary begin-certification-btn" data-id="<%= @panel_request.law_firm.id %>">Send RFI Questionnaire
											</a>
											<% end %>	
										<!-- </div> -->
									<% end %>
								</div>
							</div>
						</div>
					</div>
        </div>
      </div>
    </div>
	</div>
 

 <%= render "#{current_user.role}_show" %>