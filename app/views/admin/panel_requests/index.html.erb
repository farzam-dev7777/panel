<% content_for :page_title do %>
<span>Panel Requests</span>
<% end %>
<div class="clearfix"></div>
<div class="col-lg-12">
<div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
  <div class="page-header-sp">
    <div class="page-title m-top-zero">Panel Requests</div>
    <div class="back-edit-actions"></div>
  </div>
  <div class="col-lg-12 hidden">
    <div class="no-padding">
      <div class="widget-body">
        <div id="myTabContent" class="tab-content">
          <div class="tab-pane fade active in padding-10 no-padding-bottom" id="s1">
            <div class="row no-space text-center">
              <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <p><b><%= certification_status(current_law_firm) %></b> 
                <b><%= link_to 'Submit New Panel Request', new_admin_panel_request_path, html_options = {class: 'btn btn-primary btn-lg dashboard-certificate-button'}   %></b>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
  </div>
    <!-- widget div-->
    <div>
      <!-- search filter -->
      <div class="search-filter-sp">
        <div class="sp-filter">
          <div class="accordion" id="sp-filter">
            <div class="card z-depth-0">
              <div class="card-header" id="headingThree">
                <div class="collapsed filter-title" type="button" data-toggle="collapse" data-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                  <%= image_tag "filter-icon.svg", alt:"score" %>
                  <span>Filter</span>
                </div>
              </div>
              <div id="collapseThree" class="col-md-12 collapse sp-filter-fields" aria-labelledby="headingThree" data-parent="#sp-filter">
                <div class="card-body sp-form">
                  <%= search_form_for [:admin, @q] do |f| %>
                    <div class="row">
                      <!--<div class="col-xs-12 col-sm-12">
                        <h2 style="margin: 0px 0px 10px;">Search Filter</h2>
                      </div>-->
                      <div class="col-xs-12 col-sm-4">
                          <%= f.label :requested_by_cont, label: false, :class => 'label'  %>
                          <%= f.search_field :requested_by_cont, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 col-sm-4">
                          <%= f.label :submitted_by_email_cont, :class => 'label' %>
                          <%= f.search_field :submitted_by_email_cont, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 col-sm-4">
                        <%= f.label :law_firm_id_eq, :class => 'label' %>
                        <%= f.select :law_firm_id_eq, options_from_collection_for_select(LawFirm.all, "id", "name", @q.law_firm_id_eq), {:include_blank => 'Select law firm'}, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 col-md-12 text-right">
                          <%= f.submit "Search", class: "btn-type-primary" %>
                          <%= f.submit "Reset", type: "reset", value: "Reset",  class: "btn-type-default" %>
                      </div>
                    </div>        
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- search filter end -->
      
      <!-- widget content -->
      <div class="table-responsive">
        <table id="" class="table table-decoration table-bordered" width="100%">
          <thead>
            <tr>
              <th>Requested By</th>
              <th>Submitted By</th>
              <th>LOB Contact Name</th>
              <th>Panel Status</th>
              <th>LXP Status</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @panel_requests.each do |panel_request| %>
            <tr class="" data-id="<%= panel_request.id %>">
              <td><%= panel_request.requested_by %></td>
              <td><%= panel_request.submitted_by_email %></td>
              <td><%= panel_request.lob_contact_name %></td>
              <td><%= panel_request.status %></td>
              <td><%= panel_request.lxp_status_show ? panel_request.lxp_status_show : "-" %></td>
              <td>
                <%# <%= link_to "Edit", edit_admin_panel_request_path(panel_request), class: "btn btn-xs btn-primary" %>	
                <%= link_to "Review", admin_panel_request_path(panel_request), class: "btn btn-xs btn-secondary" %>	
              </td>
            </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <!-- end widget content -->
    </div>
    <!-- end widget div -->
  </div>
  <!-- end widget -->
</div>