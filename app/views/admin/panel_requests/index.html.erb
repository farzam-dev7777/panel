<% content_for :page_title do %>
<span>Panel Requests</span>
<% end %>
<div class="clearfix"></div>
<div class="col-lg-12">
<div class="jarviswidget jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
  <header>
    <span class="widget-icon"> <i class="fa fa-briefcase"></i> </span>
    <h2>Panel Requests</h2>
  </header>
  
  <div class="col-lg-12">
    <div class="no-padding">
      <div class="widget-body">
        <div id="myTabContent" class="tab-content">
          <div class="tab-pane fade active in padding-10 no-padding-bottom" id="s1">
            <div class="row no-space text-center">
              <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <p><b><%= certification_status(current_law_firm) %></b> 
                  <b><%= link_to 'Submit New Panel Request', new_admin_panel_request_path, html_options = {class: 'btn btn-primary btn-lg dashboard-certificate-button'}   %></b>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- widget div-->
    <div>
      <%= search_form_for [:admin, @q] do |f| %>
        <div class="row" style="padding-top: 20px;">
          <div class="col-xs-12 col-sm-12">
            <h2 style="margin: 0px 0px 10px;">Search Filter</h2>
          </div>
          <div class="col-xs-12 col-sm-4">
              <strong><%= f.label :requested_by_cont, label: false  %></strong>
              <%= f.search_field :requested_by_cont %>
          </div>
          <div class="col-xs-12 col-sm-4">
              <strong><%= f.label :submitted_by_email_cont %></strong>
              <%= f.search_field :submitted_by_email_cont %>
          </div>
          <div class="col-xs-12 col-sm-4">
            <strong><%= f.label :law_firm_id_eq %> </strong>
            <%= f.select :law_firm_id_eq, options_from_collection_for_select(LawFirm.all, "id", "name", @q.law_firm_id_eq), {:include_blank => 'Select law firm'} %>
          </div>
          <div class="col-xs-12 text-right" style="margin-top: 20px;">
              <%= f.submit "Search", class: "btn btn-primary" %>
              <%= f.submit "Reset", type: "reset", value: "Reset",  class: "btn btn-primary" %>
          </div>
        </div>        
      <% end %>
      <!-- widget edit box -->
      <div class="jarviswidget-editbox">
        <!-- This area used as dropdown edit box -->
      </div>
      <!-- end widget edit box -->
      <!-- widget content -->
      <div class="widget-body no-padding">
        <table id="dt_basic" class="table table-striped table-bordered table-hover" width="100%">
          <thead>
            <tr style="background: #007ac3;color: #fff;">
              <th>Requested By</th>
              <th>Submitted By</th>
              <th>LOB Contact Name</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @panel_requests.each do |panel_request| %>
            <tr class="" data-id="<%= panel_request.id %>">
              <td><%= panel_request.requested_by %></td>
              <td><%= panel_request.submitted_by_email %></td>
              <td><%= panel_request.lob_contact_name %></td>
              <td>
                <%= link_to "Edit", edit_admin_panel_request_path(panel_request), class: "btn btn-xs btn-primary" %>	
                <%= link_to "view", admin_panel_request_path(panel_request), class: "btn btn-xs btn-secondary" %>	
              </td>
            </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <!-- end widget content -->
    </div>
    <!-- end widget div -->
  </div>
  <!-- end widget -->
</div>