<% content_for :page_title do %>
<span>Panel Requests</span>
<% end %>
<div class="clearfix"></div>
<div class="col-lg-12">
<div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
  <div class="page-header-sp m-top">
    <div class="page-title">Panel Requests</div>
    <div class="back-edit-actions">
      <%= link_to 'Submit New Panel Request', new_admin_panel_request_path, html_options = {class: 'btn-type-primary dashboard-certificate-button'}   %>
    </div>
  </div>
  <div class="">
    <div class="">
      <b><%= certification_status(current_law_firm) %></b>
    </div>
    <!-- widget div-->
    <div>
      <!-- search filter -->
      <div class="search-filter-sp">
        <div class="sp-filter">
          <div class="accordion" id="sp-filter">
            <div class="card z-depth-0">
              <div class="card-header" id="headingThree">
                <div class="collapsed filter-title" type="button" data-toggle="collapse" data-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                  <%= image_tag "filter-icon.svg", alt:"score" %>
                  <span>Filter</span>
                </div>
              </div>
              <div id="collapseThree" class="col-md-12 collapse sp-filter-fields" aria-labelledby="headingThree" data-parent="#sp-filter">
                <div class="card-body sp-form">
                  <%= search_form_for [:admin, @q] do |f| %>
                    <div class="row">
                      <!--<div class="col-xs-12 col-sm-12">
                        <h2 style="margin: 0px 0px 10px;">Search Filter</h2>
                      </div>-->
                      <div class="col-xs-12 col-sm-4">
                          <%= f.label :requested_by_cont, label: false, :class => 'label'  %>
                          <%= f.search_field :requested_by_cont, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 col-sm-4">
                          <%= f.label :submitted_by_email_cont, :class => 'label' %>
                          <%= f.search_field :submitted_by_email_cont, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 col-sm-4">
                        <%= f.label :law_firm_id_eq, :class => 'label' %>
                        <%= f.select :law_firm_id_eq, options_from_collection_for_select(LawFirm.all, "id", "name", @q.law_firm_id_eq), {:include_blank => 'Select law firm'}, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 col-md-12 text-right">
                          <%= f.submit "Search", class: "btn-type-primary" %>
                          <%= f.submit "Reset", type: "reset", value: "Reset",  class: "btn-type-default" %>
                      </div>
                    </div>        
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- search filter end -->
      <!-- widget content -->
      <div class="table-dyanmic-search table-responsive">
        <table id="dt_basic" class="table table-decoration table-bordered" width="100%">
          <thead>
            <tr>
              <th>Requested By</th>
              <th>Submitted By</th>
              <th>LOB Contact Name</th>
              <th>Panel Status</th>
              <th>LXP Status</th>
              <!--<th width="8%">Action</th>-->
            </tr>
          </thead>
          <tbody>
            <% @panel_requests.each do |panel_request| %>
            <tr onClick="window.location.href='/admin/panel_requests/<%= panel_request.id %>'">
              <td>
                <% if panel_request.requested_by.present? %>
                  <div class="firm-name">
                    <div class="name-avatar"><img src="<%= get_avatar_image(panel_request&.requested_by&.gsub(" ", "+")) %>"></div>
                    <div><%= panel_request.requested_by %></div>
                  </div>
                <% end %>
              </td>
              <td><%= panel_request.submitted_by_email %></td>
              <td><%= panel_request.lob_contact_name %></td>
              <td>
                <div class="status">
                  <% if panel_request.status.present? %>
                    <span class="<%= panel_request.status === "Activate" ? 'label label-success' : 'label label-default' %>"> 
                      <%= panel_request.try(:status).try(:titleize) %>
                    </span>
                  <% end %>
                </div>
                <% panel_request.status %>
              </td>
              <td>
                <div class="status">
                  <% if panel_request.lxp_status_show.present? %>
                    <span class="<%= panel_request.lxp_status_show === "Approved" ? 'label label-success' : 'label label-default' %>"> 
                      <%= panel_request.try(:lxp_status_show).try(:titleize) %>
                    </span>
                  <% else %>
                    <div class="text-center">-</div>
                  <% end %>
                </div>
                <% panel_request.lxp_status_show ? panel_request.lxp_status_show : "-" %>
              </td>
              <!--<td>
                <div class="action-fields">
                  <a class="action-btn" href=/admin/panel_requests/<%= panel_request.id %>">
                    <%= image_tag "review-icon.svg", alt:"Review" %>
                  </a> 
                </div>
              </td>-->
            </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <!-- end widget content -->
    </div>
    <!-- end widget div -->
  </div>
  <!-- end widget -->
</div>