
<% if !@panel_request.fully_approved?  %>  
  <div class="col-lg-12 col-md-12 col-sm-12">
    <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
      <div class="page-header-sp">
				<div class="page-title">Add Review</div>
				<div class="back-edit-actions">
				</div>
			</div>
      <div class="">
        <div class="panelRequestProcesss">
          
            <div class="sp-form sp-form-bg">
              <%= simple_form_for [:admin, Review.new()] do |f| %>
                <div class="row">
                  <div class="col-xs-12 col-md-12">
                    <label class="label">Comment</label>
                      <%= f.input :description, label: false %>
                      <%= f.input :reviewable_type, label: false, as: :hidden, input_html: { value: @panel_request.class.to_s } %>
                      <%= f.input :reviewable_id, label: false, as: :hidden, input_html: { value: @panel_request.id } %>
                  </div>		
                  <div class="col-xs-12 col-md-6" style="display: none;">
                    <label class="label">Status</label>
                    <%= f.input :status, label: false, collection: PanelRequest::PANEL_REQUEST_STATUS.map{|value,key| [key, value]}%>
                  </div>
                  <div class="col-xs-12 col-md-12">
                    <%= link_to 'Cancel', @panel_request.new_record? ? admin_panel_request_path : admin_conflict_waiver_path, class: 'btn-type-default' %>
                    <%= f.button :submit, @panel_request.new_record? ? "Submit Request" : "Update Status", class:  @current_user.role === "lxp" ? "lxp_sttaus btn-type-primary hide" : "laywr_status btn-type-primary hide" %>
                    <div class="project-context sp-inner-dropdown">
                      <span class="dropdown-toggle sp-derpdwon" data-toggle="dropdown">
                        <div class="dropdown-text">Update</div>
                        <span class="drop-down-icon">
                          <%= image_tag "drop-down-icon.png", alt:"Drop menu" %>
                        </span>
                      </span>
                      <ul class="dropdown-menu" style="width: 190px;">
                        <li id="" class="">
                          <a href="javascript:void(0)" class="lxp_review_status" data-status="REQUEST_INFO">Request More Info</a>
                        </li>
                        <li role="separator" class="divider"></li>
                        <li id="" class="">
                          <a href="javascript:void(0)" class="lxp_review_status" data-status="PANEL_RETAINER">Send Retainer Agreement</a>
                        </li>
                        <li role="separator" class="divider"></li>
                        <li id="" class="">
                          <a href="javascript:void(0)" class="lxp_review_status" data-status="APPROVED">Approve</a>
                        </li>
                        <li role="separator" class="divider"></li>
                        <li id="" class="">
                          <a href="javascript:void(0)" class="lxp_review_status" data-status="REJECTED">Reject</a>
                        </li>
                      </ul>
                      <!-- end dropdown-menu-->
                    </div>
                  </div>
                </div>
            <% end %>
            </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
<% if @panel_request.reviews.size === 0 %>
  <div style="margin-bottom: 80px;"></div>
<% end %>
<div class="col-md-12">
    <%- if @panel_request.reviews.size > 0 %>
      <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
        <div class="page-header-sp">
          <div class="page-title">Review Logs</div>
          <div class="back-edit-actions">
          </div>
        </div>
        <div>
          <div class="clearfix"></div>
          <!-- MAIN PANEL -->
          <div role="main">
            <!-- MAIN CONTENT -->
            <div >
              <!-- row -->
              <div class="row">
                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                  <div class="sp-form-bg">
                    <!-- Timeline Content -->
                    <div class="smart-timeline">
                      <ul class="smart-timeline-list">
                        <% @panel_request.reviews.reverse.each do |review| %>
                        <% if review.status_from.blank? && review.status.blank? && review.assigned_to_id.present? %>
                          <li data-id="<%= review.id %>">
                              <div class="smart-timeline-icon">
                                R
                              </div>
                              <div class="smart-timeline-time">
                                <small><%= review.created_at.strftime('%d %b %Y at %I:%M %p') %></small>
                              </div>
                              <div class="smart-timeline-content">
                                <p>
                                  <strong>
                                  <%= review.actor.email %> assigned exception request to internal lawyer for approval.
                                  <strong>
                                </p>
                                <p>
                                  <%= review.description %>
                                </p>
                              </div>
                            </li>
                        <% else %>
                          <li data-id="<%= review.id %>">
                          <div class="smart-timeline-icon">
                            R
                          </div>
                          <div class="smart-timeline-time">
                            <small><%= review.created_at.strftime('%d %b %Y at %I:%M %p') %></small>
                            <small><i><%= time_ago_in_words(review.created_at) %> ago</i> </small>
                          </div>
                          <div class="smart-timeline-content">
                            <p>
                              <strong>
                                <%- if review.status_show %>
                                  <%= review.actor.email %> change status to <%= review.status_show %>
                                <% else %>
                                  <%= review.actor.email %> left a comment
                                <% end %>
                              <strong>
                            </p>
                            <p>
                              <%= review.description.blank? ? "NA" : review.description %>
                            </p>
                          </div>
                        </li>
                          <% end %>
                        <% end %>
                      </ul>
                    </div>
                    <!-- END Timeline Content -->
                  </div>
                </div>
              </div>
              <!-- end row -->
            </div>
            <!-- END MAIN CONTENT -->
          </div>
          <!-- END MAIN PANEL -->
        </div>
      </div>
    <% end %>
  </div>