<div class="sp-form sp-form-bg">
  <%= simple_form_for [:tenant_admin, @tenant] do |f| %>
    <div class="row form-flex-wrap">
      <div class="col-xs-12 col-md-6">
        <label class="label">Name<span class="mandatory">*</span></label>
        <%= f.input :name, label: false, required: true %>
      </div>

      <div class="col-xs-12 col-md-6">
        <label class="label">Subdomain<span class="mandatory">*</span></label>
        <%= f.input :subdomain, label: false, required: true, input_html: {readonly: readonly} %>
      </div>

      <div class="col-xs-12 col-md-6">
        <label class="label">Panel Retainer Template ID</label>
        <%= f.input :panel_retainer_template_id, label: false, value: f&.object&.panel_retainer_template_id %>
      </div>

      <div class="col-xs-12 col-md-6">
        <label class="label">Retainer Template ID</label>
        <%= f.input :retainer_template_id, label: false, value: f&.object&.retainer_template_id %>
      </div>

      <div class="col-xs-12 col-md-6 color-picker-control">
        <label class="label">Primary Color</label>
        <%= f.color_field :primary_color, label: false, value: f&.object&.primary_color || '#00a0af' %>
      </div>

      <div class="col-xs-12 col-md-6 color-picker-control">
        <label class="label">Secondary Color</label>
        <%= f.color_field :secondary_color, label: false, value: f&.object&.secondary_color || '#FFFFFF' %>
      </div>

      <div class="col-xs-12 col-md-6 upload-file-control">
        <label class="label">Logo</label>
        <%= f.input :logo, label: false, as: :file %>
      </div>

      <div class="col-xs-12 col-md-6 upload-file-control">
        <label class="label">Login Bg Image</label>
        <%= f.input :login_bg_image, label: false, as: :file %>
      </div>

      <div class="col-xs-12 col-md-6">
        <label class="label">SSO Type</label>
        <%= f.input :sso_type, label: false, collection: [['Okta', 'okta'] ,['Azure active directory', 'azure_active_directory']] , prompt: "Select" %>
      </div>

      <div class="col-xs-12 col-md-6 okta_fields">
        <label class="label">Okta Client Id</label>
        <%= f.input :okta_client_id, label: false %>
      </div>

      <div class="col-xs-12 col-md-6 okta_fields">
        <label class="label">Okta Client Secret</label>
        <%= f.input :okta_client_secret, label: false %>
      </div>

      <div class="col-xs-12 col-md-6 okta_fields">
        <label class="label">Okta Site Url</label>
        <%= f.input :okta_site, label: false %>
      </div>

      <div class="col-xs-12 col-md-6 okta_fields">
        <label class="label">Okta Api Token</label>
        <%= f.input :okta_api_token, label: false %>
      </div>

      <div class="col-xs-12 col-md-6 azure_fields">
        <label class="label">Azure Tenant Id</label>
        <%= f.input :azure_tenant_id, label: false %>
      </div>

      <div class="col-xs-12 col-md-6 azure_fields">
        <label class="label">Azure Client Id</label>
        <%= f.input :azure_client_id, label: false %>
      </div>

      <div class="col-xs-12 col-md-6 azure_fields">
        <label class="label">Azure Client Secret</label>
        <%= f.input :azure_client_secret, label: false %>
      </div>
      <div class="col-xs-12 col-md-6 azure_fields">
        <label class="label">Internal Lawyer</label>
        <%= f.input :internal_lawyer, label: false %>
      </div>
      <div class="col-xs-12 col-md-6 azure_fields">
        <label class="label">Master User</label>
        <%= f.input :master_user, label: false %>
      </div>
      <div class="col-xs-12 col-md-6 azure_fields">
        <label class="label">Business User</label>
        <%= f.input :business_user, label: false %>
      </div>

      <div class="col-xs-12 col-md-12 mt-3">
        <%=link_to 'Cancel', tenant_admin_root_path, class: 'btn-type-default' %>
        <%= f.button :submit, "Submit", class: "btn-type-primary" %>
      </div>
    </div>
  <% end %>
</div>