<div class="sp-form sp-form-bg">
  <%= simple_form_for [:tenant_admin, @tenant] do |f| %>
    <div class="row form-flex-wrap">
      <div class="col-xs-12 col-md-6">
        <label class="label">Name<span class="mandatory">*</span></label>
        <%= f.input :name, label: false, required: true %>
      </div>

      <div class="col-xs-12 col-md-6">
        <label class="label">Subdomain<span class="mandatory">*</span></label>
        <%= f.input :subdomain, label: false, required: true, input_html: {readonly: readonly} %>
      </div>

      <div class="col-xs-12 col-md-6">
        <label class="label">Panel Retainer Template ID</label>
        <%= f.input :panel_retainer_template_id, label: false, value: f&.object&.panel_retainer_template_id %>
      </div>

      <div class="col-xs-12 col-md-6">
        <label class="label">Non-Panel Retainer Template ID</label>
        <%= f.input :retainer_template_id, label: false, value: f&.object&.retainer_template_id %>
      </div>

      <div class="col-xs-12 col-md-6 color-picker-control">
        <label class="label">Primary Color</label>
        <%= f.color_field :primary_color, label: false, value: f&.object&.primary_color || '#00a0af' %>
      </div>

      <div class="col-xs-12 col-md-6 color-picker-control">
        <label class="label">Secondary Color</label>
        <%= f.color_field :secondary_color, label: false, value: f&.object&.secondary_color || '#FFFFFF' %>
      </div>

      <div class="col-xs-12 col-md-6 upload-file-control">
        <label class="label">Logo</label>
        <%= f.input :logo, label: false, as: :file %>
      </div>

      <div class="col-xs-12 col-md-6 upload-file-control">
        <label class="label">Login Bg Image</label>
        <%= f.input :login_bg_image, label: false, as: :file %>
      </div>

      <div class="col-xs-12 col-md-6 upload-file-control">
        <label class="label">Internal Lawyer Label</label>
        <%= f.input :internal_lawyer_label, label: false, as: :text %>
      </div>

      <div class="col-xs-12 col-md-6">
        <label class="label">SSO Type</label>
        <%= f.input :sso_type, label: false, collection: [['Okta', 'okta'] ,['Azure active directory', 'azure_active_directory']] , prompt: "Select" %>
      </div>

      <div class="col-xs-12 col-md-6 okta_fields">
        <label class="label">Okta Client Id</label>
        <%= f.input :okta_client_id, label: false %>
      </div>

      <div class="col-xs-12 col-md-6 okta_fields">
        <label class="label">Okta Client Secret</label>
        <%= f.input :okta_client_secret, label: false %>
      </div>

      <div class="col-xs-12 col-md-6 okta_fields">
        <label class="label">Okta Site Url</label>
        <%= f.input :okta_site, label: false %>
      </div>

      <div class="col-xs-12 col-md-6 okta_fields">
        <label class="label">Okta Api Token</label>
        <%= f.input :okta_api_token, label: false %>
      </div>

      <div class="col-xs-12 col-md-6 azure_fields">
        <label class="label">Azure Tenant Id</label>
        <%= f.input :azure_tenant_id, label: false %>
      </div>

      <div class="col-xs-12 col-md-6 azure_fields">
        <label class="label">Azure Client Id</label>
        <%= f.input :azure_client_id, label: false %>
      </div>

      <div class="col-xs-12 col-md-6 azure_fields">
        <label class="label">Azure Client Secret</label>
        <%= f.input :azure_client_secret, label: false %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label class="label">Panel Consideration Request Open for LOB/Lawyers</label>
        <%= f.input :allow_panel_consideration_lob_Lawyers, label: false %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label class="label">System Score Threshold</label>
        <%= f.number_field :system_score_threshold, label: false %>
      </div>
      <div class="col-xs-12 col-md-6 azure_fields">
        <label class="label">Internal Lawyer (SSO Group Name - default: Panel - Internal Lawyers)</label>
        <%= f.input :internal_lawyer, label: false %>
      </div>
      <div class="col-xs-12 col-md-6 azure_fields">
        <label class="label">Master User (SSO Group Name - default: Panel - Master User)</label>
        <%= f.input :master_user, label: false %>
      </div>
      <div class="col-xs-12 col-md-6 azure_fields">
        <label class="label">Business User (SSO Group Name - default: Panel - Business User)</label>
        <%= f.input :business_user, label: false %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label class="label">Matter Optional Fields</label>
        <%= f.input :matter_optional_fields, label: false, collection: ['Internal File Number', 'Business Department', 'Business Group Responsible for Invoice'],  input_html: { multiple: true }%>
      </div>
      <div class="col-xs-12 col-md-6">
        <label class="label">Matter Approval Sequence</label>
        <%= f.input :approval_process, label: false, collection: [['Serial','serial'], ['Parallel','parallel']]%>
      </div>
      <div class="col-xs-12 col-md-6">
        <label class="label">Matter Auto Approve Amount Limit</label>
        <%= f.input :auto_approve_amount_limit, label: false %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label class="label">Auto Approval Matter Type</label>
        <%= f.input :auto_approve_matter_type, label: false, collection: @tenant.within_tenant { MatterType.all.pluck(:matter_type) },  input_html: { multiple: true }%>
      </div>
      <div class="col-xs-12 col-md-6">
        <label class="label">RFP Module Required</label>
        <%= f.input :rfp_enable, label: false, as: :boolean%>
      </div>
      <% MatterApproval::MATTER_APPROVAL_ROLE.each do |key, value| %>
        <div class="col-xs-12 col-md-12" style="text-align: center;background: lightgray;">
          <hr style="width:100%;text-align:left;margin-left:0">
          <label class="label"><%= "Owner Of Matter -> #{value}"%></label>
          <hr style="width:100%;text-align:left;margin-left:0">
        </div>
        <% ['consent', 'approval'].each do |approval_type| %>
          <div class="col-xs-12 col-md-12">
            <hr style="width:100%;text-align:left;margin-left:0">
            <label class="label"><%= "#{approval_type} Parties".upcase%></label>
            <hr style="width:100%;text-align:left;margin-left:0">
          </div>
          <%= f.simple_fields_for :tenant_matter_approvals, @tenant.tenant_matter_approvals.where(approval_type: approval_type, owner_role: key).order('created_at') do |field| %>
            <div class="col-xs-12 col-md-4">
                <div class="field-label"><%= MatterApproval::MATTER_APPROVAL_ROLE[field.object.role.to_sym]%></div>
            </div>
            <div class="col-xs-12 col-md-4">
              <label class="label">Approval Required</label>
              <%= field.input :approval, label: false, as: :boolean%>
            </div>
            <div class="col-xs-12 col-md-4">
              <label class="label">Notify</label>
              <%= field.input :notification, label: false, as: :boolean%>
            </div>
          <% end %>
          <hr style="width:100%;text-align:left;margin-left:0">
        <% end %>
      <% end %>
      <!-- New Question start -->
      <div class="col-md-12 col-xs-12">
        <div class="formHeader">
          <div class="headerTitle">RFP Questions</div>
        </div>
      </div>
      <div class="col-md-12 col-xs-12">
        <% if @tenant.tenant_questions.count > 0 %>
          <% @tenant.tenant_questions.each do |question| %>
            <%= f.simple_fields_for :tenant_questions, question do |form| %>
              <%= render 'question_fields', f: form, question: question %>
            <% end %>
          <% end %>
        <% end %>
        <div class="addButton links mb-4">
          <%= link_to_add_association '<span href="javascript:void(0);"><i class="fa fa-plus-circle"></i> Add Question</span>'.html_safe, f, :tenant_questions, partial: 'question_fields' %> 
        </div>
      </div>
      <div class="col-xs-12 col-md-12 mt-3">
        <%=link_to 'Cancel', tenant_admin_root_path, class: 'btn-type-default' %>
        <%= f.button :submit, "Submit", class: "btn-type-primary" %>
      </div>
    </div>
  <% end %>
</div>
