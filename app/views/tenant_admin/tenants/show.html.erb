<style>
  div#gauge * {
    top: -25px;
  }
</style>
<div class="col-lg-12 col-md-12 col-sm-12">
  <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
    <div class="page-header-sp m-top">
      <div class="page-title">Tenant</div>
      <div class="back-edit-actions">
        <a class="btn-type-default" href="/tenant_admin">
          <%= image_tag "chevron-back-icon.svg", alt:"Back" %>
        </a>
        <%= link_to "Edit".html_safe, edit_tenant_admin_tenant_path(id: @tenant&.id), class: "btn-type-primary" %>
      </div>
    </div>
    <div class="">
      <!-- widget content -->
      <div class="view-request">
        <div class="view-request">
          <div class="sp-form-bg show-data-fields">
            <div class="row">
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Tenant Name</div>
                <div class="field-data"><%= @tenant&.name %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Subdomain</div>
                <div class="field-data"><%= @tenant&.subdomain %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Panel Retainer Template ID</div>
                <div class="field-data"><%= @tenant&.panel_retainer_template_id %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Retainer Template ID</div>
                <div class="field-data"><%= @tenant&.retainer_template_id %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Primary Color</div>
                <div class="field-data"><%= @tenant&.primary_color %></div>
              </div>

              <div class="col-xs-12 col-md-6">
                <div class="field-label">Enable Exception Requests</div>
                <div class="field-data"><%= @tenant&.enable_exception_requests ? "YES" : "NO" %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Secondary Color</div>
                <div class="field-data"><%= @tenant&.secondary_color %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">SSO Type</div>
                <div class="field-data"><%= @tenant&.sso_type&.titleize %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Okta Client Id</div>
                <div class="field-data"><%= @tenant&.okta_client_id %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Okta Client Secret</div>
                <div class="field-data"><%= @tenant&.okta_client_secret %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Okta Site Url</div>
                <div class="field-data"><%= @tenant&.okta_site %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Okta Api Token</div>
                <div class="field-data"><%= @tenant&.okta_api_token %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Azure Tenant Id</div>
                <div class="field-data"><%= @tenant&.azure_tenant_id %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Azure Client Id</div>
                <div class="field-data"><%= @tenant&.azure_client_id %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Azure Client Secret</div>
                <div class="field-data"><%= @tenant&.azure_client_secret %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Matter Optional Fields</div>
                <div class="field-data"><%= (@tenant&.matter_optional_fields||[]).select{|s| s.present?}.join(', ') %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Matter Approval Sequence</div>
                <div class="field-data"><%= @tenant&.approval_process %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Matter Auto Approve Amount Limit</div>
                <div class="field-data"><%= @tenant&.auto_approve_amount_limit %></div>
              </div>
              <div class="col-xs-12 col-md-6">
                <div class="field-label">Auto Approval Matter Type</div>
                <div class="field-data"><%= @tenant&.auto_approve_matter_type.join(', ') %></div>
              </div>
              <div class="col-xs-12 col-md-12">
                <label class="label">Matter Approvals</label>
              </div>
              <% @tenant.tenant_matter_approvals.each do |matter_approval| %>
                 <hr style="width:100%;text-align:left;margin-left:0">
                <div class="col-xs-12 col-md-12">
                  <label class="label"><%= "Owner Of Matter -> #{MatterApproval::MATTER_APPROVAL_ROLE[matter_approval.owner_role.to_sym]}".upcase%></label>
                </div>
                <div class="col-xs-12 col-md-12">
                  <label class="field-label"><%= matter_approval.title%></label>
                </div>
                <div class="col-xs-12 col-md-3">
                  <div class="field-label">Role</div>
                  <div class="field-data"><%= MatterApproval::MATTER_APPROVAL_ROLE[matter_approval.role.to_sym]%></div>
                </div>
                <div class="col-xs-12 col-md-3">
                  <div class="field-label">Approval Required</div>
                  <div class="field-data"><%= matter_approval.approval%></div>
                </div>
                <div class="col-xs-12 col-md-3">
                  <div class="field-label">Notify</div>
                  <div class="field-data"><%= matter_approval.notification%></div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
</div>
<div class="clearfix"></div>

<% if @tenant.tenant_questions.present?%>
  <%= render "question" %>
<% end %>

<div class="clearfix"></div>

<div class="col-lg-12 col-md-12 col-sm-12">
  <% if @tenant_law_firms.size > 0 %>
    <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
      <div class="page-header-sp">
        <div class="page-title">Tenant Law Firms (<%= @tenant_law_firms.size %>)</div>
        <div class="back-edit-actions">
        </div>
      </div>

      <div class="">
        <!-- widget content -->
        <div class="table-dyanmic-search table-responsive">
          <table id="dt_basic" class="table table-decoration table-bordered" width="100%">
            <thead>
              <tr>
                <th>Law Firm Name</th>
                <th>Relationship Partner Name</th>
                <th>Relationship Partner Email</th>
                <th>Location</th>
                <th>Score</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% @tenant_law_firms.each do |firm| %>
                <tr class="law-firm-row" data-id="<%= firm.id %>">
                  <td>
                    <% if firm&.law_firm&.name.present? %>
                      <div class="firm-name">
                        <div class="name-avatar"><img src="<%= get_avatar_image(firm&.law_firm&.name&.gsub(" ", "+")) %>"></div>
                        <div><%= firm&.law_firm&.name %></div>
                      </div>
                    <% end %>	
                  </td>
                  <td><%= firm&.law_firm&.bmo_relationship_partner_name%></td>
                  <td><%= firm&.law_firm&.bmo_relationship_partner_email %></td>
                  <td><%= firm&.law_firm&.locations.map{|location| [location.city, location.province, firm&.law_firm&.country_name(location.country)].reject(&:nil?).join(',') }.join(", ").html_safe if firm&.law_firm&.locations.present? %></td>
                  <td>
                    <div> 
                      <span class="percent txt-color-blue bold">
                        <% if firm&.law_firm&.form_submissions.try(:latest).try(:status) == 'approved' %>
                          <% score = firm.law_firm.total_calculated_score(firm.law_firm.form_submissions.try(:latest)) %>
                          <div class="total-score" data-color="<%= firm&.law_firm&.form_submissions.try(:latest).try(:color, score, 'total_calculated_score') %>" data-score=<%= score %>></div>
                        <% end %>
                      </span> 
                    </div>
                  </td>
                  <td>
                    <% if can? :destroy, firm %>
                      <%= link_to 'Delink', tenant_admin_law_firms_tenant_path(firm), method: :delete, class: "btn btn-xs btn-primary" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</div>