<div class="col-lg-12">
  <div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false"> 
    <div class="page-header-sp m-top">
      <div class="page-title">Users</div>
      <div class="back-edit-actions">
        <div class="action-buttons-alignment">
          <a class="action-btn export-icon" href="<%= new_tenant_admin_user_path %>" data-toggle="tooltip" data-placement="top" title="Add new Tanant Admin">
            <span class="blue-text">Add new Tenant Admin</span> <%= image_tag "add.svg", alt:"Add new Tenant Admin" %>
          </a>
        </div>
      </div>
    </div>
    <div class="">
      <!-- widget content -->
      <div class="table-dyanmic-search table-responsive">
        <table id="dt_basic" class="table table-decoration table-bordered" width="100%">
          <thead>
            <tr>
              <th>Name</th>
              <th>Username</th>
              <th>Email</th>
              <th>Created At</th>
            </tr>
          </thead>
          <tbody>
            <% @tenant_admins.each do |tenant_admin| %>
              <tr onClick="window.location.href='/tenant_admin/users/<%= tenant_admin.id %>/edit'">
                <td><%= [tenant_admin&.first_name, tenant_admin&.last_name]&.compact&.join(' ') %></td>
                <td><%= tenant_admin&.username %></td>
                <td><%= tenant_admin&.email %></td>
                <td><%= tenant_admin&.created_at&.strftime('%d %b %Y at %I:%M %p') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <!-- end widget content -->
      
    </div>
  </div>
</div>
