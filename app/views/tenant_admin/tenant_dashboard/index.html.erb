<div class="col-lg-12">
  <div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false"> 
    <div class="page-header-sp m-top">
      <div class="page-title">Tenants</div>
      <div class="back-edit-actions">
        <div class="action-buttons-alignment">
          <a class="action-btn export-icon" href="<%= link_lawfirm_tenant_admin_tenants_path %>" data-toggle="tooltip" data-placement="top" title="Link Lawfirm with Tanant">
            <span class="blue-text">Link Lawfirm with Tenant</span> <%= image_tag "add.svg", alt:"Link Lawfirm with Tanant" %>
          </a>
          <a class="action-btn export-icon" href="<%= new_tenant_admin_tenant_path %>" data-toggle="tooltip" data-placement="top" title="Add new Tanant">
            <span class="blue-text">Add new Tenant</span> <%= image_tag "add.svg", alt:"Add new Tenant" %>
          </a>
        </div>
      </div>
    </div>
    <div class="">
      <!-- widget content -->
      <div class="table-dyanmic-search table-responsive">
        <table id="dt_basic" class="table table-decoration table-bordered" width="100%">
          <thead>
            <tr>
              <th>Name</th>
              <th>Subdomain</th>
              <th>Logo</th>
              <th>Primary Color</th>
              <th>Secondary Color</th>
              <th>Login Bg Image</th>
              <th>Created At</th>
            </tr>
          </thead>
          <tbody>
            <% @tenants.each do |tenant| %>
              <tr onClick="window.location.href='/tenant_admin/tenants/<%= tenant.id %>'">
                <td><%= tenant.name %></td>
                <td><%= tenant.subdomain %></td>
                <td>
                  <% if tenant.logo.present? %>
                    <%=image_tag tenant&.logo&.url, class: 'logo-table' %>
                  <% end %>
                </td>
                <td><%= tenant.primary_color %></td>
                <td><%= tenant.secondary_color %></td>
                <td>
                  <% if tenant.login_bg_image.present? %>
                    <%=image_tag tenant&.login_bg_image&.url, class: 'logo-table' %>
                  <% end %>
                </td>
                <td><%= tenant.created_at.strftime('%d %b %Y at %I:%M %p') %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <!-- end widget content -->
      
    </div>
  </div>
</div>
