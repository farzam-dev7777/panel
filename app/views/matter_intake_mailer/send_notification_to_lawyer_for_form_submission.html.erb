<div class="">
  <p class="user-inner-content">
    A new matter intake form has been submitted by <%= @matter_intake.submitter_name %> <br>
    <% if @law_firm.present? %>
      <%= link_to "Click here", matter_intake_url(@matter_intake), class: "btn btn-xs btn-secondary" %> to review submission.
    <% else %>
      <%= link_to "Click here", review_admin_matter_intake_url(@matter_intake), class: "btn btn-xs btn-secondary" %> to review submission.
    <% end %>
  </p>
</div>