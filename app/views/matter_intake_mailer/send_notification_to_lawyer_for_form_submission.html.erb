<div class="">
  <p class="user-inner-content">
    A new matter created by <%= @matter_intake.submitter_name %> requires your attention.<br>
    <% domain = Tenant.current.domain %>
    <% if @law_firm.present? %>
      <%= link_to "Click here", domain+"/matter_intakes/#{@matter_intake.id}", class: "btn btn-xs btn-secondary" %> to review submission.
    <% else %>
      <%= link_to "Click here", domain+"/admin/matter_intakes/#{@matter_intake.id}", class: "btn btn-xs btn-secondary" %> to review submission.
    <% end %>
  </p>
</div>