<div class="">
  <p class="user-inner-content">
    Dear <%= @name%><br>
  </p>
  <p class="user-inner-content">
    A new matter created by <%= @matter_intake.submitter_name %> requires your attention.<br>
    Please click the link below to review the submission:<br>
    <% if @law_firm.present? %>
      <%= link_to "Review Submission", Tenant.current.domain+"/matter_intakes/#{@matter_intake.id}", class: "btn btn-xs btn-secondary" %>
    <% else %>
      <%= link_to "Review Submission", Tenant.current.domain+"/admin/matter_intakes/#{@matter_intake.id}", class: "btn btn-xs btn-secondary" %>
    <% end %>
    <br>
    If you have any questions or need further assistance, feel free to contact us at support@secureengage.com.<br>
  </p>
  <p class="user-inner-content">
    Best regards,<br>
    The Secure Engage Team<br>
  </p>
</div>