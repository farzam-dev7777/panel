<div class="col-lg-12">
  <div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false"> 
    <div class="page-header-sp m-top">
      <div class="page-title">External Lawyers</div>
      <div class="back-edit-actions">
        <div class="action-buttons-alignment">
          <a class="action-btn export-icon" href="<%= new_law_firm_external_lawyer_path(@law_firm) %>" data-toggle="tooltip" data-placement="top" title="Add new Lawyer">
            <span class="blue-text">Add new Lawyer</span> <%= image_tag "add.svg", alt: "Add new Lawyer" %>
          </a>
        </div>
      </div>
    </div>
    <div class="">
      <!-- widget content -->
      <div class="table-dyanmic-search table-responsive">
        <table id="dt_basic" class="table table-decoration table-bordered" width="100%">
          <thead>
            <tr>
              <th>Name</th>
              <th>Created At</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% @external_laywers.each do |external_laywer| %>
              <tr onClick="window.location.href='/law_firms/<%= external_laywer.law_firm.id %>/external_lawyers/<%=external_laywer.id%>edit'">
                <td><%= external_laywer&.name %></td>
                <td><%= external_laywer.created_at.strftime('%d %b %Y at %I:%M %p') %></td>
                <td> 
                  <a class="action-btn export-icon" href="<%= edit_law_firm_external_lawyer_path(@law_firm, external_laywer) %>" data-toggle="tooltip" data-placement="top" title="Edit">
                    <span class="blue-text">Edit</span>
                  </a>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <!-- end widget content -->
      
    </div>
  </div>
</div>
