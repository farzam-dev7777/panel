<% content_for :page_title do %>
  <span>Invoices</span>
<% end %>
<div class="clearfix"></div>
<div class="col-lg-12">
  <div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
    <div class="page-header-sp m-top">
      <div class="page-title">Invoice</div>
    </div>
    <div class="">
      <div>
        <!-- widget content -->
        <div class="table-dyanmic-search table-responsive">
          <table id="dt_basic" class="table table-decoration table-bordered" width="100%">
            <thead>
              <tr>
                <th>Invoice No</th>
                <th>Amount</th>
                <th>Client</th>
                <th>Date Submitted</th>
                <th>Approval Status</th>
                <th>Attachment</th>
              </tr>
            </thead>
            <tbody>
              <% current_user.law_firm && current_user.law_firm.matter_intakes.map(&:invoices).flatten.each do |invoice| %>
                <tr>
                  <td>
                    <%= invoice.id %>
                  </td>
                  <td>
                    <%= invoice.amount.try(:format) %>
                  </td>
                  <td>
                    <%= invoice&.matter_intake&.law_firm&.name %>
                  </td>
                  <td>
                    <%= (invoice.date||invoice.created_at).strftime('%d %b %Y')  %>
                  </td>
                  <td>
                    <%= invoice.status&.capitalize||'Pending'  %>
                  </td>
                  <td>
                    <% invoice.invoice_attachments.each do |attachment| %>
                      <a href="<%= attachment.file&.url %>" target="_blank" title="<%= attachment.file.identifier %>">
                        <i class="fa fa-money" aria-hidden="true"></i>
                      </a>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <!-- end widget content -->
      </div>
      <!-- end widget div -->
    </div>
    <!-- end widget -->
  </div>
