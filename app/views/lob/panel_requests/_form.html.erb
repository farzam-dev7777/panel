<style>
	/* input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; } */
</style>

<div class="sp-form sp-form-bg">
  <%= simple_form_for [:lob, @panel_request] do |f| %>
      <div class="row form-flex-wrap">
        <!--<div class="col-xs-12 col-md-6">
          <label  class="label">Requested By<span class="mandatory">*</span></label>
          <%= f.input :requested_by, label: false, :class => 'sp-form-control' %>
        </div>-->
        <div class="col-xs-12 col-md-6">
          <label class="label">Submitted By</label>
          <%= f.input :submitted_by_email, label: false, :input_html => { :value => @current_lob_user_email, :readonly => true } %>
          <%= f.input :user_id, :as => :hidden, :input_html => { :value => @current_lob_user_id } %>
          <%= f.input :request_type, :as => :hidden, :input_html => { :value => "ADD_TO_LAW_FIRM_PANEL" } %>
          <%= f.input :status, :as => :hidden, :input_html => { :value => "Deactivate" } %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Line of Business<span class="mandatory">*</span></label>
          <%= f.input :line_of_business, label: false, collection: PanelRequest::LOB_LIST, required: true %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">LOB Contact Name<span class="mandatory">*</span></label>
          <%= f.input :lob_contact_name, label: false, required: true %>
        </div>
        <!--<div class="col-xs-12 col-md-6">
          <label class="label">Business Manager Name</label>
          <%= f.input :business_manager_name, label: false %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Business Manager Email</label>
          <%= f.input :business_manager_email, label: false %>
        </div>
        <div class="col-xs-12 col-md-6">
          <label class="label">Business Manager Phone</label>
          <%= f.input :business_manager_phone, label: false %>
        </div>-->
        <div class="col-md-12">
          <label class="inner-label">Law Firm</label>
          <div class="">
            <%= f.simple_fields_for :law_firm do |field| %>
              <div class="inner-form-field">
                <div class="row">
                  <div class="col-xs-12 col-md-6 col-sm-6">
                    <label class="label">Name<span class="mandatory">*</span></label>
                    <%= field.input :name, label: false, required: true %>
                    <%= field.input :law_firm_category, :as => :hidden, :input_html => { :value => "PANEL" } %>
                    <%= field.input :status, :as => :hidden, :input_html => { :value => "Deactivate" } %>
                  </div>
                  <div class="col-xs-12 col-md-6 col-sm-6">
                    <label class="label">Contact Name<span class="mandatory">*</span></label>
                    <%= field.input :contact_name, label: false, required: true %>
                  </div>
                </div>
                <div class="row">
                  <%= field.simple_fields_for :users do |user_field| %>
                    <div class="col-xs-12 col-md-12">
                      <label class="label">Email<span class="mandatory">*</span></label>
                      <%= user_field.input :email, label: false %>
                      <%= user_field.input :role, :as => :hidden, label: false, :input_html => { :value => "master_user" }%>
                      <%= user_field.input :empty_user, :as => :hidden, label: false, :input_html => { :value => true }%>
                      <%= user_field.input :status, :as => :hidden, :input_html => { :value => "Deactivate" } %>
                    </div>
                  <% end %>
                </div>
                <div class="row">
                  <div class="col-xs-12 col-sm-6 col-md-6">
                    <label class="label">Phone<span class="mandatory">*</span></label>
                    <%= field.input :phone, label: false %>
                  </div>
                  <div class="col-xs-12 col-sm-6 col-md-6">
                    <label class="label">Would You use this firm on a regular basis?<span class="mandatory">*</span></label>
                    <%= field.input :firm_use_on_regular_basis, as: :select, required: true,  label: false, collection: [["Yes", "Yes"], ["No", "No"]] %>
                  </div>
                </div>
                <!--<div class="row">
                  <div class="col-xs-12 col-md-6">
                    <label class="label">Phone</label>
                    <%= field.input :phone, label: false %>
                  </div>
                  <div class="col-xs-12 col-md-6">
                    <label class="label">Description</label>
                    <%= field.input :description, label: false %>
                  </div>
                </div>-->
                <!--<div class="row">
                  <div class="col-xs-12 col-md-6">
                    <label class="label">Relationship Manager Name</label>
                    <%= field.input :relationship_manager_name, label: false %>
                  </div>
                  <div class="col-xs-12 col-md-6">
                    <label class="label">Relationship Manager Email</label>
                    <%= field.input :relationship_manager_email, label: false %>
                  </div>
                </div>-->
                <!--<div class="row">
                  <div class="col-xs-12 col-md-6">
                    <label class="label">Relationship Manager Phone</label>
                    <%= field.input :relationship_manager_phone, label: false %>
                  </div>
                  <div class="col-xs-12 col-md-6">
                    <label class="label">Select Country</label>
                    <span class="country_type"><%= field.input :country_ids, label: false, collection: Country.order(:position).map{|mt| [mt.name, mt.id] } , input_html: { multiple: false }   %></span>
                  </div>
                  
                </div>
                <div class="row">
                  <div class="col-xs-12 col-md-6 sub_matter_type_box" style="display:none;">
                    <label class="label">Select Sub Matter Type</label>
                    <span class="sub_matter_type"><%= field.input :sub_matter_type_ids, label: false, collection: SubMatterType.all.map{|mt| [mt.sub_matter_type, mt.id] } , input_html: { multiple: true }   %></span>
                  </div>
                  <div class="col-xs-12 col-md-12 multiple-selector">
                    <label class="label">Select Jurisdiction Type</label>
                    <span class="jurisdiction_type"><%= field.input :jurisdiction_type_ids, label: false, collection: JurisdictionType.all.map{|mt| [mt.jurisdiction_type, mt.id] } , input_html: { multiple: true }   %></span>
                  </div>
                </div>
                <div class="row">
                <div class="col-xs-12 col-md-12 matter_type multiple-selector">
                  <label class="label">Select Matter Type</label>
                  <%= field.input :matter_type_ids, label: false, collection: MatterType.all.map{|mt| [mt.matter_type, mt.id] } , input_html: { multiple: true }   %>
                </div>
                <div class="col-xs-12 col-md-6 state_type_box" style="display:none;">
                  <label class="label">Select State/Province</label>
                  <span class="state_type"><%= field.input :state_ids, label: false, collection: State.all.map{|mt| [mt.name, mt.id] } , input_html: { multiple: false }   %></span>
                </div>
                </div>-->
                <!-- <tr>
                  <td class="text-right" width="20%"><strong>Temp. Password</strong></td>
                  <td>
                    <%= field.input :temp_password, autocomplete: "off", label: false, input_html: { class: 'set-password' } %>
                    <p style="color: #949494;" class="text-left"><em>Minimum 10 characters required</em></p>	
                  </td>
                </tr>
                  <tr>
                  <td class="text-right" width="20%"><strong>Confirm Password</strong></td>
                  <td>
                    <%= field.input :temp_password_confirmation, autocomplete: "off", label: false, input_html: { class: 'set-password' } %>
                  </td>
                </tr> -->
              </div>
            <% end %>
          </div>
        </div>
        <div class="col-xs-12 col-md-12 multiple-selector">
          <label class="label">What type of matters would this firm work on?<span class="mandatory">*</span></label>
          <%= f.input :matter_types, label: false, collection: PanelRequest::MATTER_TYPES,  input_html: { multiple: true }%>
        </div>
        <div class="col-xs-12 col-md-12">
          <label class="label">Does this firm have a specific niche expertise not available from a BMO LXP Panel law firm?<span class="mandatory">*</span></label>
          <%= f.input :niche_preferred_external_counsel_panel_law_firms, label: false, required: true, collection: [["Yes", "Yes"], ["No", "No"]]  %>
        </div>
        <div class="col-xs-12 col-md-12 panel_request_niche_expertise" style="display:none;">
          <label class="label">If yes, please describe niche expertise</label>
          <%= f.input :niche_expertise, label: false%>
        </div>
        <div class="col-xs-12 col-md-12">
          <label class="label">Does this firm practice in a location not already covered by a BMO LXP Panel law firm?<span class="mandatory">*</span></label>
          <%= f.input :required_unique_geography, label: false, required: true, collection: [["Yes", "Yes"], ["No", "No"]]  %>
        </div>
        <div class="col-xs-12 col-md-12 panel_request_geographic_location" style="display:none;">
          <label class="label">If yes, confirm location</label>
          <%= f.input :geographic_location, label: false%>
        </div>
        <div class="col-xs-12 col-md-12">
          <label class="label">Would engagements of this firm involve the following<span class="mandatory">*</span></label>
          <%= f.input :involved_engagement, label: false, collection: PanelRequest::INVOLVED_ENGAGEMENT %>
        </div>
        <div class="col-xs-12 col-md-12">
          <label class="label">Is this a certified minority/woman owned firm?<span class="mandatory">*</span></label>
          <%= f.input :women_owned, label: false, collection: PanelRequest::MINORITY_OWNED_TYPE  %>
        </div>
        <div class="col-xs-12 col-md-12 women_owned_details"  style="display:none;">
          <label class="label">If yes, which organization certified the firm?</label>
          <%= f.input :women_owned_details, label: false%>
        </div>
        <!--<div class="col-xs-12 col-md-12">
          <label class="label">Women Owned</label>
          <%= f.input :minority_owned, label: false, collection: PanelRequest::WOMEN_OWNED_TYPE %>
        </div>
        <div class="col-xs-12 col-md-12 minority_owned_details" style="display:none;">
          <label class="label">Women Owned Details</label>
          <%= f.input :minority_owned_details, label: false %>
        </div>-->
        <div class="col-xs-12 col-md-12">
          <label class="label">Are there additional reasons to consider this firm for BMO's LXP Panel? Provide details<span class="mandatory">*</span></label>
          <%= f.input :reason_other, label: false, required: true %>
        </div>
        <!-- <div class="col-xs-12 col-md-6 matter_name">
          <label class="label">Matter Name</label>
          <%= f.input :matter_name, label: false, input_html: { autocomplete: 'off' } %>
        </div> -->
        <div class="col-xs-12 col-md-12">
          <%=link_to 'Cancel', @panel_request.new_record? ? lob_panel_requests_path : lob_panel_requests_path, class: "btn-type-default" %>
          <%= f.button :submit, @panel_request.new_record? ? "Submit Request" : "Update Request", class: "btn-type-primary" %>
        </div>
      </div>
  <% end %>
</div>
