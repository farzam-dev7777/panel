<style>
		div#gauge * {
			top: -25px;
		}
	</style>
	
	<div class="col-lg-3 back-btn">
		<%= link_to "<i class='fa fa-long-arrow-left'></i>".html_safe, lob_panel_requests_path, class: "btn btn-sm btn-default" %>
		<%= link_to "<i class='fa fa-pencil-square-o'></i> Edit".html_safe, edit_lob_panel_request_path, class: "btn btn-sm btn-primary m-l-15 no-border" %>
	</div>
	 
	<div class="clearfix"></div>


  <div class="col-lg-12 col-md-12 col-sm-12">
    <div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
      <header>
        <span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
        <h2 class="font-md"><strong> Exception Request </strong></h2>				
      </header>
      <div class="  ">
        <div class="jarviswidget-editbox"></div>
        <!-- widget content -->
        <div class="widget-body no-padding view-request">
						<div class="tab-content padding-10 view-request">
								<div class="tab-pane fade in active">
										<div class="col-md-10">
											<div class="col-md-12">
												<div class="col-md-3 column">Requested By:	</div>
												<div class="col-md-9 data"><%= @panel_request.requested_by %></div>
											</div>
											<div class="col-md-12">
												<div class="col-md-3 column">Submitted By: </div>		
												<div class="col-md-9 data"><%= @panel_request.submitted_by_email %></div>
											</div>
											<div class="col-md-12">
												<div class="col-md-3 column">Line of Business	</div>		
												<div class="col-md-9 data"><%= @panel_request.requested_by %><%= @panel_request.line_of_business %></div>
											</div>
											<div class="col-md-12">
												<div class="col-md-3 column">LOB Contact Name	</div>		
												<div class="col-md-9 data"><%= @panel_request.lob_contact_name %></div>
											</div>
											<div class="col-md-12">
												<div class="col-md-3 column">Business Manager Name</div>
												<div class="col-md-9 data"><%= @panel_request.business_manager_name %></div>
											</div>
											<div class="col-md-12">
												<div class="col-md-3 column">Business Manager Email</div>		
												<div class="col-md-9 data"><%= @panel_request.business_manager_email %></div>
											</div>
											<div class="col-md-12">
												<div class="col-md-3 column">Business Manager Phone	</div>		
												<div class="col-md-9 data"><%= @panel_request.business_manager_phone %></div>
											</div>	
											 	
											<div class="col-md-12">
													<div class="col-md-3 column">Law Firm :</div>		
													<div class="col-md-8 data">
														<div class="col-md-12 ">
															<div class="col-md-12">
																<div class="col-md-6 column">Law Firm Category : </div>
																<div class="col-md-6 data firmName"><%= @panel_request.law_firm.law_firm_category %></div>
															</div>
															<div class="col-md-12">
																<div class="col-md-6 column">Name : </div>
																<div class="col-md-6 data firmName"><%= @panel_request.law_firm.name %></div>
															</div>
															<div class="col-md-12">
																<div class="col-md-6 column">Email : </div>		
																<div class="col-md-6 data firmEmail"><%= @panel_request.law_firm.email %></div>
															</div>
															<div class="col-md-12">
																<div class="col-md-6 column">Phone : </div>		
																<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.phone %></div>
															</div>
															<div class="col-md-12">
																<div class="col-md-6 column">Description : </div>		
																<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.description %></div>
															</div>
															<div class="col-md-12">
																<div class="col-md-6 column">Relationship Manager Name :	</div>		
																<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.relationship_manager_name %></div>
															</div>
															<div class="col-md-12">
																<div class="col-md-6 column">Relationship Manager Email : </div>		
																<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.relationship_manager_email %></div>
															</div>
															<div class="col-md-12">
																<div class="col-md-6 column">Relationship Manager Phone : </div>		
																<div class="col-md-6 data firmPhone"><%= @panel_request.law_firm.relationship_manager_phone %></div>
															</div>
															
														</div>
													</div>
												</div>
											<div class="col-md-12">
												<div class="col-md-3 column">Minority Owned</div>		
												<div class="col-md-9 data"><%= @panel_request.minority_owned %></div>
											</div>
											<div class="col-md-12">
												<div class="col-md-3 column">Minority Owned Details</div>		
												<div class="col-md-9 data"><%= @panel_request.minority_owned_details %></div>
											</div>
											<div class="col-md-12">
												<div class="col-md-3 column">Women Owned</div>		
												<div class="col-md-9 data"><%= @panel_request.women_owned %></div>
											</div>
											<div class="col-md-12">
												<div class="col-md-3 column">Women Owned Details</div>		
												<div class="col-md-9 data"><%= @panel_request.women_owned_details %></div>
											</div>
											<div class="col-md-12">
												<div class="col-md-3 column">Matter Types</div>		
												<div class="col-md-9 data"><%= @panel_request.matter_types.is_a?(Array) ? @panel_request.matter_types.join(", ") : "" %></div>
											</div>	
										</div>
										<div class="clearfix"></div>
								</div>
						</div>
        </div>
      </div>
    </div>
	</div>
 