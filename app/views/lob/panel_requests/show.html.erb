<style>
	div#gauge * {
		top: -25px;
	}
</style>

  <div class="col-lg-12 col-md-12 col-sm-12">
    <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
      <div class="page-header-sp m-top">
				<div class="page-title">Panel Consideration Request</div>
				<div class="back-edit-actions">
					<a class="btn-type-default" href="/lob/panel_requests">
						<%= image_tag "chevron-back-icon.svg", alt:"Back" %>
					</a>
					<%= link_to "Edit".html_safe, edit_lob_panel_request_path, class: "btn-type-primary" %>
				</div>
  		</div>
			
      <div class="">
        <!-- widget content -->
        <div class="">
					<div class="sp-form-bg show-data-fields">
						<div class="row form-flex-wrap">
							<!--<div class="col-xs-12 col-md-6">
								<div class="field-label">Requested By</div>
								<div class="field-data"><%= @panel_request.requested_by %></div>
							</div>-->
							<div class="col-xs-12 col-md-6">
								<div class="field-label">Submitted By</div>		
								<div class="field-data"><%= @panel_request.submitted_by_email %></div>
							</div>
							<div class="col-xs-12 col-md-6">
								<div class="field-label">Line of Business</div>		
								<div class="field-data"><%= @panel_request.line_of_business %></div>
							</div>
							<div class="col-xs-12 col-md-6">
								<div class="field-label">LOB Contact Name</div>		
								<div class="field-data"><%= @panel_request.lob_contact_name %></div>
							</div>
							<!--<div class="col-xs-12 col-md-6">
								<div class="field-label">Business Manager Name</div>
								<div class="field-data"><%= @panel_request.business_manager_name %></div>
							</div>
							<div class="col-xs-12 col-md-6">
								<div class="field-label">Business Manager Email</div>		
								<div class="field-data"><%= @panel_request.business_manager_email %></div>
							</div>
							<div class="col-xs-12 col-md-6">
								<div class="field-label">Business Manager Phone	</div>		
								<div class="field-data"><%= @panel_request.business_manager_phone %></div>
							</div>-->
							<div class="col-md-12">
									<div class="inner-label">Law Firm</div>		
									<div class="row inner-form-field">
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Type</div>
											<div class="field-data"><%= @panel_request.law_firm_category %></div>
										</div>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Name</div>
											<div class="field-data"><%= @panel_request.law_frim_name %></div>
										</div>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Contact Name</div>
											<div class="field-data"><%= @panel_request.law_firm_contact_name %></div>
										</div>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Email</div>		
											<div class="field-data"><%= @panel_request.law_firm_mail %></div>
										</div>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Phone</div>		
											<div class="field-data"><%= @panel_request.law_firm_phone %></div>
										</div>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Would You use this firm on a regular basis?</div>		
											<div class="field-data"><%= @panel_request.firm_use_on_regular_basis ? "Yes" : "No" %></div>
										</div>
										
									</div>
								</div>
							<div class="col-xs-12 col-md-6">
								<div class="field-label">What type of matters would this firm work on?</div>		
								<div class="field-data"><%= @panel_request.matter_types.join(', ') %></div>
							</div>
							<div class="col-xs-12 col-md-6">
								<div class="field-label">Does this firm have a specific niche expertise not available from a BMO LXP Panel law firm?</div>		
								<div class="field-data"><%= @panel_request.niche_preferred_external_counsel_panel_law_firms %></div>
							</div>
							<div class="col-xs-12 col-md-6">
								<div class="field-label">If yes, please describe niche expertise</div>		
								<div class="field-data"><%= @panel_request.niche_expertise %></div>
							</div>
							<div class="col-xs-12 col-md-6">
								<div class="field-label">Does this firm practice in a location not already covered by a BMO LXP Panel law firm?</div>		
								<div class="field-data"><%= @panel_request.required_unique_geography %></div>
							</div>
							<div class="col-xs-12 col-md-6">
								<div class="field-label">If yes, confirm location</div>		
								<div class="field-data"><%= @panel_request.geographic_location %></div>
							</div>
							<div class="col-xs-12 col-md-6">
								<div class="field-label">Would engagements of this firm involve the following</div>		
								<div class="field-data"><%= @panel_request.involved_engagement %></div>
							</div>
							<div class="col-xs-12 col-md-6">
								<div class="field-label">Is this a certified minority/woman owned firm?</div>		
								<div class="field-data"><%= @panel_request.women_owned %></div>
							</div>
							<div class="col-xs-12 col-md-6">
								<div class="field-label">If yes, which organization certified the firm?</div>		
								<div class="field-data"><%= @panel_request.women_owned_details %></div>
							</div>
							<div class="col-xs-12 col-md-12">
								<div class="field-label">Are there additional reasons to consider this firm for BMO's LXP Panel? Provide details</div>		
								<div class="field-data"><%= @panel_request.reason_other %></div>
							</div>
							<div class="col-xs-12 col-md-6">
								<div class="field-label">LXP Status</div>
								<div class="field-data"><%=  @panel_request.lxp_status_show ? @panel_request.lxp_status_show : "-" %></div>
							</div>
							<div class="col-xs-12 col-md-6">
								<div class="field-label">Panel Approved</div>
								<div class="field-data"><%= @panel_request.fully_approved? ? "Yes" : "No" %></div>
							</div>
							<% if @panel_request.docusign_envelope_id.present? %>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Document Status</div>
									<div class="field-data"><%= @panel_request.docusign_retainer_envelope.try(:status) %></div>
								</div>
								<% if @panel_request.docusign_retainer_envelope.try(:status) == "completed"%>
									<div class="col-xs-12 col-md-6">
										<div class="field-label">Download Document</div>
										<div class="field-data">
											<%= link_to "Download Document", admin_panel_request_download_pdf_path(@panel_request), class: "" %>
										</div>
									</div>
								<% end %>	
							<% end %>
						</div>
					</div>
        </div>
      </div>
    </div>
	</div>
	