
<div class="lob_dashboard main-container">
	<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
			<div class="page-header-sp m-top">
			<div class="page-title">Non-Panel (one-off) Requests</div>
			
		</div>
		<ul id="sparks" class="top-status-card">
			<li class="sparks-info color-border-01">
				<a href="/lob/exception_requests" class="card-content">
					<div class="card-icon bg-color-01">
						<%= image_tag "exceptions-icon.svg", alt:"Non-Panel (one-off) Requests" %> 
					</div>
					<div class="card-details">
						<div class="total-record"><%= @exception_requests_count %></div>
						<div class="card-name">Non-Panel (one-off) Requests</div>
						<div class="card-tag-line">Tag lines goes here</div>
					</div>
				</a>
			</li>
			<li class="sparks-info color-border-02">
				<a href="/lob/panel_requests" class="card-content">
					<div class="card-icon bg-color-02">
						<%= image_tag "submitted-icon.svg", alt:"Panel Consideration Requests" %> 
					</div>
					<div class="card-details">
						<div class="total-record"><%= @panel_requests_count %></div>
						<div class="card-name">Panel Consideration Requests</div>
						<div class="card-tag-line">Tag lines goes here</div>
					</div>
				</a>
			</li>
			<li class="sparks-info color-border-03">
				<a href="/lob/matter_intakes" class="card-content">
					<div class="card-icon bg-color-03">
						<%= image_tag "approved-icon.svg", alt:"Exceptions" %> 
					</div>
					<div class="card-details">
						<div class="total-record"><%= @matter_intakes_count %></div>
						<div class="card-name">Matter Intake Forms</div>
						<div class="card-tag-line">Tag lines goes here</div>
					</div>
				</a>
			</li>
			<!-- <li class="sparks-info color-border-04">
				<a href="javascript:void(0);" class="card-content">
					<div class="card-icon bg-color-04">
						<%= image_tag "exceptions-icon.svg", alt:"Exceptions" %> 
					</div>
					<div class="card-details">
						<div class="total-record"><%= @exception_requests_rejected %></div>
						<div class="card-name">Rejected</div>
						<div class="card-tag-line">Tag lines goes here</div>
					</div>
				</a>
			</li>-->
		</ul>
	</div>
</div>
<% if Current.user.role === "lob" %>
	<div class="col-lg-12 col-md-12 col-sm-12" style="margin-top: 20px">
		<div class="sp-form sp-form-bg text-center">
		<p>	
			<b> <%= link_to 'Submit New Non-Panel (one-off) Request', engage_non_panel_firm_lob_exception_requests_path, html_options = {class: 'btn-type-primary'}   %></b>
			<b><%= link_to 'Submit New Matter Intake Form', new_lob_matter_intake_path, html_options = {class: 'btn-type-primary'}   %></b>
		</p>
		</div>
	</div>
<% end %>
<!-- Engage Non Panel Firms --> 
<div class="col-lg-12 col-md-12 col-sm-12">
	<div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<div class="page-header-sp mobile-dashboard-header">
			<div class="page-title">Non-Panel (one-off) Requests</div>
			<div class="back-edit-actions">
				<a class="btn-show-more" href="/lob/exception_requests">
        Show more
      	</a>
			</div>
  	</div>		
		<div class="no-padding">
			<!-- widget content -->
			<div class="widget-body">
				<div class="table-responsive table-dyanmic-search">
					<table id="" class="table table-decoration table-bordered" width="100%">
						<thead>
							<tr>
								<th>Date Submitted</th>
								<th>Requested By</th>
								<th>Submitted By</th>
								<th>LOB Contact Name</th>
								<th>Law Firm Name</th>
								<th>Matter Name</th>
								<th>Status</th>
								<!--<th>LXP Status</th>-->
								<!--<th>Internal Lawyer Status</th>-->
								<!--<th width="8%">Action</th>-->
							</tr>
						</thead>
						<tbody>
							<% @exception_requests.each do |exception_request| %>
							<% if exception_request.law_firm_id.present? %>
								<tr onClick="window.location.href='/lob/exception_requests/<%= exception_request.id %>'">
									<td>
										<%= exception_request.created_at.strftime('%d %b %Y at %I:%M %p') %>
									</td>
									<td>
										<% if exception_request.requested_by.present? %>
											<div class="firm-name">
												<div class="name-avatar">
													<img src="<%= get_avatar_image(exception_request&.requested_by&.gsub(" ", "+")) %>"></div>
												<div><%= exception_request.requested_by %></div>
											</div>
										<% end %>	
									</td>
									<td><%= exception_request.submitted_by_email %></td>
									<td><%= exception_request.lob_contact_name %></td>
									<td><%= exception_request.try(:law_firm).try(:name) %></td>
									<td><%= exception_request.try(:matter_name) %></td>
									<td>
										<div class="status">
											<% if exception_request.status_for_lob.present? %>
												<span class="<%= exception_request.status_for_lob === "APPROVED" ? 'label label-success' : 'label label-default' %>"> 
													<%= exception_request.try(:status_for_lob) %>
												</span>
											<% end %>
										</div>
									</td>
									<!--<td>
										<div class="status">
											<% if exception_request.lxp_status_show.present? %>
												<span class="<%= exception_request.lxp_status_show === "Approved" ? 'label label-success' : 'label label-default' %>"> 
													<%= exception_request.try(:lxp_status_show).try(:titleize) %>
												</span>
											<% end %>
										</div>
										<% exception_request.lxp_status_show %>
									</td>-->
									<!--<td>
										<div class="status">
											<% if exception_request.internal_lawyers_status_show.present? %>
												<span class="<%= exception_request.internal_lawyers_status_show === "Approved" ? 'label label-success' : 'label label-default' %>"> 
													<%= exception_request.try(:internal_lawyers_status_show).try(:titleize) %>
												</span>
											<% end %>
										</div>
										<% exception_request.internal_lawyers_status_show %>
									</td>-->
									<!--<td>
										<div class="action-fields">
											<% if current_user.role == 'lob' &&  exception_request.try(:lxp_status) != 'APPROVED' %>
												<a class="action-btn" href="/lob/exception_requests/<%= exception_request.id %>/edit">
													<%= image_tag "edit-icon.svg", alt:"Edit" %>
												</a>
											<% end %> 
											<a class="action-btn" href="/lob/exception_requests/<%= exception_request.id %>">
												<%= image_tag "view-icon.svg", alt:"View" %>
											</a>
										</div>
									</td>-->
								</tr>
								<% end %>
							<% end %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Engage Non Panel Firms END -->

<!--  Matter Intakes -->
<div class="col-lg-12 col-md-12 col-sm-12">
	<div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<div class="page-header-sp mobile-dashboard-header">
			<div class="page-title"> Matter Intake Forms</div>
			<div class="back-edit-actions">
				<a class="btn-show-more" href="/lob/matter_intakes">
        Show more
      	</a>
			</div>
  	</div>			
		<div class="no-padding">
			<!-- widget content -->
			<div class="widget-body">
				<div class="table-dyanmic-search table-responsive">
					<table id="" class="table table-decoration table-bordered" width="100%">
						<thead>
							<tr>
								<th>Date Submitted</th>
								<th>Submitter Name</th>
								<!--<th>LOB Contact Name</th>-->
								<!--<th>Type of Matter</th>-->
								<!--th>Law Firm Suggested</th-->
								<th>BMO lawyer name</th>
								<th>Matter Name</th>
								<th>T360 Matter Number</th>
								<!--<th>Budget amount</th>-->
								<th>Status</th>
								<!--<th>Action</th>-->
							</tr>
						</thead>
						<tbody>
							<% @matter_intakes.each do |matter_intake| %>
								<tr onClick="window.location.href='/lob/matter_intakes/<%= matter_intake.id %>'">
									<td>
										<%= matter_intake.created_at.strftime('%d %b %Y at %I:%M %p') %>
									</td>
									<td>
										<% if matter_intake.submitter_name.present? %>
											<div class="firm-name">
												<div class="name-avatar"><img src="<%= get_avatar_image(matter_intake&.submitter_name&.gsub(" ", "+")) %>"></div>
												<div><%= matter_intake&.submitter_name %></div>
											</div>
										<% end %>	
									</td>
									<!--<td><%= matter_intake.lob_contact_name %></td>-->
									<!--<td>
										<%= matter_intake&.matter_type&.matter_type %>
									</td>-->
									<!--td><%= matter_intake&.law_firm&.name %></td-->
									<td>
										<%= matter_intake&.bmo_lawyer_name %>
									</td>
									<td>
										<%= matter_intake&.name_of_matter_client %>
									</td>
									<td>
										<%= matter_intake&.matter_number %>
									</td>
									<!--<td><%= matter_intake.budget_amount %></td>-->
									<td>
										<div class="status">
											<span class="<%= matter_intake&.status === "matter_open" ? 'label label-success' : 'label label-default' %>"> 
												<%= matter_intake.show_status %>
											</span>
										</div>
									</td>
									<!--<td>
										<div class="action-fields">
											<% if matter_intake.status === "awaiting_lawyer_review" %>
												<a class="action-btn" href="/lob/matter_intakes/<%= matter_intake.id %>/edit">
													<%= image_tag "edit-icon.svg", alt:"Edit" %>
												</a>
											<% end %>
											<a class="action-btn" href="/lob/matter_intakes/<%= matter_intake.id %>">
												<%= image_tag "view-icon.svg", alt:"View" %>
											</a>
										</div>
									</td>-->
								</tr>
							<% end %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<!--  Matter Intakes END -->

