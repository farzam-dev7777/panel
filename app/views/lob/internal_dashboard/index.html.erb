
<div class="lob_dashboard">

	<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
		<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 current-stats">
			<ul id="sparks" class="text-left">
				<li class="sparks-info">
					<a href="javascript:void(0);">
						<h5 class="current-month-info"> Total Exceptions
							<span class="txt-color">
								- <%= @exception_requests_count %> -
							</span>
						</h5>
					</a>
				</li>
				<li class="sparks-info">
					<a href="javascript:void(0);">
						<h5 class="current-month-info"> Submitted Exceptions
							<span>
								- <%= @exception_requests_submitted %> -
							</span>
						</h5>
					</a>
				</li>
				<li class="sparks-info">
					<a href="javascript:void(0);">
						<h5 class="current-month-info"> Approved Exceptions
							<span>- <%= @exception_requests_approved %> -</span>
						</h5>
					</a>
				</li>
				<li class="sparks-info">
					<a href="javascript:void(0);">
						<h5 class="current-month-info"> Rejected Exceptions
							<span>
								- <%= @exception_requests_rejected %> -
							</span>
						</h5>
					</a>
				</li>
				
			</ul>
		</div>
	</div>

</div>

<p>&nbsp;</p>
 


<div class="clearfix"></div>

<div class="col-lg-12 col-md-12 col-sm-12">
	<div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<header>
			<span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
			<h2 class="font-md"><strong>Latest Exception Request </strong></h2>				
		</header>
		<div class="no-padding">
			<div class="jarviswidget-editbox"></div>
			<!-- widget content -->
			<div class="widget-body">

				<div class="table-responsive">
					<table id="" class="table table-striped table-bordered table-hover" width="100%">
						<thead>
							<tr style="background: #007ac3;color: #fff;">
								<th>Requested By</th>
								<th>Submitted By</th>
								<th>LOB Contact Name</th>
								<th>LXP Status</th>
								<th>Internal Lawyers Status</th>
								<th>Action</th>
							</tr>
						</thead>
						<tbody>
							<% @exception_requests.each do |exception_request| %>
							<tr class="" data-id="<%= exception_request.id %>">
								<td><%= exception_request.requested_by %></td>
								<td><%= exception_request.submitted_by_email %></td>
								<td><%= exception_request.lob_contact_name %></td>
								<td><%= exception_request.lxp_status_show %></td>
								<td><%= exception_request.internal_lawyers_status_show %></td>
								<td>
									<% if current_user.role == 'lob' &&  exception_request.try(:lxp_status) != 'APPROVED' %>
										<%= link_to "Edit", edit_lob_exception_request_path(exception_request), class: "btn btn-xs btn-primary" %>
									<% end %> 
									<%= link_to "Review", lob_exception_request_path(exception_request), class: "btn btn-xs btn-secondary" %>	
								</td>
							</tr>
							<% end %>
						</tbody>
					</table>
					<div class="clearfix"></div>

				</div>		

			</div>
		</div>
	</div>


</div>
<div class="clearfix"></div>