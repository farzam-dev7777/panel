
<div class="lob_dashboard main-container">
	<div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
		<ul id="sparks" class="top-status-card">
			<li class="sparks-info color-border-01">
				<a href="javascript:void(0);" class="card-content">
					<div class="card-icon bg-color-01">
						<%= image_tag "exceptions-icon.svg", alt:"Exceptions" %> 
					</div>
					<div class="card-details">
						<div class="total-record"><%= @exception_requests_count %></div>
						<div class="card-name">Engage Non Panel Firms</div>
						<div class="card-tag-line">Tag lines goes here</div>
					</div>
				</a>
			</li>
			<li class="sparks-info color-border-02">
				<a href="javascript:void(0);" class="card-content">
					<div class="card-icon bg-color-02">
						<%= image_tag "submitted-icon.svg", alt:"Exceptions" %> 
					</div>
					<div class="card-details">
						<div class="total-record"><%= @panel_requests_count %></div>
						<div class="card-name">Panel Requests</div>
						<div class="card-tag-line">Tag lines goes here</div>
					</div>
				</a>
			</li>
			<li class="sparks-info color-border-03">
				<a href="javascript:void(0);" class="card-content">
					<div class="card-icon bg-color-03">
						<%= image_tag "approved-icon.svg", alt:"Exceptions" %> 
					</div>
					<div class="card-details">
						<div class="total-record"><%= @matter_intakes_count %></div>
						<div class="card-name">Matter Takes</div>
						<div class="card-tag-line">Tag lines goes here</div>
					</div>
				</a>
			</li>
			<!-- <li class="sparks-info color-border-04">
				<a href="javascript:void(0);" class="card-content">
					<div class="card-icon bg-color-04">
						<%= image_tag "exceptions-icon.svg", alt:"Exceptions" %> 
					</div>
					<div class="card-details">
						<div class="total-record"><%= @exception_requests_rejected %></div>
						<div class="card-name">Rejected</div>
						<div class="card-tag-line">Tag lines goes here</div>
					</div>
				</a>
			</li>-->
		</ul>
	</div>
</div>

<!-- Engage Non Panel Firms --> 
<div class="col-lg-12 col-md-12 col-sm-12">
	<div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
		<div class="page-header-sp">
			<div class="page-title">Engage Non Panel Firms</div>
			<div class="back-edit-actions">
				<a class="btn-show-more" href="/lob/exception_requests">
        Show more
      	</a>
			</div>
  	</div>		
		<div class="no-padding">
			<!-- widget content -->
			<div class="widget-body">
				<div class="table-responsive table-dyanmic-search">
					<table id="" class="table table-decoration table-bordered" width="100%">
						<thead>
							<tr>
								<th>Requested By</th>
								<th>Submitted By</th>
								<th>LOB Contact Name</th>
								<th>LXP Status</th>
								<th>Internal Lawyers Status</th>
								<!--<th width="8%">Action</th>-->
							</tr>
						</thead>
						<tbody>
							<% @exception_requests.each do |exception_request| %>
							<% if exception_request.law_firm_id.present? && exception_request.requested_by != nil  %>
								<tr onClick="window.location.href='/lob/exception_requests/<%= exception_request.id %>'">
									<td>
										<div class="firm-name">
											<div class="name-avatar">
												<img src="<%= get_avatar_image(exception_request&.requested_by&.gsub(" ", "+")) %>"></div>
											<div><%= exception_request.requested_by %></div>
										</div>
									</td>
									<td><%= exception_request.submitted_by_email %></td>
									<td><%= exception_request.lob_contact_name %></td>
									<td><%= exception_request.lxp_status_show %></td>
									<td><%= exception_request.internal_lawyers_status_show %></td>
									<!--<td>
										<div class="action-fields">
											<% if current_user.role == 'lob' &&  exception_request.try(:lxp_status) != 'APPROVED' %>
												<a class="action-btn" href="/lob/exception_requests/<%= exception_request.id %>/edit">
													<%= image_tag "edit-icon.svg", alt:"Edit" %>
												</a>
											<% end %> 
											<a class="action-btn" href="/lob/exception_requests/<%= exception_request.id %>">
												<%= image_tag "view-icon.svg", alt:"View" %>
											</a>
										</div>
									</td>-->
								</tr>
								<% end %>
							<% end %>
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- Engage Non Panel Firms END -->

