<div class="clearfix"></div>
<style>
  input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
  .inner-table{
    border:1px solid #ccc;
  }
</style>

<div class="container">
  <div class="col-lg-12 col-md-12 col-sm-12">
    <div class="jarviswidget jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
      <header>
        <span class="widget-icon"> <i class="fa fa-arrows-v"></i> </span>
        <h2 class="font-md"><strong>Select To Engage Non Panel Firm </strong></h2>				
      </header>
      <div class="no-padding">
        <div class="jarviswidget-editbox"></div>
        <!-- widget content -->
        <div class="widget-body">
        <div class="clearfix"></div>
          <div class="table-responsive" style="height: 500px;">
            <div classs="row">
              <div class="col-md-4 engageForm">
                <%= simple_form_for [:lob, @law_firm] do |f| %>
                  <table class="table table-striped">
                    <tbody>
                      <tr>
                        <td class="text-left matter_type">
                          <strong>Select Matter Type</strong>
                          <%= f.input :matter_types, label: false, collection: MatterType.all.map{|mt| [mt.matter_type, mt.id] }  %>
                        </td>
                      </tr>
                      <tr class="sub_matter_type_box" style="display:none">
                        <td class="text-left sub_matter_type">
                          <strong>Select Sub Matter Type</strong>
                          <%= f.input :sub_matter_types, label: false, collection: []  %>
                        </td>
                      </tr>
                      <tr>
                        <td class="text-left jurisdiction_type">
                          <strong>Select Jurisdiction Type</strong>
                          <%= f.input :jurisdiction_types, label: false, collection: JurisdictionType.all.map{|mt| [mt.jurisdiction_type, mt.id] }  %>
                        </td>
                      </tr>
                      <tr>
                        <td class="text-left country_type">
                          <strong>Select Country</strong>
                          <%= f.input :countries, label: false, collection: Country.all.map{|mt| [mt.name, mt.id] }  %>
                        </td>
                      </tr>
                       <tr class="state_type_box" style="display:none">
                        <td class="text-left state_type">
                          <strong>Select State/Province</strong>
                          <%= f.input :states, label: false, collection: State.all.map{|mt| [mt.name, mt.id] }  %>
                        </td>
                      </tr>
                      <tr> 
                        <td colspan="2">
                          <%= f.button :submit, @law_firm.new_record? ? "Search" : "Submit", class: "searchLawFirm" %>
                        </td>
                      </tr>  
                    </tbody>
                  </table>
                  
                <% end %>
              </div>
              <div  class="col-md-8  law_firm_list" style="display:none">
                
                 <div class="" id="wid-id-0" data-widget-editbutton="false">
                  <header>
                    <h2>Select Law Firm</h2>
                  </header>
                  <div class="clearfix"></div>
                   <%= simple_form_for [:lob, @exception_request] do |f| %>
                    <div class="widget-body no-padding">
                      <table id="dt_basic" class="table table-striped table-bordered table-hover dataTable" width="100%">
                        <thead>
                          <tr style="background: #007ac3;color: #fff;">
                            <th>Select</th>
                            <th> Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                          </tr>
                        </thead>
                        <tbody>
                        </tbody>
                      </table>
                      <div class="clearfix"></div>
                      <div class="table-responsive">
                          <table class="table table-striped">
                            <tbody>
                              <tr>
                                <td class="text-right" width="50%"><strong>Could One of these Law Firms do the work?</strong></td>
                                <td><%= f.input :is_work, as: :radio_buttons, label: false, collection: ["Yes", "No"]  %></td>
                              </tr>
                             <tr>
                                <td colspan="2">
                                  <%= f.input :user_id, :as => :hidden, :input_html => { :value => @current_admin_user_id } %>
                                  <%= f.input :matter_types_search, :as => :hidden, :input_html => { :value => "" } %>
                                  <%= f.input :sub_matter_types_search, :as => :hidden, :input_html => { :value => "" } %>
                                  <%= f.input :jurisdiction_types_search, :as => :hidden, :input_html => { :value => "" } %>
                                  <%= f.input :countries_search, :as => :hidden, :input_html => { :value => "" } %>
                                  <%= f.input :states_search, :as => :hidden, :input_html => { :value => "" } %>
                                  <%= f.button :submit, @exception_request.new_record? ? "Submit Request" : "Update Request", class: "engage_non_panel_firm_btn" %>
                                </td>
                              </tr>
                            </tbody>
                          </table>
                      </div>
                    </div>
                  <% end %>  
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

