<style>
    input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
  </style>
  
  
  
  <div class="table-responsive">
      <%= simple_form_for([:lob, @law_firm], 
      :url => url_for(:action => 'law_firm_create', :controller => 'exception_requests'),
      :method => 'post', html: { class: '' }) do |field| %>
    <table class="table table-striped">
        <tbody>
            <tr>
              <td class="text-right" width="20%"><strong>Name</strong></td>
              <td><%= field.input :name, label: false %></td>
              <%= field.input :user_id, :as => :hidden, :input_html => { :value => @current_user_id } %>
              <%= field.input :law_firm_category, :as => :hidden, :input_html => { :value => "NON_PANEL" } %>
            </tr>
            <tr>
              <td class="text-right" width="20%"><strong>Email</strong></td>
              <td><%= field.input :email, label: false %></td>
            </tr>
            <tr>
              <td class="text-right" width="20%"><strong>Phone</strong></td>
              <td><%= field.input :phone, label: false %></td>
            </tr>
            <tr>
              <td class="text-right" width="20%"><strong>Description</strong></td>
              <td><%= field.input :description, label: false %></td>
            </tr>
            
                <td class="text-right" width="20%"><strong>Type</strong></td>
                <td><%= field.input :law_firm_type, label: false, collection: LawFirm::COMPANY_TYPES, input_html: { autocomplete: 'off', class: 'text-left' }, prompt: 'Please Select a Type' %></td>
              </tr>
            <tr>
              <td class="text-right" width="20%"><strong>Relationship Manager Name</strong></td>
              <td><%= field.input :relationship_manager_name, label: false %></td>
            </tr>
            <tr>
              <td class="text-right" width="20%"><strong>Relationship Manager Email</strong></td>
              <td><%= field.input :relationship_manager_email, label: false %></td>
            </tr>
            <tr>
              <td class="text-right" width="20%"><strong>Relationship Manager Phone</strong></td>
              <td><%= field.input :relationship_manager_phone, label: false %></td>
            </tr>
            <!-- <tr>
              <td class="text-right" width="20%"><strong>Temp. Password</strong></td>
              <td>
                <%= field.input :temp_password, autocomplete: "off", label: false, input_html: { class: 'set-password' } %>
                <p style="color: #949494;" class="text-left"><em>Minimum 10 characters required</em></p>	
              </td>
            </tr>
              <tr>
              <td class="text-right" width="20%"><strong>Confirm Password</strong></td>
              <td>
                <%= field.input :temp_password_confirmation, autocomplete: "off", label: false, input_html: { class: 'set-password' } %>
              </td>
            </tr> -->
            <tr>
              <td colspan="2">
                  <%=link_to 'Cancel', @law_firm.new_record? ? lob_exception_requests_path : admin_law_firm_path, class: 'btn btn-danger btn-sm' %>
                  <%= field.button :submit, @law_firm.new_record? ? "Submit Law Firm" : "Update Law Firm", class: "" %>
              </td>
            </tr>
        </tbody>
      </table>
    <% end %>
  </div>
  