                              <div class="well">
                                  <table class="table table-striped">
                                      <tbody>
                                          <tr>
                                            <td class="text-right" width="20%"><strong>Name</strong></td>
                                            <td>
                                              <%= field.input :name, label: false , required: true %>
                                              <%= field.input :law_firm_category, :as => :hidden, :input_html => { :value => "NON_PANEL" } %>
                                            </td>
                                          </tr>
                                          <tr>
                                            <td class="text-right" width="20%"><strong>Email</strong></td>
                                            <td>
                                              <%= field.input :email, label: false , required: true %>
                                            </td>
                                          </tr>
                                          
                                          <tr>
                                            <td class="text-right" width="20%"><strong>Phone</strong></td>
                                            <td><%= field.input :phone, label: false, required: true %></td>
                                          </tr>
                                          <tr>
                                            <td class="text-right" width="20%"><strong>Would You use this firm on a regular basis?</strong></td>
                                            <td><%= field.input :firm_use_on_regular_basis, as: :radio_buttons, required: true,  label: false, collection: [["Yes", true], ["No", false]] %></td>
                                          </tr> 
                                          <tr>
                                            <td class="text-right" width="20%"><strong>Would You use this firm on a regular basis?</strong></td>
                                            <td><%= field.input :matter_type_ids, label: false, required: true, collection: MatterType.all.map{|mt| [mt.matter_type, mt.id] }, input_html: { multiple: true } %></td>
                                          </tr>
                                          
                                        <!--  <tr>
                                            <td class="text-right" width="20%"><strong>Description</strong></td>
                                            <td><%= field.input :description, label: false %></td>
                                          </tr>
                                          <tr>
                                            <td class="text-right" width="20%"><strong>Relationship Manager Name</strong></td>
                                            <td><%= field.input :relationship_manager_name, label: false %></td>
                                          </tr>
                                          <tr>
                                            <td class="text-right" width="20%"><strong>Relationship Manager Email</strong></td>
                                            <td><%= field.input :relationship_manager_email, label: false %></td>
                                          </tr>
                                          <tr>
                                            <td class="text-right" width="20%"><strong>Relationship Manager Phone</strong></td>
                                            <td><%= field.input :relationship_manager_phone, label: false %></td>
                                          </tr>
                                           <tr>
                                            <td class="text-right" width="20%"><strong>Temp. Password</strong></td>
                                            <td>
                                              <%= field.input :temp_password, autocomplete: "off", label: false, input_html: { class: 'set-password' } %>
                                              <p style="color: #949494;" class="text-left"><em>Minimum 10 characters required</em></p>	
                                            </td>
                                          </tr>
                                            <tr>
                                            <td class="text-right" width="20%"><strong>Confirm Password</strong></td>
                                            <td>
                                              <%= field.input :temp_password_confirmation, autocomplete: "off", label: false, input_html: { class: 'set-password' } %>
                                            </td>
                                          </tr> -->
                                      </tbody>
                                  </table>
                              </div>
                            <% end %>
                          </td>
                        </tr>
                        
                        <tr>
                          <td class="text-right" width="20%"><strong>IS this a specific niche expertise that is not already available from one of the preferred external counsel panel law firms ?</strong></td>
                          <td><%= f.input :niche_preferred_external_counsel_panel_law_firms, label: false, required: true,  collection: [["Yes", true], ["No", false]]  %></td>
                        </tr>
                        <tr class="niche_preferred_external_details"  style="display:none;">
                          <td class="text-right" width="20%"><strong>If yes please describe niche expertise</strong></td>
                          <td><%= f.input :niche_expertise, label: false%></td>
                        </tr>
                         <tr>
                          <td class="text-right" width="20%"><strong>Does this firm practice in a required unique geography that is not already available from one of the preferred outside counsel Panel Law firms?</strong></td>
                          <td><%= f.input :required_unique_geography, label: false, required: true, collection: [["Yes", true], ["No", false]]  %></td>
                        </tr>
                        <tr class="required_unique_geography_details"  style="display:none;">
                          <td class="text-right" width="20%"><strong>If yes , confirm geographic location</strong></td>
                          <td><%= f.input :geographic_location, label: false%></td>
                        </tr>
                         <tr>
                          <td class="text-right" width="20%"><strong>Would engagements of this firm involve the following</strong></td>
                          <td><%= f.input :involved_engagement, label: false, collection: ExceptionRequest::INVOLVED_ENGAGEMENT %></td>
                        </tr> 
                        
                        <tr>
                          <td class="text-right" width="20%"><strong>Women Owned</strong></td>
                          <td><%= f.input :women_owned, label: false, collection: ExceptionRequest::WOMEN_OWNED_TYPE,  required: true %></td>
                        </tr>
                        <tr class="women_owned_details" style="display:none;">
                          <td class="text-right" width="20%"><strong>Women Owned Details</strong></td>
                          <td><%= f.input :women_owned_details, label: false %></td>
                        </tr>
                        <tr>
                          <td class="text-right" width="20%"><strong>Please confirm the reason(s) , there than theses listed above, that this firm should be considered for the preferred outside counsel Panel </strong></td>
                          <td><%= f.input :reson_other, label: false, required: true %></td>
                        </tr>
                          <tr>
                          <td>
                              <a class="tab-next-btn prev-btn-exception" data-tab="tabs-provide">Previous</a>  
                            </td>
                            <td>
                              <%= f.button :submit, @exception_request.new_record? ? "Submit Request" : "Update Request", class: "" %>
                            </td>
                          </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
             <% end %>  
          </div>