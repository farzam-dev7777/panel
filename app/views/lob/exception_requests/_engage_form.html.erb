<div id="tabs-exception" class="tabs">
            <ul>
              <li>
                <a href="#tabs-reason">Confirm the reason</a>
              </li>
              <li>
                <a href="#tabs-payer">Select Payer</a>
              </li>
              <li>
                <a href="#tabs-provide">Provide Details </a>
              </li>
            </ul>
            <%= simple_form_for [:lob, @exception_request] do |f| %>
              <div id="tabs-reason">
                <div class="row">
                  <div class="col-md-12">
                     <div class="table-responsive">
                        <table class="table table-striped">
                          <tbody>
                            <tr>
                              <td class="text-right" width="30%"><strong>Confirm the reason?</strong></td>
                              <td><%= f.input :reason, as: :check_boxes, label: false, collection: ExceptionRequest::EXCEPTION_REQUEST_REASON,  required: true %></td>  
                            </tr>
                            <tr>
                              <td colspan="2">
                                <a class="tab-next-btn next-btn-exception" data-tab="tabs-payer">Next</a>  
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </div>
                  </div>
                </div>

              </div>
              <div id="tabs-payer">
                <div class="row">
                  <div class="col-md-12">
                    <div class="table-responsive">
                      <table class="table table-striped">
                        <tbody>
                          <tr>
                            <td class="text-right" width="30%"><strong>Select Payer</strong></td>
                            <td><%= f.input :payer, as: :radio_buttons, label: false, collection: ExceptionRequest::EXCEPTION_REQUEST_PAYER,  required: true %></td>  
                          </tr>
                          <tr>
                            <td  >
                              <a class="tab-next-btn prev-btn-exception" data-tab="tabs-reason">Previous</a>  
                            </td>
                             <td  >
                              <a class="tab-next-btn next-btn-exception" data-tab="tabs-provide">Next</a>  
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
              <div id="tabs-provide">
