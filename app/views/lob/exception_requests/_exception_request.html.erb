<style>
	input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
</style>


<!-- widget div-->
<div>
          
    <!-- widget edit box -->
    
    <!-- end widget edit box -->
    
    <!-- widget content -->
    <div class="widget-body no-padding">

      <!-- widget body text-->
      
      <div class="tab-content padding-10">
        <div class="tab-pane fade in active">
          <div class="col-md-10">
            <div class="col-md-12">
              <div class="col-md-4 column">Requested By	</div>
              <div class="col-md-8 data"><%= @exception_request.requested_by %></div>
            </div>
            <div class="col-md-12">
              <div class="col-md-4 column">Submitted By</div>		
              <div class="col-md-8 data"><%= @exception_request.submitted_by_email %></div>
            </div>
            <div class="col-md-12">
              <div class="col-md-4 column">Line of Business	</div>		
              <div class="col-md-8 data"><%= @exception_request.line_of_business %></div>
            </div>
            <div class="col-md-12">
              <div class="col-md-4 column">Law Firm</div>		
              <div class="col-md-8 data">
                <div class="col-md-12 ">
                  <div class="col-md-12">
                    <div class="col-md-6 column">Law Firm Category : </div>
                    <div class="col-md-6 data firmName"><%= @law_firm.law_firm_category %></div>
                  </div>
                  <div class="col-md-12">
                    <div class="col-md-6 column">Name : </div>
                    <div class="col-md-6 data firmName"><%= @law_firm.name %></div>
                  </div>
                  <div class="col-md-12">
                    <div class="col-md-6 column">Email : </div>		
                    <div class="col-md-6 data firmEmail"><%= @law_firm.user.email %></div>
                  </div>
                  <div class="col-md-12">
                    <div class="col-md-6 column">Phone : </div>		
                    <div class="col-md-6 data firmPhone"><%= @law_firm.phone %></div>
                  </div>
                  <div class="col-md-12">
                    <div class="col-md-6 column">Description : </div>		
                    <div class="col-md-6 data firmPhone"><%= @law_firm.description %></div>
                  </div>
                  <div class="col-md-12">
                    <div class="col-md-6 column">Relationship Manager Name :	</div>		
                    <div class="col-md-6 data firmPhone"><%= @law_firm.relationship_manager_name %></div>
                  </div>
                  <div class="col-md-12">
                    <div class="col-md-6 column">Relationship Manager Email : </div>		
                    <div class="col-md-6 data firmPhone"><%= @law_firm.relationship_manager_email %></div>
                  </div>
                  <div class="col-md-12">
                    <div class="col-md-6 column">Relationship Manager Phone : </div>		
                    <div class="col-md-6 data firmPhone"><%= @law_firm.relationship_manager_phone %></div>
                  </div>
                  
                </div>
              </div>
            </div>
            <div class="col-md-12">
                <div class="col-md-4 column">Business Manager Name</div>
                <div class="col-md-8 data"><%= @exception_request.business_manager_name %></div>
              </div>
              <div class="col-md-12">
                <div class="col-md-4 column">Business Manager Email</div>		
                <div class="col-md-8 data"><%= @exception_request.business_manager_email %></div>
              </div>
              <div class="col-md-12">
                <div class="col-md-4 column">Business Manager Phone	</div>		
                <div class="col-md-8 data"><%= @exception_request.business_manager_phone %></div>
              </div>
            <div class="col-md-12">
              <div class="col-md-4 column">LOB Contact Name	</div>		
              <div class="col-md-8 data"><%= @exception_request.lob_contact_name %></div>
            </div>
            <div class="col-md-12">
                <div class="col-md-4 column">Law Firm ID</div>		
                <div class="col-md-8 data"><%= @exception_request.law_firm_id %></div>
              </div>
            <div class="col-md-12">
                <div class="col-md-4 column">Request type</div>		
                <div class="col-md-8 data"><%= @exception_request.request_type %></div>
              </div>
            <div class="col-md-12">
              <div class="col-md-4 column">Law firm Category</div>		
              <div class="col-md-8 data"><%= @exception_request.law_firm_category %></div>
            </div>
            <div class="col-md-12">
              <div class="col-md-4 column">Minority Owned</div>		
              <div class="col-md-8 data"><%= @exception_request.minority_owned %></div>
            </div>
            <div class="col-md-12">
              <div class="col-md-4 column">Minority Owned Details</div>		
              <div class="col-md-8 data"><%= @exception_request.minority_owned_details %></div>
            </div>
            <div class="col-md-12">
              <div class="col-md-4 column">Women Owned</div>		
              <div class="col-md-8 data"><%= @exception_request.women_owned %></div>
            </div>
            <div class="col-md-12">
              <div class="col-md-4 column">Women Owned Details</div>		
              <div class="col-md-8 data"><%= @exception_request.women_owned_details %></div>
            </div>
            <div class="col-md-12">
              <div class="col-md-4 column">Matter Name</div>		
              <div class="col-md-8 data"><%= @exception_request.matter_name %></div>
            </div>	
            <div class="col-md-12">
              <div class="col-md-4 column">Matter Types</div>		
              <div class="col-md-8 data"><%= @exception_request.matter_types.join(", ") %></div>
            </div>	
            <!-- <div class="col-md-12">
              <div class="col-md-4 column">LXP Status</div>
              <div class="col-md-8 data"><%=  @exception_request.lxp_status_show   %></div>
            </div>
            <div class="col-md-12">
              <div class="col-md-4 column">Internal Lawyers Status</div>
              <div class="col-md-8 data"><%= @exception_request.internal_lawyers_status_show %></div>
            </div> -->
            <div class="col-md-12">
              <div class="col-md-4 column">Waiver Approved</div>
              <div class="col-md-8 data"><%= @exception_request.fully_approved? ? "Yes" : "No" %></div>
            </div>
            <% if @exception_request.docusign_envelope_id.present? %>
             <div class="col-md-12">
                <div class="col-md-4 column">Pay Type</div>
                <div class="col-md-8 data"><%= @exception_request.pay_type_show %></div>
              </div>
              <div class="col-md-12">
                  <div class="col-md-4 column">Document Status</div>
                  <div class="col-md-8 data"><%= @exception_request.docusign_retainer_envelope.try(:status) %></div>
                </div>
            <% end %>	
          </div>
        
          <div class="clearfix"></div>

        </div>

      </div>
      
      <!-- end widget body text-->
      
    </div>
    <!-- end widget content -->
    
  </div>
  <!-- end widget div -->