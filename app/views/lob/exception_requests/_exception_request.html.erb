  
  <!-- widget div-->
  <div>      
    <!-- widget edit box -->
    <!-- end widget edit box -->
    <!-- widget content -->
    <div class="view-request">
      <!-- widget body text-->
      <div class="Col-md-12">
        <div class="sp-form-bg show-data-fields">
          <div class="row">
            <div class="col-xs-12 col-md-6">
              <div class="field-label">Reason for request	:	</div>
              <div class="field-data"><%= @exception_request.reason.reject(&:blank?).join(", ") %></div>
            </div>
            <div class="col-xs-12 col-md-6">
              <div class="field-label">Matter Type	:	</div>
              <div class="field-data"><%= @exception_request.matter_types_formated %></div>
            </div>
            <div class="col-xs-12 col-md-6">
              <div class="field-label">Country	:	</div>
              <div class="field-data"><%= @exception_request.countries_formated %></div>
            </div>
             <div class="col-xs-12 col-md-6">
              <div class="field-label">State/Province	:	</div>
              <div class="field-data"><%= @exception_request.states_formated %></div>
            </div>
             <div class="col-xs-12 col-md-6">
              <div class="field-label">Payer Type	:	</div>
              <div class="field-data"><%= @exception_request.payer %></div>
            </div>
            <div class="col-xs-12 col-md-6">
              <div class="field-label">Requested By :	</div>
              <div class="field-data"><%= @exception_request.requested_by %></div>
            </div>
            <div class="col-xs-12 col-md-6">
              <div class="field-label">Line of Business :	</div>		
              <div class="field-data"><%= @exception_request.line_of_business %></div>
            </div>
            <div class="col-xs-12 col-md-6">
              <div class="field-label">LOB Contact Name :	</div>		
              <div class="field-data"><%= @exception_request.lob_contact_name %></div>
            </div>
            <div class="col-md-12">
              <div class="inner-label">Law Firm :</div>	
              <div class="row inner-form-field">
                <div class="col-xs-12 col-md-6">
                  <div class="field-label">Law Firm Category : </div>
                  <div class="field-data"><%= @exception_request.law_firm.try(:law_firm_category) %></div>
                </div>
                <div class="col-xs-12 col-md-6">
                  <div class="field-label">Name : </div>
                  <div class="field-data"><%= @exception_request.law_firm.try(:name) %></div>
                </div>
                <div class="col-xs-12 col-md-6">
                  <div class="field-label">Email : </div>		
                  <div class="field-data"><%= @exception_request.law_firm.try(:email) %></div>
                </div>
                <div class="col-xs-12 col-md-6">
                  <div class="field-label">Phone : </div>		
                  <div class="field-data"><%= @exception_request.law_firm.try(:phone) %></div>
                </div>
                <!--<div class="col-xs-12 col-md-6">
                  <div class="field-label">Would You use this firm on a regular basis? : </div>		
                  <div class="field-data"><%= @exception_request.law_firm.try(:relationship_manager_name) ? "Yes" : "No" %></div>
                </div>
                <div class="col-xs-12 col-md-6">
                  <div class="field-label">Would You use this firm on a regular basis? :	</div>		
                  <div class="field-data"><%= @exception_request.law_firm.try(:show_matter_types) %></div>
                </div>-->
              </div>
            </div>
          </div>
          <div class="row form-field-alignment">
            <div class="col-xs-12 col-md-6">
              <div class="field-label">Name of Matter/ Client	:</div>
              <div class="field-data"><%= @exception_request.matter_name %></div>
            </div>
            <div class="col-xs-12 col-md-6">
              <div class="field-label">How will this matter be paid? :</div>		
              <div class="field-data"><%= @exception_request.mode_of_payment %></div>
            </div>
          </div>
          <div class="row form-field-alignment">
            <div class="col-xs-12 col-md-6">
              <div class="field-label">Description of the matter :</div>		
              <div class="field-data"><%= @exception_request.matter_description %></div>
            </div>
            <div class="col-xs-12 col-md-6">
              <div class="field-label">Will this matter involve the following : </div>		
              <div class="field-data"><%= @exception_request.matter_involve_following %></div>
            </div>
          </div>
          <div class="row form-field-alignment">      
            <!--div class="col-xs-12 col-md-6">
              <div class="field-label">What type of matter would this firm be working on?</div>		
              <div class="field-data"><%= @exception_request.show_matter_types %></div>
            </div-->
            <!--div class="col-xs-12 col-md-6">
              <div class="field-label">What jurisdiction will the law firm operate in for this matter?</div>		
              <div class="field-data"><%= @exception_request.jurisdiction %></div>
            </div-->
          </div>
          <div class="row form-field-alignment">      
            <div class="col-xs-12 col-md-6">
              <div class="field-label">Is this a certified minority/woman owned firm?</div>		
              <div class="field-data"><%= @exception_request.women_owned %></div>
            </div>
            <div class="col-xs-12 col-md-6">
              <div class="field-label">If yes, which organization certified the firm?</div>		
              <div class="field-data"><%= @exception_request.women_owned_details %></div>
            </div>
          </div>
          <div class="row form-field-alignment">
            <!--<div class="col-xs-12 col-md-6">
              <div class="field-label">Please confirm the reason(s) , there than theses listed above, that this firm should be considered for the preferred outside counsel Panel:</div>		
              <div class="field-data"><%= @exception_request.reson_other %></div>
            </div>-->
            <div class="col-xs-12 col-md-6">
              <div class="field-label">LXP Status:</div>
              <div class="field-data"><%=  @exception_request.lxp_status_show ? @exception_request.lxp_status_show : "-" %></div>
            </div>
            <!--div class="col-xs-12 col-md-6">
              <div class="field-label">Internal Lawyer Status:</div>
              <div class="field-data"><%= @exception_request.internal_lawyers_status_show ? @exception_request.internal_lawyers_status_show : "-"  %></div>
            </div-->
          </div>
          <div class="row form-field-alignment">
            <div class="col-xs-12 col-md-6">
              <div class="field-label">Approved:</div>
              <div class="field-data"><%= @exception_request.fully_approved? ? "Yes" : "No" %></div>
            </div>
            <div class="col-xs-12 col-md-6">
            </div>
          </div>
          <div class="row form-field-alignment">
            <% if @exception_request.docusign_envelope_id.present? %>
              <div class="col-xs-12 col-md-12">
                <div class="field-label">Document Status</div>
                <div class="field-data"><%= @exception_request.docusign_retainer_envelope.try(:status) %></div>
              </div>
              <% if @exception_request.docusign_retainer_envelope.try(:status) == "completed"%>
                <div class="col-xs-12 col-md-12">
                  <div class="field-label">Download Document</div>
                  <div class="field-data">
                    <%= link_to "Download Document", admin_exception_request_download_pdf_path(@exception_request), class: "" %>
                  </div>
                </div>
              <% end %>	
            <% end %>	
          </div>
        </div>
      </div>
      <!-- end widget body text-->
    </div>
    <!-- end widget content -->
  </div>
  <!-- end widget div -->