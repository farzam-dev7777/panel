<style>
  div#gauge * {
    top: -25px;
  }
</style>
<div class="col-lg-12 col-md-12 col-sm-12">
  <div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
    <div class="page-header-sp m-top">
      <div class="page-title">Non-Panel (one-off) Requests 
          <% if @exception_request.status_for_lob.present? %>
            <span style=" color: #fff; " class="<%= @exception_request.status_for_lob === "APPROVED" ? 'label label-success' : 'label label-default' %>"> 
              Status : <%= @exception_request.try(:status_for_lob) %>
            </span>
          <% end %>
      </div>
      <div class="back-edit-actions">
        <a class="btn-type-default" href="/lob/exception_requests">
          <%= image_tag "chevron-back-icon.svg", alt:"Back" %>
        </a>
        <% if current_user.role == "lob" %>
          <%= link_to "Edit".html_safe, exception_request_update_engage_lob_exception_requests_path(@exception_request), class: "btn-type-primary" %>
        <% end %>
      </div>
    </div>
    <div class="  ">
      <div class="jarviswidget-editbox"></div>
      <!-- widget content -->
      <div class="">
        <%= render "exception_request"  %>
      </div>
    </div>
  </div>
</div>
<%#= render "comments" %>
 