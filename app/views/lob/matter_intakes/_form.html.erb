<style>
	input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
</style>

<div class="sp-form sp-form-bg">
  <%= simple_form_for [:lob, @matter_intake] do |f| %>
    <div class="row form-flex-wrap">
      <div class="col-xs-12 col-md-6">
        <label  class="label">Submitter Name<span class="mandatory">*</span></label>
        <%= f.input :submitter_name, label: false, :input_html => { :value => @current_lob_user.try(:full_name) } %>
        <%= f.input :user_id, :as => :hidden, label: false, :input_html => { :value => @current_lob_user.id } %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label  class="label">LOB Contact Name<span class="mandatory">*</span></label>
        <%= f.input :lob_contact_name, label: false, collection: MatterIntake::LOB_CONTACT_NAMES %>
      </div>   
      <div class="col-xs-12 col-md-6">
        <label  class="label">Name of Matter/Client<span class="mandatory">*</span></label>
        <%= f.input :name_of_matter_client, label: false %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label  class="label">Type of Matter<span class="mandatory">*</span></label>
        <%= f.input :matter_type_id, label: false, collection: MatterType.all.map{|mt| [mt.matter_type, mt.id] } %>
      </div>   
      <div class="col-xs-12 col-md-6">
        <label  class="label">Matter Description<span class="mandatory">*</span></label>
        <%= f.input :matter_description, as: :string, label: false %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label  class="label">Will this matter involve the following?<span class="mandatory">*</span></label>
        <%= f.input :following_matter_involve,  label: false, collection: MatterIntake::MatterInvolveFollowing %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label  class="label">How will this law firm be paid?<span class="mandatory">*</span></label>
        <%= f.input :mode_of_payment, label: false, collection: MatterIntake::MatterBePaidOptions %>
      </div>   
      <div class="col-xs-12 col-md-6">
        <label  class="label">Law Firm Suggested<span class="mandatory">*</span></label>
        <%= f.input :law_firm_id, label: false, collection: LawFirm.where(law_firm_category: "PANEL").map{|lf| [lf.name, lf.id] } %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label  class="label">BMO lawyer name<span class="mandatory">*</span></label>
          <%= f.input :bmo_lawyer_name, label: false, collection: InternalLawyer.all.map {|il| [il.full_name, il.full_name, {'data-id'=>il.id}]} %>
          <%= f.input :lawyer_id, as: :hidden, label: false %>
      </div>   
      <!--<div class="col-xs-12 col-md-6">
        <label  class="label">Budget amount, if already negotiated with the law firm</label>
        <%= f.input :budget_amount, label: false %>
      </div>-->
      <div class="col-xs-12 col-md-6">
        <label  class="label">LOB contact to approve PO<span class="mandatory">*</span></label>
        <%= f.input :lob_contact_for_po, label: false %>
      </div>    
      <div class="col-xs-12 col-md-6">
        <label  class="label">Cost Centre for legal fees<span class="mandatory">*</span></label>
        <%= f.input :cost_centre_for_legal_fees, label: false %>
      </div>
       <div class="col-xs-12 col-md-6">
        <label  class="label">Deal Code (Capital Markets Only)</label>
        <%= f.input :deal_code, label: false %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label  class="label">Business/Group paying for this matter (level 1)<span class="mandatory">*</span></label>
        <%= f.input :business_paying_for_matter, label: false, collection: MatterIntake::Business %>
      </div>    
      <div class="col-xs-12 col-md-6">
        <label  class="label">Business/Group paying for this matter (level 2)<span class="mandatory">*</span></label>
        <%= f.input :group_paying_for_matter, label: false, collection: [] %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label  class="label">Paying Entity<span class="mandatory">*</span></label>
        <%= f.input :paying_entity, label: false, collection: MatterIntake::LegalEntity %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label  class="label">Additional Comments for LRC Lawyer<span class="mandatory">*</span></label>
        <%= f.input :additional_comments_for_lrc_lawyer, label: false %>
      </div>
      <div class="col-md-12">
        <%=link_to 'Cancel', @matter_intake.new_record? ? new_lob_matter_intake_path : new_lob_matter_intake_path, class: 'btn-type-default' %>
        <%= f.button :submit, @matter_intake.new_record? ? "Submit Matter Intake" : "Update Matter Intake", class: "btn-type-primary" %>      
      </div>
    </div>
  <% end %>
</div>