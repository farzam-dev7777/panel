<div class="sp-form sp-form-bg">
  <%= simple_form_for [:lob, @matter_intake], html: { multipart: true } do |f| %>
      <%= render 'fields', f: f %>
      <% if !@matter_intake.new_record? %>
        <%= f.input :submit_type, as: :hidden, label: false, :input_html => { :value => "update" } %>
      <% end %>
      <div class="col-md-12">
        <%=link_to 'Cancel', @matter_intake.new_record? ? new_lob_matter_intake_path : new_lob_matter_intake_path, class: 'btn-type-default' %>
        <%= f.button :submit, @matter_intake.new_record? ? "Submit" : "Submit", class: "btn-type-primary lob_matter_submit_btn" %>
      </div>
    </div>
  <% end %>
</div>
