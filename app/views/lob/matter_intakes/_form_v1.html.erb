<div class="sp-form sp-form-bg">
  <% invoice_enable = false%>
  <% matter_role = @matter_intake.matter_form_role(current_user)%>
  <%= simple_form_for [:lob, @matter_intake], html: { multipart: true } do |f| %>
    <div class="row form-flex-wrap">
      <%@matter_intake.generate_fields(current_user, Tenant.current).each do |obj| %>
        <% if obj[:access][matter_role] == 'write'%>
          <% if obj[:name].downcase.include?('invoice') == true && obj[:access][matter_role] == 'write' %>
            <% invoice_enable = true %>
          <% else %>
            <div class="col-xs-12 col-md-6">
              <label  class="label" style="white-space: unset;">
                <% if obj[:optional] == true %>
                  <%= obj[:name] %>
                <% else %>
                  <%= obj[:name] %><span class="mandatory">*</span>
                <% end %>
              </label>
              <% if obj[:access][matter_role] == 'read' %>
                <% if obj[:database_field] == :law_firm_id%>
                  <%= f.input obj[:database_field], label: false, :input_html => { :value => @matter_intake.law_firm&.name, disabled:true} %>
                <% else %>
                  <%= f.input obj[:database_field], label: false, :input_html => { :value => obj[:value], disabled:true} %>
                <% end %>
                <%= f.input obj[:database_field], as: :hidden, :input_html => { :value => obj[:value]} %>
              <% else %>
                <% if obj[:type] == 'dropdown' %>
                  <%= f.input obj[:database_field], label: false, collection: obj[:collection], input_html: { multiple: obj[:multiple].present? } %>
                <% else obj[:type] == 'text' %>
                  <%= f.input obj[:database_field], label: false, :input_html => { :value => obj[:value] } %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
      <% if !@matter_intake.new_record? %>
        <%= f.input :submit_type, as: :hidden, label: false, :input_html => { :value => "update" } %>
      <% end %>
      <div class="col-xs-12 col-md-12 text-right">
        <%=link_to 'Cancel', @matter_intake.new_record? ? matter_intakes_path : matter_intakes_path, class: 'btn-type-default' %>
        <%= f.button :submit, @matter_intake.new_record? ? "Next" : "Next", class: "btn-type-primary" %>
      </div>
    
      <% if invoice_enable == true%>
        <!-- New form start -->
        <div class="col-md-12 col-xs-12">
          <div class="formHeader">
            <div class="headerTitle">Invoices</div>
          </div>
        </div>
        <div class="col-md-12 col-xs-12">
          <% if !@new_form %>
            <% if @matter_intake.invoices.count > 0 %>
              <% @matter_intake.invoices.each do |invoice| %>
                <%= f.simple_fields_for :invoices, invoice do |form| %>
                  <%= render '/shared/invoice_fields', f: form, invoice: invoice %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
          <div class="addButton links mb-4">
            <%= link_to_add_association '<span href="javascript:void(0);"><i class="fa fa-plus-circle"></i> Add Invoice</span>'.html_safe, f, :invoices, partial: '/shared/invoice_fields' %> 
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
