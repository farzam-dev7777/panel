<% content_for :page_title do %>
  <span>Matter Intakes</span>
  <% end %>
  <div class="clearfix"></div>

  <div class="col-lg-12">
<div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
  <div class="page-header-sp m-top">
    <div class="page-title">Matter Intakes</div>
    <div>
      <%= link_to 'Submit New Matter Intake', new_lob_matter_intake_path, html_options = {class: 'page-header-btn'}   %>
    </div>
  </div>
  
  <div class="">
    <div class="no-padding">
      <div class="widget-body">
        <div id="myTabContent" class="tab-content">
          <div class="tab-pane fade active in padding-10 no-padding-bottom" id="s1">
            <div class="row no-space text-center">
              <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                <p><b><%= certification_status(current_law_firm) %></b></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- widget div-->
    <div>
      <!-- widget content -->
      <div class="table-dyanmic-search table-responsive">
        <table id="dt_basic" class="table table-decoration table-bordered" width="100%">
          <thead>
            <tr>
              <th>Submitter Name</th>
              <th>LOB Contact Name</th>
              <th>Name of Matter/Client</th>
              <th>Type of Matter</th> 
              <th>Law Firm Suggested</th>
              <th>BMO lawyer name</th>
              <th>Budget amount</th>
              <th>Status</th>
              <!--<th width="8%">Action</th>-->
            </tr>
          </thead>
          <tbody>
            <% @matter_intakes.each do |matter_intake| %>
              <tr  onClick="window.location.href='/lob/matter_intakes/<%= matter_intake.id %>'">
                <td>
                  <div class="firm-name">
                    <div class="name-avatar">
                      <img src="<%= get_avatar_image(matter_intake&.submitter_name&.gsub(" ", "+")) %>">
                    </div>
                    <div><%= matter_intake.submitter_name %></div>
                  </div>
                </td>
                <td><%= matter_intake.lob_contact_name %></td>
                <td><%= matter_intake.name_of_matter_client %></td>
                <td><%= matter_intake.matter_type.try(:matter_type) %></td>
                <td><%= matter_intake.law_firm.try(:name) %></td>
                <td><%= matter_intake.bmo_lawyer_name %></td>
                <td><%= matter_intake.budget_amount %></td>
                <td>
                  <div class="status">
                  <span class="<%= matter_intake.status === "matter_open" ? 'label label-success' : 'label label-default' %>"> 
                    <%= matter_intake.status.try(:titleize) %>
                  </span>
                  </div>
                </td>
                <!--<td>
                  <div class="action-fields">
                    <% if matter_intake.status === "waiting_for_lawyer_review" %>
                    <a class="action-btn" href="/lob/matter_intakes/<%= matter_intake.id %>/edit">
                      <%= image_tag "edit-icon.svg", alt:"Edit" %>
                    </a>
                    <% link_to "Edit", edit_lob_matter_intake_path(matter_intake), class: "btn btn-xs btn-primary" %>	
                    <% end %>
                    <a class="action-btn" href="/lob/matter_intakes/<%= matter_intake.id %>">
                      <%= image_tag "view-icon.svg", alt:"View" %>
                    </a>
                    <% link_to "view", lob_matter_intake_path(matter_intake), class: "btn btn-xs btn-secondary" %>	
                  </div>
                </td>-->
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <!-- end widget content -->
    </div>
    <!-- end widget div -->
  </div>
  <!-- end widget -->
</div>