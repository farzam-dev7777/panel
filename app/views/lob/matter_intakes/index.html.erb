<% content_for :page_title do %>
  <span>Matters</span>
<% end %>
<div class="clearfix"></div>
<div class="col-lg-12">
  <div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
    <div class="page-header-sp m-top">
      <div class="page-title">Matters</div>
      <div>
        <!-- <%= link_to 'Submit New Matters', new_lob_matter_intake_path, html_options = {class: 'page-header-btn'}   %> -->
      </div>
    </div>
    <div class="">
      <div class="no-padding">
        <div class="widget-body">
          <div id="myTabContent" class="tab-content">
            <div class="tab-pane fade active in padding-10 no-padding-bottom" id="s1">
              <div class="row no-space text-center">
                <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                  <p><b><%= certification_status(current_law_firm) %></b></p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Search filter -->
      <div class="search-filter-sp">
        <div class="sp-filter">
          <div class="accordion" id="sp-filter">
            <div class="card z-depth-0">
              <div class="card-header" id="headingThree">
                <div class="action-buttons-alignment">
                  <a class="export-icon right-action-btns add-button" href="<%= new_lob_matter_intake_path %>">
                    <%= image_tag "add.svg", alt:"Submit New Matter Intake Form" %> <span>New Matter Request</span>
                  </a>
                </div>
                <div class="collapsed filter-title" type="button" data-toggle="collapse" data-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                  <%= image_tag "filter-icon.svg", alt:"score" %>
                  <span>Filter</span>
                </div>
              </div>
              <div id="collapseThree" class="col-md-12 collapse sp-filter-fields" aria-labelledby="headingThree" data-parent="#sp-filter">
                <div class="card-body sp-form">
                  <%= search_form_for [:lob, @q] do |f| %>
                    <div class="row">
                      <div class="col-xs-12 col-sm-4">
                        <%= f.label :matter_description_cont, label: false, :class => 'label' %>
                        <%= f.search_field :matter_description_cont, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 col-sm-4">
                        <%= f.label :invoice_status_cont, label: false, :class => 'label' %>
                        <%= f.search_field :invoices_status_cont, value: @invoice_status, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 col-sm-4">
                        <%= f.label :budget_amount_lt_any, 'Fee estimate(max amount)', :class => 'label' %>
                        <%= f.search_field :budget_amount_lteq_any, :class => 'sp-form-control' %>
                      </div>
                      <div class="col-xs-12 text-right" style="margin-top: 20px;">
                        <%= f.submit "Search", class: "btn-type-primary input-btn m-right" %>
                        <%= f.submit "Reset", type: "reset", value: "Reset",  class: "btn-type-default input-btn" %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Search Filter END -->
      <div>
        <!-- widget content -->
        <div class="table-dyanmic-search table-responsive">
          <table id="dt_basic" class="table table-decoration table-bordered" width="100%">
            <thead>
              <tr>
                <th>Matter #</th>
                <th>Matter Name</th>
                <th>Date Submitted</th>
                <th>External Law Firm</th>
                <th>Requested By</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% @matter_intakes.each do |matter_intake| %>
                <tr onClick="window.location.href='/lob/matter_intakes/<%= matter_intake.id %>'">
                  <td>
                    <%= matter_intake.matter_number.present? ? matter_intake&.matter_number : "-" %>
                  </td>
                  <td>
                    <%= matter_intake&.name_of_matter_client %>
                  </td>
                  <td>
                    <%= matter_intake.created_at&.strftime('%Y/%m/%d') %>
                  </td>
                  <td>
                    <%= matter_intake&.law_firm&.name %>
                  </td>
                  <td>
                    <% if matter_intake.submitter_name.present? %>
                      <div class="firm-name">
                        <div class="name-avatar"><img src="<%= get_avatar_image(matter_intake&.submitter_name&.gsub(" ", "+")) %>"></div>
                        <div><%= matter_intake&.submitter_name %></div>
                      </div>
                    <% end %>
                  </td>
                  
                  <td>
                    <div class="status">
                      <span class="<%= matter_intake&.status === "matter_open" ? 'label label-success' : 'label label-default' %>">
                        <%= matter_intake.show_status %>
                      </span>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <!-- end widget content -->
      </div>
      <!-- end widget div -->
    </div>
    <!-- end widget -->
  </div>
