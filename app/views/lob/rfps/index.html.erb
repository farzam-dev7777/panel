<% content_for :page_title do %>
	<span>RFP</span>
<% end %>


<div class="col-lg-12">
	<div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
			<div class="page-header-sp m-top">
				<div class="page-title">RFP</div>
  		</div>
			<!-- widget div-->
			<div>

				<!-- widget content -->
				<div class="table-dyanmic-search table-responsive">
					<table id="dt_basic" class="table table-decoration table-bordered"  width="100%">
						<thead>			                
							<tr>
							<th>Title</th>
							<th>Date Submitted</th>
							<th>Status</th>
							<th>Action</th>
							</tr>
						</thead>
						<tbody>
							<% @rfps.each do |rfp| %>
								<tr class="lob-rfp-row" data-id="<%= rfp.id %>">
									<td><%= rfp.matter_intake.matter_number %></td>
									<td data-order="<%= rfp.created_at.strftime('%Y%m%d%H%M') %>">
										<%= rfp.created_at.strftime('%d %b %Y') %></td>
									<td><%= rfp.status %></td>
									<td><%= link_to "Proposals",lob_rfp_proposals_path(rfp), class: "btn btn-xs btn-secondary" %></td>
								</tr>
							<% end %>
						</tbody>
					</table>

				</div>
				<!-- end widget content -->

			</div>
			<!-- end widget div -->

		</div>
		<!-- end widget -->

</div>
