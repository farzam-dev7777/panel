<!DOCTYPE html>
<html lang="en-us" id="extr-page">
<head>
	<title>SEAL | 2 Factor Authentication</title>
	<%= csrf_meta_tags %>

	<%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>

	<style type="text/css">
		table.qrcode {
			border-width: 0;
			border-style: none;
			border-color: #0000ff;
			border-collapse: collapse;
		}
		table.qrcode td {
			border-width: 0;
			border-style: none;
			border-color: #0000ff;
			border-collapse: collapse;
			padding: 0;
			margin: 0;
			width: 10px;
			height: 10px;
		}
		table.qrcode td.black { background-color: #000; }
		table.qrcode td.white { background-color: #fff; }
		.login-page{
			background-image: url(<%= asset_path 'bg-photo.jpg' %>) !important;
		}
		.qrcodeimage {
			margin-bottom: 20px;
		}
		.qrcodeimage svg {
			transform: scale(0.5);
			background-color: #FFF;
		}
	</style>

</head>

<body>

	<div class="login-page" id="main" role="main">

		<!-- MAIN CONTENT -->
		<div id="content" class="container">

			<div class="row">

				<div class="col-md-12">
					<div class="col-md-6">
						<%= image_tag("bmo-logo.png") %>
					</div>
					<div class="col-md-6 text-right">
						<%= image_tag("seal-logo.png") %>
					</div>
				</div>


				
				<div class="col-lg-6 col-md-offset-3 no-padding tfa-wrapper">
					<h2 class="text-center" style="color: #fff;"><%= current_user.sign_in_count == 1 ? "Setup " : "" %>2 Factor Authentication</h2>

						<div class="text-center">
							<% if current_user.sign_in_count == 1 %>
								<%= image_tag current_user.google_qr_uri %>
								<br />
								Please download/open Google Authenticator App for <a target="_blank" style="color: #fff;" href="https://itunes.apple.com/ca/app/google-authenticator/id388497605?mt=8">Download for iOS</a> or <a target="_blank" style="color: #fff;" href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&hl=en_CA">Download for Android</a> based phones.
								
							<% end %>
						</div>

					<form method="POST" action="/two_factor_authentication">
						<div class="col-md-12">
							<div class="col-md-11 no-padding">
								<input style="color: #fff" type="text" placeholder="XXXXXX" name="code" class="form-control">
								<p style="color: #fff;"><i> Don't know what this is? <a href="/google-authenticator.png" style="color: #ccc" target="_blank">Click here</a> to learn more</i></p>
							</div>
							<div class="col-md-1 no-padding">
								<input class="btn btn-primary" type="submit" value="Verify">
							</div>
						</div>
					</form>

				</div>

				<div style="margin-top: 20px;" class="col-lg-6 col-md-offset-3 no-padding text-center">
					<a href="/users/sign_out" title="Sign Out" data-action="userLogout" data-logout-msg="You can improve your security further after logging out by closing this opened browser" class="btn btn-danger">Logout</a>
				</div>

			</div>
		</div>

	</div>


	<%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
</body>
</html>
