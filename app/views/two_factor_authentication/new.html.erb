<!DOCTYPE html>
<html lang="en-us" id="extr-page">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Panel | 2 Factor Authentication</title>
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>

  <script type="text/javascript">
    var myCallback = function(action, response) {
      $('.sp-signin-btn').show();
    };
  </script>
  <style type="text/css">
    .login-page{
      background-image: url(<%= asset_path 'bg-photo.jpg' %>) !important;
    }
    .alert, .notice { display: none }
  </style>
</head>

<body>



<% show_captcha = (cookies[:failure_count].present? && cookies[:failure_count].to_i > 3) %>
<div class="remove-padding" id="main" role="main"><!-- old class login-page -->
  <!-- New SignIn page -->
  <div class="sign-in-page">
    <div class="left-side signin-img">
    </div>
    <div class="right-side">
      <div class="signin-form">
        <div class="page-logo">
          <% if Tenant.current.present? && Tenant.current&.logo&.url.present? %>
            <%= image_tag Tenant.current&.logo&.url , alt:"CWB logo" %>
          <% else %>
            <%= image_tag "seal-logo-black.png", alt:"Seal Logo" %>
          <% end %>
        </div>
        <div class="sp-signin-form">
          <form method="POST" action="/two_factor_authentication">
            <div class="alert alert-danger login-error"></div>
              <span class="signin-alert">
                <% if alert %>
                  <%= content_tag :div, alert, :id => "<div class='alert alert-danger p-error'>flash_alert</div>".html_safe if alert.is_a?(String) && alert != 'You need to sign in or sign up before continuing.' %> 
                <% end %> 
              </span>
              <div>
                <div class="sp-input">
                  <input autofocus="autofocus" placeholder= 'XXXXXX' type="text" name="code">
                  <p><i> Didn't get the code in the email? <a href="/two_factor_authentication/send_two_factor_auth_again">Click here</a> to resend</i></p>                
                </div>
              </div>
              <div class="sp-signin-btn">
                <input class="btn-type-default" type="submit" value="Verify" style="background-color:black; color: white;">
                <%= link_to 'Logout', "/users/sign_out", class: 'btn-type-default', style:"background-color: black !important; color: white !important;" %>
              </div>
          </form>
        </div>
        <div class="sp-powered">
          <div>Powered By</div>
          <%= image_tag "seal-logo-light.png", alt:"Seal Logo" %>
        </div>
      </div>
    </div>
  </div>
</div>
  </div>
</div>
  <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
</body>
</html>
