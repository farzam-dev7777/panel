<!DOCTYPE html>
<html lang="en-us" id="extr-page">
<head>
	<title>Panel | 2 Factor Authentication</title>
	<%= csrf_meta_tags %>

	<%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>

	<style type="text/css">
		table.qrcode {
			border-width: 0;
			border-style: none;
			border-color: #0000ff;
			border-collapse: collapse;
		}
		table.qrcode td {
			border-width: 0;
			border-style: none;
			border-color: #0000ff;
			border-collapse: collapse;
			padding: 0;
			margin: 0;
			width: 10px;
			height: 10px;
		}
		table.qrcode td.black { background-color: #000; }
		table.qrcode td.white { background-color: #fff; }
		.login-page{
			background-image: url(<%= asset_path 'bg-photo.jpg' %>) !important;
		}
		.qrcodeimage {
			margin-bottom: 20px;
		}
		.qrcodeimage svg {
			transform: scale(0.5);
			background-color: #FFF;
		}
	</style>

</head>

<body>

	<div class="login-page" id="main" role="main">

		<!-- MAIN CONTENT -->
		<div id="content" class="container">

			<div class="row">

				<div class="col-md-12">
					<div class="col-md-6">
						<%= image_tag("cwb-logo.png") %>
					</div>
					<div class="col-md-6 text-right">
						<%= image_tag("panel-logo.png") %>
					</div>
				</div>

				
				<div class="col-lg-6 col-md-offset-3 no-padding tfa-wrapper">
					<%- if notice %>
						<div class="alert alert-success" role="alert">
							<%= notice %>
						</div>
					<% end %>

					<%- if alert %>
						<div class="alert alert-info" role="alert">
							<%= alert %>
						</div>
					<% end %>
					<h2 class="text-center" style="color: #fff;">2 Factor Authentication</h2>

						<p style="color: #fff;margin: 10px">Please check your email for authentication code.</p>	

					<form method="POST" action="/two_factor_authentication">
						<div class="col-md-12">
							<div class="col-md-11 no-padding">
								<input style="color: #fff" type="text" placeholder="XXXXXX" name="code" class="form-control">
								<p style="color: #fff;"><i> Didn't get the code in the email? <a href="/two_factor_authentication/send_two_factor_auth_again" style="color: #ccc">Click here</a> to resend</i></p>
							</div>
							<div class="col-md-1 no-padding">
								<input class="btn btn-primary" type="submit" value="Verify">
							</div>
						</div>
					</form>

				</div>

				<div style="margin-top: 20px;" class="col-lg-6 col-md-offset-3 no-padding text-center">
					<a href="/users/sign_out" title="Sign Out" data-action="userLogout" data-logout-msg="You can improve your security further after logging out by closing this opened browser" class="btn btn-danger">Logout</a>
				</div>

			</div>
		</div>

	</div>


	<%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
</body>
</html>