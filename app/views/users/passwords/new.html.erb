

<style type="text/css">
  .login-page{
    background-image: url(<%= asset_path 'bg-photo.jpg' %>) !important;
  }
</style>

<div class="login-page" id="main" role="main">

  <!-- MAIN CONTENT -->
  <div id="content" class="container">

    <div class="row">
	    <div class="col-lg-12 hidden-xs hidden-sm">
        <%= image_tag("bmo-logo.png") %>
      </div>
      <div class="col-xs-12 col-lg-8 col-lg-offset-2 login-form-wrapper">
        <div class="well">

	        <% if notice || alert %>
	        	<p class="notice"><%= notice %></p>
				    <p class="alert"><%= alert %></p>
	        <% end %>
            <header>
              Forgot Your Password
            </header>

           		<br>
              
							<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
	              <section>
									<%= f.label :email %><br />
									<%= f.email_field :email, autofocus: true,  style: 'width: 100%; padding: 8px 0px;' %>
								</section>
								<br>
								<footer class="row">
	                <div class="col-md-9">
								    <%= f.submit "Send me reset password instructions", class: 'btn btn-primary' %>
	                </div>
	                <div class="col-md-3 text-right" style="line-height: 30px;">
	                  <%= render "users/shared/links" %> 
	                </div>
	              </footer>
              <% end %>

              </div>
              
            </div>
          </div>
        </div>

      </div>

