
<div class="remove-padding" id="main" role="main"><!-- old class login-page -->
  <!-- New SignIn page -->
  <div class="sign-in-page">
    <div class="left-side signin-img">
    </div>
    <div class="right-side">
      <div class="signin-form">
        <div class="page-logo">
          <%= image_tag "seal-logo-black.png", alt:"Seal Logo" %>
        </div>
        <div class="sp-signin-form">
          <% if notice.present? %>
            <p style="color:red;"><%= notice %></p>
          <% end %>
          <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
            <section>
              <%= f.label :email %><br />
              <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
            </section>
            <br>
            <div class="sp-signin-btn">
              <%= f.submit "Change my password", class: 'btn-type-primary' %>
            </div>
            <%- if controller_name != 'sessions' %>
              <%= link_to "Log in", new_session_path(resource_name) %><br />
            <% end -%>
          <% end %>
        </div>
      </div>
    </div>
  </div>
