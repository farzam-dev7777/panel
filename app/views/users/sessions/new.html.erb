<!DOCTYPE html>
<html lang="en-us" id="extr-page">
<head>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<title>Panel | 2 Factor Authentication</title>
	<%= csrf_meta_tags %>
	<%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
<style type="text/css">
  .login-page{
    background-image: url(<%= asset_path 'bg-photo.jpg' %>) !important;
  }
  .alert, .notice { display: none }
</style>
</head>

<body>




<div class="remove-padding" id="main" role="main"><!-- old class login-page -->
  <!-- New SignIn page -->
  <div class="sign-in-page">
    <div class="left-side signin-img">
    </div>
    <div class="right-side">
      <div class="signin-form">
        <div class="page-logo">
          <%= image_tag "BMO-logo.svg", alt:"BMO Logo" %>
        </div>
        <div class="sp-signin-form">
          <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: {id: 'login-form', class: 'smart-form client-form'}) do |f| %>
            <div class="alert alert-danger login-error"></div>
              <%- flash.each do |name, msg| -%>
                <%= content_tag :div, msg, :id => "<div class='alert alert-danger p-error'>flash_#{name}</div>".html_safe if msg.is_a?(String) && msg != 'You need to sign in or sign up before continuing.' %> 
              <%- end -%> 
              <div>
                <label class="sp-label">Username</label>
                <div class="sp-input">
                  <%= f.text_field :username, autofocus: true %>
                </div>
              </div>
              <div>
                <label class="sp-label">Password</label>
                <div class="sp-input">
                <%= f.password_field :password, autocomplete: "off" %>
              </div>
            </div>
            <div class="sp-signin-btn">
              <%= f.submit "Agree & Continue", class: 'btn-type-primary' %>  
            </div>
            <div class="sp-tc">
              <label class="checkbox" style="padding-left: 0px">
                I agree to the <a href="#" data-toggle="modal" data-target="#tandcModal">Terms &amp; Conditions</a>
              </label>
            </div>
          <% end %>
        </div>
        <div class="sp-powered">
          <div>Powered By</div>
          <%= image_tag "seal-logo-light.png", alt:"Seal Logo" %>
        </div>
      </div>
    </div>
  </div>
  <!-- New SignIn page END -->
  <!-- MAIN CONTENT -->
  <div id="content" class="container hidden">
    <div class="row">
      <div class="col-md-12">
        <div class="col-md-6">
          <%= image_tag("bmo-logo.png") %>
        </div>
        <div class="col-md-6 text-right">
          <%= image_tag("panel-logo.png") %>
        </div>
      </div>
      <div class="col-xs-12 col-sm-12 col-md-5 col-lg-4 col-lg-offset-4 login-form-wrapper">
        <div class="well no-padding">
          <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: {id: 'login-form', class: 'smart-form client-form'}) do |f| %>
            <header>Sign In</header>
            <fieldset>
              <div class="alert alert-danger login-error"></div>
              <%- flash.each do |name, msg| -%>
                <%= content_tag :div, msg, :id => "<div class='alert alert-danger p-error'>flash_#{name}</div>".html_safe if msg.is_a?(String) && msg != 'You need to sign in or sign up before continuing.' %> 
              <%- end -%> 
              <section>
                <label class="label">Username</label>
                <label class="input"> <i class="icon-append fa fa-user"></i>
                <%= f.text_field :username, autofocus: true %>
                <b class="tooltip tooltip-top-right"><i class="fa fa-user txt-color-teal"></i> Please enter username</b></label>
              </section>
              <section>
                <label class="label">Password</label>
                <label class="input"> <i class="icon-append fa fa-lock"></i>
                <%= f.password_field :password, autocomplete: "off" %>
                <b class="tooltip tooltip-top-right"><i class="fa fa-lock txt-color-teal"></i> Enter your password</b> </label>
                <!-- <div class="note">
                  <%= link_to "Forgot password?", new_password_path('user'), :class => "login-link" %>

                </div> -->
              </section>
              <section>
                <label class="checkbox" style="padding-left: 0px">
                  <!-- <input id="tandc" type="checkbox" name="remember" required="required"> -->
                  <!-- <i></i> -->
                  I agree to the <a href="#" data-toggle="modal" data-target="#tandcModal">Terms &amp; Conditions</a>
                  <b class="tooltip tooltip-top-right"><i class="fa fa-user txt-color-teal"></i> Please enter username</b>
                </label>
              </section>
            </fieldset>
            <footer>
              <%= f.submit "Agree & Continue", class: 'btn btn-primary login-btn' %>  
            </footer>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
