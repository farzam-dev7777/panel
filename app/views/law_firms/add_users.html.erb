
<div id="main" role="main">

  <!-- MAIN CONTENT -->
  <div id="content" class="container">

    <div class="row">
      <div class="col-xs-12 col-lg-8 col-lg-offset-3 login-form-wrapper">
        <div class="well">

          <% if notice || alert %>
            <p class="notice"><%= notice %></p>
            <p class="alert"><%= alert %></p>
          <% end %>
            <header>
              <h5><strong>Add new user</strong></h5>
            </header>

              <br>

              <form method="post" action="/law_firms/invite_users">
              	<%= hidden_field_tag :authenticity_token, form_authenticity_token -%>
              	<section>
              		<label>Email</label>
              		<input type="email" name="email" placeholder="Enter the user's email" required="required">
              	</section>

              	<footer class="row">
                  <div class="col-md-9">
                  	<input type="submit" value="Add User" class="btn btn-lg btn-primary">
                  </div>
                </footer>
              </form>
              

              </div>
              
            </div>
          </div>

          <div class="row">
      <div class="col-xs-12 col-lg-8 col-lg-offset-3 login-form-wrapper">
        <div class="well">

          
            <header>
              <h5><strong><%= current_law_firm.name %> Users</strong></h5>
            </header>

              <br>

              <table id="dt_basic" class="table table-striped table-bordered table-hover" width="100%">
                <tr>
                  <th>Username</th>
                  <th>Email</th>
                  <th>Invited On</th>
                </tr>
                <% current_law_firm.users.where(role: 'user').each do |user| %>
                  <tr>
                    <td><%= user.username %></td>
                    <td><%= user.email %></td>
                    <td><%= user.created_at.strftime("%e %b %Y") %></td>
                  </tr>
                <% end %>
              </table>
              

              </div>
              
            </div>
          </div>

        </div>

      </div>

