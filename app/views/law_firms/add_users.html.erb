<div id="" role="main">
  <!-- MAIN CONTENT -->
  <div id="content" class="container inner-page">
    <div class="row">
      <div class="col-xs-12 col-md-12">
        <div class="">
          <div class="page-header-sp m-top">
            <div class="page-title">Add new collaborator 
              <span>You've added <%= current_law_firm.standard_users.count %> of <%= current_law_firm.law_firm_user_limit || 0 %> collaborators</span>
            </div>
          </div>
        </div>
      </div>
      <div class="col-xs-12 col-md-12 ">
        <div class="sp-form sp-form-bg">
          <form class="" method="post" action="/law_firms/invite_users">
            <div class="user-form-sp">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token -%>
              <div class="form-group col-md-12">
                <%= email_field_tag :email, nil, placeholder: "Email" -%>
              </div>
               <div class="form-group col-md-12">
                <%= password_field_tag :temp_password, nil, placeholder: "Temporary password" -%>
              </div>
              <div class="form-group col-md-12">
                <%= password_field_tag :temp_password_confirmation, nil, placeholder: "Temporary password confirmation" -%>
              </div>
            </div>
            <footer class="row" style="margin-top:15px;">
              <div class="col-md-12 text-center">
                <input type="submit" value="Add New Collaborator" class="btn-type-primary">
              </div>
            </footer>
          </form>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-xs-12 col-md-12">
        <div class="page-header-sp">
          <div class="page-title">Collaborators</div>
          <div></div>
        </div>
      </div>
      <div class="col-xs-12 col-md-12">
        <div class="">
          <div class="table-responsive">
          <table id="" class="table table-decoration table-bordered" width="100%">
            <thead>
              <tr>
                <th>Username</th>
                <th>Invited On</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
            <% current_law_firm.users.where(role: 'user').each do |user| %>
            <tr>
              <td><%= user.username %></td>
              <td><%= user.created_at.strftime("%e %b %Y") %></td>
              <td>
                <a href="javascript:void(0)" class="btn btn-sm btn-primary edit-password-btn">Edit</a>
                <%= link_to 'Delete',url_for(action: :delete_user ,id: user.id), method: :post, data: {confirm: "Are you sure you want to delete this user?" }, class: 'btn btn-sm btn-danger' %>
              </td>
            </tr>
            <tr class="edit-password-field hidden">
              <td colspan="5">
                <form action="/update_new_password" method="POST">
                  <div class="col-md-5">
                    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                    <input type="hidden" name="id" value="<%= user.id %>">
                    <input type="password" name="new_password" placeholder="Enter a new password">
                  </div>
                  <div class="col-md-5">
                    <input type="hidden" name="id" value="<%= user.id %>">
                    <input type="password" name="new_password_confirmation" placeholder="Confirm new password">
                  </div>
                  <div class="col-md-2">
                    <input type="submit" value="Update" class="btn btn-primary">
                  </div>
                </form>
              </td>
            </tr>
            <% end %>
            </tbody>
          </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

