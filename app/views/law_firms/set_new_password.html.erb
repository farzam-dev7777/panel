<!DOCTYPE html>
<html lang="en-us" id="extr-page">
<head>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<title>Panel | 2 Factor Authentication</title>
	<%= csrf_meta_tags %>
	<%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
	<style>
		::-webkit-input-placeholder {
		  color: #FFF;
		}
		::-moz-placeholder {
		  color: #FFF;
		}
		:-ms-input-placeholder {
		  color: #FFF;
		}
		:-moz-placeholder {
		  color: #FFF;
		}
	</style>
</head>

<body>
	<div class="remove-padding" id="main" role="main"><!-- old class "login-page" -->
		<!-- New SignIn page -->
			<div class="sign-in-page">
				<div class="left-side signin-img">
				</div>
				<div class="right-side">
					<div class="signin-form">
						<div class="page-logo">
							<%= image_tag "BMO-logo.svg", alt:"BMO Logo" %>
						</div>
						<div class="signin-tagline">
							Set New Password
						</div>
						<div class="sp-signin-form">
							<% if notice %>
								<p class="alert alert-success"><%= notice %></p>
							<% end %>
							<% if alert %>
								<p class="alert alert-warning"><%= alert %></p>
							<% end %>
							<form action="/update_new_password" method="POST">
								<%= hidden_field_tag :authenticity_token, form_authenticity_token %>
								<div>
									<label class="sp-label">New password</label>
									<div class="sp-input">
										<input style="" type="password" name="new_password">
									</div>
								</div>
								<div>
									<label class="sp-label">Confirm new password</label>
									<div class="sp-input">
										<input type="password" name="new_password_confirmation">
									</div>
								</div>
								<div class="sp-signin-btn">
									<input class="btn-type-primary" type="submit" name="Set new password">  
								</div>
							</form>
						</div>
						<div class="sp-powered">
							<div>Powered By</div>
          		<%= image_tag "seal-logo-light.png", alt:"Seal Logo" %>
						</div>
					</div>
				</div>
			</div>
		<!-- New SignIn page END -->
		<!-- MAIN CONTENT -->
	</div>
	<%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
</body>
</html>
