<!DOCTYPE html>
<html lang="en-us" id="extr-page">
<head>
	<title>SEAL | 2 Factor Authentication</title>
	<%= csrf_meta_tags %>

	<%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>

	<style>
		::-webkit-input-placeholder {
		  color: #FFF;
		}
		::-moz-placeholder {
		  color: #FFF;
		}
		:-ms-input-placeholder {
		  color: #FFF;
		}
		:-moz-placeholder {
		  color: #FFF;
		}
	</style>
</head>

<body>

	<div class="login-page" id="main" role="main">

		<!-- MAIN CONTENT -->
		<div id="content" class="container">

			<div class="row">

				<div class="col-md-12">
					<div class="col-md-6">
						<%= image_tag("bmo-logo.png") %>
					</div>
					<div class="col-md-6 text-right">
						<%= image_tag("seal-logo.png") %>
					</div>
				</div>


				
				<div class="col-lg-6 col-md-offset-3 no-padding tfa-wrapper">
					<% if notice %>
						<p class="alert alert-success"><%= notice %></p>
					<% end %>
			    <% if alert %>
			    	<p class="alert alert-warning"><%= alert %></p>
			    <% end %>
					<h2 class="text-center" style="color: #fff;">Set New Password</h2>

						<div class="text-center">
							<% if current_user.sign_in_count == 1 %>
								
								<form action="/update_new_password" method="POST">
									<%= hidden_field_tag :authenticity_token, form_authenticity_token %>
									<input style="color: #fff; margin-bottom: 10px;" type="password" name="new_password" placeholder="New password">
									<input style="color: #fff" type="password" name="new_password_confirmation" placeholder="Confirm new password">

									<p>&nbsp;</p>

									<input class="btn btn-primary" type="submit" name="Set new password">
								</form>

							<% end %>
						</div>

				</div>

			</div>
		</div>

	</div>


	<%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
</body>
</html>
