<style>
	input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
</style>

<div class="">
	<div class="sp-form sp-form-bg">
		<%= simple_form_for current_law_firm do |f| %>
			<div class="row">
				<div class="col-xs-12 col-md-6">
					<label class="label">BMO Relationship Partner Name</label>
					<%= f.input :bmo_relationship_partner_name, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
					<div class="col-xs-12 col-md-6">
					<label class="label">BMO Relationship Partner Email</label>
					<%= f.input :bmo_relationship_partner_email, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">BMO Relationship Partner Phone No.</label>
					<%= f.input :bmo_relationship_partner_phone_number, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Additional BMO Relationship Contact Name (optional)</label>
					<%= f.input :secondary_rm_contact, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Additional BMO Relationship Contact Email (optional)</label>
					<%= f.input :secondary_rm_contact_email, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Billing Contact Name</label>
					<%= f.input :billing_contact_name, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Billing Contact Email</label>
					<%= f.input :billing_contact_email,  label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Information Security Contact Name</label>
					<%= f.input :information_security_contact, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Information Security Contact Email</label>
					<%= f.input :information_security_contact_email, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<!--div class="col-xs-12 col-md-6">
					<label class="label">Diverse</label>
					<%= f.input :diverse, label: false, collection: LawFirm::DIVESER, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Value-Add Activities</label>
					<%= f.input :value_add_activities, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Feedback</label>
					<%= f.input :feedback, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Issues</label>
					<%= f.input :issues, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Merger/Combination</label>
					<%= f.input :merger_combination, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Engagement Number</label>
					<%= f.input :engagement_number, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Relationship Number</label>
					<%= f.input :relationship_number, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Information Security Class</label>
					<%= f.input :information_security_class, label: false, collection: LawFirm::INFORMATION_SECURITY_CLASS,  input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Information Security Assessment Outcome</label>
					<%= f.input :information_security_assessment_outcome, collection: LawFirm::INFORMATION_SECURITY_ASSESSMENT_OUTCOME, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Action Plan Findings</label>
					<%= f.input :action_plan_findings, as: :numeric, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div>
				<div class="col-xs-12 col-md-6">
					<label class="label">Action Plan Status</label>
					<%= f.input :action_plan_status, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
				</div-->
				<!--<div class="col-xs-12 col-md-6">
					<label class="label">Initial Date of Engagement with the bank</label>
					<%= f.input :initial_date_of_engagement_with_the_bank, as: :datepicker, label: false, input_html: { autocomplete: 'off', class: 'text-left datepicker' } %>
				</div>-->
				
			

				<div class="col-xs-12 col-md-6">
					<label class="label">Locations</label>
					<%= f.simple_fields_for :locations do |field| %>
						<%= render partial: "location_fields", locals: {f: field} %>
					<% end %>
					<div class="add-css">
						<%= link_to_add_association '<span href="javascript:void(0);" class="btn-type-default"><i class="fa fa-plus-circle"></i> Add Law Firm\'s Location(s)</span>'.html_safe, f, :locations %>
					</div>
				</div>
			
				<div class="row col-md-12">
					<div class="col-xs-12 col-md-6 multiple-selector">
						<label class="label">Types of matters your law firm has handled for us to date</label>
						<%= f.input :type_of_matters_your_law_firm_handles_for_us, label: false, collection: LawFirm::TYPES_OF_MATTERS_FOR_US, input_html: { autocomplete: 'off', class: 'text-left', multiple: true } %>
					</div>
					<div class="col-xs-12 col-md-6">
						<label class="label"><i class="fa fa-question-circle-o help-text" data-help="All users that have access to law firm files, electronic or physical"></i>No. of personnel</label>
						<%= f.input :number_of_lawyers, label: false, collection: LawFirm::NUMBER_OF_LAWYERS, input_html: { autocomplete: 'off', class: 'text-left' } %>
					</div>
				</div>
			
				
				<div class="col-xs-12 col-md-12 btn-decor-sp" style="margin-top: 30px;">
						<%= f.button :submit, 'Update & Continue', class: "btn-type-primary" %>
				</div>
			</div>
		<% end %>
	</div>
</div>