<style>
  input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
</style>
<div class="">
  <div class="sp-form sp-form-bg">
    <%= simple_form_for current_law_firm do |f| %>
      <div class="row">
        <div class="col-xs-12 col-md-6">
          <label class="label">Name</label>
          <%= f.input :name, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
        </div>
        <%= f.simple_fields_for :law_firms_tenants, @law_firm_tenant do |field| %>
          <div class="col-xs-12 col-md-6">
            <label class="label">Internal Relationship Partner Name</label>
            <%= field.input :bmo_relationship_partner_name, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Internal Relationship Partner Email</label>
            <%= field.input :bmo_relationship_partner_email, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Internal Relationship Partner Phone No.</label>
            <%= field.input :bmo_relationship_partner_phone_number, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Additional Internal Relationship Contact Name (optional)</label>
            <%= field.input :secondary_rm_contact, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Additional Internal Relationship Contact Email (optional)</label>
            <%= field.input :secondary_rm_contact_email, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Billing Contact Name</label>
            <%= field.input :billing_contact_name, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Billing Contact Email</label>
            <%= field.input :billing_contact_email,  label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Information Security Contact Name</label>
            <%= field.input :information_security_contact, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label">Information Security Contact Email</label>
            <%= field.input :information_security_contact_email, label: false, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
        <% end %>
        <div class="col-xs-12 col-md-6">
          <label class="label">Locations</label>
          <div class="col-md-12 no-padding">
            <div class="col-md-3">
              <div class="form-group optional law_firm_locations_country"><b>Country</b></div>
            </div>
            <div class="col-md-4"><b>Province</b></div>
            <div class="col-md-4"><b>City</b></div>
          </div>
          <%= f.simple_fields_for :locations do |field| %>
            <%= render partial: "location_fields", locals: {f: field} %>
          <% end %>
          <div class="add-css">
            <%= link_to_add_association '<span href="javascript:void(0);" class="btn-type-default"><i class="fa fa-plus-circle"></i> Add Law Firm\'s Location(s)</span>'.html_safe, f, :locations %>
          </div>
        </div>
        <div class="row col-md-12">
          <div class="col-xs-12 col-md-6 multiple-selector">
            <label class="label">Types of matters your law firm has handled for us to date</label>
            <%= f.input :type_of_matters_your_law_firm_handles_for_us, label: false, collection: LawFirm::TYPES_OF_MATTERS_FOR_US, input_html: { autocomplete: 'off', class: 'text-left', multiple: true } %>
          </div>
          <div class="col-xs-12 col-md-6">
            <label class="label"><i class="fa fa-question-circle-o help-text" data-help="All users that have access to law firm files, electronic or physical"></i>No. of personnel</label>
            <%= f.input :number_of_lawyers, label: false, collection: LawFirm::NUMBER_OF_LAWYERS, input_html: { autocomplete: 'off', class: 'text-left' } %>
          </div>
        </div>
        <div class="row col-md-12 show-data-fields">
          <% if @law_firm.panel_request && @law_firm.panel_request.docusign_envelope_id.present? %>
            <div class="col-md-12">
              <div class="field-label">Document Status</div>
              <div class="field-data"><%= @law_firm.panel_request.docusign_retainer_envelope.try(:status) %></div>
            </div>
            <% if @law_firm.panel_request &&  @law_firm.panel_request.docusign_retainer_envelope && @law_firm.panel_request.docusign_retainer_envelope.status == "completed"%>
              <div class="col-md-12">
                <div class="field-label">Download Document</div>
                <div class="field-data">
                  <%= link_to "Download Document", admin_panel_request_download_pdf_path(@law_firm.panel_request), class: "" %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>

        <div class="col-xs-12 col-md-12">
          <div class="inner-label">User Details</div>
          <%= f.simple_fields_for :users do |field| %>
            <div class="col-xs-12 col-md-6">
              <label class="label">Username</label>
              <%= field.input :username, label: false %>
            </div>
            <div class="col-xs-12 col-md-3">
              <label class="label">First Name</label>
              <%= field.input :first_name, label: false %>
            </div>
            <div class="col-xs-12 col-md-3">
              <label class="label">Last Name</label>
              <%= field.input :last_name, label: false %>
            </div>
          <% end %>
        </div>
        <div class="col-xs-12 col-md-12 btn-decor-sp" style="margin-top: 30px;">
          <%= f.button :submit, 'Update & Continue', class: "btn-type-primary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
