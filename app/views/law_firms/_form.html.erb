<style>
	input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
</style>


<div class="clearfix"></div>
<div class="container">
	<div class="table-responsive">
		<%= simple_form_for current_law_firm do |f| %>
			<table class="table table-striped">
				<tbody>
						<tr>
							<td class="text-left" width="20%"><strong>Name</strong></td>
							<td><%= f.input :name, autofocus: true, label: false, input_html: { autocomplete: 'off' } %></td>
						</tr>
						
						<tr>
							<td class="text-left" width="20%"><strong>Type</strong></td>
							<td><%= f.input :law_firm_type, label: false, collection: LawFirm::COMPANY_TYPES, input_html: { autocomplete: 'off', class: 'text-left' }, prompt: 'Please Select a Type' %></td>
						</tr>
						
						<tr>
							<td class="text-left" width="20%"><strong>Practice Area</strong></td>
							<td><%= f.input :practice_area, label: false, collection: LawFirm::PRACTICE_AREAS, input_html: { multiple: true } %></td>
						</tr>

						<tr>
							<td class="text-left" width="20%"><strong>Description</strong></td>
							<td><%= f.input :description, label: false, input_html: { autocomplete: 'off' } %></td>
						</tr>

						<tr>
							<td class="text-left" width="20%"><strong>Phone</strong></td>
							<td><%= f.input :phone, label: false, input_html: { autocomplete: 'off' } %></td>
						</tr>

						<tr>
							<td class="text-left" width="20%"><strong>Relationship Manager's Email</strong></td>
							<td><%= f.input :relationship_manager_email, label: false, input_html: { autocomplete: 'off' } %></td>
						</tr>

					<tr class="within-block">
							<td colspan="2" class="text-center"><strong>Key Security Contact/Information Security Officer</strong></td>
						</tr>

					<tr class="within-block">
							<td class="text-left" width="20%"><strong>Name</strong></td>
							<td><%= f.input :principle_name, label: false, input_html: { autocomplete: 'off' } %></td>
						</tr>

					<tr class="within-block">
							<td class="text-left" width="20%"><strong>Title</strong></td>
							<td><%= f.input :principle_title, label: false, input_html: { autocomplete: 'off' } %></td>
						</tr>

					<tr class="within-block">
							<td class="text-left" width="20%"><strong>Contact Info</strong></td>
							<td><%= f.input :principle_contact_info, label: false, input_html: { autocomplete: 'off' } %></td>
						</tr>
						
						<tr>
							<td class="text-left" width="20%"><strong>Parent Company</strong></td>
							<td><%= f.input :parent_company, label: false, input_html: { autocomplete: 'off' } %></td>
						</tr>
						
						<tr>
							<td class="text-left" width="20%"><strong>Sister Company</strong></td>
							<td><%= f.input :sister_firm, label: false, input_html: { autocomplete: 'off' } %></td>
						</tr>
						

						<tr>
							<td colspan="2">
								<div class="col-md-12 no-padding" style="margin-bottom: 15px">
									<div class="col-md-3"><label><strong>Address</strong></label></div>
									<div class="col-md-2"><label><strong>City</strong></label></div>
									<div class="col-md-2"><label><strong>State/Province</strong></label></div>
									<div class="col-md-2"><label><strong>Postal/Zip Code</strong></label></div>
									<div class="col-md-2"><label><strong>Country</strong></label></div>
								</div>
								<%= f.simple_fields_for :locations do |field| %>
							    <%= render partial: "location_fields", locals: {f: field} %>
							  <% end %>
							  <div class="add-css">
							    <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-primary btn-sm"><i class="fa fa-plus-circle"></i> Add Law Firm\'s Location(s)</span>'.html_safe, f, :locations %>
							  </div>
						  </td>
					  </tr>

						<tr>
							<td colspan="2">
								<div class="col-md-12">
									<div class="col-md-6">
										<label><strong>Country</strong></label>
									</div>
									<div class="col-md-5 j-states">
										<label><strong>States/Provinces</strong></label>
									</div>
								</div>
								<%= f.simple_fields_for :jurisdictions do |field| %>
							    <%= render partial: "jurisdiction_fields", 
							               locals: {f: field} unless field.object.nil? %>
							  <% end %>
							  <div class="add-css">
						    <%= link_to_add_association '<span href="javascript:void(0);" class="btn btn-primary btn-sm"><i class="fa fa-plus-circle"></i> Add Law Firm\'s Jurisdication(s)</span>'.html_safe, f, :jurisdictions %>
							  </div>
						  </td>
					  </tr>


						<tr>
							<td colspan="2">
								<%= f.button :submit, 'Update', class: "btn btn-primary btn-sm" %>
							</td>
						</tr>
				</tbody>
			</table>
		<% end %>
	</div>
</div>