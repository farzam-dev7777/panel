<!DOCTYPE html>
<html lang="en-us">
  <head>
    <title><%= params[:controller].humanize %> | Bluehound</title>
      
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <%= csrf_meta_tags %>

    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <!--[if IE]>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/html5shiv/3.7.3/html5shiv.js"></script>
    <![endif]-->
    <style>
      #main {
        margin-left: 0px;
      }
    </style>
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" integrity="sha384-wvfXpqpZZVQGK6TAh5PVlGOfQNHSoD2xbE+QkPxCAFlNEevoEH3Sl0sibVcOQVnN" crossorigin="anonymous">
  </head>

  <body class="smart-style-6">

        <!-- #HEADER -->
    <header id="header">
      <div id="logo-group">

        <!-- PLACE YOUR LOGO HERE -->
        <span id="logo">
          <a href="/"><%= image_tag "seal-white.png", alt:"SEAL" %></a>
        </span>
        <!-- END LOGO PLACEHOLDER -->

        <!-- Note: The activity badge color changes when clicked and resets the number to 0
           Suggestion: You may want to set a flag when this happens to tick off all checked messages / notifications -->

        <!-- AJAX-DROPDOWN : control this dropdown height, look and feel from the LESS variable file -->
        
        <!-- END AJAX-DROPDOWN -->
      </div>

      <div class="col-md-8 text-center portal-type">
        <p>Firm Portal</p>
      </div>
      <div class="col-md-1"></div>

       <div class="project-context hidden-xs col-md-1">

          <span class="label">Welcome</span>
          <span class="project-selector dropdown-toggle" data-toggle="dropdown"><%= current_user.username %> <i class="fa fa-angle-down"></i></span>

          <!-- Suggestion: populate this list with fetch and push technique -->
          <ul class="dropdown-menu">
            <% if current_law_firm && current_law_firm.form_submissions.any? && ( !['sent', 'started'].include? current_law_firm.form_submissions.latest.status ) %>
              <li>
                <%= link_to "Technologies", technology_profile_form_submission_path(current_law_firm.form_submissions.latest) %>
              </li>
              <li>
                <%= link_to "History", history_profile_form_submission_path(current_law_firm.form_submissions.latest) %>
              </li>
              <li class="divider"></li>
            <% end %>
            <li>
              <%= link_to "Change your password", edit_user_registration_path %>
            </li>
            <li class="divider"></li>
            <li>
              <a href="/users/sign_out"><i class="fa fa-power-off"></i> Logout</a>
            </li>
          </ul>
          <!-- end dropdown-menu-->

        </div>

      <!-- #PROJECTS: projects dropdown -->
      <!-- end projects dropdown -->
      
      <!-- #TOGGLE LAYOUT BUTTONS -->
      <!-- pulled right: nav area -->
      <div class="pull-right">
        
        <!-- #MOBILE -->
        <!-- Top menu profile link : this shows only when top menu is active -->
        <ul id="mobile-profile-img" class="header-dropdown-list hidden-xs padding-5">
          <li class="">
            <!-- <a href="#" class="dropdown-toggle no-margin userdropdown" data-toggle="dropdown"> 
              <img src="/assets/avatars/sunny.png" alt="John Doe" class="online" />  
            </a> -->
            <ul class="dropdown-menu pull-right">
              <li>
                <a href="javascript:void(0);" class="padding-10 padding-top-0 padding-bottom-0"><i class="fa fa-cog"></i> Setting</a>
              </li>
              <li class="divider"></li>
              <li>
                <a href="#ajax/profile.html" class="padding-10 padding-top-0 padding-bottom-0"> <i class="fa fa-user"></i> <u>P</u>rofile</a>
              </li>
              <li class="divider"></li>
              <li>
                <a href="javascript:void(0);" class="padding-10 padding-top-0 padding-bottom-0" data-action="toggleShortcut"><i class="fa fa-arrow-down"></i> <u>S</u>hortcut</a>
              </li>
              <li class="divider"></li>
              <li>
                <a href="javascript:void(0);" class="padding-10 padding-top-0 padding-bottom-0" data-action="launchFullscreen"><i class="fa fa-arrows-alt"></i> Full <u>S</u>creen</a>
              </li>
              <li class="divider"></li>
              <li>
                <a href="/users/sign_out" class="padding-10 padding-top-5 padding-bottom-5" data-action="userLogout"><i class="fa fa-sign-out fa-lg"></i> <strong><u>L</u>ogout</strong></a>
              </li>
            </ul>
          </li>
        </ul>
        
        <!-- collapse menu button -->
        <div id="hide-menu" class="btn-header pull-right hidden-lg">
          <span> <a href="javascript:void(0);" data-action="toggleMenu" title="Collapse Menu"><i class="fa fa-reorder"></i></a> </span>
        </div>

      </div>
      <!-- end pulled right: nav area -->

    </header>
    <!-- END HEADER -->

    <!-- #NAVIGATION -->
    <!-- Left panel : Navigation area -->
    <!-- Note: This width of the aside area can be adjusted through LESS/SASS variables -->
<!--     <aside id="left-panel">
      <div class="login-info">
        <span></span>
      </div>
      <nav>
        <ul>
          <li class="">
            <a href="/" title="blank_"><i class="fa fa-lg fa-fw fa-home"></i> <span class="menu-item-parent">Dashboard</span></a>
          </li>
        </ul>
      </nav>
    </aside> -->

        <!-- #MAIN PANEL -->
    <div id="main" role="main" style="padding-bottom: 0px">

      <!-- RIBBON -->
      <div id="ribbon">

        <!-- breadcrumb -->
        <ol class="breadcrumb">
          <li>Home</li>
          <li>Dashboard</li>
        </ol>

      </div>
    <!-- END NAVIGATION -->
    <div class="col-md-12">
      <% if notice %>
        <p class="alert alert-success"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="alert alert-warning"><%= alert %></p>
      <% end %>
    </div>
    <%= yield %>

      <div class="clearfix"></div>

    </div>
    <%= javascript_include_tag 'application' %>
    
    <% if current_law_firm && current_law_firm.try(:form_submissions).try(:latest).try(:total_score) && current_law_firm.try(:form_submissions).try(:latest).try(:status) == 'approved' %>
      <script>
        $('#law-firm-rating').rateYo({
          halfStar: true,
          rating: <%= current_law_firm.try(:total_calculated_score) %>,
          readOnly: true,
          multiColor: { 
            "startColor": "<%= current_law_firm.form_submissions.latest.try(:color, current_law_firm.total_calculated_score, 'total_calculated_score') %>", 
            "endColor": "<%= current_law_firm.form_submissions.latest.try(:color, current_law_firm.total_calculated_score, 'total_calculated_score') %>"
          }
        });
      </script>

      <%= javascript_include_tag 'http://cdnjs.cloudflare.com/ajax/libs/materialize/0.97.5/js/materialize.min.js' %>
    <% end %>

    <% if current_law_firm %>
      <script type="text/javascript">
        window.doorbellOptions = {
            appKey: 'jmrrnhLtSDvA0b1werKyiNoVi5SYAP44NBZkoAJycCHYYcXmNe5czwRTb8fYqVP7'
        };
        (function(w, d, t) {
            var hasLoaded = false;
            function l() { if (hasLoaded) { return; } hasLoaded = true; window.doorbellOptions.windowLoaded = true; var g = d.createElement(t);g.id = 'doorbellScript';g.type = 'text/javascript';g.async = true;g.src = 'https://embed.doorbell.io/button/6300?t='+(new Date().getTime());(d.getElementsByTagName('head')[0]||d.getElementsByTagName('body')[0]).appendChild(g); }
            if (w.attachEvent) { w.attachEvent('onload', l); } else if (w.addEventListener) { w.addEventListener('load', l, false); } else { l(); }
            if (d.readyState == 'complete') { l(); }
        }(window, document, 'script'));
      </script>
    <% end %>
    
  </body>
</html>
