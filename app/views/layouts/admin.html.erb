				<div class="col-xs-12 col-sm-7 col-md-7 col-lg-8 page-title">
					<%= yield :page_buttons %>
				</div>
			</div>
			<!-- end col -->

			<div class="col-lg-12 table-striped table-hover">
		    <%= yield %>
			</div>
			

		<!-- end row -->
		
		<!-- END #MAIN CONTENT -->

	</div>
	<!-- END #MAIN PANEL -->

