<!doctype html>
<html>
  <head>
    <meta charset='utf-8' />
  </head>
  <body onload='number_pages'>
    <div id="content" style="background-color: #efefef;">
      <style>
        body{
        font-family: Arial, Helvetica, sans-serif;
        font-size: 14px;
        }
        .main-element-div{
        width: 1024px; 
        margin: 0px auto;
        }
        .text-center{
        text-align: center;
        }
        .block-padding{
        margin-top: 25px;
        margin-bottom: 25px;
        }
      </style>
      <div class="main-element-div">
        <table width="100%">
          <tr class="text-center">
            <td> 
              <%= image_tag('panel-black.png', class: "block-padding") %>
            </td>
          </tr>
          <tr class="text-center">
            <td style="font-size: 18px; color: #484848; padding: 40px;">
              <%= yield %>
            </td>
          </tr>
         
      </table>
    </div>
  </body>
</html>