		<script> 
		$(document).ready(function(){
			$("#menu_toggle").click(function(){
				$("#dashboard_menu").slideToggle("");
			});
		});
		</script>
		<!-- Mobile main menu Start End -->
		<style>
      :root {
        --primary-color: <%= Tenant&.current&.primary_color || "#2b3344" %>;
      }
    </style>
	</head>

  <body class="">
		<!-- #HEADER -->
		<header id="header" class="sp-navbar">
			<div id="logo-group">
				<!-- PLACE YOUR LOGO HERE -->
				<span id="logo"> <a href="/lob"><%= image_tag "seal_logo.png", alt:"PANEL" %></a> </span>
				<!-- END LOGO PLACEHOLDER -->
			</div>

			<div class="text-center portal-type">
				<p><%= current_user&.lob_dashboard_name || "Business Dashboard" %></p>
			</div>
			<div id="menu_toggle_container"><div id="menu_toggle"><%= image_tag "menu-icon.svg", alt:"Menu_icon" %></div></div>
			<div class="project-context user-info hide-profile">
				<span class="project-selector dropdown-toggle" data-toggle="dropdown">
					<%= image_tag get_avatar_image(current_user.full_name), alt:"User", class:"user-image" %> 
					<span class="drop-down-icon">
						<%= image_tag "drop-down-icon.svg", alt:"Drop menu" %>
					</span>
				</span>
				<ul class="dropdown-menu">
					<li><a href="/lob/users/edit_profile/<%= current_user.id %>" title="Edit Profile" data-action="userLogout" >Profile</a></li>
					<li><a href="/lob/panel_requests" title="Panel Consideration Requests" >Panel Consideration Requests</a></li>
					<li role="separator" class="divider"></li>
					<li><a href="/users/sign_out" title="Sign Out" data-action="userLogout" data-logout-msg="You can improve your security further after logging out by closing this opened browser">Logout</a></li>
				</ul>
				<!-- end dropdown-menu-->
			</div>
		</header>
		<!-- END HEADER -->
		<div class="sp-main-page">
			<div class="left-side">
				<div class="sticky-left-side" id="dashboard_menu">
					<div class="dashboard-title"><%= current_user&.lob_dashboard_name || "Business Dashboard" %></div>
					<nav class="sp-sidebar">
						<ul>
							<li class="<%= active_menu_item('/lob') %> ">
								<a href="/lob" title="Dashboard"><i class="fa fa-home" aria-hidden="true"></i> <span class="menu-item-parent">Dashboard</span></a>
							</li>
							<% if current_user && current_user.role == 'lob' %>
								<%- if Tenant.current.enable_exception_requests %>
									<li class="<%= active_page?(:exception_requests) %> ">
										<a href="/lob/exception_requests" title="Exception Requests">
											<i class="fa fa-flag" aria-hidden="true"></i> <span class="menu-item-parent">Exception Request</span>
										</a>
									</li>
								<% end %>
								<li class="<%= active_page?(:matter_intakes) %>">
									<a href="/lob/matter_intakes" title="Matters"><i class="fa fa-users" aria-hidden="true"></i> Matters</a>
								</li>
								<li class="<%= active_page?(:invoies) %>">
									<a href="/lob/invoices" title="Invoices"><i class="fa fa-address-card" aria-hidden="true"></i> Invoices</a>
								</li>
								<li class="<%= active_page?(:panel_law_firms) %>">
									<a href="/lob/law_firms/panel_law_firms" title="Matters"><i class="fa fa-address-card" aria-hidden="true"></i> Panel Law Firms</a>
								</li>
								<li class="sp-menu-item-hidden">
									<a href="/lob/users/edit_profile/<%= current_user.id %>" title="Edit Profile" data-action="userLogout" >
										<% image_tag get_avatar_image(current_user.full_name), alt:"User", class:"user-image" %>
										<i class="fa fa-user-circle-o" aria-hidden="true"></i>
										<%= current_user.full_name %>
									</a>
								</li>
								<li class="sp-menu-item-hidden">
									<a href="/users/sign_out" title="Sign Out" data-action="userLogout" data-logout-msg="You can improve your security further after logging out by closing this opened browser">
									<i class="fa fa-power-off" aria-hidden="true"></i> Logout
									</a>
								</li>
							<% end %>
						</ul>
					</nav>
					<div class="bmo-logo">
						<% if Tenant.current.present? %>
							<%= image_tag Tenant.current&.logo&.url||'', alt:"CWB logo", style: "width: 100px;" %>
						<% end %>
					</div>
				</div>
			</div>
			<div class="right-side">
				<div class="">
					<div class="col-md-12">
						<% if !flash[:notice].blank? %>
							<div class="row">
								<div class="col-lg-12">
									<p class="alert alert-success"><%= flash[:notice] %></p>
								</div>
							</div>
						<% end %>
						<% if !flash[:alert].blank? %>
							<div class="row">
								<div class="col-lg-12">
									<p class="alert alert-warning"><%= flash[:alert] %></p>
								</div>
							</div>
						<% end %>
					</div>	
				</div>	
				<div class="main-container">
					<%= yield %>
				</div>
			</div>
		</div>
