<style>
	input, textarea, select { padding: 0px !important; margin: 0px; background: transparent; }
</style>


<div class="sp-form sp-form-bg">
  
		<%= simple_form_for [@conflict_waiver] do |f| %>
    <div class="row"> 
      <div class="col-xs-12 colmd-12">
        <label class="inner-label">Request For Conflict Waivers</label>
      </div>
      <div class="col-xs-12 col-md-6">
        <label  class="label">Name of law firm</label>
        <%= f.input :name_of_law_firm, label: false, input_html: { value: current_user.law_firm.name, readonly: true } %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label  class="label">Contact details (Email or Phone Number)</label>
        <%= f.input :contact_details, label: false %>
        <%= f.input :user_id, :as => :hidden, :input_html => { value: @current_user.id } %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label  class="label">BMO Business contact</label>
        <%= f.input :bmo_business_contact, label: false %>
      </div>
      <div class="col-xs-12 col-md-6">
        <label  class="label">Reason for request</label>
        <%= f.input :reason, as: :text, label: false, input_html: { rows: 1 } %>
      </div>
      <div class="col-xs-12 col-md-12">         
        <p><b>Does your request fall within one of the following categories?:</b></p>
        <ol class="conflict_waiver_categories_list">
          <li>
            An issuer or selling security holder in an underwriting; 
          </li>
          <li>
            A borrower in a normal course borrowing/mortgage transaction when we are already
            represented by other counsel;
          </li>   
          <li>
            A customer in the ordinary course of our business;
            A party to a transaction where we are a lender or advisor to another party to the
            transaction;
          </li>
          <li>
            A debtor in a bankruptcy, insolvency, restructuring or other similar proceeding that
            adjusts creditors’ rights where we are a creditor in such proceeding, provided that (i)
            you did not act directly or indirectly for us in the transaction or arrangement giving
            rise to our claim, and (ii) you notify us that you represent the debtor; or
          </li>
          <li>
            A party in a transaction to which we are not a party but where you acted on our
            behalf in a previous lending transaction with that party, provided that (i) the current
            transaction is unrelated to the previous lending transaction and (ii) it will have no
            bearing and/impact on the previous lending transaction.
          </li>
        </ol>
        <%#= f.input :retainer_language, as: :radio_buttons, label: false, collection: ConflictWaiver::RETAINER_LANGUAGE_TYPE  %>
      </div>
      <div class="col-xs-12 col-md-6">
          <label  class="label">I confirm that It’s not covered by the above waivers</label>
          <%= f.input :confirm_waiver, label: false, required: true, collection: [["Yes", true], ["No", false]]  %>
        </div>
        <div class="col-xs-12 col-md-12 confirm_waiver_notes" style="display:none;">
          <p>It appears your request is covered by your retainer agreement with BMO. If you are unsure, please select "No" above to proceed with submitting the request</p>
        </div>
      <div class="col-xs-12 col-md-12">
          <%=link_to 'Cancel', @conflict_waiver.new_record? ? admin_exception_requests_path : admin_law_firm_path, class: 'btn-type-default' %>
          <%= f.button :submit, @conflict_waiver.new_record? ? "Next" : "Next", class: "btn-type-primary" %>
      </div>
    </div>
		<% end %>
</div>