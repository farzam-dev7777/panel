<style>
		div#gauge * {
			top: -25px;
		}
	</style>
	<div class="container hidden">
		<div class="col-lg-3 back-btn">
			<%= link_to "<i class='fa fa-long-arrow-left'></i>".html_safe, conflict_waivers_path, class: "btn btn-sm btn-default" %>
			<% if @conflict_waiver.try(:lxp_status) == "REJECTED" %>
				<%= link_to "<i class='fa fa-pencil-square-o'></i> Edit".html_safe, edit_conflict_waiver_path, class: "btn btn-sm btn-primary m-l-15 no-border" %>
			<% end %>
		</div>
	</div>

	<div class="container">
		<div class="col-lg-12 col-md-12 col-sm-12">
			<div class="jarviswidget-color-darken" id="wid-id-2" data-widget-editbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false" data-widget-fullscreenbutton="false">
				<div class="page-header-sp m-top">
					<div class="page-title">New Conflict Waiver Requests</div>
					<div class="back-edit-actions">
						<a class="btn-type-default" href="/conflict_waivers">
							<%= image_tag "chevron-back-icon.svg", alt:"Back" %>
						</a>
						<% if @conflict_waiver.try(:lxp_status) == "REJECTED" %>
							<%= link_to "Edit".html_safe, edit_conflict_waiver_path, class: "btn-type-primary" %>
						<% end %>
					</div>
				</div>
					<div class="">
						<!-- widget content -->
						<div class="sp-form-bg show-data-fields">
							<div class="row">
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Name of law firm	</div>
									<div class="field-data"><%= @conflict_waiver.name_of_law_firm %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Contact details</div>		
									<div class="field-data"><%= @conflict_waiver.contact_details %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">BMO Business contact	</div>		
									<div class="field-data"><%= @conflict_waiver.bmo_business_contact %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Reason for Request	</div>		
									<div class="field-data"><%= @conflict_waiver.reason %></div>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">BMO Status</div>
									<div class="field-data"><%= @conflict_waiver.lxp_status_show %></div>
								</div>
								<% if @conflict_waiver.lxp_status === "ALREADY_COVERED" %>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Which part of the retainer covers</div>
									<div class="field-data"><%=  @conflict_waiver.retainer_cover   %></div>
								</div>
								<% end%>
								<div class="col-xs-12 col-md-12">         
									<p><b>Does your request fall within one of the following categories?</b></p>
									<ol class="conflict_waiver_categories_list">
										<li>
											An issuer or selling security holder in an underwriting; 
										</li>
										<li>
											A borrower in a normal course borrowing/mortgage transaction when we are already
											represented by other counsel;
										</li>   
										<li>
											A customer in the ordinary course of our business;
											A party to a transaction where we are a lender or advisor to another party to the
											transaction;
										</li>
										<li>
											A debtor in a bankruptcy, insolvency, restructuring or other similar proceeding that
											adjusts creditors’ rights where we are a creditor in such proceeding, provided that (i)
											you did not act directly or indirectly for us in the transaction or arrangement giving
											rise to our claim, and (ii) you notify us that you represent the debtor; or
										</li>
										<li>
											A party in a transaction to which we are not a party but where you acted on our
											behalf in a previous lending transaction with that party, provided that (i) the current
											transaction is unrelated to the previous lending transaction and (ii) it will have no
											bearing and/impact on the previous lending transaction.
										</li>
									</ol>
								</div>
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Is your request covered by any of the above?</div>
									<div class="field-data"><%= @conflict_waiver.confirm_waiver === true ? "Yes" : "No"  %></div>
								</div>
								<% if @conflict_waiver.confirm_waiver === true %>
									<div class="col-xs-12 col-md-12 confirm_waiver_notes" >
										<p>It appears your request is covered by your retainer agreement with BMO and there is no need to submit this request. If you are unsure, please select "No" above to proceed with submitting the request</p>
									</div>
								<% end %>	
								<div class="col-xs-12 col-md-6">
									<div class="field-label">Conflict Representing</div>
									<div class="field-data"><%= @conflict_waiver.repesenting %></div>
								</div>
								<% if @conflict_waiver.repesenting === "Other Client" %>	
									<div class="col-xs-12 col-md-6">
										<div class="field-label">Name(s) Of the other Clients</div>
										<div class="field-data"><%= @conflict_waiver.name_of_other_client %></div>
									</div>
										<div class="col-xs-12 col-md-6">
										<div class="field-label">Description Of Transactio</div>
										<div class="field-data"><%= @conflict_waiver.description_of_transaction %></div>
									</div>
										<div class="col-xs-12 col-md-6">
										<div class="field-label">Nature And Extent Of Mandate, e.g. Nagotiation, Documentation And Closing of Transaction</div>
										<div class="field-data"><%= @conflict_waiver.nature_of_mandate %></div>
									</div> 
									<div class="col-xs-12 col-md-6">
										<div class="field-label">Office Locations</div>
										<div class="field-data"><%= @conflict_waiver.office_locattion %></div>
									</div>
										<div class="col-xs-12 col-md-6">
										<div class="field-label">Names Of Primary Professionals Responsible For Managing The Mandate And The Transaction </div>
										<div class="field-data"><%= @conflict_waiver.names_of_primary %></div>
									</div>
								<% end %>
								<% if @conflict_waiver.repesenting === "BMO" %>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Name(s) Of the other Clients</div>
											<div class="field-data"><%= @conflict_waiver.name_of_other_client %></div>
										</div>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Description Of Transaction</div>
											<div class="field-data"><%= @conflict_waiver.description_of_transaction %></div>
										</div>
										<div class="col-xs-12 col-md-6">
											<div class="field-label">Types Of Matters For Which Your Firm Represents Other Client</div>
											<div class="field-data"><%= @conflict_waiver.types_of_matters.reject { |e| e.to_s.empty? }.join(', ') %></div>
											
										</div>
								<% end %>
	
  
							</div>
						</div>
					</div>
			</div>
		</div>
	</div>
		 