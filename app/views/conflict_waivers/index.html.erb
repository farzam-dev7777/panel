<% content_for :page_title do %>
  <span>Conflict Waiver</span>
<% end %>
<div class="container">
  <div class="col-lg-12">
    <div class="jarviswidget-color-darken" id="wid-id-0" data-widget-editbutton="false">
      <div class="page-header-sp m-top">
        <div class="page-title">Conflict Waiver</div>
        <div class="back-edit-actions">
          <a class="btn-type-default" href="/">
            <%= image_tag "chevron-back-icon.svg", alt:"Back" %>
          </a>
        </div>
      </div>
      <!-- widget div-->
      <div>
        <!-- widget content -->
        <div class="table-responsive table-dyanmic-search">
          <table id="dt_basic" class="table table-decoration table-bordered" width="100%">
            <thead>
              <tr>
                <th>Name of law firm</th>
                <th>Contact details</th>
                <th>BMO business  contact</th>
                <th width="8%">Action</th>
              </tr>
            </thead>
            <tbody>
              <% @conflict_waivers.each do |conflict_waiver| %>
                <tr>
                  <td><%= conflict_waiver.name_of_law_firm %></td>
                  <td><%= conflict_waiver.contact_details %></td>
                  <td><%= conflict_waiver.bmo_business_contact %></td>
                  <td> 
                    <div class="action-fields">
                      <% if conflict_waiver.try(:lxp_status) == "REJECTED" %>
                      <a class="action-btn" href="/conflict_waivers/<%= conflict_waiver.id %>/edit">
                        <%= image_tag "edit-icon.svg", alt:"Edit" %>
                      </a>	
                      <% end %>
                      <a class="action-btn" href="/conflict_waivers/<%= conflict_waiver.id %>">
                        <%= image_tag "view-icon.svg", alt:"View" %>
                      </a>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <!-- end widget content -->
      </div>
      <!-- end widget div -->
    </div>
    <!-- end widget -->
  </div>
</div>
